@page "/Account/ForgotPassword"
@layout AuthLayout

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using System.Text.Json
@using Microsoft.AspNetCore.DataProtection
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using ClinicApp.Data

@inject UserManager<ApplicationUser> UserManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject ClinicApp.Services.ClinicService ClinicService
@inject IDataProtectionProvider DataProtection
@inject IWebHostEnvironment Environment
@inject ILogger<ForgotPassword> Logger

<PageTitle>Forgot your password? | ProTouch Physio - Slimming Clinic</PageTitle>

<AuthSplitShell BrandTitle="Back in a minute"
                BrandTagline="We confirm it is you with a code on WhatsApp, then you choose a new password."
                Benefits="@(new[] { "A 6-digit code, valid for 5 minutes", "Works with your email or mobile number", "Your old password stops working once you reset" })">

    <div class="pt-auth-role-badge">
        <span class="pt-auth-role-dot"></span>
        Password help
    </div>

    <ol class="pt-auth-steps" aria-label="Reset progress">
        <li class="@(step == "find" ? "is-current" : "is-done")"><span>@(step == "find" ? "1" : "✓")</span>Find account</li>
        <li class="@(step == "reset" ? "is-current" : "")"><span>2</span>New password</li>
    </ol>

    <h1 class="pt-auth-heading">@(step == "reset" ? "Choose a new password" : "Forgot your password?")</h1>

    @if (step == "reset")
    {
        <p class="pt-auth-subheading">If an account matches, we sent a 6-digit code on WhatsApp to <strong>@maskedPhone</strong>.</p>

        @if (!string.IsNullOrEmpty(notice))
        {
            <div class="pt-auth-alert pt-auth-alert--info" role="status">@notice</div>
        }
        @if (!string.IsNullOrEmpty(resetError))
        {
            <div class="pt-auth-alert pt-auth-alert--error pt-auth-error-alert" role="alert">@resetError</div>
        }
        @if (!string.IsNullOrEmpty(testCode))
        {
            @if (Environment.IsDevelopment())
            {
                <div class="pt-auth-testcode" role="status">
                    <span>Development only. WhatsApp is in test mode, so no message was sent. Your code is</span>
                    <strong>@testCode</strong>
                </div>
            }
            else
            {
                <div class="pt-auth-alert pt-auth-alert--info" role="status">
                    WhatsApp is in test mode, so no code was sent. Ask the clinic to switch on live messaging.
                </div>
            }
        }

        <EditForm Model="Reset" FormName="forgot-verify" OnValidSubmit="ResetWithCode" method="post" autocomplete="off">
            <DataAnnotationsValidator />
            <ValidationSummary class="pt-auth-field-error" role="alert" />
            <input type="hidden" name="Reset.Token" value="@token" />

            <div class="pt-auth-field">
                <label for="Reset.Code">Verification code</label>
                <InputText @bind-Value="Reset.Code"
                           id="Reset.Code"
                           class="pt-auth-input pt-auth-otp"
                           type="text"
                           inputmode="numeric"
                           autocomplete="one-time-code"
                           maxlength="6"
                           pattern="[0-9]{6}"
                           data-pt-otp
                           data-pt-otp-nosubmit
                           autofocus
                           aria-required="true"
                           placeholder="••••••" />
                <ValidationMessage For="() => Reset.Code" class="pt-auth-field-error" />
            </div>

            <div class="pt-auth-field">
                <label for="Reset.Password">New password</label>
                <div class="pt-auth-input-wrap" data-pt-field="newpass">
                    <svg class="pt-auth-input-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 11h12v9H6zM8 11V8a4 4 0 0 1 8 0v3" /></svg>
                    <InputText type="password" @bind-Value="Reset.Password" id="Reset.Password" class="pt-auth-input"
                               autocomplete="new-password" data-pt-clear aria-required="true" placeholder="Create a new password" />
                    <button type="button" class="pt-auth-show-pw" data-pt-toggle-password aria-pressed="false" aria-label="Show password">
                        <svg class="pt-eye" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" /></svg>
                        <svg class="pt-eye-off" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3l18 18M10.6 6.1A10 10 0 0 1 12 5c6.5 0 10 7 10 7a17 17 0 0 1-3.2 4M6.5 7.5A17 17 0 0 0 2 12s3.5 7 10 7a9.6 9.6 0 0 0 4-.9" /></svg>
                    </button>
                </div>
                <div class="pt-auth-meter" data-pt-meter hidden>
                    <div class="pt-auth-meter-bar"><i></i></div>
                    <span class="pt-auth-meter-label" data-pt-meter-label></span>
                </div>
                <ul class="pt-auth-rules" data-pt-rules>
                    <li data-rule="len">8 or more characters</li>
                    <li data-rule="upper">A capital letter</li>
                    <li data-rule="lower">A small letter</li>
                    <li data-rule="digit">A number</li>
                </ul>
                <ValidationMessage For="() => Reset.Password" class="pt-auth-field-error" />
            </div>

            <div class="pt-auth-field">
                <label for="Reset.ConfirmPassword">Confirm new password</label>
                <div class="pt-auth-input-wrap" data-pt-field="confirm">
                    <svg class="pt-auth-input-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 11h12v9H6zM8 11V8a4 4 0 0 1 8 0v3" /></svg>
                    <InputText type="password" @bind-Value="Reset.ConfirmPassword" id="Reset.ConfirmPassword" class="pt-auth-input"
                               autocomplete="new-password" data-pt-clear aria-required="true" placeholder="Repeat the new password" />
                    <span class="pt-auth-valid" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12 5 5 9-10" /></svg></span>
                </div>
                <ValidationMessage For="() => Reset.ConfirmPassword" class="pt-auth-field-error" />
            </div>

            <button type="submit" class="pt-auth-button" data-pt-submit data-pt-loading="Saving…">
                <span>Save new password</span>
                <span class="pt-auth-btn-arrow">→</span>
            </button>
        </EditForm>

        <div class="pt-auth-inline-actions">
            <EditForm Model="Resend" FormName="forgot-resend" OnSubmit="ResendCode" method="post">
                <input type="hidden" name="Resend.Token" value="@token" />
                <button type="submit" class="pt-auth-link-button" data-pt-countdown="@retryAfter" data-pt-countdown-label="Resend code">Resend code</button>
            </EditForm>
            <a class="pt-auth-link-button" href="Account/ForgotPassword">Use a different account</a>
        </div>
    }
    else
    {
        <p class="pt-auth-subheading">Enter your email or mobile number. We will send a code to the mobile number on the account.</p>

        <EditForm Model="Input" FormName="forgot-password" OnValidSubmit="OnValidSubmitAsync" method="post" autocomplete="off">
            <DataAnnotationsValidator />
            <ValidationSummary class="pt-auth-field-error" role="alert" />

            <div class="pt-auth-field">
                <label for="Input.Identifier">Email or mobile number</label>
                <div class="pt-auth-input-wrap" data-pt-field="identifier">
                    <svg class="pt-auth-input-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /></svg>
                    <InputText @bind-Value="Input.Identifier" id="Input.Identifier" class="pt-auth-input"
                               autocomplete="off" autocapitalize="none" spellcheck="false" data-pt-clear data-pt-keep="@(!string.IsNullOrEmpty(Input.Identifier))" autofocus
                               aria-required="true" placeholder="name@example.com or 98765 43210" />
                    <span class="pt-auth-valid" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12 5 5 9-10" /></svg></span>
                </div>
                <ValidationMessage For="() => Input.Identifier" class="pt-auth-field-error" />
            </div>

            <button type="submit" class="pt-auth-button" data-pt-submit data-pt-loading="Sending code…">
                <span>Send code</span>
                <span class="pt-auth-btn-arrow">→</span>
            </button>

            <div class="pt-auth-form-footer">
                <span>Remembered it?</span>
                <a class="pt-auth-link" href="Account/Login">Sign in</a>
            </div>
        </EditForm>
    }
</AuthSplitShell>

@code {
    private string step = "find";
    private string token = "";
    private string maskedPhone = "your mobile number";
    private string? testCode;
    private string? notice;
    private string? resetError;
    private int retryAfter;

    [SupplyParameterFromForm(FormName = "forgot-password")]
    private InputModel Input { get; set; } = new();

    [SupplyParameterFromForm(FormName = "forgot-verify")]
    private ResetModel Reset { get; set; } = new();

    [SupplyParameterFromForm(FormName = "forgot-resend")]
    private TokenModel Resend { get; set; } = new();

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // A posted form can only be handled if it exists when the page first renders, so the step
    // that was on screen is worked out from the form that was sent.
    protected override void OnInitialized()
    {
        if (HttpMethods.IsPost(HttpContext.Request.Method) && HttpContext.Request.HasFormContentType)
        {
            var form = HttpContext.Request.Form;
            if (form.ContainsKey("Reset.Token") || form.ContainsKey("Resend.Token"))
                step = "reset";
        }
    }

    private ITimeLimitedDataProtector Protector =>
        DataProtection.CreateProtector("ProTouch.ForgotPassword.v1").ToTimeLimitedDataProtector();

    // The token carries who asked and where the code went. For an unknown account it carries nothing,
    // so the next screen looks the same and nobody can use this page to find out who has an account.
    private string MakeToken(Pending pending) =>
        Protector.Protect(JsonSerializer.Serialize(pending), TimeSpan.FromMinutes(20));

    private Pending? ReadToken(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;
        try { return JsonSerializer.Deserialize<Pending>(Protector.Unprotect(value)); }
        catch { return null; }
    }

    private async Task<ApplicationUser?> FindAccountAsync(string identifier)
    {
        identifier = identifier.Trim();
        if (identifier.Contains('@')) return await UserManager.FindByEmailAsync(identifier);
        var byPhone = await ClinicService.FindUserByPhoneAsync(identifier);
        return byPhone == null ? null : await UserManager.FindByIdAsync(byPhone.Id);
    }

    private async Task OnValidSubmitAsync()
    {
        var user = await FindAccountAsync(Input.Identifier);
        var phone = ClinicApp.Services.ClinicService.CanonicalPhone(user?.PhoneNumber);

        // No mobile number on the account: fall back to an email link, if the email is confirmed.
        if (user != null && phone == null)
        {
            if (!string.IsNullOrEmpty(user.Email) && await UserManager.IsEmailConfirmedAsync(user))
            {
                var emailCode = await UserManager.GeneratePasswordResetTokenAsync(user);
                emailCode = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(emailCode));
                var callbackUrl = NavigationManager.GetUriWithQueryParameters(
                    NavigationManager.ToAbsoluteUri("Account/ResetPassword").AbsoluteUri,
                    new Dictionary<string, object?> { ["code"] = emailCode });
                await EmailSender.SendPasswordResetLinkAsync(user, user.Email, HtmlEncoder.Default.Encode(callbackUrl));
            }
            RedirectManager.RedirectTo("Account/ForgotPasswordConfirmation");
            return;
        }

        if (user != null && phone != null)
        {
            var sent = await ClinicService.SendOtpAsync(phone);
            retryAfter = sent.RetryAfterSeconds;
            testCode = sent.TestCode;
            // Same words for every outcome, so this screen never shows whether an account exists.
            if (!sent.Sent) notice = "If the code does not arrive within a minute, ask for a new one.";
            maskedPhone = ClinicApp.Services.ClinicService.MaskPhone(phone);
            token = MakeToken(new Pending(user.Id, phone));
        }
        else
        {
            token = MakeToken(new Pending(null, null));
            retryAfter = 30;
        }
        step = "reset";
    }

    public async Task ResetWithCode()
    {
        token = Reset.Token;
        step = "reset";
        var pending = ReadToken(token);
        if (pending == null)
        {
            step = "find";
            notice = null;
            Input.Identifier = "";
            return;
        }
        maskedPhone = pending.Phone == null ? "your mobile number" : ClinicApp.Services.ClinicService.MaskPhone(pending.Phone);

        const string wrong = "That code is not right or has expired. Check it, or ask for a new one.";
        if (pending.UserId == null || pending.Phone == null)
        {
            resetError = wrong; Reset.Code = ""; Reset.Password = ""; Reset.ConfirmPassword = "";
            return;
        }

        var check = await ClinicService.VerifyOtpAsync(pending.Phone, Reset.Code);
        if (!check.Ok)
        {
            // Say how many tries are left only when it helps this person: it is their own account's code.
            resetError = check.AttemptsLeft == 0 ? check.Error : wrong;
            Reset.Code = ""; Reset.Password = ""; Reset.ConfirmPassword = "";
            return;
        }

        var user = await UserManager.FindByIdAsync(pending.UserId);
        if (user == null)
        {
            resetError = wrong;
            return;
        }

        var resetToken = await UserManager.GeneratePasswordResetTokenAsync(user);
        var result = await UserManager.ResetPasswordAsync(user, resetToken, Reset.Password);
        if (!result.Succeeded)
        {
            // The code was used up, so ask for a new one rather than leaving them stuck.
            resetError = string.Join(" ", result.Errors.Select(e => e.Description)) + " Ask for a new code and try again.";
            Reset.Code = ""; Reset.Password = ""; Reset.ConfirmPassword = "";
            return;
        }

        await UserManager.ResetAccessFailedCountAsync(user);
        if (await UserManager.IsLockedOutAsync(user)) await UserManager.SetLockoutEndDateAsync(user, null);
        Logger.LogInformation("A password was reset with a verification code.");
        RedirectManager.RedirectTo("Account/ResetPasswordConfirmation");
    }

    public async Task ResendCode()
    {
        token = Resend.Token;
        step = "reset";
        var pending = ReadToken(token);
        if (pending == null) { step = "find"; return; }
        maskedPhone = pending.Phone == null ? "your mobile number" : ClinicApp.Services.ClinicService.MaskPhone(pending.Phone);
        retryAfter = 30;
        if (pending.Phone != null)
        {
            var sent = await ClinicService.SendOtpAsync(pending.Phone);
            retryAfter = sent.RetryAfterSeconds;
            if (sent.Sent) { notice = "A new code is on its way."; testCode = sent.TestCode; }
            else resetError = sent.Error;
        }
        else notice = "A new code is on its way.";
    }

    private sealed record Pending(string? UserId, string? Phone);

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Enter your email or mobile number.")]
        public string Identifier { get; set; } = "";
    }

    private sealed class ResetModel
    {
        public string Token { get; set; } = "";

        [Required(ErrorMessage = "Enter the 6-digit code."), RegularExpression(@"^\d{6}$", ErrorMessage = "The code is 6 digits.")]
        public string Code { get; set; } = "";

        [Required(ErrorMessage = "Create a new password."), DataType(DataType.Password)]
        [RegularExpression(@"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{8,100}$", ErrorMessage = "Use at least 8 characters with a capital letter, a small letter and a number.")]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare("Password", ErrorMessage = "The two passwords do not match.")]
        public string ConfirmPassword { get; set; } = "";
    }

    private sealed class TokenModel
    {
        public string Token { get; set; } = "";
    }
}
