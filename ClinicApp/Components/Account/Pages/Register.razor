@page "/Account/Register"
@layout PublicLayout

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using ClinicApp.Data

@inject UserManager<ApplicationUser> UserManager
@inject IUserStore<ApplicationUser> UserStore
@inject SignInManager<ApplicationUser> SignInManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject ILogger<Register> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject RoleManager<IdentityRole> RoleManager
@inject ClinicApp.Services.ClinicService ClinicService

<PageTitle>Register | Sri Sai Protouch Portal</PageTitle>

<div class="auth-page">
    <div class="auth-card auth-card-wide">
        <div class="auth-brand">
            <img src="/images/sri-sai-protouch-logo.svg" alt="Sri Sai Protouch" />
            <p>Create your client account</p>
        </div>

        <StatusMessage Message="@Message" />

        <EditForm Model="Input" method="post" OnValidSubmit="RegisterUser" FormName="register">
            <DataAnnotationsValidator />
            <ValidationSummary class="auth-error" role="alert" />

            <div class="auth-grid">
                <div class="auth-field">
                    <label for="Input.FullName">Full Name *</label>
                    <InputText @bind-Value="Input.FullName" id="Input.FullName" class="auth-input"
                               autocomplete="name" aria-required="true" placeholder="Your full name" />
                    <ValidationMessage For="() => Input.FullName" class="auth-field-error" />
                </div>

                <div class="auth-field">
                    <label for="Input.Email">Email Address *</label>
                    <InputText @bind-Value="Input.Email" id="Input.Email" class="auth-input"
                               autocomplete="username" aria-required="true"
                               placeholder="name@example.com" />
                    <ValidationMessage For="() => Input.Email" class="auth-field-error" />
                </div>

                <div class="auth-field">
                    <label for="Input.PhoneNumber">Mobile Number</label>
                    <InputText @bind-Value="Input.PhoneNumber" id="Input.PhoneNumber" class="auth-input"
                               maxlength="15" placeholder="10-digit mobile number" />
                    <ValidationMessage For="() => Input.PhoneNumber" class="auth-field-error" />
                </div>

                <div class="auth-field">
                    <!-- spacer -->
                </div>

                <div class="auth-field">
                    <label for="Input.Password">Password *</label>
                    <InputText type="password" @bind-Value="Input.Password" id="Input.Password"
                               class="auth-input" autocomplete="new-password"
                               aria-required="true" placeholder="Minimum 8 characters" />
                    <ValidationMessage For="() => Input.Password" class="auth-field-error" />
                </div>

                <div class="auth-field">
                    <label for="Input.ConfirmPassword">Confirm Password *</label>
                    <InputText type="password" @bind-Value="Input.ConfirmPassword"
                               id="Input.ConfirmPassword" class="auth-input"
                               autocomplete="new-password" aria-required="true"
                               placeholder="Repeat your password" />
                    <ValidationMessage For="() => Input.ConfirmPassword" class="auth-field-error" />
                </div>
            </div>

            <button type="submit" class="auth-submit">Create Account →</button>

            <div class="auth-footer">
                <span>Already registered?</span>
                <a href="Account/Login">Sign in</a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private IEnumerable<IdentityError>? identityErrors;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? Message => identityErrors is null
        ? null
        : $"Error: {string.Join(", ", identityErrors.Select(e => e.Description))}";

    public async Task RegisterUser(EditContext editContext)
    {
        var user = Activator.CreateInstance<ApplicationUser>();
        await UserStore.SetUserNameAsync(user, Input.Email, CancellationToken.None);
        var emailStore = (IUserEmailStore<ApplicationUser>)UserStore;
        await emailStore.SetEmailAsync(user, Input.Email, CancellationToken.None);
        user.FullName = Input.FullName;
        if (!string.IsNullOrWhiteSpace(Input.PhoneNumber))
            user.PhoneNumber = Input.PhoneNumber;

        var result = await UserManager.CreateAsync(user, Input.Password);
        if (!result.Succeeded) { identityErrors = result.Errors; return; }

        if (!await RoleManager.RoleExistsAsync("Client"))
            await RoleManager.CreateAsync(new IdentityRole("Client"));
        await UserManager.AddToRoleAsync(user, "Client");

        Logger.LogInformation("User created a new account.");

        if (!string.IsNullOrWhiteSpace(Input.PhoneNumber))
        {
            await ClinicService.GeneratePhoneOtpAsync(Input.PhoneNumber);
            RedirectManager.RedirectTo("Account/VerifyPhone",
                new() { ["phone"] = Input.PhoneNumber, ["returnUrl"] = ReturnUrl });
            return;
        }

        await SignInManager.SignInAsync(user, isPersistent: false);
        RedirectManager.RedirectTo(ReturnUrl ?? "client-dashboard");
    }

    private sealed class InputModel
    {
        [Required, Display(Name = "Full name")]
        public string FullName { get; set; } = "";

        [Required, EmailAddress]
        public string Email { get; set; } = "";

        [Phone, StringLength(15)]
        public string PhoneNumber { get; set; } = "";

        [Required, StringLength(100, MinimumLength = 8), DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare("Password", ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
