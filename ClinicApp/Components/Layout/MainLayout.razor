@inherits LayoutComponentBase

<div class="page dashboard-theme">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 justify-content-between">
            <div class="d-flex align-items-center">
                <span class="text-secondary small d-none d-md-inline">ProTouch Physio - Slimming Clinic | Management Portal</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <AuthorizeView>
                    <Authorized>
                        <div class="user-badge">
                            <span class="text-teal" style="font-weight: 700; font-size: 0.85rem;">
                                @(context.User.IsInRole("Admin") ? "ADMIN" : "CLIENT")
                            </span>
                            <span style="color: var(--text-primary); font-size: 0.85rem; font-weight: 500;">
                                @(context.User.Identity?.Name)
                            </span>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <span class="text-secondary small">Not signed in</span>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>

        <article class="content px-4 py-4" style="flex: 1; overflow-y: auto;">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
