@inherits LayoutComponentBase

<div class="page dashboard-theme">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <header class="pt-topbar">
            <!-- Left slot: brand logo -->
            <div class="d-flex align-items-center gap-2">
                <img src="/favicon.svg" alt="" class="pt-topbar-logo" />
                <span class="pt-topbar-title">PROTOUCH Physio · Management Portal</span>
            </div>

            <!-- Right slot: actions + role chip + username -->
            <div class="d-flex align-items-center gap-2">
                <AuthorizeView>
                    <Authorized Context="authCtx">
                        <a href="/" class="btn-clinic-secondary btn-sm" title="Go to public website">
                            🏠 <span class="d-none d-sm-inline">Visit Website</span>
                        </a>
                        <AuthorizeView Roles="Admin" Context="adminTopCtx">
                            <span class="pt-role-chip admin">ADMIN</span>
                        </AuthorizeView>
                        <AuthorizeView Roles="Client" Context="clientTopCtx">
                            <span class="pt-role-chip client">CLIENT</span>
                        </AuthorizeView>
                        <span class="user-badge">
                            <span style="color: var(--text-primary); font-size: 0.85rem; font-weight: 500;">
                                @authCtx.User.Identity?.Name
                            </span>
                        </span>
                    </Authorized>
                    <NotAuthorized>
                        <span class="text-secondary small">Not signed in</span>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>

        <article class="content px-4 py-4" style="flex: 1; overflow-y: auto;">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
