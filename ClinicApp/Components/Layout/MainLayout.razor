@inherits LayoutComponentBase

<div class="page dashboard-theme">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <header class="pt-topbar">
            <AuthorizeView>
                <Authorized Context="authCtx">
                    <!-- Left: greeting and date (filled in the browser so it uses the visitor's local time) -->
                    <div class="pt-topbar-hi">
                        <strong data-pt-greeting data-pt-name="@DisplayName(authCtx.User.Identity?.Name)">Welcome back, @DisplayName(authCtx.User.Identity?.Name)</strong>
                        <small data-pt-date>Management Portal</small>
                    </div>

                    <!-- Right: website link, role chip, avatar -->
                    <div class="pt-topbar-actions">
                        <a href="/" class="pt-topbar-site" title="Go to public website">
                            <svg class="pt-i" aria-hidden="true"><use href="#pt-ico-globe"></use></svg>
                            <span class="pt-topbar-site-label">Visit website</span>
                        </a>
                        <AuthorizeView Roles="Admin" Context="adminTopCtx">
                            <span class="pt-role-chip admin">ADMIN</span>
                        </AuthorizeView>
                        <AuthorizeView Roles="Client" Context="clientTopCtx">
                            <span class="pt-role-chip client">CLIENT</span>
                        </AuthorizeView>
                        <span class="pt-topbar-avatar" title="@authCtx.User.Identity?.Name" aria-label="Signed in as @authCtx.User.Identity?.Name">@DisplayName(authCtx.User.Identity?.Name).Substring(0, 1).ToUpperInvariant()</span>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="pt-topbar-hi"><strong>ProTouch Physio</strong><small>Management Portal</small></div>
                    <div class="pt-topbar-actions"><span class="text-secondary small">Not signed in</span></div>
                </NotAuthorized>
            </AuthorizeView>
        </header>

        <article class="content dashboard-content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // The sign-in name is an email address; show the part before the @, capitalised.
    private static string DisplayName(string? identityName)
    {
        var name = (identityName ?? "").Split('@')[0].Trim();
        if (string.IsNullOrEmpty(name)) return "Account";
        return char.ToUpperInvariant(name[0]) + name.Substring(1);
    }
}
