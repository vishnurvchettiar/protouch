@implements IDisposable

@inject NavigationManager NavigationManager

<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <defs>
        <symbol id="pt-ico-grid" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></symbol>
        <symbol id="pt-ico-users" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></symbol>
        <symbol id="pt-ico-pulse" viewBox="0 0 24 24"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></symbol>
        <symbol id="pt-ico-clip" viewBox="0 0 24 24"><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2M9 13l2 2 4-4"/></symbol>
        <symbol id="pt-ico-leaf" viewBox="0 0 24 24"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></symbol>
        <symbol id="pt-ico-cal" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></symbol>
        <symbol id="pt-ico-chat" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></symbol>
        <symbol id="pt-ico-sliders" viewBox="0 0 24 24"><path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/></symbol>
        <symbol id="pt-ico-check" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></symbol>
        <symbol id="pt-ico-trend" viewBox="0 0 24 24"><path d="m3 17 6-6 4 4 8-8"/><path d="M15 7h6v6"/></symbol>
        <symbol id="pt-ico-out" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></symbol>
        <symbol id="pt-ico-login" viewBox="0 0 24 24"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3"/></symbol>
        <symbol id="pt-ico-user-plus" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6M22 11h-6"/></symbol>
        <symbol id="pt-ico-globe" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></symbol>
        <symbol id="pt-ico-rupee" viewBox="0 0 24 24"><path d="M6 3h12M6 8h12M6 13l8.5 8M6 13h3a4 4 0 0 0 0-8"/></symbol>
        <symbol id="pt-ico-refresh" viewBox="0 0 24 24"><path d="M21 12a9 9 0 1 1-3-6.7L21 8M21 3v5h-5"/></symbol>
        <symbol id="pt-ico-star" viewBox="0 0 24 24"><path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/></symbol>
        <symbol id="pt-ico-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></symbol>
        <symbol id="pt-ico-upload" viewBox="0 0 24 24"><path d="M12 16V4M7 9l5-5 5 5M4 20h16"/></symbol>
        <symbol id="pt-ico-file" viewBox="0 0 24 24"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9zM14 3v6h6"/></symbol>
        <symbol id="pt-ico-camera" viewBox="0 0 24 24"><path d="M4 8h3l2-3h6l2 3h3v11H4zM12 17a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z"/></symbol>
        <symbol id="pt-ico-download" viewBox="0 0 24 24"><path d="M12 4v12M7 11l5 5 5-5M4 20h16"/></symbol>
        <symbol id="pt-ico-chevrons" viewBox="0 0 24 24"><path d="m11 17-5-5 5-5M18 17l-5-5 5-5"/></symbol>
    </defs>
</svg>

<nav class="pt-sidebar" aria-label="Main">
    <!-- Logo + hide/show button (top right corner) -->
    <div class="pt-sidebar-logo">
        <img src="/images/protouch-logo.svg" alt="ProTouch Physio" class="pt-sidebar-logo-img" />
        <span class="pt-sidebar-mark" aria-hidden="true">PT</span>
        <button type="button"
                class="pt-sidebar-toggle"
                data-pt-sidebar-toggle
                aria-label="Hide sidebar"
                aria-expanded="true"
                title="Hide sidebar">
            <svg class="pt-i" aria-hidden="true"><use href="#pt-ico-chevrons"></use></svg>
        </button>
    </div>

    <!-- Nav items -->
    <AuthorizeView>
        <Authorized Context="authCtx">
            <AuthorizeView Roles="Admin" Context="adminCtx">
                <ul class="pt-nav-list">
                    @foreach (var group in adminNavGroups)
                    {
                        if (!string.IsNullOrEmpty(group.Label))
                        {
                            <li class="pt-nav-group" aria-hidden="true"><span>@group.Label</span></li>
                        }
                        foreach (var item in group.Items)
                        {
                            <li class="pt-nav-item">
                                <a class="pt-nav-link @(IsNavItemActive(item) ? "pt-nav-link--active" : "")"
                                   href="@item.Href"
                                   title="@item.Label"
                                   aria-current="@(IsNavItemActive(item) ? "page" : null)">
                                    <svg class="pt-i pt-nav-icon" aria-hidden="true"><use href="#pt-ico-@item.Icon"></use></svg>
                                    <span class="pt-nav-label">@item.Label</span>
                                </a>
                            </li>
                        }
                    }
                </ul>
            </AuthorizeView>
            <AuthorizeView Roles="Client" Context="clientCtx">
                <ul class="pt-nav-list">
                    @foreach (var group in clientNavGroups)
                    {
                        if (!string.IsNullOrEmpty(group.Label))
                        {
                            <li class="pt-nav-group" aria-hidden="true"><span>@group.Label</span></li>
                        }
                        foreach (var item in group.Items)
                        {
                            <li class="pt-nav-item">
                                <a class="pt-nav-link @(IsNavItemActive(item) ? "pt-nav-link--active" : "")"
                                   href="@item.Href"
                                   title="@item.Label"
                                   aria-current="@(IsNavItemActive(item) ? "page" : null)">
                                    <svg class="pt-i pt-nav-icon" aria-hidden="true"><use href="#pt-ico-@item.Icon"></use></svg>
                                    <span class="pt-nav-label">@item.Label</span>
                                </a>
                            </li>
                        }
                    }
                </ul>
            
                <nav class="pt-bottom-nav" aria-label="Client pages">
                    @foreach (var item in clientNavGroups[0].Items)
                    {
                        <a class="pt-bottom-link @(IsNavItemActive(item) ? "on" : "")" href="@item.Href" aria-current="@(IsNavItemActive(item) ? "page" : null)">
                            <svg class="pt-i" aria-hidden="true"><use href="#pt-ico-@item.Icon"></use></svg>
                            <span>@BottomLabel(item.Label)</span>
                        </a>
                    }
                </nav>
            </AuthorizeView>

            <!-- Signed-in user + Logout -->
            <div class="pt-sidebar-footer mt-auto">
                <form action="Account/Logout" method="post" class="pt-user-card">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                    <span class="pt-user-avatar" aria-hidden="true">@UserInitial(authCtx.User.Identity?.Name)</span>
                    <span class="pt-user-name">
                        @(authCtx.User.Identity?.Name ?? "Account")
                        <small>@(authCtx.User.IsInRole("Admin") ? "Admin" : "Client")</small>
                    </span>
                    <button type="submit" class="pt-logout-btn" title="Logout" aria-label="Logout">
                        <svg class="pt-i" aria-hidden="true"><use href="#pt-ico-out"></use></svg>
                    </button>
                </form>
            </div>
        </Authorized>

        <NotAuthorized>
            <ul class="pt-nav-list">
                <li class="pt-nav-item">
                    <NavLink class="pt-nav-link" href="Account/Register" ActiveClass="pt-nav-link--active" title="Register">
                        <svg class="pt-i pt-nav-icon" aria-hidden="true"><use href="#pt-ico-user-plus"></use></svg>
                        <span class="pt-nav-label">Register</span>
                    </NavLink>
                </li>
                <li class="pt-nav-item">
                    <NavLink class="pt-nav-link" href="Account/Login" ActiveClass="pt-nav-link--active" title="Login">
                        <svg class="pt-i pt-nav-icon" aria-hidden="true"><use href="#pt-ico-login"></use></svg>
                        <span class="pt-nav-label">Login</span>
                    </NavLink>
                </li>
            </ul>
        </NotAuthorized>
    </AuthorizeView>
</nav>

@code {
    private string? currentUrl;

    private record NavItem(string Href, string Icon, string Label);
    private record NavGroup(string? Label, NavItem[] Items);

    private readonly NavGroup[] adminNavGroups =
    {
        new("Clinic", new NavItem[]
        {
            new("/admin-dashboard",                  "grid",   "Overview"),
            new("/admin-dashboard?tab=clients",      "users",  "Clients"),
            new("/admin-dashboard?tab=add",          "user-plus", "Add user"),
            new("/admin-dashboard?tab=visits",       "pulse",  "Visits"),
            new("/admin-dashboard?tab=appointments", "clip",   "Appointments"),
        }),
        new("Care", new NavItem[]
        {
            new("/admin-dashboard?tab=mealreview",   "leaf",   "Meal Review"),
            new("/admin-dashboard?tab=bookings",     "cal",    "Bookings"),
            new("/admin-dashboard?tab=whatsapp",     "chat",   "WhatsApp"),
            new("/admin-dashboard?tab=feedback",     "star",   "Feedback"),
        }),
        new("System", new NavItem[]
        {
            new("/admin-dashboard?tab=settings",     "sliders","Settings"),
        }),
    };

    private readonly NavGroup[] clientNavGroups =
    {
        new(null, new NavItem[]
        {
            new("/client-dashboard",                      "grid",  "Overview"),
            new("/client-dashboard?tab=checkin",          "check", "Check-In"),
            new("/client-dashboard?tab=appointments",     "cal",   "Appointments"),
            new("/client-dashboard?tab=diet",             "leaf",  "Diet Plan"),
            new("/client-dashboard?tab=history",          "trend", "My History"),
        }),
    };

    private static string BottomLabel(string label) => label switch
    {
        "Overview" => "Home",
        "Check-In" => "Check-in",
        "Appointments" => "Visits",
        "Diet Plan" => "Diet",
        "My History" => "History",
        _ => label
    };

    private static string UserInitial(string? name) =>
        string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[0].ToString().ToUpperInvariant();

    private bool IsNavItemActive(NavItem item)
    {
        var current = currentUrl?.TrimStart('/') ?? string.Empty;
        var target = item.Href.TrimStart('/');

        if (target.Contains('?') || target.Contains('#'))
            return string.Equals(current, target, StringComparison.OrdinalIgnoreCase);

        if (!string.Equals(current.Split('?', '#')[0], target, StringComparison.OrdinalIgnoreCase))
            return false;

        // The overview item is active only when no dashboard section is selected.
        return !current.Contains('#')
            && (!current.Contains('?') || current.Contains("?tab=overview", StringComparison.OrdinalIgnoreCase));
    }

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
