    // Bar chart: one bar per day, drawn to a single scale (0 .. nice maximum).
    private static MarkupString BarChart(List<KeyValuePair<string, int>> data, string colour)
    {
        const int w = 640, h = 200, left = 30, right = 8, top = 12, bottom = 26;
        int max = Math.Max(4, data.Max(d => d.Value));
        if (max % 2 == 1) max++;
        double plotW = w - left - right, plotH = h - top - bottom;
        double slot = plotW / data.Count, barW = Math.Min(26, slot * 0.58);
        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg class=\"pt-chart\" viewBox=\"0 0 {w} {h}\" role=\"img\" aria-label=\"Visits per day\">");
        foreach (var tick in new[] { 0, max / 2, max })
        {
            double y = top + plotH - plotH * tick / max;
            sb.Append($"<line x1=\"{left}\" x2=\"{w - right}\" y1=\"{y:F1}\" y2=\"{y:F1}\" class=\"pt-chart-grid\"/>");
            sb.Append($"<text x=\"{left - 6}\" y=\"{y + 3:F1}\" text-anchor=\"end\" class=\"pt-chart-text\">{tick}</text>");
        }
        for (int i = 0; i < data.Count; i++)
        {
            double cx = left + slot * i + slot / 2;
            double bh = plotH * data[i].Value / max;
            bool last = i == data.Count - 1;
            sb.Append($"<rect x=\"{cx - barW / 2:F1}\" y=\"{top + plotH - bh:F1}\" width=\"{barW:F1}\" height=\"{Math.Max(bh, data[i].Value > 0 ? 2 : 0):F1}\" rx=\"4\" fill=\"{colour}\" opacity=\"{(last ? "1" : "0.55")}\"><title>{data[i].Key}: {data[i].Value}</title></rect>");
            if (data[i].Value > 0)
                sb.Append($"<text x=\"{cx:F1}\" y=\"{top + plotH - bh - 4:F1}\" text-anchor=\"middle\" class=\"pt-chart-value\">{data[i].Value}</text>");
            if (i % 2 == data.Count % 2 || last)
                sb.Append($"<text x=\"{cx:F1}\" y=\"{h - 8}\" text-anchor=\"middle\" class=\"pt-chart-text\">{data[i].Key}</text>");
        }
        sb.Append("</svg>");
        return new MarkupString(sb.ToString());
    }

    // Donut chart: segments share one circle, so they always add up to 100%.
    private static MarkupString Donut(List<ChartSlice> slices, int total)
    {
        const double r = 42, c = 2 * Math.PI * r;
        var sb = new System.Text.StringBuilder();
        sb.Append("<svg class=\"pt-donut\" viewBox=\"0 0 120 120\" role=\"img\" aria-label=\"Appointments by status\">");
        sb.Append($"<circle cx=\"60\" cy=\"60\" r=\"{r}\" fill=\"none\" class=\"pt-donut-track\" stroke-width=\"14\"/>");
        double offset = 0;
        foreach (var s in slices.Where(x => x.Count > 0))
        {
            double len = c * s.Count / total;
            sb.Append($"<circle cx=\"60\" cy=\"60\" r=\"{r}\" fill=\"none\" stroke=\"{s.Colour}\" stroke-width=\"14\" stroke-dasharray=\"{Math.Max(len - 2, 0.5):F2} {c:F2}\" stroke-dashoffset=\"{-offset:F2}\" transform=\"rotate(-90 60 60)\"><title>{s.Label}: {s.Count}</title></circle>");
            offset += len;
        }
        sb.Append($"<text x=\"60\" y=\"58\" text-anchor=\"middle\" class=\"pt-donut-num\">{total}</text>");
        sb.Append("<text x=\"60\" y=\"73\" text-anchor=\"middle\" class=\"pt-chart-text\">appointments</text>");
        sb.Append("</svg>");
        return new MarkupString(sb.ToString());
    }

