                                <button class="btn-clinic-secondary" @onclick="() => StartEditUser(selectedClient)">Edit user</button>
                                <a class="btn-clinic" target="_blank" href='@ClinicService.BuildWhatsAppLink(selectedClient.User?.PhoneNumber ?? "", $"Hello {selectedClient.User?.FullName}, this is ProTouch Physio - Slimming Clinic.")'>WhatsApp</a>
                                <button class="btn-clinic-danger" @onclick="ConfirmDeleteClient">Delete</button>
                            </div>
                        </div>
                        <!-- Delete confirmation modal (Task 9.2) -->
                        @if (showDeleteConfirm)
                        {
                            <div class="clinic-alert clinic-alert-danger mb-3">
                                <div>
                                    <strong>⚠️ Confirm deletion of @selectedClient.User?.FullName</strong><br />
                                    This will permanently delete:<br />
                                    • <strong>@selectedClientLogs.Count</strong> daily logs<br />
                                    • <strong>@selectedClientVisits.Count</strong> visit records<br />
                                    • <strong>@selectedClientAppts.Count</strong> appointments<br />
                                    • <strong>@selectedClientPayments.Count</strong> payment records<br />
                                    This action cannot be undone.
                                </div>
                                <div class="d-flex gap-2 mt-2">
                                    <button class="btn-clinic-danger" @onclick="ExecuteDeleteClient">Yes, delete permanently</button>
                                    <button class="btn-clinic-secondary" @onclick="() => showDeleteConfirm = false">Cancel</button>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(deleteClientError)) { <div class="clinic-alert clinic-alert-danger mb-3">@deleteClientError</div> }
                        <!-- Task 9.4: Measurement validation -->
                        @if (!string.IsNullOrWhiteSpace(profileMeasurementError)) { <div class="clinic-alert clinic-alert-danger mb-3">@profileMeasurementError</div> }
                        <div class="row g-3">
                            <div class="col-md-4"><label class="clinic-label">Access role</label><select class="clinic-input" @bind="selectedRole"><option>Client</option><option>Admin</option></select></div>
                            <div class="col-md-4">
                                <label class="clinic-label">Height (cm)</label>
                                <input class="clinic-input" type="number" step="0.1" @bind="selectedClient.Height" />
                                @if (heightError != null) { <span class="text-danger small">@heightError</span> }
                            </div>
                            <div class="col-md-4"><label class="clinic-label">Current weight</label><div class="clinic-input readonly">@(selectedClientLogs.FirstOrDefault()?.Weight.ToString("F1") ?? "—") kg</div></div>
                            <div class="col-md-3">
                                <label class="clinic-label">Waist (in)</label><input class="clinic-input" type="number" step="0.1" @bind="selectedClient.WaistInches" />
                                @if (waistError != null) { <span class="text-danger small">@waistError</span> }
                            </div>
                            <div class="col-md-3">
                                <label class="clinic-label">Chest (in)</label><input class="clinic-input" type="number" step="0.1" @bind="selectedClient.ChestInches" />
                                @if (chestError != null) { <span class="text-danger small">@chestError</span> }
                            </div>
                            <div class="col-md-3">
                                <label class="clinic-label">Hips (in)</label><input class="clinic-input" type="number" step="0.1" @bind="selectedClient.HipsInches" />
                                @if (hipsError != null) { <span class="text-danger small">@hipsError</span> }
                            </div>
                            <div class="col-md-3">
                                <label class="clinic-label">Arms (in)</label><input class="clinic-input" type="number" step="0.1" @bind="selectedClient.ArmsInches" />
                                @if (armsError != null) { <span class="text-danger small">@armsError</span> }
                            </div>
                            <div class="col-12"><label class="clinic-label">Doctor / dietician notes</label><textarea class="clinic-input" rows="2" @bind="selectedClient.DoctorNotes"></textarea></div>
                        </div>
                        <div class="d-flex gap-2 mt-3">
                            <button class="btn-clinic" @onclick="SaveClient">Save profile & role</button>
                            <button class="btn-clinic-secondary" @onclick="ToggleClientStatus">@(selectedClient.IsActive ? "Suspend" : "Activate")</button>
                        </div>
                        <div class="row g-4 mt-1">
                            <div class="col-md-6">
                                <div class="glass-panel p-3 h-100"><h4>Weight trend</h4>
                                    @if (selectedClientLogs.Any()) { @foreach (var log in selectedClientLogs.Take(7).OrderBy(x => x.LogDate)) { <div class="message-row"><span>@log.LogDate.ToString("dd MMM")</span><strong>@log.Weight.ToString("F1") kg</strong></div> } }
                                    else { <span class="text-secondary">No weight logs yet.</span> }
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="glass-panel p-3 h-100">
                                    <div class="d-flex justify-content-between"><h4>Billing</h4><span class="soft-pill">@selectedClientPayments.Count(x => !x.IsPaid) pending</span></div>
                                    <div class="d-flex gap-2 mb-2"><input class="clinic-input" placeholder="Fee description" @bind="newInvoiceDesc" /><input class="clinic-input" type="number" step="0.01" min="1" placeholder="Amount ₹" @bind="newInvoiceAmount" /><button class="btn-clinic" @onclick="CreateClientInvoice">Add</button></div>
                                    @foreach (var invoice in selectedClientPayments) { <div class="message-row"><div><strong>₹@invoice.Amount</strong><div class="text-secondary small">@invoice.Description</div></div>@if (!invoice.IsPaid) { <button class="btn-clinic-secondary btn-sm" @onclick="() => MarkPaid(invoice.Id)">Settle</button> } else { <span class="soft-pill">Paid</span> }</div> }
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="glass-panel p-3"><h4>Treatment history</h4>
                                    @if (!selectedClientVisits.Any()) { <span class="text-secondary">No visits recorded yet.</span> }
                                    else { @foreach (var visit in selectedClientVisits.Take(8)) { <div class="message-row"><div><strong>@visit.TreatmentReceived</strong><div class="text-secondary small">@visit.Therapist • @visit.CheckInTime.ToLocalTime().ToString("dd MMM yyyy")</div><div class="text-muted small">@visit.Notes</div></div><span class="soft-pill">@visit.Status</span></div> } }
                                </div>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(profileSaveMsg)) { <div class="text-success small mt-2">@profileSaveMsg</div> }

                        <!-- Diet Plan Panel — Task 9.2, 9.3 -->
                        <div class="mt-3">
                            <button class="btn-clinic-secondary" @onclick="OpenDietPanel">📋 Send Diet Plan</button>
                        </div>

                        @if (showDietPanel && selectedClient != null)
                        {
                            <div class="glass-panel p-4 mt-3">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 class="mb-0">Diet Plan for @selectedClientName</h5>
                                    <button class="btn-clinic-secondary" @onclick="CloseDietPanel">✕ Close</button>
                                </div>
                                <div class="mb-3">
                                    <label class="clinic-label">Diet Plan (max 2,000 characters)</label>
                                    <textarea class="clinic-input"
                                              rows="8"
                                              maxlength="2000"
                                              @bind="dietPlanText"
                                              @bind:event="oninput"
                                              placeholder="Enter the personalised diet plan..."></textarea>
                                    <div class="text-end text-muted small mt-1">@dietPlanText.Length / 2000</div>
                                </div>
                                <div class="mb-3 d-flex gap-3 flex-wrap">
                                    <label class="d-flex align-items-center gap-2">
                                        <input type="checkbox"
                                               @bind="sendViaWA"
                                               disabled="@string.IsNullOrWhiteSpace(selectedClientPhone)" />
                                        Send via WhatsApp
                                        @if (string.IsNullOrWhiteSpace(selectedClientPhone))
                                        {
                                            <span class="text-muted small">(No phone on record)</span>
                                        }
                                    </label>
                                    <label class="d-flex align-items-center gap-2">
                                        <input type="checkbox" @bind="saveToProfile" />
                                        Save to client profile
                                    </label>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(dietPlanStatus))
                                {
                                    <div class="clinic-alert @(dietPlanSuccess ? "clinic-alert-info" : "clinic-alert-danger") mb-3">
                                        @dietPlanStatus
                                    </div>
                                }
                                <div class="d-flex gap-2">
                                    <button class="btn-clinic" @onclick="SendDietPlanAsync">Send / Save</button>
                                    <button class="btn-clinic-secondary" @onclick="CloseDietPanel">Cancel</button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>


@code {
    // ── Overview view-model records (task 4.1) ────────────────────────────
    private record ActivityItem(string Title, string SubText, DateTime Timestamp, string Kind);
    private record StatCardModel(string Label, string Value, string Icon, string AccentColour, string Trend, string TabTarget);

    // State
    private List<ClientProfile> clients = new();
    private List<AttendanceRecord> attendanceLogs = new();
    private List<WhatsAppLog> whatsappLogs = new();
    private List<Appointment> allAppointments = new();
    private List<DailyLog> mealLogs = new();
    private List<BookingRequest> allBookings = new();
    private ClientProfile? selectedClient;
    private List<DailyLog> selectedClientLogs = new();
    private List<AttendanceRecord> selectedClientVisits = new();
    private List<Appointment> selectedClientAppts = new();
    private List<PaymentNotification> selectedClientPayments = new();
    private string activeTab = "overview", searchQuery = "", selectedRole = "Client";
    private int todayAttendanceCount, pendingInvoicesCount, pendingBookingsCount;
    private int mealPage = 1;

    // Overview-specific state (task 4.1)
    private string adminName = "Admin";
    private string? errorMessage;
    private List<ActivityItem> recentActivity = new();
    private List<Appointment> todayAppointments = new();

    // Add/Edit user
    private string? editingUserId = null;
    private string newName = "", newEmail = "", newPhone = "", newNotes = "", newRole = "Client", createUserMessage = "";
    private string lastCreatedEmail = "", lastCreatedPassword = "", lastCredentialWhatsAppLink = "";
    private double newStartWeight = 70, newTargetWeight = 65, newHeight = 170;
    private bool creatingUser, createUserSuccess;

    // WhatsApp
    private string campaignText = "Hello {{Name}}, this is ProTouch Physio - Slimming Clinic. Please remember to update your daily weight and diet check today.";
    private string campaignSuccessMsg = "";
    private List<CsvRecipient> csvRecipients = new();
    private List<CsvPreviewRow> campaignPreviews = new();
    private bool sendingCampaign;
    private int campaignSent, campaignFailed, campaignTotal;

    // Visit management
    private string visitUserId = "", visitTreatment = "Physiotherapy", visitPractitioner = "", visitNotes = "", visitSaveMsg = "";
    private DateTime visitDate = DateTime.Now, nextAppointmentDate = DateTime.Now.AddDays(7);
    private int? editingVisitId = null;
    private AttendanceRecord editVisit = new();
    private DateTime? editVisitCheckout, editVisitNextAppt;
    private string visitEditError = "";
    private AttendanceRecord? deleteVisitConfirm;

    // Billing
    private string newInvoiceDesc = "";
    private decimal newInvoiceAmount = 0;
    private string profileSaveMsg = "";

    // Diet Plan Panel (Requirements 9, 10, 11)
    private string dietPlanText = string.Empty;
    private bool sendViaWA = false;
    private bool saveToProfile = false;
    private bool showDietPanel = false;
    private string dietPlanStatus = string.Empty;
    private bool dietPlanSuccess;
    private string selectedClientName => selectedClient?.User?.FullName ?? string.Empty;
    private string selectedClientPhone => selectedClient?.User?.PhoneNumber ?? string.Empty;

    // Measurement validation
    private string? heightError, waistError, chestError, hipsError, armsError;
    private string profileMeasurementError = "";

    // Delete confirmation
    private bool showDeleteConfirm = false;
    private string deleteClientError = "";

    // Error maps
    private Dictionary<int, string> apptUpdateError = new();
    private Dictionary<int, string> mealDeleteErrors = new();
    private Dictionary<int, string> bookingUpdateErrors = new();
    private Dictionary<int, string> reminderErrors = new();
    private HashSet<int> remindersSent = new();

    // Settings tab (Task 5.2)
    private string settingsMode = "Mock";
    private string settingsSid = "", settingsToken = "", settingsFrom = "", settingsClinicNum = "";
    private string settingsSaveMsg = "", settingsTestMsg = "";
    private bool settingsSaveSuccess, settingsTestSuccess;

    private IEnumerable<ClientProfile> FilteredClients => string.IsNullOrWhiteSpace(searchQuery)
        ? clients
        : clients.Where(c => (c.User?.FullName ?? "").Contains(searchQuery, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        clients = new(); attendanceLogs = new(); whatsappLogs = new();
        selectedClient = null; selectedClientLogs = new(); selectedClientVisits = new();
        selectedClientPayments = new(); selectedClientAppts = new();
        // Default to overview tab; query string can override
        var uri = new Uri(NavManager.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        activeTab = query.TryGetValue("tab", out var tab) ? tab.ToString() : "overview";

        await LoadAdminDataAsync();
        await LoadSettingsAsync();
    }

    private async Task LoadAdminDataAsync()
    {
        errorMessage = null;
        try
        {
            // Fan-out all data loads in parallel (task 4.2)
            var clientsTask       = ClinicService.GetAllClientsAsync();
            var attendanceTask    = ClinicService.GetAllAttendanceAsync();
            var whatsappTask      = ClinicService.GetWhatsAppLogsAsync();
            var appointmentsTask  = ClinicService.GetAllAppointmentsAsync();
            var bookingsTask      = ClinicService.GetAllBookingRequestsAsync();

            await Task.WhenAll(clientsTask, attendanceTask, whatsappTask, appointmentsTask, bookingsTask);

            clients         = clientsTask.Result;
            attendanceLogs  = attendanceTask.Result;
            whatsappLogs    = whatsappTask.Result;
            allAppointments = appointmentsTask.Result;
            allBookings     = bookingsTask.Result;

            pendingInvoicesCount  = (await ClinicService.GetAllPaymentsAsync()).Count(x => !x.IsPaid);
            pendingBookingsCount  = allBookings.Count(b => b.Status == "Pending");

            // IST date comparisons (task 4.2)
            var ist = GetIst();
            var istNow = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, ist);
            todayAttendanceCount = attendanceLogs
                .Count(a => TimeZoneInfo.ConvertTimeFromUtc(a.CheckInTime, ist).Date == istNow.Date);

            // Seed remindersSent from DB state
            remindersSent = allAppointments.Where(a => a.ReminderSent).Select(a => a.Id).ToHashSet();

            // Build overview collections
            recentActivity    = BuildActivityItems();
            todayAppointments = allAppointments
                .Where(a => TimeZoneInfo.ConvertTimeFromUtc(a.AppointmentDate, ist).Date == istNow.Date)
                .OrderBy(a => a.AppointmentDate)
                .ToList();

            // Resolve admin display name
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var appUser   = await UserManager.GetUserAsync(authState.User);
            adminName = appUser?.FullName ?? appUser?.UserName ?? "Admin";
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "LoadAdminDataAsync failed");
            errorMessage = "Unable to load dashboard data. Please try again.";
        }
        StateHasChanged();
    }

    private async Task SwitchToMealReview() { activeTab = "mealreview"; mealPage = 1; await LoadMealLogs(); }
    private async Task SwitchToBookings() { activeTab = "bookings"; allBookings = await ClinicService.GetAllBookingRequestsAsync(); }
    private async Task LoadMealLogs() { mealLogs = await ClinicService.GetAllMealLogsAsync(mealPage); StateHasChanged(); }
    private async Task PrevMealPage() { if (mealPage > 1) { mealPage--; await LoadMealLogs(); } }
    private async Task NextMealPage() { mealPage++; await LoadMealLogs(); }

    private async Task InspectClient(ClientProfile client)
    {
        selectedClient = client;
        selectedClientLogs = await ClinicService.GetClientDailyLogsAsync(client.UserId);
        selectedClientVisits = await ClinicService.GetClientAttendanceAsync(client.UserId);
        selectedClientAppts = await ClinicService.GetClientAppointmentsAsync(client.UserId);
        selectedClientPayments = await ClinicService.GetClientPaymentsAsync(client.UserId);
        selectedRole = (await UserManager.GetRolesAsync(client.User!)).FirstOrDefault() ?? "Client";
        profileSaveMsg = ""; showDeleteConfirm = false; deleteClientError = "";
        ClearMeasurementErrors();
    }

    private void ClearMeasurementErrors() { heightError = waistError = chestError = hipsError = armsError = null; profileMeasurementError = ""; }

    private bool ValidateMeasurements()
    {
        ClearMeasurementErrors();
        if (selectedClient == null) return true;
        var valid = true;
        bool InRange(double v) => v > 0 && v <= 999.9;
        if (!InRange(selectedClient.Height)) { heightError = "Must be between 0.1 and 999.9"; valid = false; }
        if (selectedClient.WaistInches > 0 && !InRange(selectedClient.WaistInches)) { waistError = "Must be between 0.1 and 999.9"; valid = false; }
        if (selectedClient.ChestInches > 0 && !InRange(selectedClient.ChestInches)) { chestError = "Must be between 0.1 and 999.9"; valid = false; }
        if (selectedClient.HipsInches > 0 && !InRange(selectedClient.HipsInches)) { hipsError = "Must be between 0.1 and 999.9"; valid = false; }
        if (selectedClient.ArmsInches > 0 && !InRange(selectedClient.ArmsInches)) { armsError = "Must be between 0.1 and 999.9"; valid = false; }
        return valid;
    }

    private async Task SaveClient()
    {
        if (selectedClient?.User == null) return;
        if (!ValidateMeasurements()) return;
        await ClinicService.UpdateClientProfileAsync(selectedClient);
