    private async Task SendCsvCampaign()
    {
        sendingCampaign = true; campaignSent = 0; campaignFailed = 0; campaignTotal = csvRecipients.Count;
        try {
            var progress = new Progress<(int sent, int failed, int total)>(r => { campaignSent = r.sent; campaignFailed = r.failed; campaignTotal = r.total; InvokeAsync(StateHasChanged); });
            await ClinicService.SendCsvWhatsAppCampaignAsync("CSV broadcast", campaignText, csvRecipients, progress);
            campaignSuccessMsg = $"✓ Bulk campaign dispatched to {csvRecipients.Count} recipients.";
            csvRecipients = new(); campaignPreviews = new();
            await LoadAdminDataAsync();
        } finally { sendingCampaign = false; }
    }

