    private async Task ReadCsvRecipients(InputFileChangeEventArgs e)
    {
        campaignErrorMsg = null;
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(2 * 1024 * 1024));
            csvRecipients = CsvRecipientParser.Parse(await reader.ReadToEndAsync());
            var invalid = csvRecipients.Count(r => string.IsNullOrEmpty(ClinicService.NormalisePhone(r.Phone)));
            campaignSuccessMsg = csvRecipients.Any()
                ? $"Loaded {csvRecipients.Count} recipients." + (invalid > 0 ? $" {invalid} have an invalid phone number and will be skipped." : "")
                : "No valid recipients found. The file needs a Name column and a Phone column.";
        }
        catch (Exception ex)
        {
            csvRecipients = new();
            campaignSuccessMsg = null;
            campaignErrorMsg = ex is IOException
                ? "That file is too large. Keep CSV files under 2 MB."
                : "Could not read that file. Check that it is a CSV.";
            _logger.LogWarning(ex, "CSV recipient upload failed");
        }
        campaignPreviews = new();
    }

    private async Task PreviewCsvCampaign()
    {
        if (!csvRecipients.Any()) return;
        campaignErrorMsg = null;
        campaignPreviews = await ClinicService.PreviewCsvCampaignAsync(campaignText, csvRecipients);
        StateHasChanged();
    }

    private async Task SendCsvCampaign()
    {
        if (sendingCampaign || !csvRecipients.Any()) return;
        if (string.IsNullOrWhiteSpace(campaignText))
        {
            campaignErrorMsg = "Write a message first.";
            return;
        }

        campaignErrorMsg = null; campaignSuccessMsg = null;
        sendingCampaign = true; campaignSent = 0; campaignFailed = 0; campaignTotal = csvRecipients.Count;
        try
        {
            var progress = new Progress<(int sent, int failed, int total)>(r => { campaignSent = r.sent; campaignFailed = r.failed; campaignTotal = r.total; InvokeAsync(StateHasChanged); });
            var result = await ClinicService.SendCsvWhatsAppCampaignAsync("CSV broadcast", campaignText, csvRecipients, progress);

            if (result.Mode != "Twilio")
                campaignSuccessMsg = $"Test run only: {result.Simulated} messages were simulated and nothing was sent. Switch WhatsApp mode to Twilio in Settings to send for real.";
            else if (result.Failed == 0)
                campaignSuccessMsg = $"Sent to {result.Sent} recipients." + (result.Skipped > 0 ? $" {result.Skipped} duplicates skipped." : "");
            else
                campaignErrorMsg = $"Sent to {result.Sent}, {result.Failed} failed" + (result.Skipped > 0 ? $", {result.Skipped} duplicates skipped" : "") + ". See Recent activity for the reason.";

            // Keep the list when nothing went out so it can be retried after fixing the problem.
            if (result.Sent + result.Simulated > 0)
            {
                csvRecipients = new(); campaignPreviews = new();
            }
            await LoadAdminDataAsync();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Bulk WhatsApp campaign failed");
            campaignErrorMsg = "The campaign stopped unexpectedly. Check Recent activity to see who was messaged before retrying.";
        }
        finally { sendingCampaign = false; }
    }

