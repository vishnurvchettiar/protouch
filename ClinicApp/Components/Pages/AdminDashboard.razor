    protected override async Task OnInitializedAsync()
    {
        clients = new(); attendanceLogs = new(); whatsappLogs = new();
        selectedClient = null; selectedClientLogs = new(); selectedClientVisits = new();
        selectedClientPayments = new(); selectedClientAppts = new();
        // Default to overview tab; query string can override
        var uri = new Uri(NavManager.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        activeTab = query.TryGetValue("tab", out var tab) ? tab.ToString() : "overview";

