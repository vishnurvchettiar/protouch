    private void ClearMeasurementErrors() { heightError = waistError = chestError = hipsError = armsError = null; profileMeasurementError = ""; }

    private bool ValidateMeasurements()
    {
        ClearMeasurementErrors();
        if (selectedClient == null) return true;
        var valid = true;
        bool InRange(double v) => v > 0 && v <= 999.9;
        if (!InRange(selectedClient.Height)) { heightError = "Must be between 0.1 and 999.9"; valid = false; }
        if (selectedClient.WaistInches > 0 && !InRange(selectedClient.WaistInches)) { waistError = "Must be between 0.1 and 999.9"; valid = false; }
        if (selectedClient.ChestInches > 0 && !InRange(selectedClient.ChestInches)) { chestError = "Must be between 0.1 and 999.9"; valid = false; }
        if (selectedClient.HipsInches > 0 && !InRange(selectedClient.HipsInches)) { hipsError = "Must be between 0.1 and 999.9"; valid = false; }
        if (selectedClient.ArmsInches > 0 && !InRange(selectedClient.ArmsInches)) { armsError = "Must be between 0.1 and 999.9"; valid = false; }
        return valid;
    }

    private async Task SaveClient()
    {
        if (selectedClient?.User == null) return;
        if (!ValidateMeasurements()) return;
        await ClinicService.UpdateClientProfileAsync(selectedClient);
        var roles = await UserManager.GetRolesAsync(selectedClient.User);
        if (!roles.SequenceEqual([selectedRole])) { await UserManager.RemoveFromRolesAsync(selectedClient.User, roles); await UserManager.AddToRoleAsync(selectedClient.User, selectedRole); }
        profileSaveMsg = "✓ Profile and access role saved.";
        StateHasChanged();
        await LoadAdminDataAsync();
        await Task.Delay(3000);
        profileSaveMsg = "";
        StateHasChanged();
    }

