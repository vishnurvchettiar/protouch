    private List<ActivityItem> BuildActivityItems()
    {
        var visits = attendanceLogs
            .OrderByDescending(a => a.CheckInTime)
            .Take(8)
            .Select(a => new ActivityItem(
                $"{a.User?.FullName ?? "Client"} logged a visit",
                a.TreatmentReceived ?? "Treatment",
                a.CheckInTime,
                "visit"));

        var bookings = allBookings
            .OrderByDescending(b => b.SubmittedAt)
            .Take(8)
            .Select(b => new ActivityItem(
                $"Booking: {b.FullName} ({b.ServiceType})",
                b.PreferredDate.ToString("dd MMM yyyy"),
                b.SubmittedAt,
                "booking"));

        return visits.Concat(bookings)
            .OrderByDescending(x => x.Timestamp)
            .Take(8)
            .ToList();
    }

    // ── Overview charts ─────────────────────────────────────────────────────
    private record ChartSlice(string Label, int Count, string Colour);

    private DateTime IstToday() => TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, GetIst()).Date;

    private List<KeyValuePair<string, int>> VisitsByDay(int days)
    {
        var tz = GetIst();
        var today = IstToday();
        var counts = attendanceLogs
            .GroupBy(a => TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(a.CheckInTime, DateTimeKind.Utc), tz).Date)
            .ToDictionary(g => g.Key, g => g.Count());
        var result = new List<KeyValuePair<string, int>>();
        for (int i = days - 1; i >= 0; i--)
        {
            var d = today.AddDays(-i);
            result.Add(new(d.ToString("d MMM"), counts.TryGetValue(d, out var c) ? c : 0));
        }
        return result;
    }

    private List<ChartSlice> AppointmentStatusCounts()
    {
        var tz = GetIst();
        var today = IstToday();
        var monthStart = new DateTime(today.Year, today.Month, 1);
        var thisMonth = allAppointments
            .Where(a => TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(a.AppointmentDate, DateTimeKind.Utc), tz) >= monthStart
                     && TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(a.AppointmentDate, DateTimeKind.Utc), tz) < monthStart.AddMonths(1))
            .ToList();
        return new List<ChartSlice>
        {
            new("Scheduled", thisMonth.Count(a => a.Status == "Scheduled"), "#7c1b68"),
            new("Completed", thisMonth.Count(a => a.Status == "Completed"), "#008d36"),
            new("Cancelled", thisMonth.Count(a => a.Status == "Cancelled"), "#d6343b"),
        };
    }

    private List<ChartSlice> TopTreatments(int take)
    {
        var tz = GetIst();
        var today = IstToday();
        var monthStart = new DateTime(today.Year, today.Month, 1);
        return allAppointments
            .Where(a => !string.IsNullOrWhiteSpace(a.TreatmentType)
                     && TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(a.AppointmentDate, DateTimeKind.Utc), tz) >= monthStart)
            .GroupBy(a => a.TreatmentType)
            .Select(g => new ChartSlice(g.Key, g.Count(), "#008d36"))
            .OrderByDescending(x => x.Count)
            .Take(take)
            .ToList();
    }

    private List<ChartSlice> BookingStatusCounts()
    {
        return allBookings
            .GroupBy(b => string.IsNullOrWhiteSpace(b.Status) ? "Pending" : b.Status)
            .Select(g => new ChartSlice(g.Key, g.Count(),
                g.Key == "Pending" ? "#b58900" : g.Key == "Confirmed" || g.Key == "Approved" ? "#008d36" : g.Key == "Rejected" || g.Key == "Cancelled" ? "#d6343b" : "#7c1b68"))
            .OrderByDescending(x => x.Count)
            .ToList();
    }

    private static string StatusClass(string? status) => status switch
    {
        "Completed" => "ok",
        "Cancelled" => "bad",
        _ => "info"
    };

    // Bar chart: one bar per day, drawn to a single scale (0 .. nice maximum).
    private static MarkupString BarChart(List<KeyValuePair<string, int>> data, string colour)
    {
        const int w = 640, h = 200, left = 30, right = 8, top = 12, bottom = 26;
        int max = Math.Max(4, data.Max(d => d.Value));
        if (max % 2 == 1) max++;
        double plotW = w - left - right, plotH = h - top - bottom;
        double slot = plotW / data.Count, barW = Math.Min(26, slot * 0.58);
        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg class=\"pt-chart\" viewBox=\"0 0 {w} {h}\" role=\"img\" aria-label=\"Visits per day\">");
        foreach (var tick in new[] { 0, max / 2, max })
        {
            double y = top + plotH - plotH * tick / max;
            sb.Append($"<line x1=\"{left}\" x2=\"{w - right}\" y1=\"{y:F1}\" y2=\"{y:F1}\" class=\"pt-chart-grid\"/>");
            sb.Append($"<text x=\"{left - 6}\" y=\"{y + 3:F1}\" text-anchor=\"end\" class=\"pt-chart-text\">{tick}</text>");
        }
        for (int i = 0; i < data.Count; i++)
        {
            double cx = left + slot * i + slot / 2;
            double bh = plotH * data[i].Value / max;
            bool last = i == data.Count - 1;
            sb.Append($"<rect x=\"{cx - barW / 2:F1}\" y=\"{top + plotH - bh:F1}\" width=\"{barW:F1}\" height=\"{Math.Max(bh, data[i].Value > 0 ? 2 : 0):F1}\" rx=\"4\" fill=\"{colour}\" opacity=\"{(last ? "1" : "0.55")}\"><title>{data[i].Key}: {data[i].Value}</title></rect>");
            if (data[i].Value > 0)
                sb.Append($"<text x=\"{cx:F1}\" y=\"{top + plotH - bh - 4:F1}\" text-anchor=\"middle\" class=\"pt-chart-value\">{data[i].Value}</text>");
            if (i % 2 == data.Count % 2 || last)
                sb.Append($"<text x=\"{cx:F1}\" y=\"{h - 8}\" text-anchor=\"middle\" class=\"pt-chart-text\">{data[i].Key}</text>");
        }
        sb.Append("</svg>");
        return new MarkupString(sb.ToString());
    }

    // Donut chart: segments share one circle, so they always add up to 100%.
    private static MarkupString Donut(List<ChartSlice> slices, int total)
    {
        const double r = 42, c = 2 * Math.PI * r;
        var sb = new System.Text.StringBuilder();
        sb.Append("<svg class=\"pt-donut\" viewBox=\"0 0 120 120\" role=\"img\" aria-label=\"Appointments by status\">");
        sb.Append($"<circle cx=\"60\" cy=\"60\" r=\"{r}\" fill=\"none\" class=\"pt-donut-track\" stroke-width=\"14\"/>");
        double offset = 0;
        foreach (var s in slices.Where(x => x.Count > 0))
        {
            double len = c * s.Count / total;
            sb.Append($"<circle cx=\"60\" cy=\"60\" r=\"{r}\" fill=\"none\" stroke=\"{s.Colour}\" stroke-width=\"14\" stroke-dasharray=\"{Math.Max(len - 2, 0.5):F2} {c:F2}\" stroke-dashoffset=\"{-offset:F2}\" transform=\"rotate(-90 60 60)\"><title>{s.Label}: {s.Count}</title></circle>");
            offset += len;
        }
        sb.Append($"<text x=\"60\" y=\"58\" text-anchor=\"middle\" class=\"pt-donut-num\">{total}</text>");
        sb.Append("<text x=\"60\" y=\"73\" text-anchor=\"middle\" class=\"pt-chart-text\">appointments</text>");
        sb.Append("</svg>");
        return new MarkupString(sb.ToString());
    }

    // The sidebar links to /admin-dashboard?tab=..., so react when the query string changes.
    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabQuery { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var wanted = string.IsNullOrWhiteSpace(TabQuery) ? "overview" : TabQuery!;
        if (wanted == activeTab) return;
        switch (wanted)
        {
            case "mealreview": await SwitchToMealReview(); break;
            case "bookings": await SwitchToBookings(); break;
            case "feedback": await SwitchToFeedback(); break;
            default: activeTab = wanted; break;
        }
    }


    private void NavigateToTab(string tab)
    {
        activeTab = tab;
        NavManager.NavigateTo($"/admin-dashboard?tab={tab}");
    }

    private static string GetGreeting()
    {
        var ist = GetIst();
        var hour = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, ist).Hour;
        return hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
    }

    private static string TimeAgo(DateTime utc)
    {
        var diff = DateTime.UtcNow - utc;
        if (diff.TotalMinutes < 1)  return "just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes} min ago";
        if (diff.TotalHours < 24)   return $"{(int)diff.TotalHours} hr ago";
        if (diff.TotalDays < 7)     return $"{(int)diff.TotalDays} days ago";
        return utc.ToString("dd MMM");
    }

    private static TimeZoneInfo GetIst()
    {
        try { return TimeZoneInfo.FindSystemTimeZoneById("Asia/Kolkata"); }
        catch { return TimeZoneInfo.FindSystemTimeZoneById("India Standard Time"); }
    }

    private async Task SendDietPlanAsync()
    {
        dietPlanStatus = string.Empty;

        // Validation
        if (string.IsNullOrWhiteSpace(dietPlanText))
        {
            dietPlanStatus = "Diet plan cannot be empty";
            dietPlanSuccess = false;
            return;
        }
        if (!sendViaWA && !saveToProfile)
        {
            dietPlanStatus = "Please select at least one delivery method";
            dietPlanSuccess = false;
            return;
        }

        var errors = new List<string>();

        if (saveToProfile)
        {
            try
            {
                await ClinicService.UpdateClientDietPlanAsync(selectedClient!.UserId, dietPlanText);
                // Update local model so panel re-opens with fresh value
                selectedClient!.DietPlan = dietPlanText;
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Diet plan profile save failed for {UserId}", selectedClient!.UserId);
                errors.Add("Profile save failed. Please try again.");
            }
        }

        if (sendViaWA && !string.IsNullOrWhiteSpace(selectedClientPhone))
        {
            try
            {
                var message = WhatsAppLogHelper.FormatDietPlanMessage(selectedClientName, dietPlanText);
                await ClinicService.SendWhatsAppMessageAsync(selectedClientPhone, message);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Diet plan WhatsApp send failed for {Phone}", selectedClientPhone);
                errors.Add("WhatsApp delivery failed. Please try again.");
            }
        }

        if (errors.Count > 0)
        {
            dietPlanStatus = string.Join(" | ", errors);
            dietPlanSuccess = false;
        }
        else
        {
            var parts = new List<string>();
            if (saveToProfile) parts.Add($"Diet plan saved to {selectedClientName}'s profile");
            if (sendViaWA)     parts.Add($"Diet plan sent via WhatsApp to {selectedClientName}");
            dietPlanStatus = string.Join(". ", parts);
            dietPlanSuccess = true;
        }
    }
