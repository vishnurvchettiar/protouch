    private async Task LoadAdminDataAsync()
    {
        errorMessage = null;
        try
        {
            // Fan-out all data loads in parallel (task 4.2)
            var clientsTask       = ClinicService.GetAllClientsAsync();
            var attendanceTask    = ClinicService.GetAllAttendanceAsync();
            var whatsappTask      = ClinicService.GetWhatsAppLogsAsync();
            var appointmentsTask  = ClinicService.GetAllAppointmentsAsync();
            var bookingsTask      = ClinicService.GetAllBookingRequestsAsync();

            await Task.WhenAll(clientsTask, attendanceTask, whatsappTask, appointmentsTask, bookingsTask);

            clients         = clientsTask.Result;
            attendanceLogs  = attendanceTask.Result;
            whatsappLogs    = whatsappTask.Result;
            allAppointments = appointmentsTask.Result;
            allBookings     = bookingsTask.Result;

            pendingInvoicesCount  = (await ClinicService.GetAllPaymentsAsync()).Count(x => !x.IsPaid);
            pendingBookingsCount  = allBookings.Count(b => b.Status == "Pending");

            // IST date comparisons (task 4.2)
            var ist = GetIst();
            var istNow = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, ist);
            todayAttendanceCount = attendanceLogs
                .Count(a => TimeZoneInfo.ConvertTimeFromUtc(a.CheckInTime, ist).Date == istNow.Date);

            // Seed remindersSent from DB state
            remindersSent = allAppointments.Where(a => a.ReminderSent).Select(a => a.Id).ToHashSet();

            // Build overview collections
            recentActivity    = BuildActivityItems();
            todayAppointments = allAppointments
                .Where(a => TimeZoneInfo.ConvertTimeFromUtc(a.AppointmentDate, ist).Date == istNow.Date)
                .OrderBy(a => a.AppointmentDate)
                .ToList();

            // Resolve admin display name
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var appUser   = await UserManager.GetUserAsync(authState.User);
            adminName = appUser?.FullName ?? appUser?.UserName ?? "Admin";
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "LoadAdminDataAsync failed");
            errorMessage = "Unable to load dashboard data. Please try again.";
        }
        StateHasChanged();
    }

