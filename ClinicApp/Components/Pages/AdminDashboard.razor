@page "/admin-dashboard"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using ClinicApp.Data
@using ClinicApp.Services
@attribute [Authorize(Roles = "Admin")]
@inject ClinicService ClinicService
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavManager

<PageTitle>ProTouch Admin | Clinic Control Center</PageTitle>

<div class="container-fluid py-4 admin-shell">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><span class="eyebrow">PROTOUCH CLINIC • ADMIN</span><h1 class="gradient-text display-5 mb-1">Clinic Control Center</h1><p class="text-secondary mb-0">Clients, visits, care plans and secure WhatsApp communication.</p></div><button class="btn-clinic" @onclick="LoadAdminDataAsync">Refresh</button></div>

    <div class="dashboard-grid mb-4">
        <button class="glass-panel stat-card text-start border-0" @onclick='() => activeTab = "clients"'><div><span class="text-secondary small">Active Clients</span><h2>@clients.Count(c => c.IsActive)</h2><span class="text-muted small">Open client directory</span></div><div class="stat-icon">👥</div></button>
        <button class="glass-panel stat-card text-start border-0" @onclick='() => activeTab = "visits"'><div><span class="text-secondary small">Today's Visits</span><h2>@todayAttendanceCount</h2><span class="text-muted small">Open visit register</span></div><div class="stat-icon">🏥</div></button>
        <button class="glass-panel stat-card text-start border-0" @onclick='() => activeTab = "clients"'><div><span class="text-secondary small">Pending Fees</span><h2>@pendingInvoicesCount</h2><span class="text-muted small">Review client billing</span></div><div class="stat-icon">₹</div></button>
        <button class="glass-panel stat-card text-start border-0" @onclick='() => activeTab = "whatsapp"'><div><span class="text-secondary small">WhatsApp Activity</span><h2>@whatsappLogs.Count</h2><span class="text-muted small">Open broadcast center</span></div><div class="stat-icon">💬</div></button>
    </div>

    <div class="glass-panel p-2 mb-4 d-flex flex-wrap gap-2"><button class="btn @(activeTab == "clients" ? "btn-clinic" : "btn-clinic-secondary")" @onclick='() => activeTab = "clients"'>Clients</button><button class="btn @(activeTab == "add" ? "btn-clinic" : "btn-clinic-secondary")" @onclick='() => activeTab = "add"'>Add user</button><button class="btn @(activeTab == "visits" ? "btn-clinic" : "btn-clinic-secondary")" @onclick='() => activeTab = "visits"'>Visits</button><button class="btn @(activeTab == "whatsapp" ? "btn-clinic" : "btn-clinic-secondary")" @onclick='() => activeTab = "whatsapp"'>WhatsApp Center</button></div>

    @if (activeTab == "add")
    {
        <div class="row g-4"><div class="col-xl-8"><div class="glass-panel p-4"><div class="section-heading"><div><span class="eyebrow">USER ACCESS</span><h3>Add user & assign role</h3></div></div><div class="row g-3"><div class="col-md-6"><label class="clinic-label">Full name</label><input class="clinic-input" @bind="newName" /></div><div class="col-md-6"><label class="clinic-label">Role</label><select class="clinic-input" @bind="newRole"><option>Client</option><option>Admin</option></select></div><div class="col-md-6"><label class="clinic-label">Email / username</label><input class="clinic-input" type="email" @bind="newEmail" /></div><div class="col-md-6"><label class="clinic-label">WhatsApp number</label><input class="clinic-input" @bind="newPhone" /></div>@if (newRole == "Client") { <div class="col-md-4"><label class="clinic-label">Starting weight (kg)</label><input class="clinic-input" type="number" @bind="newStartWeight" /></div><div class="col-md-4"><label class="clinic-label">Target weight (kg)</label><input class="clinic-input" type="number" @bind="newTargetWeight" /></div><div class="col-md-4"><label class="clinic-label">Height (cm)</label><input class="clinic-input" type="number" @bind="newHeight" /></div> }<div class="col-12"><label class="clinic-label">Clinical / staff notes</label><textarea class="clinic-input" rows="3" @bind="newNotes"></textarea></div></div><button class="btn-clinic mt-3" @onclick="CreateUser" disabled="@creatingUser">@(creatingUser ? "Creating..." : "Create user")</button>@if (!string.IsNullOrWhiteSpace(createUserMessage)) { <div class="clinic-alert @(createUserSuccess ? "clinic-alert-success" : "clinic-alert-danger") mt-3">@createUserMessage</div> }</div></div><div class="col-xl-4"><div class="glass-panel p-4 h-100"><span class="eyebrow">ACCESS POLICY</span><h3>Roles are explicit</h3><p class="text-secondary">Admins manage clinic records. Clients can access only their own portal for logs, booking and guidance.</p>@if (!string.IsNullOrWhiteSpace(lastCreatedEmail)) { <div class="credential-row"><span>Login</span><strong>@lastCreatedEmail</strong></div><div class="credential-row"><span>Temporary password</span><strong>@lastCreatedPassword</strong></div>@if (!string.IsNullOrWhiteSpace(lastCredentialWhatsAppLink)) { <a class="btn-clinic mt-3" target="_blank" href="@lastCredentialWhatsAppLink">Send credentials via WhatsApp</a> } else { <span class="text-secondary small mt-3 d-block">No phone number provided — share credentials manually.</span> } }</div></div></div>
    }
    else if (activeTab == "whatsapp")
    {
        <div class="row g-4"><div class="col-xl-5"><div class="glass-panel p-4"><span class="eyebrow">CSV BROADCAST</span><h3>Bulk WhatsApp Campaign</h3><p class="text-secondary small">Upload a CSV with <strong>Name</strong> and <strong>Phone</strong> columns. Use <code>{{Name}}</code> in your message to personalise it.</p><label class="clinic-label">CSV recipients</label><InputFile class="clinic-input mb-3" accept=".csv,text/csv" OnChange="ReadCsvRecipients" /><label class="clinic-label">Message template</label><textarea class="clinic-input" rows="7" @bind="campaignText"></textarea><div class="d-flex gap-2 mt-3"><button class="btn-clinic" @onclick="SendCsvCampaign" disabled="@(!csvRecipients.Any() || sendingCampaign)">@(sendingCampaign ? "Sending..." : "Send Bulk Campaign")</button><button class="btn-clinic-secondary" @onclick="UseDietTemplate">Diet template</button></div>@if (!string.IsNullOrWhiteSpace(campaignSuccessMsg)) { <div class="clinic-alert clinic-alert-success mt-3">@campaignSuccessMsg</div> }</div></div><div class="col-xl-7"><div class="glass-panel p-4"><div class="section-heading"><div><span class="eyebrow">RECIPIENT PREVIEW</span><h3>@csvRecipients.Count CSV recipients</h3></div></div>@if (!csvRecipients.Any()) { <div class="empty-state">Choose a CSV file to preview recipients.</div> } else { @foreach (var recipient in csvRecipients.Take(30)) { <div class="message-row"><div><strong>@recipient.Name</strong><div class="text-secondary small">@recipient.Phone</div></div><span class="soft-pill">Ready</span></div> } }</div><div class="glass-panel p-4 mt-4"><h4>Recent activity</h4>@foreach (var log in whatsappLogs.Take(8)) { <div class="activity-row"><div><strong>@log.TargetAudience</strong><div class="text-secondary small">@log.MessageTemplate</div></div><span class="soft-pill">@log.Status • @log.RecipientCount</span></div> }</div></div></div>
    }
    else if (activeTab == "visits")
    {
        <div class="glass-panel p-4"><div class="section-heading"><div><span class="eyebrow">TREATMENT REGISTER</span><h3>Log a visit</h3></div><span class="soft-pill">@todayAttendanceCount today</span></div><div class="row g-3 mb-4"><div class="col-md-4"><label class="clinic-label">Client</label><select class="clinic-input" @bind="visitUserId"><option value="">Select client</option>@foreach (var c in clients) { <option value="@c.UserId">@c.User?.FullName</option> }</select></div><div class="col-md-4"><label class="clinic-label">Visit date & time</label><input class="clinic-input" type="datetime-local" @bind="visitDate" /></div><div class="col-md-4"><label class="clinic-label">Treatment given</label><select class="clinic-input" @bind="visitTreatment"><option>Physiotherapy</option><option>Skin Consultation</option><option>Diet Review</option><option>Slimming Therapy</option><option>Wellness Consultation</option></select></div><div class="col-md-4"><label class="clinic-label">Doctor / practitioner</label><input class="clinic-input" @bind="visitPractitioner" /></div><div class="col-md-4"><label class="clinic-label">Next appointment</label><input class="clinic-input" type="datetime-local" @bind="nextAppointmentDate" /></div><div class="col-md-4"><label class="clinic-label">Notes</label><input class="clinic-input" @bind="visitNotes" placeholder="Treatment response / instructions" /></div></div><button class="btn-clinic mb-4" @onclick="SaveVisit" disabled="@string.IsNullOrWhiteSpace(visitUserId)">Save visit</button><h4 class="mb-3">Service history</h4>@foreach (var visit in attendanceLogs.Take(50)) { <div class="message-row"><div><strong>@visit.User?.FullName</strong><div class="text-secondary small">@visit.TreatmentReceived • @visit.Therapist</div><div class="text-muted small">@visit.CheckInTime.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt") • Next: @(visit.NextAppointmentDate?.ToLocalTime().ToString("dd MMM yyyy") ?? "Not set")</div>@if (!string.IsNullOrWhiteSpace(visit.Notes)) { <div class="text-secondary small mt-1">@visit.Notes</div> }</div><span class="soft-pill">@visit.Status</span></div> }</div>
    }
    else
    {
        <div class="row g-4"><div class="col-xl-4"><div class="glass-panel p-4 sticky-xl-top" style="top:20px"><div class="section-heading"><div><span class="eyebrow">DIRECTORY</span><h3>Clients</h3></div><button class="btn-icon" @onclick='() => activeTab = "add"'>+</button></div><input class="clinic-input mb-3" placeholder="Search clients..." @bind="searchQuery" @bind:event="oninput" /><div class="client-list">@foreach (var client in FilteredClients) { <button class="client-list-item @(selectedClient?.Id == client.Id ? "selected" : "")" @onclick="() => InspectClient(client)"><span class="avatar-sm">@(client.User?.FullName?.FirstOrDefault() ?? '?')</span><span class="text-start flex-grow-1"><strong>@client.User?.FullName</strong><small>@client.User?.PhoneNumber</small></span></button> }</div></div></div><div class="col-xl-8">@if (selectedClient == null) { <div class="glass-panel p-5 text-center"><h2>Select a client</h2><p class="text-secondary">Select a profile to review treatment history, weight trend, measurements and billing.</p></div> } else { <div class="glass-panel p-4"><div class="d-flex justify-content-between align-items-center gap-3 mb-4"><div><span class="eyebrow">CLIENT PROFILE</span><h2>@selectedClient.User?.FullName</h2><span class="text-secondary">@selectedClient.User?.Email • @selectedClient.User?.PhoneNumber</span></div><div class="d-flex gap-2"><a class="btn-clinic" target="_blank" href='@ClinicService.BuildWhatsAppLink(selectedClient.User?.PhoneNumber ?? "", $"Hello {selectedClient.User?.FullName}, this is ProTouch Clinic.")'>WhatsApp</a><button class="btn-clinic-danger" @onclick="DeleteSelectedClient">Delete</button></div></div><div class="row g-3"><div class="col-md-4"><label class="clinic-label">Access role</label><select class="clinic-input" @bind="selectedRole"><option>Client</option><option>Admin</option></select></div><div class="col-md-4"><label class="clinic-label">Height (cm)</label><input class="clinic-input" type="number" @bind="selectedClient.Height" /></div><div class="col-md-4"><label class="clinic-label">Current weight</label><div class="clinic-input readonly">@(selectedClientLogs.FirstOrDefault()?.Weight.ToString("F1") ?? "—") kg</div></div><div class="col-md-3"><label class="clinic-label">Waist (in)</label><input class="clinic-input" type="number" step="0.1" @bind="selectedClient.WaistInches" /></div><div class="col-md-3"><label class="clinic-label">Chest (in)</label><input class="clinic-input" type="number" step="0.1" @bind="selectedClient.ChestInches" /></div><div class="col-md-3"><label class="clinic-label">Hips (in)</label><input class="clinic-input" type="number" step="0.1" @bind="selectedClient.HipsInches" /></div><div class="col-md-3"><label class="clinic-label">Arms (in)</label><input class="clinic-input" type="number" step="0.1" @bind="selectedClient.ArmsInches" /></div><div class="col-12"><label class="clinic-label">Doctor / dietician notes</label><textarea class="clinic-input" rows="2" @bind="selectedClient.DoctorNotes"></textarea></div></div><div class="d-flex gap-2 mt-3"><button class="btn-clinic" @onclick="SaveClient">Save profile & role</button><button class="btn-clinic-secondary" @onclick="ToggleClientStatus">@(selectedClient.IsActive ? "Suspend" : "Activate")</button></div><div class="row g-4 mt-1"><div class="col-md-6"><div class="glass-panel p-3 h-100"><h4>Weight trend</h4>@if (selectedClientLogs.Any()) { @foreach (var log in selectedClientLogs.Take(7).OrderBy(x => x.LogDate)) { <div class="message-row"><span>@log.LogDate.ToString("dd MMM")</span><strong>@log.Weight.ToString("F1") kg</strong></div> } } else { <span class="text-secondary">No weight logs yet.</span> }</div></div><div class="col-md-6"><div class="glass-panel p-3 h-100"><div class="d-flex justify-content-between"><h4>Billing</h4><span class="soft-pill">@selectedClientPayments.Count(x => !x.IsPaid) pending</span></div><div class="d-flex gap-2 mb-2"><input class="clinic-input" placeholder="Fee description" @bind="newInvoiceDesc" /><input class="clinic-input" type="number" step="0.01" min="1" placeholder="Amount ₹" @bind="newInvoiceAmount" /><button class="btn-clinic" @onclick="CreateClientInvoice">Add</button></div>@foreach (var invoice in selectedClientPayments) { <div class="message-row"><div><strong>₹@invoice.Amount</strong><div class="text-secondary small">@invoice.Description</div></div>@if (!invoice.IsPaid) { <button class="btn-clinic-secondary btn-sm" @onclick="() => MarkPaid(invoice.Id)">Settle</button> } else { <span class="soft-pill">Paid</span> }</div> }</div></div><div class="col-12"><div class="glass-panel p-3"><h4>Treatment history</h4>@if (!selectedClientVisits.Any()) { <span class="text-secondary">No visits recorded yet.</span> } else { @foreach (var visit in selectedClientVisits.Take(8)) { <div class="message-row"><div><strong>@visit.TreatmentReceived</strong><div class="text-secondary small">@visit.Therapist • @visit.CheckInTime.ToLocalTime().ToString("dd MMM yyyy")</div><div class="text-muted small">@visit.Notes</div></div><span class="soft-pill">@visit.Status</span></div> } }</div></div></div>@if (!string.IsNullOrWhiteSpace(profileSaveMsg)) { <div class="text-success small mt-2">@profileSaveMsg</div> }</div> }</div></div>
    }
</div>

@code {
    private List<ClientProfile> clients = new(); private List<AttendanceRecord> attendanceLogs = new(); private List<WhatsAppLog> whatsappLogs = new(); private ClientProfile? selectedClient; private List<DailyLog> selectedClientLogs = new(); private List<AttendanceRecord> selectedClientVisits = new(); private List<PaymentNotification> selectedClientPayments = new(); private string activeTab = "clients", searchQuery = "", selectedRole = "Client"; private int todayAttendanceCount, pendingInvoicesCount;
    private string newName = "", newEmail = "", newPhone = "", newNotes = "", newRole = "Client", createUserMessage = "", lastCreatedEmail = "", lastCreatedPassword = "", lastCredentialWhatsAppLink = ""; private double newStartWeight = 70, newTargetWeight = 65, newHeight = 170; private bool creatingUser, createUserSuccess;
    private string campaignText = "Hello {{Name}}, this is ProTouch Clinic. Please remember to update your daily weight and diet check today.", campaignSuccessMsg = ""; private List<CsvRecipient> csvRecipients = new(); private bool sendingCampaign;
    private string visitUserId = "", visitTreatment = "Physiotherapy", visitPractitioner = "", visitNotes = "", newInvoiceDesc = ""; private decimal newInvoiceAmount = 0; private DateTime visitDate = DateTime.Now, nextAppointmentDate = DateTime.Now.AddDays(7); private string profileSaveMsg = "";
    private IEnumerable<ClientProfile> FilteredClients => string.IsNullOrWhiteSpace(searchQuery) ? clients : clients.Where(c => (c.User?.FullName ?? "").Contains(searchQuery, StringComparison.OrdinalIgnoreCase));
    protected override async Task OnInitializedAsync()
    {
        clients = new();
        attendanceLogs = new();
        whatsappLogs = new();
        selectedClient = null;
        selectedClientLogs = new();
        selectedClientVisits = new();
        selectedClientPayments = new();
        activeTab = "clients";
        await LoadAdminDataAsync();
    }
    private async Task LoadAdminDataAsync() { clients = await ClinicService.GetAllClientsAsync(); attendanceLogs = await ClinicService.GetAllAttendanceAsync(); whatsappLogs = await ClinicService.GetWhatsAppLogsAsync(); pendingInvoicesCount = (await ClinicService.GetAllPaymentsAsync()).Count(x => !x.IsPaid); todayAttendanceCount = attendanceLogs.Count(x => x.CheckInTime.ToLocalTime().Date == DateTime.Today); StateHasChanged(); }
    private async Task InspectClient(ClientProfile client) { selectedClient = client; selectedClientLogs = await ClinicService.GetClientDailyLogsAsync(client.UserId); selectedClientVisits = await ClinicService.GetClientAttendanceAsync(client.UserId); selectedClientPayments = await ClinicService.GetClientPaymentsAsync(client.UserId); selectedRole = (await UserManager.GetRolesAsync(client.User!)).FirstOrDefault() ?? "Client"; profileSaveMsg = ""; }
    private async Task SaveClient()
    {
        if (selectedClient?.User == null) return;
        await ClinicService.UpdateClientProfileAsync(selectedClient);
        var roles = await UserManager.GetRolesAsync(selectedClient.User);
        if (!roles.SequenceEqual([selectedRole]))
        {
            await UserManager.RemoveFromRolesAsync(selectedClient.User, roles);
            await UserManager.AddToRoleAsync(selectedClient.User, selectedRole);
        }
        profileSaveMsg = "✓ Profile and access role saved.";
        StateHasChanged();
        await LoadAdminDataAsync();
        await Task.Delay(3000);
        profileSaveMsg = "";
        StateHasChanged();
    }
    private async Task ToggleClientStatus() { if (selectedClient == null) return; selectedClient.IsActive = !selectedClient.IsActive; await ClinicService.UpdateClientProfileAsync(selectedClient); await LoadAdminDataAsync(); }
    private async Task CreateClientInvoice() { if (selectedClient == null || newInvoiceAmount <= 0 || string.IsNullOrWhiteSpace(newInvoiceDesc)) return; await ClinicService.CreateInvoiceAsync(selectedClient.UserId, newInvoiceAmount, newInvoiceDesc); newInvoiceAmount = 0; newInvoiceDesc = ""; await InspectClient(selectedClient); await LoadAdminDataAsync(); }
    private async Task MarkPaid(int invoiceId) { await ClinicService.MarkInvoiceAsPaidAsync(invoiceId); if (selectedClient != null) await InspectClient(selectedClient); await LoadAdminDataAsync(); }
    private async Task DeleteSelectedClient() { if (selectedClient?.User == null) return; var user = selectedClient.User; var userId = selectedClient.UserId; await ClinicService.DeleteClientDataAsync(userId); await UserManager.DeleteAsync(user); selectedClient = null; selectedClientLogs = new(); selectedClientVisits = new(); selectedClientPayments = new(); profileSaveMsg = "Client removed."; await LoadAdminDataAsync(); }
    private async Task CreateUser() { creatingUser = true; try { if (string.IsNullOrWhiteSpace(newName) || string.IsNullOrWhiteSpace(newEmail)) { createUserMessage = "Name and email are required."; createUserSuccess = false; return; } if (await UserManager.FindByEmailAsync(newEmail.Trim()) != null) { createUserMessage = "A user with this email already exists."; createUserSuccess = false; return; } var password = $"PT{Random.Shared.Next(100000, 999999)}!a"; var user = new ApplicationUser { UserName = newEmail.Trim(), Email = newEmail.Trim(), EmailConfirmed = true, FullName = newName.Trim(), PhoneNumber = newPhone.Trim() }; var result = await UserManager.CreateAsync(user, password); if (!result.Succeeded) { createUserMessage = string.Join(" ", result.Errors.Select(x => x.Description)); createUserSuccess = false; return; } await UserManager.AddToRoleAsync(user, newRole); if (newRole == "Client") { await ClinicService.EnsureClientProfileExistsAsync(user.Id, newStartWeight, newTargetWeight, newHeight); var profile = await ClinicService.GetClientProfileByUserIdAsync(user.Id); if (profile != null) { profile.DoctorNotes = newNotes; await ClinicService.UpdateClientProfileAsync(profile); } } lastCreatedEmail = user.Email!; lastCreatedPassword = password; lastCredentialWhatsAppLink = !string.IsNullOrWhiteSpace(user.PhoneNumber) ? ClinicService.BuildWhatsAppLink(user.PhoneNumber, $"Hello {user.FullName}, your ProTouch login is {user.Email}. Temporary password: {password}") : ""; createUserMessage = $"{newRole} created successfully."; createUserSuccess = true; newName = newEmail = newPhone = newNotes = ""; newRole = "Client"; newStartWeight = 70; newTargetWeight = 65; newHeight = 170; await LoadAdminDataAsync(); } finally { creatingUser = false; } }
    private async Task ReadCsvRecipients(InputFileChangeEventArgs e) { using var reader = new StreamReader(e.File.OpenReadStream(2 * 1024 * 1024)); var lines = (await reader.ReadToEndAsync()).Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries); csvRecipients = lines.Skip(1).Select(line => line.Split(',')).Where(parts => parts.Length >= 2).Select(parts => new CsvRecipient(parts[0].Trim().Trim('"'), parts[1].Trim().Trim('"'))).Where(x => !string.IsNullOrWhiteSpace(x.Phone)).ToList(); campaignSuccessMsg = csvRecipients.Any() ? $"Loaded {csvRecipients.Count} CSV recipients." : "No valid recipients found. Use Name,Phone headings."; }
    private async Task SendCsvCampaign()
    {
        sendingCampaign = true;
        try
        {
            await ClinicService.SendCsvWhatsAppCampaignAsync("CSV broadcast", campaignText, csvRecipients);
            campaignSuccessMsg = $"✓ Bulk campaign dispatched to {csvRecipients.Count} recipients.";
            csvRecipients = new(); // Bug 16: clear to prevent re-sending same campaign
            await LoadAdminDataAsync();
        }
        finally { sendingCampaign = false; }
    }
    private void UseDietTemplate() => campaignText = "Hello {{Name}}, this is your ProTouch Clinic diet reminder. Please follow your prescribed diet plan and update today's morning weight.";
    private async Task SaveVisit()
    {
        if (string.IsNullOrWhiteSpace(visitUserId)) return;
        await ClinicService.LogCheckInAsync(visitUserId, visitTreatment, visitPractitioner, visitNotes, nextAppointmentDate, visitDate);
        visitUserId = "";
        visitNotes = "";
        visitPractitioner = "";
        visitDate = DateTime.Now;
        nextAppointmentDate = DateTime.Now.AddDays(7);
        await LoadAdminDataAsync();
    }
}
