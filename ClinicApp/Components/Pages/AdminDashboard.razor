    private DateTime IstToday() => TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, GetIst()).Date;

    private List<KeyValuePair<string, int>> VisitsByDay(int days)
    {
        var tz = GetIst();
        var today = IstToday();
        var counts = attendanceLogs
            .GroupBy(a => TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(a.CheckInTime, DateTimeKind.Utc), tz).Date)
            .ToDictionary(g => g.Key, g => g.Count());
        var result = new List<KeyValuePair<string, int>>();
        for (int i = days - 1; i >= 0; i--)
        {
            var d = today.AddDays(-i);
            result.Add(new(d.ToString("d MMM"), counts.TryGetValue(d, out var c) ? c : 0));
        }
        return result;
    }

    private List<ChartSlice> AppointmentStatusCounts()
    {
        var tz = GetIst();
        var today = IstToday();
        var monthStart = new DateTime(today.Year, today.Month, 1);
        var thisMonth = allAppointments
            .Where(a => TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(a.AppointmentDate, DateTimeKind.Utc), tz) >= monthStart
                     && TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(a.AppointmentDate, DateTimeKind.Utc), tz) < monthStart.AddMonths(1))
            .ToList();
        return new List<ChartSlice>
        {
            new("Scheduled", thisMonth.Count(a => a.Status == "Scheduled"), "#7c1b68"),
            new("Completed", thisMonth.Count(a => a.Status == "Completed"), "#008d36"),
            new("Cancelled", thisMonth.Count(a => a.Status == "Cancelled"), "#d6343b"),
        };
    }

    private List<ChartSlice> TopTreatments(int take)
    {
        var tz = GetIst();
        var today = IstToday();
        var monthStart = new DateTime(today.Year, today.Month, 1);
        return allAppointments
            .Where(a => !string.IsNullOrWhiteSpace(a.TreatmentType)
                     && TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(a.AppointmentDate, DateTimeKind.Utc), tz) >= monthStart)
            .GroupBy(a => a.TreatmentType)
            .Select(g => new ChartSlice(g.Key, g.Count(), "#008d36"))
