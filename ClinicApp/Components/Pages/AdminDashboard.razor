    // Line chart of weight over time with a dashed target line, drawn to one scale.
    private static MarkupString WeightTrendChart(List<DailyLog> logs, double target)
    {
        const int w = 360, h = 170, left = 34, right = 10, top = 14, bottom = 24;
        var points = logs.Where(l => l.Weight > 0).ToList();
        if (points.Count < 2) return new MarkupString("");
        double min = Math.Min(points.Min(l => l.Weight), target > 0 ? target : double.MaxValue);
        double max = points.Max(l => l.Weight);
        min = Math.Floor(min - 1); max = Math.Ceiling(max + 1);
        double plotW = w - left - right, plotH = h - top - bottom;
        double X(int i) => left + plotW * i / (points.Count - 1);
        double Y(double kg) => top + plotH - plotH * (kg - min) / (max - min);
        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg class=\"pt-chart\" viewBox=\"0 0 {w} {h}\" role=\"img\" aria-label=\"Weight trend\">");
        foreach (var tick in new[] { min, (min + max) / 2, max })
        {
            sb.Append($"<line x1=\"{left}\" x2=\"{w - right}\" y1=\"{Y(tick):F1}\" y2=\"{Y(tick):F1}\" class=\"pt-chart-grid\"/>");
            sb.Append($"<text x=\"{left - 6}\" y=\"{Y(tick) + 3:F1}\" text-anchor=\"end\" class=\"pt-chart-text\">{tick:0}</text>");
        }
        if (target >= min && target <= max)
        {
            sb.Append($"<line x1=\"{left}\" x2=\"{w - right}\" y1=\"{Y(target):F1}\" y2=\"{Y(target):F1}\" stroke=\"#7c1b68\" stroke-dasharray=\"4 3\" stroke-width=\"1.2\"/>");
            sb.Append($"<text x=\"{w - right}\" y=\"{Y(target) - 4:F1}\" text-anchor=\"end\" class=\"pt-chart-text\" fill=\"#7c1b68\">Target {target:0.#} kg</text>");
        }
        sb.Append("<polyline fill=\"none\" stroke=\"#008d36\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" points=\"");
        for (int i = 0; i < points.Count; i++) sb.Append($"{X(i):F1},{Y(points[i].Weight):F1} ");
        sb.Append("\"/>");
        for (int i = 0; i < points.Count; i++)
        {
            bool last = i == points.Count - 1;
            sb.Append($"<circle cx=\"{X(i):F1}\" cy=\"{Y(points[i].Weight):F1}\" r=\"{(last ? 4 : 2.6)}\" fill=\"#008d36\"><title>{points[i].LogDate:d MMM}: {points[i].Weight:0.#} kg</title></circle>");
        }
        sb.Append($"<text x=\"{left}\" y=\"{h - 6}\" class=\"pt-chart-text\">{points.First().LogDate:d MMM}</text>");
        sb.Append($"<text x=\"{w - right}\" y=\"{h - 6}\" text-anchor=\"end\" class=\"pt-chart-text\">{points.Last().LogDate:d MMM}</text>");
        sb.Append("</svg>");
        return new MarkupString(sb.ToString());
    }


    private void NavigateToTab(string tab)
    {
        activeTab = tab;
        NavManager.NavigateTo($"/admin-dashboard?tab={tab}");
    }

    private static string GetGreeting()
    {
        var ist = GetIst();
        var hour = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, ist).Hour;
        return hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
    }

    private static string TimeAgo(DateTime utc)
    {
        var diff = DateTime.UtcNow - utc;
        if (diff.TotalMinutes < 1)  return "just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes} min ago";
        if (diff.TotalHours < 24)   return $"{(int)diff.TotalHours} hr ago";
        if (diff.TotalDays < 7)     return $"{(int)diff.TotalDays} days ago";
        return utc.ToString("dd MMM");
    }

    private static TimeZoneInfo GetIst()
    {
        try { return TimeZoneInfo.FindSystemTimeZoneById("Asia/Kolkata"); }
        catch { return TimeZoneInfo.FindSystemTimeZoneById("India Standard Time"); }
    }

    private async Task SendDietPlanAsync()
    {
        dietPlanStatus = string.Empty;

        // Validation
        if (string.IsNullOrWhiteSpace(dietPlanText))
        {
            dietPlanStatus = "Diet plan cannot be empty";
            dietPlanSuccess = false;
            return;
        }
        if (!sendViaWA && !saveToProfile)
        {
            dietPlanStatus = "Please select at least one delivery method";
            dietPlanSuccess = false;
            return;
        }

        var errors = new List<string>();

        if (saveToProfile)
        {
            try
            {
                await ClinicService.UpdateClientDietPlanAsync(selectedClient!.UserId, dietPlanText);
                // Update local model so panel re-opens with fresh value
                selectedClient!.DietPlan = dietPlanText;
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Diet plan profile save failed for {UserId}", selectedClient!.UserId);
                errors.Add("Profile save failed. Please try again.");
            }
        }

        if (sendViaWA && !string.IsNullOrWhiteSpace(selectedClientPhone))
        {
            try
            {
                var message = WhatsAppLogHelper.FormatDietPlanMessage(selectedClientName, dietPlanText);
                await ClinicService.SendWhatsAppMessageAsync(selectedClientPhone, message);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Diet plan WhatsApp send failed for {Phone}", selectedClientPhone);
                errors.Add("WhatsApp delivery failed. Please try again.");
            }
        }

        if (errors.Count > 0)
        {
            dietPlanStatus = string.Join(" | ", errors);
            dietPlanSuccess = false;
        }
        else
        {
            var parts = new List<string>();
            if (saveToProfile) parts.Add($"Diet plan saved to {selectedClientName}'s profile");
            if (sendViaWA)     parts.Add($"Diet plan sent via WhatsApp to {selectedClientName}");
            dietPlanStatus = string.Join(". ", parts);
            dietPlanSuccess = true;
        }
    }
