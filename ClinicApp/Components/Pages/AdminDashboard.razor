    private async Task UploadDietPlanDocumentAsync()
    {
        if (selectedClient == null || selectedDietPlanDocument == null || uploadingDietPlanDocument)
            return;

        uploadingDietPlanDocument = true;
        dietPlanDocumentStatus = string.Empty;
        try
        {
            var (document, error) = await DietPlanDocuments.SaveAsync(selectedClient.UserId, selectedDietPlanDocument);
            if (document == null)
            {
                dietPlanDocumentStatus = error ?? "The document could not be uploaded.";
                dietPlanDocumentSuccess = false;
                return;
            }

            currentDietPlanDocument = document;
            selectedDietPlanDocument = null;
            dietPlanDocumentSuccess = true;
            dietPlanDocumentStatus = $"{document.OriginalFileName} is available in {selectedClientName}'s client portal.";

            if (sendDocumentViaWhatsApp && !string.IsNullOrWhiteSpace(selectedClientPhone))
            {
                try
                {
                    var downloadUrl = new Uri(new Uri(NavManager.BaseUri), $"diet-plan-documents/{document.Id}/download");
                    await ClinicService.SendWhatsAppMessageAsync(
                        selectedClientPhone,
                        $"Hello {selectedClientName}, your diet plan document is ready. Sign in to your ProTouch client portal to download it: {downloadUrl}");
                    dietPlanDocumentStatus += " A secure download link was sent via WhatsApp.";
                }
                catch (Exception ex)
                {
                    _logger.LogError(ex, "Diet plan document link WhatsApp send failed for client {ClientUserId}", selectedClient.UserId);
                    dietPlanDocumentStatus += " Upload succeeded, but WhatsApp delivery failed.";
                    dietPlanDocumentSuccess = false;
                }
            }
        }
        finally
        {
            uploadingDietPlanDocument = false;
        }
    }

