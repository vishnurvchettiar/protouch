                                    <textarea class="clinic-input"
                                              rows="8"
                                              maxlength="2000"
                                              @bind="dietPlanText"
                                              @bind:event="oninput"
                                              placeholder="Enter the personalised diet plan..."></textarea>
                                    <div class="text-end text-muted small mt-1">@dietPlanText.Length / 2000</div>
                                </div>
                                <div class="diet-document-upload mb-3">
                                    <div>
                                        <label class="clinic-label" for="diet-plan-document">Attach a diet plan document</label>
                                        <InputFile id="diet-plan-document"
                                                   OnChange="SelectDietPlanDocument"
                                                   accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                                        <small class="text-secondary d-block mt-1">PDF, DOC, or DOCX · up to 15 MB · shared securely in the client's portal</small>
                                    </div>
                                    @if (selectedDietPlanDocument != null)
                                    {
                                        <span class="soft-pill">@selectedDietPlanDocument.Name</span>
                                    }
                                    @if (currentDietPlanDocument != null)
                                    {
                                        <a class="btn-clinic-secondary btn-sm"
                                           href="/diet-plan-documents/@currentDietPlanDocument.Id/download">
                                            Download current document
                                        </a>
                                    }
                                    <label class="d-flex align-items-center gap-2">
                                        <input type="checkbox"
                                               @bind="sendDocumentViaWhatsApp"
                                               disabled="@(string.IsNullOrWhiteSpace(selectedClientPhone) || selectedDietPlanDocument == null)" />
                                        Send download link via WhatsApp
                                    </label>
                                    <button class="btn-clinic"
                                            @onclick="UploadDietPlanDocumentAsync"
                                            disabled="@(selectedDietPlanDocument == null || uploadingDietPlanDocument)">
                                        @(uploadingDietPlanDocument ? "Uploading..." : "Upload & Share with Client")
                                    </button>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(dietPlanDocumentStatus))
                                {
                                    <div class="clinic-alert @(dietPlanDocumentSuccess ? "clinic-alert-info" : "clinic-alert-danger") mb-3" role="status">
                                        @dietPlanDocumentStatus
                                    </div>
                                }
                                <div class="mb-3 d-flex gap-3 flex-wrap">
                                    <label class="d-flex align-items-center gap-2">
                                        <input type="checkbox"
                                               @bind="sendViaWA"
                                               disabled="@string.IsNullOrWhiteSpace(selectedClientPhone)" />
                                        Send via WhatsApp
                                        @if (string.IsNullOrWhiteSpace(selectedClientPhone))
                                        {
                                            <span class="text-muted small">(No phone on record)</span>
                                        }
                                    </label>
                                    <label class="d-flex align-items-center gap-2">
                                        <input type="checkbox" @bind="saveToProfile" />
                                        Save to client profile
                                    </label>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(dietPlanStatus))
                                {
                                    <div class="clinic-alert @(dietPlanSuccess ? "clinic-alert-info" : "clinic-alert-danger") mb-3">
                                        @dietPlanStatus
                                    </div>
                                }
                                <div class="d-flex gap-2">
                                    <button class="btn-clinic" @onclick="SendDietPlanAsync">Send / Save</button>
                                    <button class="btn-clinic-secondary" @onclick="CloseDietPanel">Cancel</button>
                                </div>
                            </div>
                        }
                }
            </div>
        </div>
    }
</div>


