@page "/admin-dashboard"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using ClinicApp.Data
@using ClinicApp.Services
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject ClinicService ClinicService
@inject DietPlanDocumentService DietPlanDocuments
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager
@inject ILogger<AdminDashboard> _logger

<PageTitle>PROTOUCH | Admin Control Center</PageTitle>

<div class="container-fluid py-4 admin-shell">
    <!-- OVERVIEW TAB -->
    @if (activeTab == "overview")
    {
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="clinic-alert clinic-alert-danger mb-4">
                <div><strong>Error:</strong> @errorMessage</div>
                <button class="btn-clinic-secondary ms-auto" @onclick="LoadAdminDataAsync">Retry</button>
            </div>
        }

        <!-- Page title + quick actions -->
        <div class="pt-ov-head">
            <div>
                <h1 class="pt-ov-title">Overview</h1>
                <span class="pt-ov-sub">@TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, GetIst()).ToString("dddd, dd MMMM yyyy")</span>
            </div>
            <div class="pt-ov-actions">
                <button type="button" class="pt-ov-act pt-ov-act--primary" @onclick='() => NavigateToTab("add")'>
                    <svg class="pt-i" aria-hidden="true"><use href="#pt-ico-user-plus"></use></svg>Add client
                </button>
                <button type="button" class="pt-ov-act" @onclick='() => NavigateToTab("visits")'>
                    <svg class="pt-i" aria-hidden="true"><use href="#pt-ico-pulse"></use></svg>Log a visit
                </button>
                <button type="button" class="pt-ov-act" @onclick='() => NavigateToTab("bookings")'>
                    <svg class="pt-i" aria-hidden="true"><use href="#pt-ico-cal"></use></svg>Bookings
                </button>
                <button type="button" class="pt-ov-act" @onclick='() => NavigateToTab("whatsapp")'>
                    <svg class="pt-i" aria-hidden="true"><use href="#pt-ico-chat"></use></svg>WhatsApp
                </button>
                <button type="button" class="pt-ov-act pt-ov-act--icon" title="Refresh" aria-label="Refresh" @onclick="LoadAdminDataAsync">
                    <svg class="pt-i" aria-hidden="true"><use href="#pt-ico-refresh"></use></svg>
                </button>
            </div>
        </div>

        <!-- Stat tiles -->
        <div class="pt-ov-stats">
            @foreach (var card in BuildStatCards())
            {
                <button type="button" class="pt-card pt-ov-stat" style="--c: @card.AccentColour"
                        @onclick='() => NavigateToTab(card.TabTarget)'>
                    <span class="pt-ov-stat-icon"><svg class="pt-i" aria-hidden="true"><use href="#pt-ico-@card.Icon"></use></svg></span>
                    <span class="pt-ov-stat-value">@card.Value</span>
                    <span class="pt-ov-stat-label">@card.Label</span>
                </button>
            }
        </div>

        <!-- Graphs -->
        var visitDays = VisitsByDay(14);
        var apptStatus = AppointmentStatusCounts();
        var apptTotal = apptStatus.Sum(x => x.Count);
        var topTreatments = TopTreatments(5);
        var bookingStatus = BookingStatusCounts();
        <div class="pt-ov-charts">
            <div class="pt-card pt-ov-chart pt-ov-chart--wide">
                <div class="pt-ov-card-head">
                    <h3>Visits, last 14 days</h3>
                    <span class="pt-ov-pill">@visitDays.Sum(x => x.Value) total</span>
                </div>
                @if (visitDays.Sum(x => x.Value) == 0)
                {
                    <p class="pt-ov-empty">No visits logged in the last 14 days.</p>
                }
                else
                {
                    @BarChart(visitDays, "#008d36")
                }
            </div>

            <div class="pt-card pt-ov-chart">
                <div class="pt-ov-card-head">
                    <h3>Appointments this month</h3>
                    <span class="pt-ov-pill">@apptTotal total</span>
                </div>
                @if (apptTotal == 0)
                {
                    <p class="pt-ov-empty">No appointments this month.</p>
                }
                else
                {
                    <div class="pt-ov-donut-wrap">
                        @Donut(apptStatus, apptTotal)
                        <ul class="pt-ov-legend">
                            @foreach (var seg in apptStatus)
                            {
                                <li><i style="background:@seg.Colour"></i><span>@seg.Label</span><b>@seg.Count</b></li>
                            }
                        </ul>
                    </div>
                }
            </div>

            <div class="pt-card pt-ov-chart">
                <div class="pt-ov-card-head">
                    <h3>Popular treatments</h3>
                    <span class="pt-ov-pill">this month</span>
                </div>
                @if (!topTreatments.Any())
                {
                    <p class="pt-ov-empty">No treatments booked this month.</p>
                }
                else
                {
                    <ul class="pt-ov-hbars">
                        @foreach (var t in topTreatments)
                        {
                            <li>
                                <div class="pt-ov-hbar-top"><span>@t.Label</span><b>@t.Count</b></div>
                                <div class="pt-ov-hbar-track"><div class="pt-ov-hbar-fill" style="width:@(topTreatments.Max(x => x.Count) == 0 ? 0 : (int)Math.Round(100.0 * t.Count / topTreatments.Max(x => x.Count)))%"></div></div>
                            </li>
                        }
                    </ul>
                }
            </div>

            <div class="pt-card pt-ov-chart">
                <div class="pt-ov-card-head">
                    <h3>Booking requests</h3>
                    <span class="pt-ov-pill">@bookingStatus.Sum(x => x.Count) total</span>
                </div>
                @if (!bookingStatus.Any())
                {
                    <p class="pt-ov-empty">No booking requests yet.</p>
                }
                else
                {
                    <ul class="pt-ov-hbars">
                        @foreach (var b in bookingStatus)
                        {
                            <li>
                                <div class="pt-ov-hbar-top"><span>@b.Label</span><b>@b.Count</b></div>
                                <div class="pt-ov-hbar-track"><div class="pt-ov-hbar-fill" style="background:@b.Colour;width:@(bookingStatus.Max(x => x.Count) == 0 ? 0 : (int)Math.Round(100.0 * b.Count / bookingStatus.Max(x => x.Count)))%"></div></div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

        <!-- Appointments + activity -->
        <div class="pt-ov-cols">
            <div class="pt-card pt-ov-panel">
                <div class="pt-ov-card-head">
                    <h3>Today's appointments</h3>
                    <span class="pt-ov-pill">@todayAppointments.Count scheduled</span>
                </div>
                @if (!todayAppointments.Any())
                {
                    <p class="pt-ov-empty">No appointments today.</p>
                }
                else
                {
                    <ul class="pt-ov-list">
                        @foreach (var appt in todayAppointments)
                        {
                            <li>
                                <span class="pt-ov-time">@TimeZoneInfo.ConvertTimeFromUtc(appt.AppointmentDate, GetIst()).ToString("h:mm tt")</span>
                                <div class="pt-ov-who">@(appt.User?.FullName ?? "—")<small>@appt.TreatmentType</small></div>
                                <span class="pt-ov-status pt-ov-status--@StatusClass(appt.Status)">@appt.Status</span>
                            </li>
                        }
                    </ul>
                }
            </div>

            <div class="pt-card pt-ov-panel">
                <div class="pt-ov-card-head"><h3>Recent activity</h3></div>
                @if (!recentActivity.Any())
                {
                    <p class="pt-ov-empty">No recent activity.</p>
                }
                else
                {
                    <ul class="pt-ov-feed">
                        @foreach (var item in recentActivity)
                        {
                            <li>
                                <i style="background:@(item.Kind == "booking" ? "#b58900" : "#008d36")"></i>
                                <div>@item.Title<small>@item.SubText</small></div>
                                <time>@TimeAgo(item.Timestamp)</time>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    }

    <!-- ADD USER TAB -->
    @if (activeTab == "add")
    {
        <div class="pt-ov-head">
            <div>
                <h1 class="pt-ov-title">@(editingUserId == null ? "Add user" : "Edit user")</h1>
                <span class="pt-ov-sub">@(editingUserId == null ? "Create a login and assign a role" : "Update this person's details")</span>
            </div>
            @if (editingUserId != null)
            {
                <div class="pt-ov-actions"><button type="button" class="pt-ov-act" @onclick="CancelEditUser">Cancel edit</button></div>
            }
        </div>
        <div class="pt-split pt-split--r">
            <div class="pt-card pt-form">
                <div class="pt-grid2">
                    <div class="pt-field"><label for="nu-name">Full name</label><input id="nu-name" class="pt-input" @bind="newName" /></div>
                    <div class="pt-field"><label for="nu-role">Role</label><select id="nu-role" class="pt-input" @bind="newRole" disabled="@(editingUserId != null)"><option>Client</option><option>Admin</option></select></div>
                    <div class="pt-field"><label for="nu-email">Email / username</label><input id="nu-email" class="pt-input" type="email" @bind="newEmail" disabled="@(editingUserId != null)" /></div>
                    <div class="pt-field"><label for="nu-phone">WhatsApp number</label><input id="nu-phone" class="pt-input" @bind="newPhone" placeholder="98765 43210" /></div>
                </div>
                @if (newRole == "Client" && editingUserId == null)
                {
                    <div class="pt-form-section">Treatment details <span>clients only</span></div>
                    <div class="pt-grid3">
                        <div class="pt-field"><label for="nu-sw">Starting weight (kg)</label><input id="nu-sw" class="pt-input" type="number" @bind="newStartWeight" /></div>
                        <div class="pt-field"><label for="nu-tw">Target weight (kg)</label><input id="nu-tw" class="pt-input" type="number" @bind="newTargetWeight" /></div>
                        <div class="pt-field"><label for="nu-h">Height (cm)</label><input id="nu-h" class="pt-input" type="number" @bind="newHeight" /></div>
                    </div>
                }
                <div class="pt-field"><label for="nu-notes">Clinical / staff notes</label><textarea id="nu-notes" class="pt-input" rows="3" @bind="newNotes"></textarea></div>
                <div class="pt-form-actions">
                    @if (editingUserId == null)
                    {
                        <button type="button" class="pt-btn pt-btn--pri" @onclick="CreateUser" disabled="@creatingUser">@(creatingUser ? "Creating..." : "Create user")</button>
                    }
                    else
                    {
                        <button type="button" class="pt-btn pt-btn--pri" @onclick="SaveEditUser" disabled="@creatingUser">@(creatingUser ? "Saving..." : "Save changes")</button>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(createUserMessage)) { <div class="clinic-alert @(createUserSuccess ? "clinic-alert-info" : "clinic-alert-danger")" role="status">@createUserMessage</div> }
            </div>
            <div class="pt-card">
                <div class="pt-card-head"><h3>What each role can do</h3></div>
                <div class="pt-role-help">
                    <span class="pt-ov-status pt-ov-status--ok">Client</span>
                    <p>Sees their own dashboard, logs weight and meals, books appointments and reads their diet plan.</p>
                    <span class="pt-ov-status pt-ov-status--info">Admin</span>
                    <p>Manages clients, visits, bookings and WhatsApp. Create admins sparingly.</p>
                </div>
                @if (!string.IsNullOrWhiteSpace(lastCreatedEmail))
                {
                    <div class="pt-created">
                        <h4>Login created</h4>
                        <div class="credential-row"><span>Login</span><strong>@lastCreatedEmail</strong></div>
                        <div class="credential-row"><span>Temporary password</span><strong>@lastCreatedPassword</strong></div>
                        @if (!string.IsNullOrWhiteSpace(lastCredentialWhatsAppLink)) { <a class="pt-btn pt-btn--pri" target="_blank" rel="noopener" href="@lastCredentialWhatsAppLink">Send credentials via WhatsApp</a> }
                        else { <span class="pt-muted">No phone number provided. Share the credentials manually.</span> }
                    </div>
                }
            </div>
        </div>
    }
    else if (activeTab == "visits")
    {
        <div class="pt-ov-head">
            <div>
                <h1 class="pt-ov-title">Visits</h1>
                <span class="pt-ov-sub">@todayAttendanceCount logged today</span>
            </div>
        </div>
        <div class="pt-kpis">
            <div class="pt-kpi"><b>@todayAttendanceCount</b><span>Today</span></div>
            <div class="pt-kpi"><b>@VisitsSince(7)</b><span>Last 7 days</span></div>
            <div class="pt-kpi"><b>@VisitsSince(30)</b><span>Last 30 days</span></div>
        </div>
        <div class="pt-split">
            <div class="pt-card pt-form">
                <div class="pt-card-head"><h3>Log a visit</h3></div>
                <div class="pt-field"><label for="v-client">Client</label><select id="v-client" class="pt-input" @bind="visitUserId"><option value="">Select client</option>@foreach (var c in clients) { <option value="@c.UserId">@c.User?.FullName</option> }</select></div>
                <div class="pt-field"><label for="v-date">Visit date and time</label><input id="v-date" class="pt-input" type="datetime-local" @bind="visitDate" /></div>
                <div class="pt-field"><label for="v-treat">Treatment given</label><select id="v-treat" class="pt-input" @bind="visitTreatment"><option>Physiotherapy</option><option>Skin Consultation</option><option>Diet Review</option><option>Slimming Therapy</option><option>Wellness Consultation</option></select></div>
                <div class="pt-field"><label for="v-prac">Doctor / practitioner</label><input id="v-prac" class="pt-input" @bind="visitPractitioner" /></div>
                <div class="pt-field"><label for="v-next">Next appointment</label><input id="v-next" class="pt-input" type="datetime-local" @bind="nextAppointmentDate" /></div>
                <div class="pt-field"><label for="v-notes">Notes</label><input id="v-notes" class="pt-input" @bind="visitNotes" placeholder="Treatment response or instructions" /></div>
                <div class="pt-form-actions"><button type="button" class="pt-btn pt-btn--pri" @onclick="SaveVisit" disabled="@string.IsNullOrWhiteSpace(visitUserId)">Save visit</button></div>
                @if (!string.IsNullOrWhiteSpace(visitSaveMsg)) { <div class="clinic-alert clinic-alert-info" role="status">@visitSaveMsg</div> }
            </div>
            <div class="pt-card">
                <div class="pt-card-head"><h3>Service history</h3><span class="pt-ov-pill">latest 50</span></div>
                @if (!attendanceLogs.Any()) { <p class="pt-ov-empty">No visits recorded yet.</p> }
                <div class="pt-rows">
                @foreach (var visit in attendanceLogs.Take(50))
                {
                    @if (editingVisitId == visit.Id)
                {
                    <div class="pt-edit-box">
                        <div class="row g-2">
                            <div class="col-md-4"><label class="pt-label">Treatment</label><input class="pt-input" @bind="editVisit.TreatmentReceived" /></div>
                            <div class="col-md-4"><label class="pt-label">Therapist</label><input class="pt-input" @bind="editVisit.Therapist" /></div>
                            <div class="col-md-4"><label class="pt-label">Status</label><select class="pt-input" @bind="editVisit.Status"><option>Checked In</option><option>Completed</option><option>Absent</option></select></div>
                            <div class="col-md-4"><label class="pt-label">Checkout time</label><input class="pt-input" type="datetime-local" @bind="editVisitCheckout" /></div>
                            <div class="col-md-4"><label class="pt-label">Next appointment</label><input class="pt-input" type="datetime-local" @bind="editVisitNextAppt" /></div>
                            <div class="col-12"><label class="pt-label">Notes</label><textarea class="pt-input" rows="2" @bind="editVisit.Notes" maxlength="2000"></textarea></div>
                        </div>
                        <div class="pt-form-actions">
                            <button class="pt-btn pt-btn--pri" type="button" @onclick="SaveEditVisit">Save</button>
                            <button class="pt-btn" type="button" @onclick="CancelEditVisit">Cancel</button>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(visitEditError)) { <div class="clinic-alert clinic-alert-danger mt-2">@visitEditError</div> }
                    </div>
                }
                    else
                    {
                        <div class="pt-row">
                            <span class="pt-avatar" style="--c:@AvatarColour(visit.User?.FullName)">@Initials(visit.User?.FullName)</span>
                            <div class="pt-row-main">
                                <strong>@visit.User?.FullName</strong>
                                <small>@visit.TreatmentReceived · @visit.Therapist</small>
                                <small>@visit.CheckInTime.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt") · Next: @(visit.NextAppointmentDate?.ToLocalTime().ToString("dd MMM yyyy") ?? "not set")</small>
                                @if (!string.IsNullOrWhiteSpace(visit.Notes)) { <small>@visit.Notes</small> }
                            </div>
                            <div class="pt-row-actions">
                                <span class="pt-ov-status pt-ov-status--@(visit.Status == "Completed" ? "ok" : visit.Status == "Absent" ? "bad" : "info")">@visit.Status</span>
                                @if (visit.Status == "Checked In") { <button type="button" class="pt-btn pt-btn--sm" @onclick="() => CheckoutVisit(visit)">Check out</button> }
                                <button type="button" class="pt-btn pt-btn--sm" @onclick="() => StartEditVisit(visit)">Edit</button>
                                <button type="button" class="pt-btn pt-btn--sm pt-btn--dng" @onclick="() => ConfirmDeleteVisit(visit)">Delete</button>
                            </div>
                        </div>
                    }
                }
                </div>
                @if (deleteVisitConfirm != null)
                {
                    <div class="clinic-alert clinic-alert-danger" role="alert">
                        Delete visit by <strong>@deleteVisitConfirm.User?.FullName</strong> on <strong>@deleteVisitConfirm.CheckInTime.ToLocalTime().ToString("dd MMM yyyy")</strong>?
                        <div class="pt-form-actions">
                            <button type="button" class="pt-btn pt-btn--dng" @onclick="ExecuteDeleteVisit">Yes, delete</button>
                            <button type="button" class="pt-btn" @onclick="() => deleteVisitConfirm = null">Cancel</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else if (activeTab == "appointments")
    {
        var shownAppts = FilteredAppointments().ToList();
        <div class="pt-ov-head">
            <div>
                <h1 class="pt-ov-title">Appointments</h1>
                <span class="pt-ov-sub">@allAppointments.Count(a => IsToday(a.AppointmentDate)) today · @allAppointments.Count(a => a.AppointmentDate > DateTime.UtcNow && (a.Status == "Scheduled" || a.Status == "Confirmed")) upcoming</span>
            </div>
        </div>
        <div class="pt-toolbar">
            <div class="pt-seg" role="group" aria-label="Appointment filter">
                @foreach (var f in new[] { ("today", "Today"), ("upcoming", "Upcoming"), ("completed", "Completed"), ("cancelled", "Cancelled"), ("all", "All") })
                {
                    <button type="button" class="@(apptFilter == f.Item1 ? "on" : "")" @onclick="() => apptFilter = f.Item1">@f.Item2</button>
                }
            </div>
            <div class="pt-search"><svg class="pt-i" aria-hidden="true"><use href="#pt-ico-search"></use></svg><input aria-label="Search appointments" placeholder="Search client" @bind="apptSearch" @bind:event="oninput" /></div>
        </div>
        <div class="pt-card pt-card--flush">
            @if (!shownAppts.Any()) { <p class="pt-ov-empty pt-pad">No appointments in this view.</p> }
            else
            {
                <div class="pt-table-wrap">
                    <table class="pt-table">
                        <thead><tr><th>When</th><th>Client</th><th>Treatment</th><th>Status</th><th>Reminder</th></tr></thead>
                        <tbody>
                            @foreach (var appt in shownAppts)
                            {
                                <tr>
                                    <td class="pt-nowrap"><strong>@appt.AppointmentDate.ToLocalTime().ToString("hh:mm tt")</strong><small>@appt.AppointmentDate.ToLocalTime().ToString("dd MMM yyyy")</small></td>
                                    <td><div class="pt-cell-user"><span class="pt-avatar" style="--c:@AvatarColour(appt.User?.FullName)">@Initials(appt.User?.FullName)</span>@appt.User?.FullName</div></td>
                                    <td>@appt.TreatmentType</td>
                                    <td>
                                        <select class="pt-input pt-input--sm" aria-label="Status" value="@appt.Status" @onchange="(e) => UpdateApptStatus(appt.Id, e.Value?.ToString() ?? appt.Status)">
                                            <option>Scheduled</option><option>Confirmed</option><option>Completed</option><option>Cancelled</option>
                                        </select>
                                        @if (apptUpdateError.ContainsKey(appt.Id)) { <small class="pt-err">@apptUpdateError[appt.Id]</small> }
                                    </td>
                                    <td>
                                        @if (remindersSent.Contains(appt.Id)) { <span class="pt-ov-status pt-ov-status--ok">Sent</span> }
                                        else if (string.IsNullOrWhiteSpace(appt.User?.PhoneNumber)) { <small class="pt-muted">No phone</small> }
                                        else { <button type="button" class="pt-btn pt-btn--sm" @onclick="() => SendReminderManually(appt)">Send reminder</button> }
                                        @if (reminderErrors.ContainsKey(appt.Id)) { <small class="pt-err">@reminderErrors[appt.Id]</small> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
    else if (activeTab == "mealreview")
    {
        <div class="pt-ov-head">
            <div>
                <h1 class="pt-ov-title">Meal review</h1>
                <span class="pt-ov-sub">Photos and notes clients logged with their weight</span>
            </div>
            <span class="pt-ov-pill">Page @mealPage</span>
        </div>
        @if (!mealLogs.Any()) { <div class="pt-card"><p class="pt-ov-empty">No meal photos uploaded yet.</p></div> }
        else
        {
            <div class="pt-meal-grid">
                @foreach (var log in mealLogs)
                {
                    <div class="pt-card pt-meal">
                        @if (!string.IsNullOrWhiteSpace(log.MealPhotoUrl)) { <img src="@log.MealPhotoUrl" class="pt-meal-photo" alt="Meal photo from @log.User?.FullName" loading="lazy" /> }
                        else { <div class="pt-meal-photo pt-meal-photo--empty"><svg class="pt-i" aria-hidden="true"><use href="#pt-ico-leaf"></use></svg></div> }
                        <div class="pt-meal-body">
                            <div class="pt-meal-top"><strong>@log.User?.FullName</strong><span>@log.LogDate.ToString("dd MMM yyyy")</span></div>
                            @if (!string.IsNullOrWhiteSpace(log.DietNotes)) { <p class="pt-meal-notes">@log.DietNotes</p> }
                            <div class="macro-bar">
                                <div class="seg-carbs" style="width: @log.CarbsPercentage%"></div>
                                <div class="seg-protein" style="width: @log.ProteinPercentage%"></div>
                                <div class="seg-fat" style="width: @log.FatPercentage%"></div>
                                <div class="seg-veg" style="width: @log.VegPercentage%"></div>
                            </div>
                            <div class="pt-meal-macros">Carbs @log.CarbsPercentage% · Protein @log.ProteinPercentage% · Fat @log.FatPercentage% · Veg @log.VegPercentage%</div>
                            <div class="pt-meal-actions"><button type="button" class="pt-btn pt-btn--sm pt-btn--dng" @onclick="() => DeleteMealLog(log.Id)">Delete</button></div>
                            @if (mealDeleteErrors.ContainsKey(log.Id)) { <div class="clinic-alert clinic-alert-danger" role="alert">@mealDeleteErrors[log.Id]</div> }
                        </div>
                    </div>
                }
            </div>
            <div class="pt-pager">
                <button type="button" class="pt-btn pt-btn--sm" @onclick="PrevMealPage" disabled="@(mealPage <= 1)">Previous</button>
                <span>Page @mealPage</span>
                <button type="button" class="pt-btn pt-btn--sm" @onclick="NextMealPage" disabled="@(mealLogs.Count < 20)">Next</button>
            </div>
        }
    }
    else if (activeTab == "bookings")
    {
        var shownBookings = allBookings.Where(b => bookingFilter == "All" || b.Status == bookingFilter).ToList();
        <div class="pt-ov-head">
            <div>
                <h1 class="pt-ov-title">Bookings</h1>
                <span class="pt-ov-sub">Requests from the website booking form</span>
            </div>
        </div>
        <div class="pt-kpis">
            <div class="pt-kpi pt-kpi--wait"><b>@allBookings.Count(b => b.Status == "Pending")</b><span>Pending</span></div>
            <div class="pt-kpi pt-kpi--ok"><b>@allBookings.Count(b => b.Status == "Confirmed")</b><span>Confirmed</span></div>
            <div class="pt-kpi pt-kpi--bad"><b>@allBookings.Count(b => b.Status == "Cancelled")</b><span>Cancelled</span></div>
        </div>
        <div class="pt-toolbar">
            <div class="pt-seg" role="group" aria-label="Booking filter">
                @foreach (var f in new[] { "Pending", "Confirmed", "Cancelled", "All" })
                {
                    <button type="button" class="@(bookingFilter == f ? "on" : "")" @onclick="() => bookingFilter = f">@f</button>
                }
            </div>
        </div>
        <div class="pt-card pt-card--flush">
            @if (!allBookings.Any()) { <p class="pt-ov-empty pt-pad">No booking requests yet. They appear here after visitors submit the booking form.</p> }
            else if (!shownBookings.Any()) { <p class="pt-ov-empty pt-pad">No @bookingFilter.ToLowerInvariant() requests.</p> }
            else
            {
                <div class="pt-table-wrap">
                    <table class="pt-table">
                        <thead><tr><th>Requested by</th><th>Service</th><th>Preferred date</th><th>Notes</th><th>Status</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var booking in shownBookings)
                            {
                                var waLink = string.IsNullOrWhiteSpace(booking.PhoneNumber) ? "" : ClinicService.BuildWhatsAppLink(booking.PhoneNumber, $"Hello {booking.FullName}, this is ProTouch Physio - Slimming Clinic regarding your booking for {booking.ServiceType}.");
                                <tr>
                                    <td><strong>@booking.FullName</strong><small>@booking.PhoneNumber · sent @booking.SubmittedAt.ToLocalTime().ToString("dd MMM, hh:mm tt")</small></td>
                                    <td>@booking.ServiceType</td>
                                    <td class="pt-nowrap">@booking.PreferredDate.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td>
                                    <td class="pt-notes-cell">@booking.Notes</td>
                                    <td><span class="pt-ov-status pt-ov-status--@(booking.Status == "Pending" ? "wait" : booking.Status == "Confirmed" ? "ok" : "bad")">@booking.Status</span></td>
                                    <td>
                                        <div class="pt-row-actions">
                                            @if (booking.Status == "Pending")
                                            {
                                                <button type="button" class="pt-btn pt-btn--sm pt-btn--pri" @onclick="() => ConfirmBooking(booking.Id)">Confirm</button>
                                                <button type="button" class="pt-btn pt-btn--sm pt-btn--dng" @onclick="() => CancelBooking(booking.Id)">Cancel</button>
                                            }
                                            else if (booking.Status == "Confirmed")
                                            {
                                                <button type="button" class="pt-btn pt-btn--sm pt-btn--dng" @onclick="() => CancelBooking(booking.Id)">Cancel</button>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(waLink)) { <a class="pt-btn pt-btn--sm" target="_blank" rel="noopener" href="@waLink">WhatsApp</a> }
                                            else { <small class="pt-muted">Phone missing</small> }
                                        </div>
                                        @if (bookingUpdateErrors.ContainsKey(booking.Id)) { <small class="pt-err">@bookingUpdateErrors[booking.Id]</small> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
    else if (activeTab == "whatsapp")
    {
        var recipientStats = RecipientStats();
        <div class="pt-ov-head">
            <div>
                <h1 class="pt-ov-title">WhatsApp</h1>
                <span class="pt-ov-sub">Bulk campaigns and message history</span>
            </div>
            <span class="pt-ov-status pt-ov-status--@(settingsMode == "Twilio" ? "ok" : "wait")">@(settingsMode == "Twilio" ? "Live: Twilio" : "Test mode")</span>
        </div>
        @if (settingsMode != "Twilio")
        {
            <div class="pt-banner pt-banner--warn" role="status"><span><strong>Test mode is on.</strong> Campaigns are simulated and nothing is sent. Switch WhatsApp mode to Twilio in Settings to send for real.</span></div>
        }
        else
        {
            <div class="pt-banner pt-banner--info" role="status"><span><strong>Templates:</strong> Twilio only delivers free-text messages inside the 24-hour reply window. Use templates approved in the <a href="https://console.twilio.com" target="_blank" rel="noopener">Twilio Console</a> for everyone else.</span></div>
        }
        <div class="pt-split pt-split--w">
            <div class="pt-stack">
                <div class="pt-card pt-form">
                    <div class="pt-step"><em>1</em>Upload recipients</div>
                    <label class="pt-drop" for="csv-upload">
                        <svg class="pt-i" aria-hidden="true"><use href="#pt-ico-upload"></use></svg>
                        <strong>@(csvRecipients.Any() ? $"{csvRecipients.Count} rows loaded" : "Choose a CSV file")</strong>
                        <span>Needs a Name column and a Phone column. Up to 2 MB.</span>
                        <InputFile id="csv-upload" class="pt-drop-input" accept=".csv,text/csv" OnChange="ReadCsvRecipients" />
                    </label>
                    @if (csvRecipients.Any())
                    {
                        <div class="pt-chips">
                            <span class="pt-ov-status pt-ov-status--ok">@recipientStats.Ready ready</span>
                            @if (recipientStats.Duplicates > 0) { <span class="pt-ov-status pt-ov-status--wait">@recipientStats.Duplicates duplicate</span> }
                            @if (recipientStats.Invalid > 0) { <span class="pt-ov-status pt-ov-status--bad">@recipientStats.Invalid invalid number</span> }
                        </div>
                    }
                </div>
                <div class="pt-card pt-form">
                    <div class="pt-step"><em>2</em>Write the message</div>
                    <div class="pt-toolbar pt-toolbar--tight">
                        <button type="button" class="pt-btn pt-btn--sm" @onclick="UseDietTemplate">Diet reminder</button>
                        <button type="button" class="pt-btn pt-btn--sm" @onclick="UseAppointmentTemplate">Appointment</button>
                        <button type="button" class="pt-btn pt-btn--sm" @onclick="InsertNameToken">Insert name</button>
                    </div>
                    <div class="pt-field"><label for="campaign-text">Message. Use <code>{{Name}}</code> to personalise.</label><textarea id="campaign-text" class="pt-input" rows="5" @bind="campaignText" @bind:event="oninput"></textarea></div>
                    <div class="pt-hint"><span>@((campaignText ?? "").Length) of 4,096 characters</span><span>The opt-out line is added automatically</span></div>
                </div>
                <div class="pt-card pt-form">
                    <div class="pt-step"><em>3</em>Review and send</div>
                    <div class="pt-send-row">
                        <span>@(csvRecipients.Any() ? $"Sending to {recipientStats.Ready} people" : "Add recipients to continue")</span>
                        <div class="pt-row-actions">
                            <button type="button" class="pt-btn" @onclick="PreviewCsvCampaign" disabled="@(!csvRecipients.Any() || sendingCampaign)">Preview all</button>
                            <button type="button" class="pt-btn pt-btn--pri" @onclick="SendCsvCampaign" disabled="@(!csvRecipients.Any() || sendingCampaign)">@(sendingCampaign ? "Sending..." : (settingsMode == "Twilio" ? "Send campaign" : "Run test campaign"))</button>
                        </div>
                    </div>
                    @if (sendingCampaign)
                    {
                        <div class="pt-progress"><div class="pt-progress-bar" style="width: @(campaignTotal > 0 ? (int)((double)campaignSent / campaignTotal * 100) : 0)%"></div></div>
                        <div class="pt-hint"><span>@campaignSent of @campaignTotal done@(campaignFailed > 0 ? $" · {campaignFailed} failed" : "")</span></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(campaignSuccessMsg)) { <div class="clinic-alert clinic-alert-info" role="status">@campaignSuccessMsg</div> }
                    @if (!string.IsNullOrWhiteSpace(campaignErrorMsg)) { <div class="clinic-alert clinic-alert-danger" role="alert">@campaignErrorMsg</div> }
                </div>
            </div>
            <div class="pt-stack">
                <div class="pt-chat">
                    <div class="pt-chat-label">Preview for @PreviewName()</div>
                    <div class="pt-bubble">@BubbleText()<small>Reply STOP to unsubscribe.</small></div>
                </div>
                @if (campaignPreviews.Any())
                {
                    <div class="pt-card pt-scroll">
                        <div class="pt-card-head"><h3>@campaignPreviews.Count personalised messages</h3></div>
                        <ul class="pt-rows">
                            @foreach (var preview in campaignPreviews.Take(500))
                            {
                                <li class="pt-row">
                                    <div class="pt-row-main"><strong>@preview.RecipientName</strong><small>@preview.RecipientPhone</small><small class="pt-pre">@preview.PersonalisedMessage</small></div>
                                    @if (preview.Warning != null) { <span class="pt-ov-status pt-ov-status--wait">@preview.Warning</span> }
                                </li>
                            }
                        </ul>
                    </div>
                }
                <div class="pt-card">
                    <div class="pt-card-head"><h3>Recent campaigns</h3></div>
                    @if (!whatsappLogs.Any()) { <p class="pt-ov-empty">Nothing sent yet.</p> }
                    <ul class="pt-rows">
                        @foreach (var log in whatsappLogs.Take(8))
                        {
                            var badges = WhatsAppLogHelper.GetLogDetailBadges(log.LogDetail);
                            <li class="pt-row">
                                <div class="pt-row-main">
                                    <strong>@log.TargetAudience</strong>
                                    <small class="pt-clip">@log.MessageTemplate</small>
                                    <small>@TimeZoneInfo.ConvertTimeFromUtc(log.SentAt, GetIst()).ToString("dd MMM, hh:mm tt")</small>
                                </div>
                                <div class="pt-row-actions">
                                    <span class="pt-ov-pill">@log.Status · @log.RecipientCount</span>
                                    @foreach (var b in badges.Take(3)) { <span class="badge-clinic @b.Css" style="font-size: 0.65rem;">@b.Label</span> }
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    }
    else if (activeTab == "feedback")
    {
        var fbFiltered = (_feedbackStarFilter.HasValue ? _feedbackList.Where(f => f.Rating == _feedbackStarFilter.Value) : _feedbackList).ToList();
        var fbPageCount = Math.Max(1, (int)Math.Ceiling(fbFiltered.Count / (double)FeedbackPageSize));
        if (_feedbackPage > fbPageCount) _feedbackPage = fbPageCount;
        <div class="pt-ov-head">
            <div>
                <h1 class="pt-ov-title">Feedback</h1>
                <span class="pt-ov-sub">What clients say on the website</span>
            </div>
        </div>
        @if (!_feedbackList.Any())
        {
            <div class="pt-card"><p class="pt-ov-empty">No feedback submitted yet.</p></div>
        }
        else
        {
            <div class="pt-split pt-split--r">
                <div class="pt-stack">
                    <div class="pt-toolbar">
                        <div class="pt-seg" role="group" aria-label="Rating filter">
                            <button type="button" class="@(_feedbackStarFilter == null ? "on" : "")" @onclick="() => { _feedbackStarFilter = null; _feedbackPage = 1; }">All</button>
                            @foreach (var r in new[] { 5, 4, 3, 2, 1 })
                            {
                                <button type="button" class="@(_feedbackStarFilter == r ? "on" : "")" @onclick="() => { _feedbackStarFilter = r; _feedbackPage = 1; }">@r ★</button>
                            }
                        </div>
                    </div>
                    @if (!fbFiltered.Any()) { <div class="pt-card"><p class="pt-ov-empty">No feedback with that rating.</p></div> }
                    @foreach (var f in FilteredFeedback)
                    {
                        <div class="pt-card pt-review">
                            <div class="pt-review-top">
                                <span class="pt-stars" aria-label="@f.Rating out of 5">@(new string('★', f.Rating))<span>@(new string('★', 5 - f.Rating))</span></span>
                                <small>@TimeZoneInfo.ConvertTimeFromUtc(f.SubmittedAt, GetIst()).ToString("dd MMM yyyy, hh:mm tt")</small>
                            </div>
                            <p class="pt-review-text">
                                @if (f.Comment?.Length > 160 && !_feedbackExpandedIds.Contains(f.Id)) { @(f.Comment[..160] + "…") <button type="button" class="pt-link" @onclick="() => ToggleFeedbackExpand(f.Id)">Show more</button> }
                                else if (f.Comment?.Length > 160) { @f.Comment <button type="button" class="pt-link" @onclick="() => ToggleFeedbackExpand(f.Id)">Show less</button> }
                                else { @f.Comment }
                            </p>
                            <div class="pt-row-actions">
                                @if (_feedbackDeleteId == f.Id)
                                {
                                    <span class="pt-muted">Delete this review?</span>
                                    <button type="button" class="pt-btn pt-btn--sm pt-btn--dng" @onclick="() => ConfirmDeleteFeedback(f.Id)">Yes, delete</button>
                                    <button type="button" class="pt-btn pt-btn--sm" @onclick="() => _feedbackDeleteId = null">No</button>
                                }
                                else
                                {
                                    <button type="button" class="pt-btn pt-btn--sm pt-btn--dng" @onclick="() => _feedbackDeleteId = f.Id">Delete</button>
                                }
                            </div>
                        </div>
                    }
                    @if (fbPageCount > 1)
                    {
                        <div class="pt-pager">
                            <button type="button" class="pt-btn pt-btn--sm" @onclick="() => _feedbackPage--" disabled="@(_feedbackPage <= 1)">Previous</button>
                            <span>Page @_feedbackPage of @fbPageCount</span>
                            <button type="button" class="pt-btn pt-btn--sm" @onclick="() => _feedbackPage++" disabled="@(_feedbackPage >= fbPageCount)">Next</button>
                        </div>
                    }
                </div>
                <div class="pt-card pt-summary">
                    <div class="pt-card-head"><h3>Rating summary</h3></div>
                    <div class="pt-summary-score"><b>@_feedbackAvgRating.ToString("0.0")</b><span>from @_feedbackTotal reviews</span></div>
                    <ul class="pt-ov-hbars">
                        @foreach (var r in new[] { 5, 4, 3, 2, 1 })
                        {
                            <li>
                                <div class="pt-ov-hbar-top"><span>@r ★</span><b>@_feedbackPerStar[r]</b></div>
                                <div class="pt-ov-hbar-track"><div class="pt-ov-hbar-fill" style="width:@(_feedbackTotal == 0 ? 0 : (int)Math.Round(100.0 * _feedbackPerStar[r] / _feedbackTotal))%;background:@(r >= 4 ? "#008d36" : r == 3 ? "#b58900" : "#d6343b")"></div></div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
    }
    else if (activeTab == "settings")
    {
        <div class="pt-ov-head">
            <div>
                <h1 class="pt-ov-title">Settings</h1>
                <span class="pt-ov-sub">WhatsApp connection and sending rules</span>
            </div>
            <div class="pt-ov-actions">
                <button type="button" class="pt-ov-act" @onclick="TestTwilioConnectionAsync">Send test message</button>
                <button type="button" class="pt-ov-act pt-ov-act--primary" @onclick="SaveSettingsAsync">Save settings</button>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(settingsSaveMsg)) { <div class="clinic-alert @(settingsSaveSuccess ? "clinic-alert-info" : "clinic-alert-danger")" role="status">@settingsSaveMsg</div> }
        @if (!string.IsNullOrWhiteSpace(settingsTestMsg)) { <div class="clinic-alert @(settingsTestSuccess ? "clinic-alert-info" : "clinic-alert-danger")" role="status">@settingsTestMsg</div> }
        <div class="pt-stack">
            <div class="pt-card pt-form">
                <div class="pt-card-head"><h3>WhatsApp connection</h3><span class="pt-ov-status pt-ov-status--@(settingsMode == "Twilio" ? "ok" : "wait")">@(settingsMode == "Twilio" ? "Live" : "Test mode")</span></div>
                <div class="pt-field">
                    <span class="pt-label">Mode</span>
                    <div class="pt-seg" role="group" aria-label="WhatsApp mode">
                        <button type="button" class="@(settingsMode == "Mock" ? "on" : "")" @onclick='() => settingsMode = "Mock"'>Test (simulated)</button>
                        <button type="button" class="@(settingsMode == "Twilio" ? "on" : "")" @onclick='() => settingsMode = "Twilio"'>Twilio (live)</button>
                    </div>
                    <small class="pt-muted">Test mode records messages without sending. Twilio mode sends real WhatsApp messages.</small>
                </div>
                <div class="pt-grid2">
                    <div class="pt-field"><label for="s-sid">Account SID</label><input id="s-sid" class="pt-input" type="password" autocomplete="off" @bind="settingsSid" placeholder="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" /></div>
                    <div class="pt-field"><label for="s-token">Auth token</label><input id="s-token" class="pt-input" type="password" autocomplete="off" @bind="settingsToken" placeholder="Your Twilio auth token" /></div>
                    <div class="pt-field"><label for="s-from">Sending number</label><input id="s-from" class="pt-input" @bind="settingsFrom" placeholder="whatsapp:+14155238886" /></div>
                    <div class="pt-field"><label for="s-clinic">Clinic number for alerts</label><input id="s-clinic" class="pt-input" @bind="settingsClinicNum" placeholder="+919028027888" /></div>
                </div>
            </div>
            <div class="pt-card pt-form">
                <div class="pt-card-head"><h3>Bulk sending</h3></div>
                <div class="pt-grid2">
                    <div class="pt-field"><label for="s-delay">Pause between messages (ms)</label><input id="s-delay" class="pt-input" type="number" min="100" max="60000" step="100" @bind="settingsBulkDelay" /><small class="pt-muted">Between 100 and 60,000. A longer pause is safer for large lists.</small></div>
                    <div class="pt-field"><label for="s-footer">Opt-out line</label><input id="s-footer" class="pt-input" @bind="settingsOptOut" placeholder="Reply STOP to unsubscribe." /><small class="pt-muted">Added to the end of every bulk message.</small></div>
                </div>
            </div>
            <details class="pt-card pt-guide">
                <summary>Twilio setup guide</summary>
                <ol>
                    <li>Create a free Twilio account at <a href="https://twilio.com" target="_blank" rel="noopener">twilio.com</a>.</li>
                    <li>From the Twilio Console dashboard, copy your <strong>Account SID</strong> and <strong>Auth Token</strong>.</li>
                    <li>Go to <strong>Messaging, Senders, WhatsApp Senders</strong> and join the Twilio Sandbox by sending the join code from your WhatsApp.</li>
                    <li>The sandbox sending number is <code>whatsapp:+14155238886</code>.</li>
                    <li>Enter the clinic's WhatsApp number, for example <code>+919028027888</code>, in the alerts field.</li>
                    <li>Set the mode to <strong>Twilio (live)</strong> and save.</li>
                    <li>Use <strong>Send test message</strong> to check delivery.</li>
                </ol>
            </details>
        </div>
    }
    else
    {
        <div class="pt-ov-head">
            <div>
                <h1 class="pt-ov-title">Clients</h1>
                <span class="pt-ov-sub">@clients.Count(c => c.IsActive) active · @clients.Count(c => !c.IsActive) inactive</span>
            </div>
            <div class="pt-ov-actions">
                <button type="button" class="pt-ov-act pt-ov-act--primary" @onclick='() => { editingUserId = null; NavigateToTab("add"); }'>
                    <svg class="pt-i" aria-hidden="true"><use href="#pt-ico-user-plus"></use></svg>Add client
                </button>
            </div>
        </div>
        <div class="pt-split">
            <div class="pt-card pt-dir">
                <div class="pt-search"><svg class="pt-i" aria-hidden="true"><use href="#pt-ico-search"></use></svg><input aria-label="Search clients" placeholder="Search by name or phone" @bind="searchQuery" @bind:event="oninput" /></div>
                <div class="pt-seg" role="group" aria-label="Status filter">
                    @foreach (var f in new[] { ("active", "Active"), ("inactive", "Inactive"), ("all", "All") })
                    {
                        <button type="button" class="@(clientStatusFilter == f.Item1 ? "on" : "")" @onclick="() => clientStatusFilter = f.Item1">@f.Item2</button>
                    }
                </div>
                <div class="pt-dir-list">
                    @foreach (var client in FilteredClients)
                    {
                        <button type="button" class="pt-dir-item @(selectedClient?.Id == client.Id ? "on" : "")" @onclick="() => InspectClient(client)">
                            <span class="pt-avatar" style="--c:@AvatarColour(client.User?.FullName)">@Initials(client.User?.FullName)</span>
                            <span class="pt-dir-name">@client.User?.FullName<small>@client.User?.PhoneNumber</small></span>
                            <i class="pt-dot @(client.IsActive ? "" : "off")" title="@(client.IsActive ? "Active" : "Inactive")"></i>
                        </button>
                    }
                    @if (!FilteredClients.Any()) { <p class="pt-ov-empty">No clients match.</p> }
                </div>
            </div>
            <div class="pt-stack">
                @if (selectedClient == null)
                {
                    <div class="pt-card pt-empty-detail"><h3>Select a client</h3><p>Pick someone from the list to see their weight trend, fees, measurements and treatment history.</p></div>
                }
                else
                {
                    var latestKg = selectedClientLogs.FirstOrDefault()?.Weight;
                    var lostKg = latestKg.HasValue ? selectedClient.StartWeight - latestKg.Value : 0;
                    var planKg = selectedClient.StartWeight - selectedClient.TargetWeight;
                    var goalPct = planKg > 0 ? (int)Math.Clamp(lostKg / planKg * 100, 0, 100) : 0;
                    <div class="pt-card">
                        <div class="pt-profile-head">
                            <span class="pt-avatar pt-avatar--lg" style="--c:@AvatarColour(selectedClient.User?.FullName)">@Initials(selectedClient.User?.FullName)</span>
                            <div class="pt-profile-id">
                                <h2>@selectedClient.User?.FullName</h2>
                                <span>@selectedClient.User?.Email · @selectedClient.User?.PhoneNumber</span>
                            </div>
                            <div class="pt-row-actions">
                                <button type="button" class="pt-btn pt-btn--sm" @onclick="() => StartEditUser(selectedClient)">Edit user</button>
                                <a class="pt-btn pt-btn--sm" target="_blank" rel="noopener" href='@ClinicService.BuildWhatsAppLink(selectedClient.User?.PhoneNumber ?? "", $"Hello {selectedClient.User?.FullName}, this is ProTouch Physio - Slimming Clinic.")'>WhatsApp</a>
                                <button type="button" class="pt-btn pt-btn--sm pt-btn--dng" @onclick="ConfirmDeleteClient">Delete</button>
                            </div>
                        </div>
                        @if (showDeleteConfirm)
                        {
                            <div class="clinic-alert clinic-alert-danger" role="alert">
                                <div>
                                    <strong>Delete @selectedClient.User?.FullName?</strong><br />
                                    This permanently deletes <strong>@selectedClientLogs.Count</strong> daily logs, <strong>@selectedClientVisits.Count</strong> visit records, <strong>@selectedClientAppts.Count</strong> appointments and <strong>@selectedClientPayments.Count</strong> payment records. It cannot be undone.
                                </div>
                                <div class="pt-form-actions">
                                    <button type="button" class="pt-btn pt-btn--dng" @onclick="ExecuteDeleteClient">Yes, delete permanently</button>
                                    <button type="button" class="pt-btn" @onclick="() => showDeleteConfirm = false">Cancel</button>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(deleteClientError)) { <div class="clinic-alert clinic-alert-danger" role="alert">@deleteClientError</div> }
                    </div>
                    <div class="pt-kpis pt-kpis--4">
                        <div class="pt-kpi"><b>@selectedClient.StartWeight.ToString("0.#") kg</b><span>Start weight</span></div>
                        <div class="pt-kpi"><b>@(latestKg.HasValue ? latestKg.Value.ToString("0.#") + " kg" : "—")</b><span>Current weight</span></div>
                        <div class="pt-kpi"><b>@selectedClient.TargetWeight.ToString("0.#") kg</b><span>Target</span></div>
                        <div class="pt-kpi pt-kpi--ok"><b>@goalPct%</b><span>Goal reached</span></div>
                    </div>
                    <div class="pt-grid2 pt-grid2--top">
                        <div class="pt-card">
                            <div class="pt-card-head"><h3>Weight trend</h3><span class="pt-ov-pill">last @Math.Min(selectedClientLogs.Count, 12) logs</span></div>
                            @if (selectedClientLogs.Count < 2) { <p class="pt-ov-empty">Needs at least two weight logs to draw a trend.</p> }
                            else { @WeightTrendChart(selectedClientLogs.Take(12).OrderBy(x => x.LogDate).ToList(), selectedClient.TargetWeight) }
                        </div>
                        <div class="pt-card">
                            <div class="pt-card-head"><h3>Fees</h3><span class="pt-ov-status pt-ov-status--@(selectedClientPayments.Any(x => !x.IsPaid) ? "wait" : "ok")">@selectedClientPayments.Count(x => !x.IsPaid) pending</span></div>
                            <div class="pt-inline-form">
