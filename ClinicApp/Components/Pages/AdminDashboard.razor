    // WhatsApp
    private async Task ReadCsvRecipients(InputFileChangeEventArgs e)
    {
        using var reader = new StreamReader(e.File.OpenReadStream(2 * 1024 * 1024));
        var lines = (await reader.ReadToEndAsync()).Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries);
        csvRecipients = lines.Skip(1).Select(line => line.Split(',')).Where(parts => parts.Length >= 2)
            .Select(parts => new CsvRecipient(parts[0].Trim().Trim('"'), parts[1].Trim().Trim('"')))
            .Where(x => !string.IsNullOrWhiteSpace(x.Phone)).ToList();
        campaignSuccessMsg = csvRecipients.Any() ? $"Loaded {csvRecipients.Count} CSV recipients." : "No valid recipients found. Use Name,Phone headings.";
        campaignPreviews = new();
    }

