@page "/admin-dashboard"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using ClinicApp.Data
@using ClinicApp.Services
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject ClinicService ClinicService
@inject DietPlanDocumentService DietPlanDocuments
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager
@inject ILogger<AdminDashboard> _logger

<PageTitle>PROTOUCH | Admin Control Center</PageTitle>

<div class="container-fluid py-4 admin-shell">
    <!-- OVERVIEW TAB -->
    @if (activeTab == "overview")
    {
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="clinic-alert clinic-alert-danger mb-4">
                <div><strong>Error:</strong> @errorMessage</div>
                <button class="btn-clinic-secondary ms-auto" @onclick="LoadAdminDataAsync">Retry</button>
            </div>
        }

        <!-- Page title + quick actions -->
        <div class="pt-ov-head">
            <div>
                <h1 class="pt-ov-title">Overview</h1>
                <span class="pt-ov-sub">@TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, GetIst()).ToString("dddd, dd MMMM yyyy")</span>
            </div>
            <div class="pt-ov-actions">
                <button type="button" class="pt-ov-act pt-ov-act--primary" @onclick='() => NavigateToTab("add")'>
                    <svg class="pt-i" aria-hidden="true"><use href="#pt-ico-user-plus"></use></svg>Add client
                </button>
                <button type="button" class="pt-ov-act" @onclick='() => NavigateToTab("visits")'>
                    <svg class="pt-i" aria-hidden="true"><use href="#pt-ico-pulse"></use></svg>Log a visit
                </button>
                <button type="button" class="pt-ov-act" @onclick='() => NavigateToTab("bookings")'>
                    <svg class="pt-i" aria-hidden="true"><use href="#pt-ico-cal"></use></svg>Bookings
                </button>
                <button type="button" class="pt-ov-act" @onclick='() => NavigateToTab("whatsapp")'>
                    <svg class="pt-i" aria-hidden="true"><use href="#pt-ico-chat"></use></svg>WhatsApp
                </button>
                <button type="button" class="pt-ov-act pt-ov-act--icon" title="Refresh" aria-label="Refresh" @onclick="LoadAdminDataAsync">
                    <svg class="pt-i" aria-hidden="true"><use href="#pt-ico-refresh"></use></svg>
                </button>
            </div>
        </div>

        <!-- Stat tiles -->
        <div class="pt-ov-stats">
            @foreach (var card in BuildStatCards())
            {
                <button type="button" class="pt-card pt-ov-stat" style="--c: @card.AccentColour"
                        @onclick='() => NavigateToTab(card.TabTarget)'>
                    <span class="pt-ov-stat-icon"><svg class="pt-i" aria-hidden="true"><use href="#pt-ico-@card.Icon"></use></svg></span>
                    <span class="pt-ov-stat-value">@card.Value</span>
                    <span class="pt-ov-stat-label">@card.Label</span>
                </button>
            }
        </div>

        <!-- Graphs -->
        var visitDays = VisitsByDay(14);
        var apptStatus = AppointmentStatusCounts();
        var apptTotal = apptStatus.Sum(x => x.Count);
        var topTreatments = TopTreatments(5);
        var bookingStatus = BookingStatusCounts();
        <div class="pt-ov-charts">
            <div class="pt-card pt-ov-chart pt-ov-chart--wide">
                <div class="pt-ov-card-head">
                    <h3>Visits, last 14 days</h3>
                    <span class="pt-ov-pill">@visitDays.Sum(x => x.Value) total</span>
                </div>
                @if (visitDays.Sum(x => x.Value) == 0)
                {
                    <p class="pt-ov-empty">No visits logged in the last 14 days.</p>
                }
                else
                {
                    @BarChart(visitDays, "#008d36")
                }
            </div>

            <div class="pt-card pt-ov-chart">
                <div class="pt-ov-card-head">
                    <h3>Appointments this month</h3>
                    <span class="pt-ov-pill">@apptTotal total</span>
                </div>
                @if (apptTotal == 0)
                {
                    <p class="pt-ov-empty">No appointments this month.</p>
                }
                else
                {
                    <div class="pt-ov-donut-wrap">
                        @Donut(apptStatus, apptTotal)
                        <ul class="pt-ov-legend">
                            @foreach (var seg in apptStatus)
                            {
                                <li><i style="background:@seg.Colour"></i><span>@seg.Label</span><b>@seg.Count</b></li>
                            }
                        </ul>
                    </div>
                }
            </div>

            <div class="pt-card pt-ov-chart">
                <div class="pt-ov-card-head">
                    <h3>Popular treatments</h3>
                    <span class="pt-ov-pill">this month</span>
                </div>
                @if (!topTreatments.Any())
                {
                    <p class="pt-ov-empty">No treatments booked this month.</p>
                }
                else
                {
                    <ul class="pt-ov-hbars">
                        @foreach (var t in topTreatments)
                        {
                            <li>
                                <div class="pt-ov-hbar-top"><span>@t.Label</span><b>@t.Count</b></div>
                                <div class="pt-ov-hbar-track"><div class="pt-ov-hbar-fill" style="width:@(topTreatments.Max(x => x.Count) == 0 ? 0 : (int)Math.Round(100.0 * t.Count / topTreatments.Max(x => x.Count)))%"></div></div>
                            </li>
                        }
                    </ul>
                }
            </div>

            <div class="pt-card pt-ov-chart">
                <div class="pt-ov-card-head">
                    <h3>Booking requests</h3>
                    <span class="pt-ov-pill">@bookingStatus.Sum(x => x.Count) total</span>
                </div>
                @if (!bookingStatus.Any())
                {
                    <p class="pt-ov-empty">No booking requests yet.</p>
                }
                else
                {
                    <ul class="pt-ov-hbars">
                        @foreach (var b in bookingStatus)
                        {
                            <li>
                                <div class="pt-ov-hbar-top"><span>@b.Label</span><b>@b.Count</b></div>
                                <div class="pt-ov-hbar-track"><div class="pt-ov-hbar-fill" style="background:@b.Colour;width:@(bookingStatus.Max(x => x.Count) == 0 ? 0 : (int)Math.Round(100.0 * b.Count / bookingStatus.Max(x => x.Count)))%"></div></div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

        <!-- Appointments + activity -->
        <div class="pt-ov-cols">
            <div class="pt-card pt-ov-panel">
                <div class="pt-ov-card-head">
                    <h3>Today's appointments</h3>
                    <span class="pt-ov-pill">@todayAppointments.Count scheduled</span>
                </div>
                @if (!todayAppointments.Any())
                {
                    <p class="pt-ov-empty">No appointments today.</p>
                }
                else
                {
                    <ul class="pt-ov-list">
                        @foreach (var appt in todayAppointments)
                        {
                            <li>
                                <span class="pt-ov-time">@TimeZoneInfo.ConvertTimeFromUtc(appt.AppointmentDate, GetIst()).ToString("h:mm tt")</span>
                                <div class="pt-ov-who">@(appt.User?.FullName ?? "—")<small>@appt.TreatmentType</small></div>
                                <span class="pt-ov-status pt-ov-status--@StatusClass(appt.Status)">@appt.Status</span>
                            </li>
                        }
                    </ul>
                }
            </div>

            <div class="pt-card pt-ov-panel">
                <div class="pt-ov-card-head"><h3>Recent activity</h3></div>
                @if (!recentActivity.Any())
                {
                    <p class="pt-ov-empty">No recent activity.</p>
                }
                else
                {
                    <ul class="pt-ov-feed">
                        @foreach (var item in recentActivity)
                        {
                            <li>
                                <i style="background:@(item.Kind == "booking" ? "#b58900" : "#008d36")"></i>
                                <div>@item.Title<small>@item.SubText</small></div>
                                <time>@TimeAgo(item.Timestamp)</time>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    }

    <!-- ADD USER TAB -->
    @if (activeTab == "add")
    {
        <div class="row g-4">
            <div class="col-xl-8">
                <div class="pt-card p-4">
                    <div class="section-heading"><div><span class="eyebrow">USER ACCESS</span><h3>@(editingUserId == null ? "Add user & assign role" : "Edit existing user")</h3></div>
                    @if (editingUserId != null) { <button class="btn-clinic-secondary" @onclick="CancelEditUser">Cancel edit</button> }
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6"><label class="clinic-label">Full name</label><input class="clinic-input" @bind="newName" /></div>
                        <div class="col-md-6"><label class="clinic-label">Role</label><select class="clinic-input" @bind="newRole" disabled="@(editingUserId != null)"><option>Client</option><option>Admin</option></select></div>
                        <div class="col-md-6"><label class="clinic-label">Email / username</label><input class="clinic-input" type="email" @bind="newEmail" disabled="@(editingUserId != null)" /></div>
                        <div class="col-md-6"><label class="clinic-label">WhatsApp number</label><input class="clinic-input" @bind="newPhone" /></div>
                        @if (newRole == "Client" && editingUserId == null) {
                            <div class="col-md-4"><label class="clinic-label">Starting weight (kg)</label><input class="clinic-input" type="number" @bind="newStartWeight" /></div>
                            <div class="col-md-4"><label class="clinic-label">Target weight (kg)</label><input class="clinic-input" type="number" @bind="newTargetWeight" /></div>
                            <div class="col-md-4"><label class="clinic-label">Height (cm)</label><input class="clinic-input" type="number" @bind="newHeight" /></div>
                        }
                        <div class="col-12"><label class="clinic-label">Clinical / staff notes</label><textarea class="clinic-input" rows="3" @bind="newNotes"></textarea></div>
                    </div>
                    @if (editingUserId == null) {
                        <button class="btn-clinic mt-3" @onclick="CreateUser" disabled="@creatingUser">@(creatingUser ? "Creating..." : "Create user")</button>
                    } else {
                        <button class="btn-clinic mt-3" @onclick="SaveEditUser" disabled="@creatingUser">@(creatingUser ? "Saving..." : "Save changes")</button>
                    }
                    @if (!string.IsNullOrWhiteSpace(createUserMessage)) { <div class="clinic-alert @(createUserSuccess ? "clinic-alert-info" : "clinic-alert-danger") mt-3">@createUserMessage</div> }
                </div>
            </div>
            <div class="col-xl-4">
                <div class="pt-card p-4 h-100">
                    <span class="eyebrow">ACCESS POLICY</span><h3>Roles are explicit</h3>
                    <p class="text-secondary">Admins manage clinic records. Clients can access only their own portal for logs, booking and guidance.</p>
                    @if (!string.IsNullOrWhiteSpace(lastCreatedEmail)) {
                        <div class="credential-row"><span>Login</span><strong>@lastCreatedEmail</strong></div>
                        <div class="credential-row"><span>Temporary password</span><strong>@lastCreatedPassword</strong></div>
                        @if (!string.IsNullOrWhiteSpace(lastCredentialWhatsAppLink)) { <a class="btn-clinic mt-3" target="_blank" href="@lastCredentialWhatsAppLink">Send credentials via WhatsApp</a> }
                        else { <span class="text-secondary small mt-3 d-block">No phone number provided — share credentials manually.</span> }
                    }
                </div>
            </div>
        </div>
    }
    else if (activeTab == "visits")
    {
        <div class="pt-card p-4">
            <div class="section-heading"><div><span class="eyebrow">TREATMENT REGISTER</span><h3>Log a visit</h3></div><span class="soft-pill">@todayAttendanceCount today</span></div>
            <div class="row g-3 mb-4">
                <div class="col-md-4"><label class="clinic-label">Client</label><select class="clinic-input" @bind="visitUserId"><option value="">Select client</option>@foreach (var c in clients) { <option value="@c.UserId">@c.User?.FullName</option> }</select></div>
                <div class="col-md-4"><label class="clinic-label">Visit date & time</label><input class="clinic-input" type="datetime-local" @bind="visitDate" /></div>
                <div class="col-md-4"><label class="clinic-label">Treatment given</label><select class="clinic-input" @bind="visitTreatment"><option>Physiotherapy</option><option>Skin Consultation</option><option>Diet Review</option><option>Slimming Therapy</option><option>Wellness Consultation</option></select></div>
                <div class="col-md-4"><label class="clinic-label">Doctor / practitioner</label><input class="clinic-input" @bind="visitPractitioner" /></div>
                <div class="col-md-4"><label class="clinic-label">Next appointment</label><input class="clinic-input" type="datetime-local" @bind="nextAppointmentDate" /></div>
                <div class="col-md-4"><label class="clinic-label">Notes</label><input class="clinic-input" @bind="visitNotes" placeholder="Treatment response / instructions" /></div>
            </div>
            <button class="btn-clinic mb-4" @onclick="SaveVisit" disabled="@string.IsNullOrWhiteSpace(visitUserId)">Save visit</button>
            @if (!string.IsNullOrWhiteSpace(visitSaveMsg)) { <div class="clinic-alert clinic-alert-info mb-3">@visitSaveMsg</div> }
            <h4 class="mb-3">Service history</h4>
            @foreach (var visit in attendanceLogs.Take(50))
            {
                @if (editingVisitId == visit.Id)
                {
                    <div class="pt-card p-3 mb-3 border-0" style="background: rgba(0,242,254,0.03);">
                        <div class="row g-2">
                            <div class="col-md-4"><label class="clinic-label">Treatment</label><input class="clinic-input" @bind="editVisit.TreatmentReceived" /></div>
                            <div class="col-md-4"><label class="clinic-label">Therapist</label><input class="clinic-input" @bind="editVisit.Therapist" /></div>
                            <div class="col-md-4"><label class="clinic-label">Status</label><select class="clinic-input" @bind="editVisit.Status"><option>Checked In</option><option>Completed</option><option>Absent</option></select></div>
                            <div class="col-md-4"><label class="clinic-label">Checkout time</label><input class="clinic-input" type="datetime-local" @bind="editVisitCheckout" /></div>
                            <div class="col-md-4"><label class="clinic-label">Next appointment</label><input class="clinic-input" type="datetime-local" @bind="editVisitNextAppt" /></div>
                            <div class="col-12"><label class="clinic-label">Notes</label><textarea class="clinic-input" rows="2" @bind="editVisit.Notes" maxlength="2000"></textarea></div>
                        </div>
                        <div class="d-flex gap-2 mt-2">
                            <button class="btn-clinic" @onclick="SaveEditVisit">Save</button>
                            <button class="btn-clinic-secondary" @onclick="CancelEditVisit">Cancel</button>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(visitEditError)) { <div class="clinic-alert clinic-alert-danger mt-2">@visitEditError</div> }
                    </div>
                }
                else
                {
                    <div class="message-row">
                        <div><strong>@visit.User?.FullName</strong><div class="text-secondary small">@visit.TreatmentReceived • @visit.Therapist</div><div class="text-muted small">@visit.CheckInTime.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt") • Next: @(visit.NextAppointmentDate?.ToLocalTime().ToString("dd MMM yyyy") ?? "Not set")</div>@if (!string.IsNullOrWhiteSpace(visit.Notes)) { <div class="text-secondary small mt-1">@visit.Notes</div> }</div>
                        <div class="d-flex gap-2 align-items-center flex-wrap">
                            <span class="soft-pill">@visit.Status</span>
                            @if (visit.Status == "Checked In") { <button class="btn-clinic-secondary" @onclick="() => CheckoutVisit(visit)">Check out</button> }
                            <button class="btn-clinic-secondary" @onclick="() => StartEditVisit(visit)">Edit</button>
                            <button class="btn-clinic-danger" @onclick="() => ConfirmDeleteVisit(visit)">Delete</button>
                        </div>
                    </div>
                }
            }
            @if (deleteVisitConfirm != null)
            {
                <div class="clinic-alert clinic-alert-danger mt-3">
                    Delete visit by <strong>@deleteVisitConfirm.User?.FullName</strong> on <strong>@deleteVisitConfirm.CheckInTime.ToLocalTime().ToString("dd MMM yyyy")</strong>?
                    <div class="d-flex gap-2 mt-2">
                        <button class="btn-clinic-danger" @onclick="ExecuteDeleteVisit">Yes, delete</button>
                        <button class="btn-clinic-secondary" @onclick="() => deleteVisitConfirm = null">Cancel</button>
                    </div>
                </div>
            }
        </div>
    }
    else if (activeTab == "appointments")
    {
        <div class="pt-card p-4">
            <div class="section-heading"><div><span class="eyebrow">APPOINTMENTS</span><h3>All Appointments</h3></div></div>
            @if (!allAppointments.Any()) { <div class="empty-state">No appointments found.</div> }
            else {
                <div class="clinic-table-container">
                    <table class="clinic-table">
                        <thead><tr><th>Client</th><th>Treatment</th><th>Date</th><th>Status</th><th></th><th>Reminder</th></tr></thead>
                        <tbody>
                            @foreach (var appt in allAppointments)
                            {
                                <tr>
                                    <td>@appt.User?.FullName</td>
                                    <td>@appt.TreatmentType</td>
                                    <td>@appt.AppointmentDate.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td>
                                    <td>
                                        <select class="clinic-input" style="width:auto;" value="@appt.Status" @onchange="(e) => UpdateApptStatus(appt.Id, e.Value?.ToString() ?? appt.Status)">
                                            <option>Scheduled</option><option>Confirmed</option><option>Completed</option><option>Cancelled</option>
                                        </select>
                                    </td>
                                    <td>@if (apptUpdateError.ContainsKey(appt.Id)) { <span class="text-danger small">@apptUpdateError[appt.Id]</span> }</td>
                                    <td>
                                        @if (remindersSent.Contains(appt.Id))
                                        {
                                            <span class="soft-pill">Reminder Sent ✓</span>
                                        }
                                        else if (string.IsNullOrWhiteSpace(appt.User?.PhoneNumber))
                                        {
                                            <span class="text-muted small">No phone</span>
                                        }
                                        else
                                        {
                                            <button class="btn-clinic-secondary" @onclick="() => SendReminderManually(appt)">Send Reminder</button>
                                        }
                                        @if (reminderErrors.ContainsKey(appt.Id))
                                        {
                                            <div class="clinic-alert clinic-alert-danger mt-1 small">@reminderErrors[appt.Id]</div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
    else if (activeTab == "mealreview")
    {
        <div class="pt-card p-4">
            <div class="section-heading"><div><span class="eyebrow">MEAL REVIEW</span><h3>Client Meal Photos</h3></div><span class="soft-pill">Page @mealPage</span></div>
            @if (!mealLogs.Any()) { <div class="empty-state">No meal photos uploaded yet.</div> }
            else {
                <div class="row g-3">
                    @foreach (var log in mealLogs)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="pt-card p-3 h-100">
                                <div class="d-flex gap-3 mb-2">
                                    @if (!string.IsNullOrWhiteSpace(log.MealPhotoUrl)) { <img src="@log.MealPhotoUrl" class="meal-thumb" alt="Meal" /> }
                                    <div><strong>@log.User?.FullName</strong><div class="text-secondary small">@log.LogDate.ToString("dd MMM yyyy")</div></div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(log.DietNotes)) { <p class="text-secondary small mb-2">@log.DietNotes</p> }
                                <!-- Macro Bar -->
                                <div class="macro-bar mb-2">
                                    <div class="seg-carbs" style="width: @log.CarbsPercentage%"></div>
                                    <div class="seg-protein" style="width: @log.ProteinPercentage%"></div>
                                    <div class="seg-fat" style="width: @log.FatPercentage%"></div>
                                    <div class="seg-veg" style="width: @log.VegPercentage%"></div>
                                </div>
                                <div class="text-muted small mb-2">C:@log.CarbsPercentage% P:@log.ProteinPercentage% F:@log.FatPercentage% V:@log.VegPercentage%</div>
                                <button class="btn-clinic-danger" @onclick="() => DeleteMealLog(log.Id)">Delete</button>
                                @if (mealDeleteErrors.ContainsKey(log.Id)) { <div class="clinic-alert clinic-alert-danger mt-1 small">@mealDeleteErrors[log.Id]</div> }
                            </div>
                        </div>
                    }
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button class="btn-clinic-secondary" @onclick="PrevMealPage" disabled="@(mealPage <= 1)">← Previous</button>
                    <button class="btn-clinic-secondary" @onclick="NextMealPage" disabled="@(mealLogs.Count < 20)">Next →</button>
                </div>
            }
        </div>
    }
    else if (activeTab == "bookings")
    {
        <div class="pt-card p-4">
            <div class="section-heading"><div><span class="eyebrow">BOOKING REQUESTS</span><h3>All Booking Requests</h3></div><span class="soft-pill">@pendingBookingsCount pending</span></div>
            @if (!allBookings.Any()) { <div class="empty-state">No booking requests yet. They will appear here after visitors submit the /book form.</div> }
            else {
                <div class="clinic-table-container">
                    <table class="clinic-table">
                        <thead><tr><th>Name</th><th>Phone</th><th>Service</th><th>Preferred Date</th><th>Notes</th><th>Status</th><th>Actions</th></tr></thead>
                        <tbody>
                            @foreach (var booking in allBookings)
                            {
                                <tr>
                                    <td><strong>@booking.FullName</strong><div class="text-muted small">@booking.SubmittedAt.ToLocalTime().ToString("dd MMM, hh:mm tt")</div></td>
                                    <td>@booking.PhoneNumber</td>
                                    <td>@booking.ServiceType</td>
                                    <td>@booking.PreferredDate.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td>
                                    <td style="max-width: 200px; white-space: normal;">@booking.Notes</td>
                                    <td>
                                        <span class="soft-pill @(booking.Status == "Pending" ? "badge-pending" : booking.Status == "Confirmed" ? "badge-active" : "badge-danger")">@booking.Status</span>
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2 flex-wrap">
                                            @if (booking.Status == "Pending")
                                            {
                                                <button class="btn-clinic" @onclick="() => ConfirmBooking(booking.Id)">Confirm</button>
                                                <button class="btn-clinic-danger" @onclick="() => CancelBooking(booking.Id)">Cancel</button>
                                            }
                                            else if (booking.Status == "Confirmed")
                                            {
                                                <button class="btn-clinic-danger" @onclick="() => CancelBooking(booking.Id)">Cancel</button>
                                            }
                                            @{
                                                var waLink = string.IsNullOrWhiteSpace(booking.PhoneNumber) ? "" : ClinicService.BuildWhatsAppLink(booking.PhoneNumber, $"Hello {booking.FullName}, this is ProTouch Physio - Slimming Clinic regarding your booking for {booking.ServiceType}.");
                                            }
                                            @if (!string.IsNullOrWhiteSpace(waLink)) { <a class="btn-clinic-secondary" target="_blank" href="@waLink">WhatsApp</a> }
                                            else { <span class="text-muted small">Phone missing/invalid</span> }
                                        </div>
                                        @if (bookingUpdateErrors.ContainsKey(booking.Id)) { <div class="clinic-alert clinic-alert-danger mt-1 small">@bookingUpdateErrors[booking.Id]</div> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
    else if (activeTab == "whatsapp")
    {        <!-- Task 11.1: Template approval notice banner -->
        <div class="clinic-alert clinic-alert-info mb-4">
            <div>
                <strong>ℹ️ WhatsApp Template Requirement:</strong> Twilio requires pre-approved message templates for WhatsApp Business messaging.
                Ensure your templates are approved in the <a href="https://console.twilio.com" target="_blank" rel="noopener" style="color: var(--accent-teal);">Twilio Console</a> before sending bulk campaigns.
            </div>
        </div>
        <div class="row g-4">
            <div class="col-xl-5">
                <div class="pt-card p-4">
                    <span class="eyebrow">CSV BROADCAST</span><h3>Bulk WhatsApp Campaign</h3>
                    <p class="text-secondary small">Upload a CSV with <strong>Name</strong> and <strong>Phone</strong> columns. Use <code>{{Name}}</code> in your message to personalise it.</p>
                    <label class="clinic-label">CSV recipients</label>
                    <InputFile class="clinic-input mb-3" accept=".csv,text/csv" OnChange="ReadCsvRecipients" />
                    <label class="clinic-label">Message template</label>
                    <textarea class="clinic-input" rows="7" @bind="campaignText"></textarea>
                    <!-- Task 11.3: Progress bar -->
                    @if (sendingCampaign)
                    {
                        <div class="mt-3">
                            <div class="progress mb-1"><div class="progress-bar" style="width: @(campaignTotal > 0 ? (int)((double)campaignSent / campaignTotal * 100) : 0)%"></div></div>
                            <span class="text-secondary small">Sent: @campaignSent / @campaignTotal @(campaignFailed > 0 ? $"• Failed: {campaignFailed}" : "")</span>
                        </div>
                    }
                    <div class="d-flex gap-2 mt-3 flex-wrap">
                        <button class="btn-clinic" @onclick="SendCsvCampaign" disabled="@(!csvRecipients.Any() || sendingCampaign)">@(sendingCampaign ? "Sending..." : "Send Bulk Campaign")</button>
                        <!-- Task 11.2: Preview button -->
                        <button class="btn-clinic-secondary" @onclick="PreviewCsvCampaign" disabled="@(!csvRecipients.Any() || sendingCampaign)">Preview</button>
                        <button class="btn-clinic-secondary" @onclick="UseDietTemplate">Diet template</button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(campaignSuccessMsg)) { <div class="clinic-alert clinic-alert-info mt-3">@campaignSuccessMsg</div> }
                </div>
            </div>
            <div class="col-xl-7">
                <!-- Task 11.2: Preview panel -->
                @if (campaignPreviews.Any())
                {
                    <div class="pt-card p-4 mb-4" style="max-height: 400px; overflow-y: auto;">
                        <div class="section-heading"><div><span class="eyebrow">MESSAGE PREVIEW</span><h3>@campaignPreviews.Count personalised messages</h3></div></div>
                        @foreach (var preview in campaignPreviews.Take(500))
                        {
                            <div class="message-row"><div><strong>@preview.RecipientName</strong><div class="text-secondary small">@preview.RecipientPhone</div><div class="text-muted small" style="white-space: pre-wrap; font-size: 0.8rem;">@preview.PersonalisedMessage</div></div></div>
                        }
                    </div>
                }
                <div class="pt-card p-4">
                    <div class="section-heading"><div><span class="eyebrow">RECIPIENT PREVIEW</span><h3>@csvRecipients.Count CSV recipients</h3></div></div>
                    @if (!csvRecipients.Any()) { <div class="empty-state">Choose a CSV file to preview recipients.</div> }
                    else { @foreach (var recipient in csvRecipients.Take(30)) { <div class="message-row"><div><strong>@recipient.Name</strong><div class="text-secondary small">@recipient.Phone</div></div><span class="soft-pill">Ready</span></div> } }
                </div>
                <div class="pt-card p-4 mt-4">
                    <h4>Recent activity</h4>
                    @foreach (var log in whatsappLogs.Take(8)) {
                        <!-- Task 11.4: Parse LogDetail for per-recipient status -->
                        <div class="activity-row">
                            <div><strong>@log.TargetAudience</strong><div class="text-secondary small">@log.MessageTemplate</div></div>
                            <div class="d-flex flex-wrap gap-1 align-items-center">
                                <span class="soft-pill">@log.Status • @log.RecipientCount</span>
                                @{
                                    var badges = WhatsAppLogHelper.GetLogDetailBadges(log.LogDetail);
                                    var extraCount = badges.Count > 5 ? badges.Count - 5 : 0;
                                }
                                @foreach (var b in badges.Take(5))
                                {
                                    <span class="badge-clinic @b.Css" style="font-size: 0.65rem;">@b.Label</span>
                                }
                                @if (extraCount > 0)
                                {
                                    <span class="text-muted small">+@extraCount more</span>
                                }
                                @if (badges.Count == 0)
                                {
                                    <span class="text-muted small">No detail available</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else if (activeTab == "feedback")
    {
        <div class="pt-card p-4">
            <div class="section-heading">
                <div><span class="eyebrow">PATIENT FEEDBACK</span><h3>Feedback Management</h3></div>
            </div>

            <!-- Summary stats -->
            @if (_feedbackList.Any())
            {
                <div class="pt-feedback-stats d-flex flex-wrap gap-3 mb-4">
                    <span class="soft-pill">Total: <strong>@_feedbackTotal</strong></span>
                    <span class="soft-pill">Average: <strong>@_feedbackAvgRating ★</strong></span>
                    @foreach (var r in Enumerable.Range(1, 5))
                    {
                        <span class="soft-pill">@r★: <strong>@_feedbackPerStar[r]</strong></span>
                    }
                </div>
            }

            <!-- Star filter -->
            <div class="mb-3">
                <label class="clinic-label">Filter by star rating</label>
                <select class="clinic-input" style="width:auto;"
                        value="@(_feedbackStarFilter?.ToString() ?? "")"
                        @onchange="(e) => _feedbackStarFilter = string.IsNullOrEmpty(e.Value?.ToString()) ? (int?)null : int.Parse(e.Value.ToString()!)">
                    <option value="">All</option>
                    @foreach (var r in Enumerable.Range(1, 5))
                    {
                        <option value="@r">@r ★</option>
                    }
                </select>
            </div>

            @if (!_feedbackList.Any())
            {
                <div class="empty-state">No feedback submitted yet.</div>
            }
            else
            {
                <div class="clinic-table-container">
                    <table class="clinic-table">
                        <thead>
                            <tr>
                                <th>Date / Time (IST)</th>
                                <th>Rating</th>
                                <th>Comment</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in FilteredFeedback)
                            {
                                <tr>
                                    <td>@TimeZoneInfo.ConvertTimeFromUtc(f.SubmittedAt, GetIst()).ToString("dd MMM yyyy, hh:mm tt")</td>
                                    <td>@(new string('★', f.Rating))</td>
                                    <td>
                                        @if (f.Comment?.Length > 100 && !_feedbackExpandedIds.Contains(f.Id))
                                        {
                                            @f.Comment[..100]<text>… </text>
                                            <button type="button" class="btn-link" @onclick="() => ToggleFeedbackExpand(f.Id)">Show more</button>
                                        }
                                        else if (f.Comment?.Length > 100 && _feedbackExpandedIds.Contains(f.Id))
                                        {
                                            @f.Comment
                                            <button type="button" class="btn-link" @onclick="() => ToggleFeedbackExpand(f.Id)">Show less</button>
                                        }
                                        else
                                        {
                                            @f.Comment
                                        }
                                    </td>
                                    <td>
                                        @if (_feedbackDeleteId == f.Id)
                                        {
                                            <span>Confirm? </span>
                                            <button class="btn btn-danger btn-sm" @onclick="() => ConfirmDeleteFeedback(f.Id)">Yes</button>
                                            <button class="btn btn-sm btn-clinic-secondary" @onclick="() => _feedbackDeleteId = null">No</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-outline-danger btn-sm" @onclick="() => _feedbackDeleteId = f.Id">Delete</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
    else if (activeTab == "settings")
    {
        <div class="pt-card p-4">
            <div class="section-heading"><div><span class="eyebrow">CONFIGURATION</span><h3>WhatsApp Settings</h3></div></div>
            <div class="mb-4">
                <label class="clinic-label">WhatsApp Mode</label>
                <div class="d-flex gap-2">
                    <button class="btn @(settingsMode == "Mock" ? "btn-clinic" : "btn-clinic-secondary")"
                            @onclick='() => settingsMode = "Mock"'>Mock</button>
                    <button class="btn @(settingsMode == "Twilio" ? "btn-clinic" : "btn-clinic-secondary")"
                            @onclick='() => settingsMode = "Twilio"'>Twilio</button>
                </div>
                <p class="text-secondary small mt-1">Mock mode logs messages without sending. Twilio mode sends real WhatsApp messages.</p>
            </div>

            <!-- Credential inputs -->
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="clinic-label">Account SID</label>
                    <input class="clinic-input" type="password" @bind="settingsSid" placeholder="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" />
                </div>
                <div class="col-md-6">
                    <label class="clinic-label">Auth Token</label>
                    <input class="clinic-input" type="password" @bind="settingsToken" placeholder="Your Twilio Auth Token" />
                </div>
                <div class="col-md-6">
                    <label class="clinic-label">From (Twilio WhatsApp Sender)</label>
                    <input class="clinic-input" @bind="settingsFrom" placeholder="whatsapp:+14155238886" />
                </div>
                <div class="col-md-6">
                    <label class="clinic-label">Clinic WhatsApp Number</label>
                    <input class="clinic-input" @bind="settingsClinicNum" placeholder="+919028027888" />
                </div>
            </div>

            <!-- Actions -->
            <div class="d-flex gap-2 flex-wrap mb-3">
                <button class="btn-clinic" @onclick="SaveSettingsAsync">Save</button>
                <button class="btn-clinic-secondary" @onclick="TestTwilioConnectionAsync">Test Connection</button>
            </div>

            <!-- Status messages -->
            @if (!string.IsNullOrWhiteSpace(settingsSaveMsg))
            {
                <div class="clinic-alert @(settingsSaveSuccess ? "clinic-alert-info" : "clinic-alert-danger") mb-3">@settingsSaveMsg</div>
            }
            @if (!string.IsNullOrWhiteSpace(settingsTestMsg))
            {
                <div class="clinic-alert @(settingsTestSuccess ? "clinic-alert-info" : "clinic-alert-danger") mb-3">@settingsTestMsg</div>
            }

            <!-- Twilio Setup Guide (Req 5.3) -->
            <details>
                <summary class="clinic-label" style="cursor:pointer;">📖 Twilio Setup Guide (click to expand)</summary>
                <div class="pt-card p-3 mt-2">
                    <ol class="text-secondary small" style="line-height: 2;">
                        <li>Create a free Twilio account at <a href="https://twilio.com" target="_blank" rel="noopener" style="color: var(--accent-teal);">twilio.com</a></li>
                        <li>From the Twilio Console dashboard, copy your <strong>Account SID</strong> and <strong>Auth Token</strong></li>
                        <li>Go to <strong>Messaging → Senders → WhatsApp Senders</strong> and join the Twilio Sandbox (send the join code from your WhatsApp)</li>
                        <li>Your Twilio WhatsApp sender number is <code>whatsapp:+14155238886</code> (sandbox default)</li>
                        <li>Enter your clinic's WhatsApp number (e.g. <code>+919028027888</code>) in the <strong>Clinic Number</strong> field</li>
                        <li>Set <strong>WhatsApp Mode</strong> to <strong>Twilio</strong> and click Save</li>
                        <li>Send a test reminder from the Appointments tab to verify delivery</li>
                    </ol>
                </div>
            </details>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-xl-4">
                <div class="pt-card p-4 sticky-xl-top" style="top:20px">
                    <div class="section-heading"><div><span class="eyebrow">DIRECTORY</span><h3>Clients</h3></div><button class="btn-icon" @onclick='() => { activeTab = "add"; editingUserId = null; }'>+</button></div>
                    <input class="clinic-input mb-3" placeholder="Search clients..." @bind="searchQuery" @bind:event="oninput" />
                    <div class="client-list">
                        @foreach (var client in FilteredClients) {
                            <button class="client-list-item @(selectedClient?.Id == client.Id ? "selected" : "")" @onclick="() => InspectClient(client)">
                                <span class="avatar-sm">@(client.User?.FullName?.FirstOrDefault() ?? '?')</span>
                                <span class="text-start flex-grow-1"><strong>@client.User?.FullName</strong><small>@client.User?.PhoneNumber</small></span>
                            </button>
                        }
                    </div>
                </div>
            </div>
            <div class="col-xl-8">
                @if (selectedClient == null) {
                    <div class="pt-card p-5 text-center"><h2>Select a client</h2><p class="text-secondary">Select a profile to review treatment history, weight trend, measurements and billing.</p></div>
                } else {
                    <div class="pt-card p-4">
                        <div class="d-flex justify-content-between align-items-center gap-3 mb-4">
                            <div><span class="eyebrow">CLIENT PROFILE</span><h2>@selectedClient.User?.FullName</h2><span class="text-secondary">@selectedClient.User?.Email • @selectedClient.User?.PhoneNumber</span></div>
                            <div class="d-flex gap-2 flex-wrap">
                                <button class="btn-clinic-secondary" @onclick="() => StartEditUser(selectedClient)">Edit user</button>
                                <a class="btn-clinic" target="_blank" href='@ClinicService.BuildWhatsAppLink(selectedClient.User?.PhoneNumber ?? "", $"Hello {selectedClient.User?.FullName}, this is ProTouch Physio - Slimming Clinic.")'>WhatsApp</a>
                                <button class="btn-clinic-danger" @onclick="ConfirmDeleteClient">Delete</button>
                            </div>
                        </div>
                        <!-- Delete confirmation modal (Task 9.2) -->
                        @if (showDeleteConfirm)
                        {
                            <div class="clinic-alert clinic-alert-danger mb-3">
                                <div>
                                    <strong>⚠️ Confirm deletion of @selectedClient.User?.FullName</strong><br />
                                    This will permanently delete:<br />
                                    • <strong>@selectedClientLogs.Count</strong> daily logs<br />
                                    • <strong>@selectedClientVisits.Count</strong> visit records<br />
                                    • <strong>@selectedClientAppts.Count</strong> appointments<br />
                                    • <strong>@selectedClientPayments.Count</strong> payment records<br />
                                    This action cannot be undone.
                                </div>
                                <div class="d-flex gap-2 mt-2">
                                    <button class="btn-clinic-danger" @onclick="ExecuteDeleteClient">Yes, delete permanently</button>
                                    <button class="btn-clinic-secondary" @onclick="() => showDeleteConfirm = false">Cancel</button>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(deleteClientError)) { <div class="clinic-alert clinic-alert-danger mb-3">@deleteClientError</div> }
                        <!-- Task 9.4: Measurement validation -->
                        @if (!string.IsNullOrWhiteSpace(profileMeasurementError)) { <div class="clinic-alert clinic-alert-danger mb-3">@profileMeasurementError</div> }
                        <div class="row g-3">
                            <div class="col-md-4"><label class="clinic-label">Access role</label><select class="clinic-input" @bind="selectedRole"><option>Client</option><option>Admin</option></select></div>
                            <div class="col-md-4">
                                <label class="clinic-label">Height (cm)</label>
                                <input class="clinic-input" type="number" step="0.1" @bind="selectedClient.Height" />
                                @if (heightError != null) { <span class="text-danger small">@heightError</span> }
                            </div>
                            <div class="col-md-4"><label class="clinic-label">Current weight</label><div class="clinic-input readonly">@(selectedClientLogs.FirstOrDefault()?.Weight.ToString("F1") ?? "—") kg</div></div>
                            <div class="col-md-3">
                                <label class="clinic-label">Waist (in)</label><input class="clinic-input" type="number" step="0.1" @bind="selectedClient.WaistInches" />
                                @if (waistError != null) { <span class="text-danger small">@waistError</span> }
                            </div>
                            <div class="col-md-3">
                                <label class="clinic-label">Chest (in)</label><input class="clinic-input" type="number" step="0.1" @bind="selectedClient.ChestInches" />
                                @if (chestError != null) { <span class="text-danger small">@chestError</span> }
                            </div>
                            <div class="col-md-3">
                                <label class="clinic-label">Hips (in)</label><input class="clinic-input" type="number" step="0.1" @bind="selectedClient.HipsInches" />
                                @if (hipsError != null) { <span class="text-danger small">@hipsError</span> }
                            </div>
                            <div class="col-md-3">
                                <label class="clinic-label">Arms (in)</label><input class="clinic-input" type="number" step="0.1" @bind="selectedClient.ArmsInches" />
                                @if (armsError != null) { <span class="text-danger small">@armsError</span> }
                            </div>
                            <div class="col-12"><label class="clinic-label">Doctor / dietician notes</label><textarea class="clinic-input" rows="2" @bind="selectedClient.DoctorNotes"></textarea></div>
                        </div>
                        <div class="d-flex gap-2 mt-3">
                            <button class="btn-clinic" @onclick="SaveClient">Save profile & role</button>
                            <button class="btn-clinic-secondary" @onclick="ToggleClientStatus">@(selectedClient.IsActive ? "Suspend" : "Activate")</button>
                        </div>
                        <div class="row g-4 mt-1">
                            <div class="col-md-6">
                                <div class="pt-card p-3 h-100"><h4>Weight trend</h4>
                                    @if (selectedClientLogs.Any()) { @foreach (var log in selectedClientLogs.Take(7).OrderBy(x => x.LogDate)) { <div class="message-row"><span>@log.LogDate.ToString("dd MMM")</span><strong>@log.Weight.ToString("F1") kg</strong></div> } }
                                    else { <span class="text-secondary">No weight logs yet.</span> }
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="pt-card p-3 h-100">
                                    <div class="d-flex justify-content-between"><h4>Billing</h4><span class="soft-pill">@selectedClientPayments.Count(x => !x.IsPaid) pending</span></div>
                                    <div class="d-flex gap-2 mb-2"><input class="clinic-input" placeholder="Fee description" @bind="newInvoiceDesc" /><input class="clinic-input" type="number" step="0.01" min="1" placeholder="Amount ₹" @bind="newInvoiceAmount" /><button class="btn-clinic" @onclick="CreateClientInvoice">Add</button></div>
                                    @foreach (var invoice in selectedClientPayments) { <div class="message-row"><div><strong>₹@invoice.Amount</strong><div class="text-secondary small">@invoice.Description</div></div>@if (!invoice.IsPaid) { <button class="btn-clinic-secondary btn-sm" @onclick="() => MarkPaid(invoice.Id)">Settle</button> } else { <span class="soft-pill">Paid</span> }</div> }
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="pt-card p-3"><h4>Treatment history</h4>
                                    @if (!selectedClientVisits.Any()) { <span class="text-secondary">No visits recorded yet.</span> }
                                    else { @foreach (var visit in selectedClientVisits.Take(8)) { <div class="message-row"><div><strong>@visit.TreatmentReceived</strong><div class="text-secondary small">@visit.Therapist • @visit.CheckInTime.ToLocalTime().ToString("dd MMM yyyy")</div><div class="text-muted small">@visit.Notes</div></div><span class="soft-pill">@visit.Status</span></div> } }
                                </div>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(profileSaveMsg)) { <div class="text-success small mt-2">@profileSaveMsg</div> }

                        <!-- Diet Plan Panel — Task 9.2, 9.3 -->
                        <div class="mt-3">
                            <button class="btn-clinic-secondary" @onclick="OpenDietPanel">📋 Send Diet Plan</button>
                        </div>

                        @if (showDietPanel && selectedClient != null)
                        {
                            <div class="pt-card p-4 mt-3">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 class="mb-0">Diet Plan for @selectedClientName</h5>
                                    <button class="btn-clinic-secondary" @onclick="CloseDietPanel">✕ Close</button>
                                </div>
                                <div class="mb-3">
                                    <label class="clinic-label">Diet Plan (max 2,000 characters)</label>
                                    <textarea class="clinic-input"
                                              rows="8"
                                              maxlength="2000"
                                              @bind="dietPlanText"
                                              @bind:event="oninput"
                                              placeholder="Enter the personalised diet plan..."></textarea>
                                    <div class="text-end text-muted small mt-1">@dietPlanText.Length / 2000</div>
                                </div>
                                <div class="diet-document-upload mb-3">
                                    <div>
                                        <label class="clinic-label" for="diet-plan-document">Attach a diet plan document</label>
                                        <InputFile id="diet-plan-document"
                                                   OnChange="SelectDietPlanDocument"
                                                   accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                                        <small class="text-secondary d-block mt-1">PDF, DOC, or DOCX · up to 15 MB · shared securely in the client's portal</small>
                                    </div>
                                    @if (selectedDietPlanDocument != null)
                                    {
                                        <span class="soft-pill">@selectedDietPlanDocument.Name</span>
                                    }
                                    @if (currentDietPlanDocument != null)
                                    {
                                        <a class="btn-clinic-secondary btn-sm"
                                           href="/diet-plan-documents/@currentDietPlanDocument.Id/download">
                                            Download current document
                                        </a>
                                    }
                                    <label class="d-flex align-items-center gap-2">
                                        <input type="checkbox"
                                               @bind="sendDocumentViaWhatsApp"
                                               disabled="@(string.IsNullOrWhiteSpace(selectedClientPhone) || selectedDietPlanDocument == null)" />
                                        Send download link via WhatsApp
                                    </label>
                                    <button class="btn-clinic"
                                            @onclick="UploadDietPlanDocumentAsync"
                                            disabled="@(selectedDietPlanDocument == null || uploadingDietPlanDocument)">
                                        @(uploadingDietPlanDocument ? "Uploading..." : "Upload & Share with Client")
                                    </button>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(dietPlanDocumentStatus))
                                {
                                    <div class="clinic-alert @(dietPlanDocumentSuccess ? "clinic-alert-info" : "clinic-alert-danger") mb-3" role="status">
                                        @dietPlanDocumentStatus
                                    </div>
                                }
                                <div class="mb-3 d-flex gap-3 flex-wrap">
                                    <label class="d-flex align-items-center gap-2">
                                        <input type="checkbox"
                                               @bind="sendViaWA"
                                               disabled="@string.IsNullOrWhiteSpace(selectedClientPhone)" />
                                        Send via WhatsApp
                                        @if (string.IsNullOrWhiteSpace(selectedClientPhone))
                                        {
                                            <span class="text-muted small">(No phone on record)</span>
                                        }
                                    </label>
                                    <label class="d-flex align-items-center gap-2">
                                        <input type="checkbox" @bind="saveToProfile" />
                                        Save to client profile
                                    </label>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(dietPlanStatus))
                                {
                                    <div class="clinic-alert @(dietPlanSuccess ? "clinic-alert-info" : "clinic-alert-danger") mb-3">
                                        @dietPlanStatus
                                    </div>
                                }
                                <div class="d-flex gap-2">
                                    <button class="btn-clinic" @onclick="SendDietPlanAsync">Send / Save</button>
                                    <button class="btn-clinic-secondary" @onclick="CloseDietPanel">Cancel</button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>


@code {
    // ── Overview view-model records (task 4.1) ────────────────────────────
    private record ActivityItem(string Title, string SubText, DateTime Timestamp, string Kind);
    private record StatCardModel(string Label, string Value, string Icon, string AccentColour, string Trend, string TabTarget);

    // State
    private List<ClientProfile> clients = new();
    private List<AttendanceRecord> attendanceLogs = new();
    private List<WhatsAppLog> whatsappLogs = new();
    private List<Appointment> allAppointments = new();
    private List<DailyLog> mealLogs = new();
    private List<BookingRequest> allBookings = new();
    private ClientProfile? selectedClient;
    private List<DailyLog> selectedClientLogs = new();
    private List<AttendanceRecord> selectedClientVisits = new();
    private List<Appointment> selectedClientAppts = new();
    private List<PaymentNotification> selectedClientPayments = new();
    private string activeTab = "overview", searchQuery = "", selectedRole = "Client";
    private int todayAttendanceCount, pendingInvoicesCount, pendingBookingsCount;
    private int mealPage = 1;

    // Overview-specific state (task 4.1)
    private string adminName = "Admin";
    private string? errorMessage;
    private List<ActivityItem> recentActivity = new();
    private List<Appointment> todayAppointments = new();

    // Add/Edit user
    private string? editingUserId = null;
    private string newName = "", newEmail = "", newPhone = "", newNotes = "", newRole = "Client", createUserMessage = "";
    private string lastCreatedEmail = "", lastCreatedPassword = "", lastCredentialWhatsAppLink = "";
    private double newStartWeight = 70, newTargetWeight = 65, newHeight = 170;
    private bool creatingUser, createUserSuccess;

    // WhatsApp
    private string campaignText = "Hello {{Name}}, this is ProTouch Physio - Slimming Clinic. Please remember to update your daily weight and diet check today.";
