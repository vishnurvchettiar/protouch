    private void CancelEditUser() { editingUserId = null; newName = newEmail = newPhone = newNotes = ""; newRole = "Client"; }

    private async Task SaveEditUser()
    {
        creatingUser = true;
        try {
            if (string.IsNullOrWhiteSpace(newName)) { createUserMessage = "Full name is required."; createUserSuccess = false; return; }
            var user = await UserManager.FindByIdAsync(editingUserId!);
            if (user == null) { createUserMessage = "User not found."; createUserSuccess = false; return; }
            // Check for email collision on another account
            var existing = await UserManager.FindByEmailAsync(newEmail.Trim());
            if (existing != null && existing.Id != editingUserId) { createUserMessage = "Email already in use by another account."; createUserSuccess = false; return; }
            user.FullName = newName.Trim();
            user.PhoneNumber = newPhone.Trim();
            var result = await UserManager.UpdateAsync(user);
            if (!result.Succeeded) { createUserMessage = string.Join(" ", result.Errors.Select(e => e.Description)); createUserSuccess = false; return; }
            createUserMessage = "User updated successfully."; createUserSuccess = true;
            editingUserId = null;
            await LoadAdminDataAsync();
            if (selectedClient != null) await InspectClient(selectedClient);
        } finally { creatingUser = false; }
    }

    private async Task CreateUser()
    {
        creatingUser = true;
        try {
            if (string.IsNullOrWhiteSpace(newName) || string.IsNullOrWhiteSpace(newEmail)) { createUserMessage = "Name and email are required."; createUserSuccess = false; return; }
            if (await UserManager.FindByEmailAsync(newEmail.Trim()) != null) { createUserMessage = "A user with this email already exists."; createUserSuccess = false; return; }
            var password = $"PT{Random.Shared.Next(100000, 999999)}!a";
            var user = new ApplicationUser { UserName = newEmail.Trim(), Email = newEmail.Trim(), EmailConfirmed = true, FullName = newName.Trim(), PhoneNumber = newPhone.Trim() };
            var result = await UserManager.CreateAsync(user, password);
            if (!result.Succeeded) { createUserMessage = string.Join(" ", result.Errors.Select(x => x.Description)); createUserSuccess = false; return; }
            await UserManager.AddToRoleAsync(user, newRole);
            if (newRole == "Client") {
                await ClinicService.EnsureClientProfileExistsAsync(user.Id, newStartWeight, newTargetWeight, newHeight);
                var profile = await ClinicService.GetClientProfileByUserIdAsync(user.Id);
                if (profile != null) { profile.DoctorNotes = newNotes; await ClinicService.UpdateClientProfileAsync(profile); }
            }
            lastCreatedEmail = user.Email!; lastCreatedPassword = password;
            lastCredentialWhatsAppLink = !string.IsNullOrWhiteSpace(user.PhoneNumber) ? ClinicService.BuildWhatsAppLink(user.PhoneNumber, $"Hello {user.FullName}, your ProTouch login is {user.Email}. Temporary password: {password}") : "";
            createUserMessage = $"{newRole} created successfully."; createUserSuccess = true;
            newName = newEmail = newPhone = newNotes = ""; newRole = "Client"; newStartWeight = 70; newTargetWeight = 65; newHeight = 170;
            await LoadAdminDataAsync();
        } finally { creatingUser = false; }
    }

