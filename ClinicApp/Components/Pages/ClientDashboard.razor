@page "/client-dashboard"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using ClinicApp.Data
@using ClinicApp.Services
@attribute [Authorize(Roles = "Client,Admin")]
@rendermode InteractiveServer

@inject ClinicService ClinicService
@inject FileUploadService FileUploadService
@inject DietPlanDocumentService DietPlanDocuments
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavManager
@inject IWebHostEnvironment Environment

<PageTitle>PROTOUCH Physio - Slimming Clinic | My Portal</PageTitle>

@if (loading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-info" role="status">
            <span class="visually-hidden">Loading Dashboard...</span>
        </div>
        <p class="text-secondary mt-3">Syncing clinical records...</p>
    </div>
}
else if (userProfile == null)
{
    <div class="clinic-alert clinic-alert-danger">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi" viewBox="0 0 16 16">
            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
        </svg>
        <div>
            <strong>Error:</strong> Profile record could not be resolved. Please log in as a registered client.
        </div>
    </div>
}
else
{
    <div class="container-fluid client-dashboard-shell py-3">
    @{
        double kgLost    = userProfile.StartWeight - latestWeight;
        double heroTotal = userProfile.StartWeight - userProfile.TargetWeight;
        int    goalPct   = heroTotal > 0 ? (int)Math.Clamp(kgLost / heroTotal * 100.0, 0.0, 100.0) : 0;
        double toGo      = Math.Max(0, latestWeight - userProfile.TargetWeight);
        var    nextAppt  = GetNextAppointment(appointments);
        string dietPreview = GetDietPreview(userProfile.DietPlan);
        string firstName = (userProfile.User?.FullName ?? currentUser?.FullName ?? "there").Split(' ')[0];
        var week = LoggedLastDays(7);
        int streak = LogStreak();
    }

    @if (activeTab == "overview")
    {
        <!-- ═════════ OVERVIEW (main page) ═════════ -->
        @if (activePaymentAlerts != null && activePaymentAlerts.Any())
        {
            @foreach (var alert in activePaymentAlerts)
            {
                <div class="pt-banner pt-banner--warn" role="alert">
                    <span><strong>Payment due:</strong> @alert.Amount.ToString("C") for "@alert.Description".</span>
                    <button type="button" class="pt-btn pt-btn--sm" @onclick="() => PayInvoice(alert.Id)">Pay invoice (demo)</button>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(paymentSuccessMsg)) { <div class="clinic-alert clinic-alert-info" role="status">@paymentSuccessMsg</div> }
        }

        <section class="pt-cl-hero" aria-label="Your progress">
            <div class="pt-cl-ring" role="img" aria-label="@goalPct percent of your goal">
                <svg viewBox="0 0 100 100">
                    <circle cx="50" cy="50" r="42" fill="none" stroke="rgba(255,255,255,.1)" stroke-width="9" />
                    <circle cx="50" cy="50" r="42" fill="none" stroke="#2fd072" stroke-width="9" stroke-linecap="round"
                            stroke-dasharray="263.9" stroke-dashoffset="@((263.9 * (1 - goalPct / 100.0)).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))" transform="rotate(-90 50 50)" />
                </svg>
                <div class="pt-cl-ring-text"><b>@kgLost.ToString("0.0") kg</b><span>@(heroTotal > 0 ? $"{goalPct}% of goal" : "lost so far")</span></div>
            </div>
            <div class="pt-cl-main">
                <h2>@(heroTotal > 0 ? $"You are {goalPct}% of the way there" : $"Welcome, {firstName}")</h2>
                <p>@(streak > 1 ? $"{streak} day logging streak. Keep it going." : "Log your weight each day to build a streak.")</p>
                <div class="pt-cl-chips">
                    <span><b>@latestWeight.ToString("0.0") kg</b>Current</span>
                    <span><b>@userProfile.TargetWeight.ToString("0.0") kg</b>Target</span>
                    <span><b>@toGo.ToString("0.0") kg</b>To go</span>
                </div>
            </div>
            <div class="pt-cl-next">
                <small>Next appointment</small>
                @if (nextAppt != null)
                {
                    <b>@ToIst(nextAppt.AppointmentDate).ToString("ddd d MMM, h:mm tt")</b>
                    <span>@nextAppt.TreatmentType · @nextAppt.Status</span>
                }
                else
                {
                    <b>None booked</b>
                    <button type="button" class="pt-link pt-link--light" @onclick='() => GoTab("appointments")'>Book a visit</button>
                }
            </div>
        </section>

        @if (!hasLoggedWeightToday)
        {
            <div class="pt-nudge pt-only-desktop" role="status">
                <svg class="pt-i" aria-hidden="true"><use href="#pt-ico-check"></use></svg>
                <span><strong>Log today's weight</strong> to keep your streak. It takes under a minute.</span>
                <button type="button" class="pt-btn pt-btn--pri pt-btn--sm" @onclick='() => GoTab("checkin")'>Check in now</button>
            </div>
            <button type="button" class="pt-cta-float pt-only-mobile" @onclick='() => GoTab("checkin")'>Log today's weight</button>
        }

        <div class="pt-kpis pt-kpis--client">
            <div class="pt-kpi"><b>@(latestWeight > 0 ? latestWeight.ToString("0.0") + " kg" : "N/A")</b><span>Current weight</span></div>
            <div class="pt-kpi pt-kpi--ok"><b>@(kgLost >= 0 ? "−" : "+")@Math.Abs(kgLost).ToString("0.0") kg</b><span>@(kgLost >= 0 ? "Total lost" : "Total gained")</span></div>
            <div class="pt-kpi"><b>@attendanceRecords.Count</b><span>Clinic visits</span></div>
        </div>

        <div class="pt-split pt-split--client">
            <div class="pt-card">
                <div class="pt-card-head"><h3>Weight progress</h3><span class="pt-ov-pill">@Math.Min(dailyLogs.Count, 14) logs</span></div>
                @if (dailyLogs.Count < 2) { <p class="pt-ov-empty">Log your weight on two different days to see your progress here.</p> }
                else { @ProgressChart(dailyLogs.Take(14).OrderBy(x => x.LogDate).ToList(), userProfile.TargetWeight) }
            </div>
            <div class="pt-card pt-stack">
                <div class="pt-card-head"><h3>This week</h3></div>
                <div class="pt-streak" role="img" aria-label="@week.Count(d => d) of 7 days logged">
                    @for (int i = 0; i < week.Length; i++)
                    {
                        <i class="@(week[i] ? "on" : (i == week.Length - 1 ? "today" : ""))">@if (week[i]) { <svg class="pt-i" aria-hidden="true"><use href="#pt-ico-check"></use></svg> }</i>
                    }
                </div>
                <span class="pt-muted">Weight logged @week.Count(d => d) of 7 days</span>
                <div class="pt-diet-peek">
                    <div class="pt-card-head"><h3>Your diet plan</h3></div>
                    @if (!string.IsNullOrWhiteSpace(dietPreview)) { <p>@dietPreview</p><button type="button" class="pt-link" @onclick='() => GoTab("diet")'>Open full plan</button> }
                    else { <p class="pt-muted">No plan assigned yet. Contact the clinic.</p> }
                </div>
            </div>
        </div>

        var weightChanges = WeightChanges(8);
        var visitMonths = VisitsByMonth(6);
        <div class="pt-ov-charts">
            <div class="pt-card pt-ov-chart">
                <div class="pt-card-head"><h3>Weight change per log</h3><span class="pt-ov-pill">kg vs previous</span></div>
                @if (weightChanges.Count == 0) { <p class="pt-ov-empty">Log on two different days to see your change.</p> }
                else { @ChangeChart(weightChanges) }
            </div>
            <div class="pt-card pt-ov-chart">
                <div class="pt-card-head"><h3>Clinic visits, last 6 months</h3><span class="pt-ov-pill">@visitMonths.Sum(x => x.Value) total</span></div>
                @if (visitMonths.Sum(x => x.Value) == 0) { <p class="pt-ov-empty">No clinic visits recorded yet.</p> }
                else { @MonthChart(visitMonths) }
            </div>
        </div>
    }
    else if (activeTab == "checkin")
    {
        <!-- ═════════ CHECK-IN ═════════ -->
        <div class="pt-ov-head">
            <div>
                <h1 class="pt-ov-title">Daily check-in</h1>
                <span class="pt-ov-sub">Weight, measurements and today's meals</span>
            </div>
            <span class="pt-ov-status pt-ov-status--@(hasLoggedWeightToday ? "ok" : "wait")">@(hasLoggedWeightToday ? "Logged today" : "Not logged today")</span>
        </div>
        <div class="pt-seg pt-seg--page" role="group" aria-label="Check-in view">
            <button type="button" class="@(portalView == "log" ? "on" : "")" @onclick='() => portalView = "log"'>Log entry</button>
            <button type="button" class="@(portalView == "history" ? "on" : "")" @onclick='() => portalView = "history"'>Photo history</button>
        </div>

        @if (portalView == "history")
        {
            @if (!dailyLogs.Any(l => !string.IsNullOrWhiteSpace(l.MealPhotoUrl)))
            {
                <div class="pt-card"><p class="pt-ov-empty">No meal photos uploaded yet.</p></div>
            }
            else
            {
                <div class="pt-meal-grid">
                    @foreach (var log in dailyLogs.Where(l => !string.IsNullOrWhiteSpace(l.MealPhotoUrl)).Take(20))
                    {
                        <div class="pt-card pt-meal">
                            <img src="@log.MealPhotoUrl" class="pt-meal-photo" alt="Meal photo from @log.LogDate.ToString("dd MMM yyyy")" loading="lazy" />
                            <div class="pt-meal-body">
                                <div class="pt-meal-top"><strong>@log.LogDate.ToString("dd MMM yyyy")</strong><span>@log.Weight.ToString("0.0") kg</span></div>
                                @if (!string.IsNullOrWhiteSpace(log.DietNotes)) { <p class="pt-meal-notes">@log.DietNotes</p> }
                                <div class="macro-bar">
                                    <div class="seg-carbs" style="width: @log.CarbsPercentage%"></div>
                                    <div class="seg-protein" style="width: @log.ProteinPercentage%"></div>
                                    <div class="seg-fat" style="width: @log.FatPercentage%"></div>
                                    <div class="seg-veg" style="width: @log.VegPercentage%"></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <EditForm Model="logModel" OnValidSubmit="HandleLogSubmission">
                <DataAnnotationsValidator />
                <div class="pt-split pt-split--client">
                    <div class="pt-stack">
                        <div class="pt-card pt-form">
                            <div class="pt-card-head"><h3>Weight</h3></div>
                            <div class="pt-weight-row">
                                <div class="pt-field pt-field--weight"><label for="ci-weight">Today's weight (kg)</label><InputNumber id="ci-weight" @bind-Value="logModel.Weight" class="pt-input pt-input--big" step="0.1" inputmode="decimal" /></div>
                                <div class="pt-field"><label for="ci-date">Log date</label><InputDate id="ci-date" @bind-Value="logModel.LogDate" class="pt-input" /></div>
                            </div>
                            <details class="pt-more">
                                <summary>Add measurements <span>optional</span></summary>
                                <div class="pt-grid4">
                                    <div class="pt-field"><label for="ci-waist">Waist (in)</label><input id="ci-waist" type="number" class="pt-input" step="0.1" min="0.1" max="999.9" inputmode="decimal" @bind="waistInput" @bind:event="oninput" /></div>
                                    <div class="pt-field"><label for="ci-chest">Chest (in)</label><input id="ci-chest" type="number" class="pt-input" step="0.1" min="0.1" max="999.9" inputmode="decimal" @bind="chestInput" @bind:event="oninput" /></div>
                                    <div class="pt-field"><label for="ci-hips">Hips (in)</label><input id="ci-hips" type="number" class="pt-input" step="0.1" min="0.1" max="999.9" inputmode="decimal" @bind="hipsInput" @bind:event="oninput" /></div>
                                    <div class="pt-field"><label for="ci-arms">Arms (in)</label><input id="ci-arms" type="number" class="pt-input" step="0.1" min="0.1" max="999.9" inputmode="decimal" @bind="armsInput" @bind:event="oninput" /></div>
                                </div>
                            </details>
                            @if (!string.IsNullOrWhiteSpace(measurementError)) { <span class="pt-err">@measurementError</span> }
                        </div>

                        <div class="pt-card pt-form">
                            <div class="pt-card-head"><h3>Today's meals</h3>@{ var macroTotal = logModel.CarbsPercentage + logModel.ProteinPercentage + logModel.FatPercentage + logModel.VegPercentage; }<span class="pt-ov-status pt-ov-status--@(macroTotal == 100 ? "ok" : "wait")">@macroTotal%</span></div>
                            <label class="pt-drop" for="ci-photo">
                                @if (!string.IsNullOrWhiteSpace(mealPhotoPreviewUrl)) { <img src="@mealPhotoPreviewUrl" class="pt-drop-preview" alt="Meal preview" /> }
                                else if (!string.IsNullOrWhiteSpace(logModel.MealPhotoUrl)) { <img src="@logModel.MealPhotoUrl" class="pt-drop-preview" alt="Uploaded meal" /> }
                                else { <svg class="pt-i" aria-hidden="true"><use href="#pt-ico-camera"></use></svg> }
                                <strong>Add a meal photo</strong>
                                <span>Take a photo or pick one from your gallery.</span>
                                <InputFile id="ci-photo" class="pt-drop-input" OnChange="HandleMealPhotoUpload" accept="image/*" />
                            </label>
                            @if (!string.IsNullOrWhiteSpace(mealPhotoError)) { <div class="clinic-alert clinic-alert-danger" role="alert">@mealPhotoError</div> }

                            <div class="macro-bar pt-macro-live">
                                <div class="seg-carbs" style="width: @logModel.CarbsPercentage%"></div>
                                <div class="seg-protein" style="width: @logModel.ProteinPercentage%"></div>
                                <div class="seg-fat" style="width: @logModel.FatPercentage%"></div>
                                <div class="seg-veg" style="width: @logModel.VegPercentage%"></div>
                            </div>
                            <div class="pt-sliders">
                                <div class="pt-slider pt-slider--carbs"><label for="m-carbs">Carbs</label><input id="m-carbs" type="range" min="0" max="100" value="@logModel.CarbsPercentage" @oninput="OnCarbsChange" /><b>@logModel.CarbsPercentage%</b></div>
                                <div class="pt-slider pt-slider--protein"><label for="m-protein">Protein</label><input id="m-protein" type="range" min="0" max="100" value="@logModel.ProteinPercentage" @oninput="OnProteinChange" /><b>@logModel.ProteinPercentage%</b></div>
                                <div class="pt-slider pt-slider--fat"><label for="m-fat">Fat</label><input id="m-fat" type="range" min="0" max="100" value="@logModel.FatPercentage" @oninput="OnFatChange" /><b>@logModel.FatPercentage%</b></div>
                                <div class="pt-slider pt-slider--veg"><label for="m-veg">Veg</label><input id="m-veg" type="range" min="0" max="100" value="@logModel.VegPercentage" @oninput="OnVegChange" /><b>@logModel.VegPercentage%</b></div>
                            </div>
                            <span class="pt-muted">The four must add up to 100%.</span>
                            @if (!string.IsNullOrWhiteSpace(macroSumError)) { <div class="clinic-alert clinic-alert-danger" role="alert">@macroSumError</div> }

                            <div class="pt-field"><label for="ci-notes">Notes for your dietician</label><InputTextArea id="ci-notes" @bind-Value="logModel.DietNotes" class="pt-input" rows="3" placeholder="What you ate, water, activity and how you felt today" /></div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(logSaveMsg)) { <div class="clinic-alert clinic-alert-info" role="status">@logSaveMsg</div> }
                        <div class="pt-savebar">
                            <span class="pt-muted pt-only-desktop">Your clinic team will review this update.</span>
                            <button type="submit" class="pt-btn pt-btn--pri pt-btn--lg">Save today's check-in</button>
                        </div>
                    </div>

                    <div class="pt-stack pt-only-desktop">
                        <div class="pt-card">
                            <div class="pt-card-head"><h3>Your streak</h3></div>
                            <div class="pt-streak">
                                @for (int i = 0; i < week.Length; i++)
                                {
                                    <i class="@(week[i] ? "on" : (i == week.Length - 1 ? "today" : ""))">@if (week[i]) { <svg class="pt-i" aria-hidden="true"><use href="#pt-ico-check"></use></svg> }</i>
                                }
                            </div>
                            <p class="pt-muted pt-mt">@(hasLoggedWeightToday ? "Logged today. See you tomorrow." : $"Log today to make it {streak + 1} day{(streak + 1 == 1 ? "" : "s")}.")</p>
                        </div>
                        <div class="pt-card">
                            <div class="pt-card-head"><h3>Recent weights</h3></div>
                            @if (!dailyLogs.Any()) { <p class="pt-ov-empty">Nothing logged yet.</p> }
                            <ul class="pt-rows">
                                @foreach (var l in dailyLogs.Take(5))
                                {
                                    <li class="pt-row"><span class="pt-row-main"><strong>@l.LogDate.ToString("d MMM")</strong></span><b class="pt-num">@l.Weight.ToString("0.0") kg</b></li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </EditForm>
        }
    }
    else if (activeTab == "appointments")
    {
        <!-- ═════════ APPOINTMENTS ═════════ -->
        var upcoming = appointments.Where(a => a.AppointmentDate >= DateTime.UtcNow && a.Status != "Cancelled" && a.Status != "Completed").OrderBy(a => a.AppointmentDate).ToList();
        var past = appointments.Where(a => !upcoming.Contains(a)).OrderByDescending(a => a.AppointmentDate).ToList();
        <div class="pt-ov-head">
            <div>
                <h1 class="pt-ov-title">Appointments</h1>
                <span class="pt-ov-sub">Your visits and booking</span>
            </div>
        </div>
        <div class="pt-split pt-split--client">
            <div class="pt-stack">
                @if (nextAppt != null)
                {
                    <div class="pt-cl-card">
                        <svg class="pt-i" aria-hidden="true"><use href="#pt-ico-cal"></use></svg>
                        <div><small>Next appointment</small><b>@ToIst(nextAppt.AppointmentDate).ToString("dddd d MMM, h:mm tt")</b><span>@nextAppt.TreatmentType</span></div>
                        <span class="pt-ov-status pt-ov-status--@(nextAppt.Status == "Confirmed" ? "ok" : "info")">@nextAppt.Status</span>
                    </div>
                }
                <div class="pt-card pt-form">
                    <div class="pt-card-head"><h3>Book a visit</h3></div>
                    <EditForm Model="apptModel" OnValidSubmit="HandleAppointmentBooking" class="pt-form">
                        <div class="pt-field"><label for="ap-service">Treatment</label><select id="ap-service" class="pt-input" @bind="apptModel.TreatmentType"><option>Slimming</option><option>Physio</option><option>Consultation</option><option>Wellness</option></select></div>
                        <div class="pt-field"><label for="ap-date">Preferred date</label><InputDate id="ap-date" @bind-Value="apptModel.AppointmentDate" class="pt-input" /></div>
                        <div class="pt-field"><label for="ap-note">Notes</label><InputTextArea id="ap-note" @bind-Value="apptModel.Notes" class="pt-input" rows="2" placeholder="Preferred time or any concern" /></div>
                        <button type="submit" class="pt-btn pt-btn--pri pt-btn--block">Request appointment</button>
                        <span class="pt-muted">The clinic confirms your request on WhatsApp.</span>
                    </EditForm>
                    @if (!string.IsNullOrWhiteSpace(apptSaveMsg)) { <div class="clinic-alert clinic-alert-info" role="status">@apptSaveMsg</div> }
                </div>
                <div class="pt-card">
                    <div class="pt-card-head"><h3>Upcoming</h3><span class="pt-ov-pill">@upcoming.Count</span></div>
                    @if (!upcoming.Any()) { <p class="pt-ov-empty">Nothing booked. Request a visit above.</p> }
                    <ul class="pt-rows">
                        @foreach (var a in upcoming)
                        {
                            <li class="pt-row">
                                <div class="pt-row-main"><strong>@a.TreatmentType</strong><small>@ToIst(a.AppointmentDate).ToString("ddd d MMM, h:mm tt")</small></div>
                                <span class="pt-ov-status pt-ov-status--@(a.Status == "Confirmed" ? "ok" : "info")">@a.Status</span>
                            </li>
                        }
                    </ul>
                </div>
                <div class="pt-card">
                    <div class="pt-card-head"><h3>Past visits</h3><span class="pt-ov-pill">@past.Count</span></div>
                    @if (!past.Any()) { <p class="pt-ov-empty">No past appointments.</p> }
                    <ul class="pt-rows">
                        @foreach (var a in past.Take(10))
                        {
                            <li class="pt-row">
                                <div class="pt-row-main"><strong>@a.TreatmentType</strong><small>@ToIst(a.AppointmentDate).ToString("d MMM yyyy")</small></div>
                                <span class="pt-ov-status pt-ov-status--@(a.Status == "Completed" ? "ok" : a.Status == "Cancelled" ? "bad" : "info")">@a.Status</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
            <div class="pt-stack pt-sticky">
                <div class="pt-card">
                    <div class="pt-card-head"><h3>Talk to the clinic</h3></div>
                    <p class="pt-muted pt-mb">For diet changes, fees, appointment changes or treatment concerns, WhatsApp is the quickest way.</p>
                    @if (currentUser != null) { <a class="pt-btn pt-btn--block" target="_blank" rel="noopener" href="@GetClinicWhatsAppLink()"><svg class="pt-i" aria-hidden="true"><use href="#pt-ico-chat"></use></svg>Message on WhatsApp</a> }
                </div>
            </div>
        </div>
    }
    else if (activeTab == "diet")
    {
        <!-- ═════════ DIET PLAN ═════════ -->
        <div class="pt-ov-head">
            <div>
                <h1 class="pt-ov-title">My diet plan</h1>
                <span class="pt-ov-sub">Set by your dietician</span>
            </div>
        </div>
        @if (string.IsNullOrWhiteSpace(userProfile.DietPlan) && dietPlanDocument == null)
        {
            <div class="pt-card"><p class="pt-ov-empty">No diet plan has been assigned yet. Please contact your clinic.</p></div>
        }
        else
        {
            <div class="pt-split pt-split--client">
                <div class="pt-card">
                    <div class="pt-card-head"><h3>Your plan</h3></div>
                    @if (!string.IsNullOrWhiteSpace(userProfile.DietPlan)) { <div class="pt-diet-text">@userProfile.DietPlan</div> }
                    else { <p class="pt-ov-empty">See the attached document.</p> }
                </div>
                <div class="pt-stack">
                    @if (dietPlanDocument != null)
                    {
                        <div class="pt-card">
                            <div class="pt-card-head"><h3>Plan document</h3></div>
                            <div class="pt-doc">
                                <span class="pt-doc-icon"><svg class="pt-i" aria-hidden="true"><use href="#pt-ico-file"></use></svg></span>
                                <div><strong>@dietPlanDocument.OriginalFileName</strong><small>Uploaded @dietPlanDocument.UploadedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</small></div>
                            </div>
                            <a class="pt-btn pt-btn--pri pt-btn--block pt-mt" href="/diet-plan-documents/@dietPlanDocument.Id/download" download><svg class="pt-i" aria-hidden="true"><use href="#pt-ico-download"></use></svg>Download plan</a>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(userProfile.DoctorNotes))
                    {
                        <div class="pt-card"><div class="pt-card-head"><h3>Doctor's notes</h3></div><p class="pt-note-text">@userProfile.DoctorNotes</p></div>
                    }
                    <div class="pt-card">
                        <div class="pt-card-head"><h3>Questions?</h3></div>
                        @if (currentUser != null) { <a class="pt-btn pt-btn--block" target="_blank" rel="noopener" href="@GetClinicWhatsAppLink()"><svg class="pt-i" aria-hidden="true"><use href="#pt-ico-chat"></use></svg>Ask on WhatsApp</a> }
                    </div>
                </div>
            </div>
        }
    }
    else if (activeTab == "history")
    {
        <!-- ═════════ MY HISTORY ═════════ -->
        var visitMonthsH = VisitsByMonth(6);
        <div class="pt-ov-head">
            <div>
                <h1 class="pt-ov-title">My history</h1>
                <span class="pt-ov-sub">Weight, visits and treatments</span>
            </div>
        </div>
        <div class="pt-kpis pt-kpis--client">
            <div class="pt-kpi"><b>@attendanceRecords.Count</b><span>Clinic visits</span></div>
            <div class="pt-kpi"><b>@dailyLogs.Count</b><span>Weight logs</span></div>
            <div class="pt-kpi pt-kpi--ok"><b>@(kgLost >= 0 ? "−" : "+")@Math.Abs(kgLost).ToString("0.0") kg</b><span>Since you started</span></div>
        </div>
        <div class="pt-split pt-split--client">
            <div class="pt-card">
                <div class="pt-card-head"><h3>Visits and treatments</h3></div>
                @if (!attendanceRecords.Any()) { <p class="pt-ov-empty">No clinic visits recorded yet.</p> }
                <div class="pt-timeline">
                    @foreach (var visit in attendanceRecords)
                    {
                        <div class="pt-tl-item">
                            <span class="pt-tl-date">@visit.CheckInTime.ToLocalTime().ToString("d MMM")<small>@visit.CheckInTime.ToLocalTime().ToString("yyyy")</small></span>
                            <span class="pt-tl-dot pt-tl-dot--@(visit.Status == "Absent" ? "bad" : visit.Status == "Checked In" ? "wait" : "ok")"></span>
                            <div class="pt-tl-body">
                                <strong>@visit.TreatmentReceived</strong>
                                <small>@visit.Therapist · @visit.CheckInTime.ToLocalTime().ToString("h:mm tt")@(visit.CheckOutTime.HasValue ? $" to {visit.CheckOutTime.Value.ToLocalTime():h:mm tt}" : "")</small>
                                @if (!string.IsNullOrEmpty(visit.Notes)) { <small>@visit.Notes</small> }
                            </div>
                            <span class="pt-ov-status pt-ov-status--@(visit.Status == "Absent" ? "bad" : visit.Status == "Checked In" ? "wait" : "ok")">@visit.Status</span>
                        </div>
                    }
                </div>
            </div>
            <div class="pt-stack">
                <div class="pt-card">
                    <div class="pt-card-head"><h3>Visits per month</h3></div>
                    @if (visitMonthsH.Sum(x => x.Value) == 0) { <p class="pt-ov-empty">No visits yet.</p> }
                    else { @MonthChart(visitMonthsH) }
                </div>
                <div class="pt-card">
                    <div class="pt-card-head"><h3>Weight logs</h3><span class="pt-ov-pill">latest</span></div>
                    @if (!dailyLogs.Any()) { <p class="pt-ov-empty">Nothing logged yet.</p> }
                    <ul class="pt-rows">
                        @for (int i = 0; i < Math.Min(dailyLogs.Count, 8); i++)
                        {
                            var delta = i + 1 < dailyLogs.Count ? dailyLogs[i].Weight - dailyLogs[i + 1].Weight : (double?)null;
                            <li class="pt-row">
                                <span class="pt-row-main"><strong>@dailyLogs[i].LogDate.ToString("d MMM")</strong></span>
                                <b class="pt-num">@dailyLogs[i].Weight.ToString("0.0") kg</b>
                                @if (delta.HasValue) { <span class="pt-ov-status pt-ov-status--@(delta < 0 ? "ok" : delta > 0 ? "bad" : "info")">@(delta > 0 ? "+" : "")@delta.Value.ToString("0.0")</span> }
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    }
    </div>
}

