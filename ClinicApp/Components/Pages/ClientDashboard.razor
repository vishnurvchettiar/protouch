        // Bug 11: Show confirmation message
        apptSaveMsg = "✓ Appointment request submitted! The clinic will confirm shortly.";
        StateHasChanged();
        await Task.Delay(4000);
        apptSaveMsg = "";
        StateHasChanged();
    }

    private async Task PayInvoice(int invoiceId)
    {
        await ClinicService.MarkInvoiceAsPaidAsync(invoiceId);
        paymentSuccessMsg = "✓ Invoice marked as settled.";
        await LoadProfileDataAsync();
        StateHasChanged();
        await Task.Delay(3000);
        paymentSuccessMsg = "";
        StateHasChanged();
