    public record ChartPoint(double X, double Y, string Label, double Weight);

    // ── Pages (tabs) ────────────────────────────────────────────────────────
    private string activeTab = "overview";

    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabQuery { get; set; }

    protected override void OnParametersSet()
    {
        activeTab = TabQuery is "checkin" or "appointments" or "diet" or "history" ? TabQuery : "overview";
    }

    // Times are stored as UTC. Entities booked in this session can carry Kind=Local, which
    // ConvertTimeFromUtc rejects, so always stamp them as UTC first.
    private static DateTime ToIst(DateTime d) =>
        TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(d, DateTimeKind.Utc), GetClientIst());

    private void GoTab(string tab) =>
        NavManager.NavigateTo(tab == "overview" ? "/client-dashboard" : $"/client-dashboard?tab={tab}");

    // True for each of the last N days (oldest first, today last) that has a weight log.
    private bool[] LoggedLastDays(int days)
    {
        var logged = new HashSet<DateTime>((dailyLogs ?? new()).Select(l => l.LogDate.Date));
        var result = new bool[days];
        for (int i = 0; i < days; i++) result[i] = logged.Contains(DateTime.Today.AddDays(-(days - 1 - i)));
        return result;
    }

    // Consecutive days with a log, counting back from today (or from yesterday if today is not logged yet).
    private int LogStreak()
    {
        var logged = new HashSet<DateTime>((dailyLogs ?? new()).Select(l => l.LogDate.Date));
        var day = logged.Contains(DateTime.Today) ? DateTime.Today : DateTime.Today.AddDays(-1);
        int count = 0;
        while (logged.Contains(day)) { count++; day = day.AddDays(-1); }
        return count;
    }

    // Weight over time with a dashed target line, drawn to one scale.
    private static MarkupString ProgressChart(List<DailyLog> logs, double target)
    {
        const int w = 520, h = 210, left = 36, right = 12, top = 16, bottom = 26;
        var points = logs.Where(l => l.Weight > 0).ToList();
        if (points.Count < 2) return new MarkupString("");
        double min = Math.Min(points.Min(l => l.Weight), target > 0 ? target : double.MaxValue);
        double max = points.Max(l => l.Weight);
        min = Math.Floor(min - 1); max = Math.Ceiling(max + 1);
        double plotW = w - left - right, plotH = h - top - bottom;
        double X(int i) => left + plotW * i / (points.Count - 1);
        double Y(double kg) => top + plotH - plotH * (kg - min) / (max - min);
        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg class=\"pt-chart\" viewBox=\"0 0 {w} {h}\" role=\"img\" aria-label=\"Weight progress\">");
        foreach (var tick in new[] { min, (min + max) / 2, max })
        {
            sb.Append($"<line x1=\"{left}\" x2=\"{w - right}\" y1=\"{Y(tick):F1}\" y2=\"{Y(tick):F1}\" class=\"pt-chart-grid\"/>");
            sb.Append($"<text x=\"{left - 6}\" y=\"{Y(tick) + 3:F1}\" text-anchor=\"end\" class=\"pt-chart-text\">{tick:0}</text>");
        }
        if (target >= min && target <= max)
        {
            sb.Append($"<line x1=\"{left}\" x2=\"{w - right}\" y1=\"{Y(target):F1}\" y2=\"{Y(target):F1}\" stroke=\"#7c1b68\" stroke-dasharray=\"4 3\" stroke-width=\"1.2\"/>");
            sb.Append($"<text x=\"{w - right}\" y=\"{Y(target) - 4:F1}\" text-anchor=\"end\" class=\"pt-chart-text\" fill=\"#7c1b68\">Target {target:0.#} kg</text>");
        }
        var path = new System.Text.StringBuilder();
        for (int i = 0; i < points.Count; i++) path.Append($"{X(i):F1},{Y(points[i].Weight):F1} ");
        sb.Append($"<polygon points=\"{X(0):F1},{top + plotH:F1} {path}{X(points.Count - 1):F1},{top + plotH:F1}\" fill=\"#008d36\" opacity=\"0.08\"/>");
        sb.Append($"<polyline fill=\"none\" stroke=\"#008d36\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" points=\"{path}\"/>");
        for (int i = 0; i < points.Count; i++)
        {
            bool last = i == points.Count - 1;
            sb.Append($"<circle cx=\"{X(i):F1}\" cy=\"{Y(points[i].Weight):F1}\" r=\"{(last ? 4.5 : 3)}\" fill=\"#008d36\"><title>{points[i].LogDate:d MMM}: {points[i].Weight:0.#} kg</title></circle>");
        }
        sb.Append($"<text x=\"{left}\" y=\"{h - 7}\" class=\"pt-chart-text\">{points.First().LogDate:d MMM}</text>");
        sb.Append($"<text x=\"{w - right}\" y=\"{h - 7}\" text-anchor=\"end\" class=\"pt-chart-text\">{points.Last().LogDate:d MMM}</text>");
        sb.Append("</svg>");
        return new MarkupString(sb.ToString());
    }


    // ── Graphs ──────────────────────────────────────────────────────────────
    private List<KeyValuePair<string, double>> WeightChanges(int take)
    {
        var logs = (dailyLogs ?? new()).Where(l => l.Weight > 0).OrderBy(l => l.LogDate).ToList();
        var result = new List<KeyValuePair<string, double>>();
        for (int i = 1; i < logs.Count; i++)
            result.Add(new(logs[i].LogDate.ToString("d MMM"), Math.Round(logs[i].Weight - logs[i - 1].Weight, 1)));
        return result.Skip(Math.Max(0, result.Count - take)).ToList();
    }

    private List<KeyValuePair<string, int>> VisitsByMonth(int months)
    {
        var ist = GetClientIst();
        var now = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, ist);
        var first = new DateTime(now.Year, now.Month, 1).AddMonths(-(months - 1));
        var counts = (attendanceRecords ?? new())
            .Select(a => TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(a.CheckInTime, DateTimeKind.Utc), ist))
            .GroupBy(d => new DateTime(d.Year, d.Month, 1))
            .ToDictionary(g => g.Key, g => g.Count());
        var result = new List<KeyValuePair<string, int>>();
        for (int i = 0; i < months; i++)
        {
            var m = first.AddMonths(i);
            result.Add(new(m.ToString("MMM"), counts.TryGetValue(m, out var n) ? n : 0));
        }
        return result;
    }

    // Diverging bars around a zero line: green is weight lost, red is weight gained.
    private static MarkupString ChangeChart(List<KeyValuePair<string, double>> data)
    {
        const int w = 520, h = 190, left = 34, right = 8, top = 14, bottom = 26;
        double max = Math.Max(0.5, Math.Ceiling(data.Max(d => Math.Abs(d.Value)) * 2) / 2);
        double plotW = w - left - right, plotH = h - top - bottom, mid = top + plotH / 2;
        double slot = plotW / data.Count, barW = Math.Min(34, slot * 0.58);
        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg class=\"pt-chart\" viewBox=\"0 0 {w} {h}\" role=\"img\" aria-label=\"Weight change per log\">");
        foreach (var tick in new[] { -max, 0, max })
        {
            double y = mid - (plotH / 2) * tick / max;
            sb.Append($"<line x1=\"{left}\" x2=\"{w - right}\" y1=\"{y:F1}\" y2=\"{y:F1}\" class=\"pt-chart-grid\"/>");
            sb.Append($"<text x=\"{left - 6}\" y=\"{y + 3:F1}\" text-anchor=\"end\" class=\"pt-chart-text\">{(tick > 0 ? "+" : "")}{tick:0.#}</text>");
        }
        for (int i = 0; i < data.Count; i++)
        {
            double cx = left + slot * i + slot / 2;
            double v = data[i].Value;
            double bh = (plotH / 2) * Math.Abs(v) / max;
            double y = v <= 0 ? mid : mid - bh;
            string colour = v <= 0 ? "#008d36" : "#d6343b";
            sb.Append($"<rect x=\"{cx - barW / 2:F1}\" y=\"{y:F1}\" width=\"{barW:F1}\" height=\"{Math.Max(bh, v != 0 ? 2 : 0):F1}\" rx=\"4\" fill=\"{colour}\"><title>{data[i].Key}: {v:+0.0;-0.0;0.0} kg</title></rect>");
            double ty = v <= 0 ? y + bh + 11 : y - 4;
            sb.Append($"<text x=\"{cx:F1}\" y=\"{ty:F1}\" text-anchor=\"middle\" class=\"pt-chart-value\">{v:+0.0;-0.0;0.0}</text>");
            sb.Append($"<text x=\"{cx:F1}\" y=\"{h - 8}\" text-anchor=\"middle\" class=\"pt-chart-text\">{data[i].Key}</text>");
        }
        sb.Append("</svg>");
        return new MarkupString(sb.ToString());
    }

    private static MarkupString MonthChart(List<KeyValuePair<string, int>> data)
    {
        const int w = 520, h = 190, left = 30, right = 8, top = 14, bottom = 26;
        int max = Math.Max(4, data.Max(d => d.Value));
        if (max % 2 == 1) max++;
        double plotW = w - left - right, plotH = h - top - bottom;
        double slot = plotW / data.Count, barW = Math.Min(40, slot * 0.58);
        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg class=\"pt-chart\" viewBox=\"0 0 {w} {h}\" role=\"img\" aria-label=\"Clinic visits per month\">");
        foreach (var tick in new[] { 0, max / 2, max })
        {
            double y = top + plotH - plotH * tick / max;
            sb.Append($"<line x1=\"{left}\" x2=\"{w - right}\" y1=\"{y:F1}\" y2=\"{y:F1}\" class=\"pt-chart-grid\"/>");
            sb.Append($"<text x=\"{left - 6}\" y=\"{y + 3:F1}\" text-anchor=\"end\" class=\"pt-chart-text\">{tick}</text>");
        }
        for (int i = 0; i < data.Count; i++)
        {
            double cx = left + slot * i + slot / 2;
            double bh = plotH * data[i].Value / max;
            sb.Append($"<rect x=\"{cx - barW / 2:F1}\" y=\"{top + plotH - bh:F1}\" width=\"{barW:F1}\" height=\"{Math.Max(bh, data[i].Value > 0 ? 2 : 0):F1}\" rx=\"4\" fill=\"#7c1b68\" opacity=\"{(i == data.Count - 1 ? "1" : "0.6")}\"><title>{data[i].Key}: {data[i].Value}</title></rect>");
            if (data[i].Value > 0)
                sb.Append($"<text x=\"{cx:F1}\" y=\"{top + plotH - bh - 4:F1}\" text-anchor=\"middle\" class=\"pt-chart-value\">{data[i].Value}</text>");
            sb.Append($"<text x=\"{cx:F1}\" y=\"{h - 8}\" text-anchor=\"middle\" class=\"pt-chart-text\">{data[i].Key}</text>");
        }
        sb.Append("</svg>");
        return new MarkupString(sb.ToString());
    }

    private List<ChartPoint> GetClientChartPoints()
    {
        var points = new List<ChartPoint>();
        if (dailyLogs == null || dailyLogs.Count < 2 || userProfile == null) return points;

        var sortedLogs = dailyLogs.OrderBy(l => l.LogDate).ToList();
        // Bug 9: Guard against single-entry list to prevent division by zero
        if (sortedLogs.Count < 2) return points;

        double maxWeight = sortedLogs.Max(l => l.Weight) + 1;
        double minWeight = Math.Max(0, sortedLogs.Min(l => l.Weight) - 1);
        double weightRange = maxWeight - minWeight;
        if (weightRange == 0) weightRange = 1;

        int svgWidth = 700;
        int svgHeight = 200;
        int padding = 35;

        for (int i = 0; i < sortedLogs.Count; i++)
        {
            double x = padding + ((double)i / (sortedLogs.Count - 1)) * (svgWidth - 2 * padding);
            double y = (svgHeight - padding) - ((sortedLogs[i].Weight - minWeight) / weightRange) * (svgHeight - 2 * padding);
            points.Add(new ChartPoint(x, y, sortedLogs[i].LogDate.ToString("dd MMM"), sortedLogs[i].Weight));
        }
        return points;
    }

    private string GetClientFillPath(List<ChartPoint> points)
    {
        if (points == null || !points.Any()) return "";
        string path = $"M {points.First().X:F1},{200 - 35} ";
        foreach (var pt in points)
        {
            path += $"L {pt.X:F1},{pt.Y:F1} ";
        }
        path += $"L {points.Last().X:F1},{200 - 35} Z";
        return path;
    }

    private double GetTargetY(double targetWeight, List<ChartPoint> points)
    {
        // Bug 9: Guard against empty lists to prevent exceptions
        if (dailyLogs == null || !dailyLogs.Any() || points == null || !points.Any()) return -1;
        var sortedLogs = dailyLogs.OrderBy(l => l.LogDate).ToList();
        double maxWeight = sortedLogs.Max(l => l.Weight) + 1;
        double minWeight = Math.Max(0, sortedLogs.Min(l => l.Weight) - 1);
        double weightRange = maxWeight - minWeight;
        if (weightRange == 0) weightRange = 1;

        int svgHeight = 200;
        int padding = 35;

        return (svgHeight - padding) - ((targetWeight - minWeight) / weightRange) * (svgHeight - 2 * padding);
    }

    // ── Client hero helpers (tasks 6.1, 6.2, 6.3) ────────────────────────

    private static string GetDietPreview(string? dietPlan)
    {
        if (string.IsNullOrWhiteSpace(dietPlan)) return "";
        return dietPlan.Length > 120 ? dietPlan[..120] + "…" : dietPlan;
    }

    private static Appointment? GetNextAppointment(List<Appointment> appts)
    {
        return appts
            .Where(a => a.AppointmentDate > DateTime.UtcNow && a.Status != "Cancelled")
            .OrderBy(a => a.AppointmentDate)
            .FirstOrDefault();
    }

    private static string GetClientGreeting()
    {
        var ist = GetClientIst();
        var hour = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, ist).Hour;
        return hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
    }

    private static TimeZoneInfo GetClientIst()
    {
        try { return TimeZoneInfo.FindSystemTimeZoneById("Asia/Kolkata"); }
        catch { return TimeZoneInfo.FindSystemTimeZoneById("India Standard Time"); }
    }

