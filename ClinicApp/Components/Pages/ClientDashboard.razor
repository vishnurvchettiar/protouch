    public record ChartPoint(double X, double Y, string Label, double Weight);

    private List<ChartPoint> GetClientChartPoints()
    {
        var points = new List<ChartPoint>();
        if (dailyLogs == null || dailyLogs.Count < 2 || userProfile == null) return points;

        var sortedLogs = dailyLogs.OrderBy(l => l.LogDate).ToList();
        // Bug 9: Guard against single-entry list to prevent division by zero
        if (sortedLogs.Count < 2) return points;

        double maxWeight = sortedLogs.Max(l => l.Weight) + 1;
        double minWeight = Math.Max(0, sortedLogs.Min(l => l.Weight) - 1);
        double weightRange = maxWeight - minWeight;
        if (weightRange == 0) weightRange = 1;

        int svgWidth = 700;
        int svgHeight = 200;
        int padding = 35;

        for (int i = 0; i < sortedLogs.Count; i++)
        {
            double x = padding + ((double)i / (sortedLogs.Count - 1)) * (svgWidth - 2 * padding);
            double y = (svgHeight - padding) - ((sortedLogs[i].Weight - minWeight) / weightRange) * (svgHeight - 2 * padding);
            points.Add(new ChartPoint(x, y, sortedLogs[i].LogDate.ToString("dd MMM"), sortedLogs[i].Weight));
        }
        return points;
    }

    private string GetClientFillPath(List<ChartPoint> points)
    {
        if (points == null || !points.Any()) return "";
        string path = $"M {points.First().X:F1},{200 - 35} ";
        foreach (var pt in points)
        {
            path += $"L {pt.X:F1},{pt.Y:F1} ";
        }
        path += $"L {points.Last().X:F1},{200 - 35} Z";
        return path;
    }

    private double GetTargetY(double targetWeight, List<ChartPoint> points)
    {
        // Bug 9: Guard against empty lists to prevent exceptions
        if (dailyLogs == null || !dailyLogs.Any() || points == null || !points.Any()) return -1;
        var sortedLogs = dailyLogs.OrderBy(l => l.LogDate).ToList();
        double maxWeight = sortedLogs.Max(l => l.Weight) + 1;
        double minWeight = Math.Max(0, sortedLogs.Min(l => l.Weight) - 1);
        double weightRange = maxWeight - minWeight;
        if (weightRange == 0) weightRange = 1;

        int svgHeight = 200;
        int padding = 35;

        return (svgHeight - padding) - ((targetWeight - minWeight) / weightRange) * (svgHeight - 2 * padding);
    }

    // ── Client hero helpers (tasks 6.1, 6.2, 6.3) ────────────────────────

    private static string GetDietPreview(string? dietPlan)
    {
        if (string.IsNullOrWhiteSpace(dietPlan)) return "";
        return dietPlan.Length > 120 ? dietPlan[..120] + "…" : dietPlan;
    }

    private static Appointment? GetNextAppointment(List<Appointment> appts)
    {
        return appts
            .Where(a => a.AppointmentDate > DateTime.UtcNow && a.Status != "Cancelled")
            .OrderBy(a => a.AppointmentDate)
            .FirstOrDefault();
    }

    private static string GetClientGreeting()
    {
        var ist = GetClientIst();
        var hour = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, ist).Hour;
        return hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
    }

    private static TimeZoneInfo GetClientIst()
    {
        try { return TimeZoneInfo.FindSystemTimeZoneById("Asia/Kolkata"); }
        catch { return TimeZoneInfo.FindSystemTimeZoneById("India Standard Time"); }
    }

