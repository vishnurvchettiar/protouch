@page "/client-dashboard"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using ClinicApp.Data
@using ClinicApp.Services
@attribute [Authorize(Roles = "Client,Admin")]
@rendermode InteractiveServer

@inject ClinicService ClinicService
@inject FileUploadService FileUploadService
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavManager
@inject IWebHostEnvironment Environment

<PageTitle>PROTOUCH Physio - Slimming Clinic | My Portal</PageTitle>

@if (loading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-info" role="status">
            <span class="visually-hidden">Loading Dashboard...</span>
        </div>
        <p class="text-secondary mt-3">Syncing clinical records...</p>
    </div>
}
else if (userProfile == null)
{
    <div class="clinic-alert clinic-alert-danger">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi" viewBox="0 0 16 16">
            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
        </svg>
        <div>
            <strong>Error:</strong> Profile record could not be resolved. Please log in as a registered client.
        </div>
    </div>
}
else
{
    <div class="container py-3">

        <!-- ── pt-client-hero section (tasks 6.1-6.5) ───────────────────── -->
        @{
            const double HeroR = 44.0;
            const double HeroC = 2 * Math.PI * HeroR;
            double kgLost    = userProfile.StartWeight - latestWeight;
            double heroTotal = userProfile.StartWeight - userProfile.TargetWeight;
            int    goalPct   = heroTotal > 0
                                 ? (int)Math.Clamp(kgLost / heroTotal * 100.0, 0.0, 100.0)
                                 : 0;
            double dashOffset = HeroC * (1.0 - goalPct / 100.0);
            string ringLabel  = heroTotal <= 0 ? "Goal not set" : $"{goalPct}% of goal";
            var    nextAppt   = GetNextAppointment(appointments);
            string dietPreview = GetDietPreview(userProfile.DietPlan);
            string heroGreet   = GetClientGreeting();
        }

        <section class="pt-client-hero mb-4" aria-label="Client overview hero">
            <div class="pt-client-hero-left">
                <!-- SVG Progress Ring -->
                <div class="pt-progress-ring" aria-label="Weight goal @goalPct% achieved">
                    <svg viewBox="0 0 100 100" class="pt-ring-svg">
                        <!-- Background grey ring -->
                        <circle cx="50" cy="50" r="@HeroR"
                                fill="none"
                                stroke="rgba(255,255,255,0.08)"
                                stroke-width="8" />
                        <!-- Green progress arc -->
                        <circle cx="50" cy="50" r="@HeroR"
                                fill="none"
                                stroke="#008d36"
                                stroke-width="8"
                                stroke-linecap="round"
                                stroke-dasharray="@HeroC.ToString("F2")"
                                stroke-dashoffset="@dashOffset.ToString("F2")"
                                transform="rotate(-90 50 50)" />
                        <!-- Centre label -->
                        <text x="50" y="45" text-anchor="middle"
                              fill="#f8fafc"
                              font-size="12" font-weight="900"
                              font-family="Outfit, sans-serif">
                            @($"{kgLost:F1} kg")
                        </text>
                        <text x="50" y="60" text-anchor="middle"
                              fill="#94a3b8"
                              font-size="8"
                              font-family="Outfit, sans-serif">
                            @ringLabel
                        </text>
                    </svg>
                </div>

                <!-- Greeting + stat pills -->
                <div class="flex-grow-1">
                    <h2 class="gradient-text mb-1">@heroGreet, @(userProfile.User?.FullName ?? currentUser?.FullName ?? "Patient") 👋</h2>
                    <p class="text-secondary mb-3">Keep going — every session counts.</p>

                    <!-- Stat Pills -->
                    <div class="pt-stat-pills">
                        <div class="pt-stat-pill">
                            <span class="pill-value">@latestWeight.ToString("F1") kg</span>
                            <span class="pill-label">Current Weight</span>
                        </div>
                        <div class="pt-stat-pill">
                            <span class="pill-value">@userProfile.TargetWeight.ToString("F1") kg</span>
                            <span class="pill-label">Target Weight</span>
                        </div>
                        <div class="pt-stat-pill">
                            <span class="pill-value">@dailyLogs.Count</span>
                            <span class="pill-label">Total Visits</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="pt-client-hero-right">
                <!-- Daily Check-In Prompt (task 6.5) -->
                <div class="pt-checkin-prompt @(hasLoggedWeightToday ? "logged" : "needs-log")">
                    @if (hasLoggedWeightToday)
                    {
                        <span>✅ Weight logged today — great work!</span>
                    }
                    else
                    {
                        <span>⏰ Log your weight today to stay on track.</span>
                    }
                </div>

                <!-- Next Appointment Card (task 6.4) -->
                @if (nextAppt != null)
                {
                    <div class="pt-next-appt-card">
                        <span class="eyebrow mb-1">NEXT APPOINTMENT</span>
                        <div class="appt-time">
                            @TimeZoneInfo.ConvertTimeFromUtc(nextAppt.AppointmentDate, GetClientIst()).ToString("ddd dd MMM, h:mm tt")
                        </div>
                        <div class="appt-service">@nextAppt.TreatmentType</div>
                        <span class="soft-pill mt-2" style="font-size: 0.7rem;">@nextAppt.Status</span>
                    </div>
                }
                else
                {
                    <div class="pt-next-appt-card">
                        <span class="eyebrow mb-1">NEXT APPOINTMENT</span>
                        <p class="text-secondary small mt-1 mb-1">No upcoming appointments</p>
                        <a href="#appointments" class="text-success small">Book now →</a>
                    </div>
                }

                <!-- Diet Preview (task 6.5) -->
                @if (!string.IsNullOrWhiteSpace(dietPreview))
                {
                    <div class="pt-diet-preview">
                        <span class="eyebrow mb-1">DIET PLAN PREVIEW</span>
                        <p>@dietPreview</p>
                        <a href="#diet" class="text-success small">View full plan →</a>
                    </div>
                }
                else
                {
                    <div class="pt-diet-preview">
                        <span class="eyebrow mb-1">DIET PLAN</span>
                        <p>No plan assigned yet — contact your clinic.</p>
                    </div>
                }
            </div>
        </section>
        <!-- ── end pt-client-hero ────────────────────────────────────────── -->

        <!-- Dashboard Header -->
        <div class="glass-panel p-4 mb-4 client-hero">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="profile-photo-wrap">
                        @if (!string.IsNullOrWhiteSpace(userProfile.ProfilePhotoUrl))
                        { <img src="@userProfile.ProfilePhotoUrl" class="profile-photo" alt="Profile photo" /> }
                        else { <div class="profile-photo placeholder">@(currentUser?.FullName?.FirstOrDefault() ?? 'P')</div> }
                    </div>
                    <div><span class="eyebrow">CLIENT PORTAL</span><h1 class="gradient-text mb-1">Hello, @(currentUser?.FullName ?? "Patient")</h1><p class="text-secondary mb-0">Your progress, appointments, diet check-ins and clinic communication.</p></div>
                </div>
                <div class="text-md-end"><span class="soft-pill">🟢 Joined @userProfile.JoiningDate.ToString("MMM yyyy")</span><div class="mt-2"><label class="upload-mini">📷 Change photo <InputFile OnChange="HandleProfilePhotoUpload" accept="image/*" /></label></div>
                @if (!string.IsNullOrWhiteSpace(photoUploadError))
                {
                    <div class="clinic-alert clinic-alert-danger mt-1 small">@photoUploadError</div>
                }</div>
            </div>
        </div>

        <!-- Reminders / Alerts -->
        @if (activePaymentAlerts != null && activePaymentAlerts.Any())
        {
            @foreach (var alert in activePaymentAlerts)
            {
                <div class="clinic-alert clinic-alert-danger">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi me-2" viewBox="0 0 16 16">
                        <path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2zm.002-13a1 1 0 0 0-.707.293l-5.647 5.646a.5.5 0 0 0-.146.354v5.414A1 1 0 0 0 2.5 15h11a1 1 0 0 0 1-1V8.293a.5.5 0 0 0-.146-.354l-5.647-5.646A1 1 0 0 0 8.002 3z"/>
                    </svg>
                    <div class="w-100 d-flex justify-content-between align-items-center flex-wrap">
                        <div>
                            <strong>⚠️ Billing Reminder:</strong> An outstanding payment of <strong>@alert.Amount.ToString("C")</strong> for "<em>@alert.Description</em>" is due. Please settle.
                        </div>
                        <button class="btn btn-clinic-secondary py-1 px-3 mt-2 mt-md-0 btn-sm text-white" @onclick="() => PayInvoice(alert.Id)">
                            💳 Pay invoice (Demo)
                        </button>
                    </div>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(paymentSuccessMsg))
            {
                <div class="clinic-alert clinic-alert-success">@paymentSuccessMsg</div>
            }
        }

        @if (!hasLoggedWeightToday)
        {
            <div class="clinic-alert clinic-alert-warning">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi me-2" viewBox="0 0 16 16">
                    <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM8 4a.905.905 0 0 0-.9.995l.35 3.507a.552.552 0 0 0 1.1 0l.35-3.507A.905.905 0 0 0 8 4zm.002 6a1 1 0 1 0 0 2 1 1 0 0 0 0-2z"/>
                </svg>
                <div>
                    <strong>🕒 Daily Logging Notice:</strong> You haven't recorded your weight or meals today. Keep your streak going to stay on track!
                </div>
            </div>
        }

        <!-- Stat Row -->
        <div class="dashboard-grid">
            <!-- Current Weight Card -->
            <div class="glass-panel stat-card">
                <div class="stat-info">
                    <h4>Current Weight</h4>
                    <p>@(latestWeight > 0 ? $"{latestWeight:F1} kg" : "N/A")</p>
                    <span class="text-secondary small">Target: @userProfile.TargetWeight kg</span>
                </div>
                <div class="stat-icon">
                    ⚖️
                </div>
            </div>

            <!-- Weight Loss Progress Card -->
            <div class="glass-panel stat-card">
                <div class="stat-info">
                    <h4>Weight Loss Journey</h4>
                    @{
                        double diff = userProfile.StartWeight - latestWeight;
                        double totalTarget = userProfile.StartWeight - userProfile.TargetWeight;
                        int percentage = totalTarget > 0 ? (int)Math.Clamp((diff / totalTarget) * 100, 0, 100) : 0;
                    }
                    <p>@($"{diff:F1} kg lost")</p>
                    <span class="text-secondary small">@percentage% of target achieved</span>
                </div>
                <div class="stat-icon" style="background: rgba(16, 185, 129, 0.1); color: var(--accent-success);">
                    📈
                </div>
            </div>

            <!-- Attendance Counter Card -->
            <div class="glass-panel stat-card">
                <div class="stat-info">
                    <h4>Total Clinic Visits</h4>
                    <p>@attendanceRecords.Count</p>
                    <span class="text-secondary small">Active Check-ins: @(attendanceRecords.Any(ar => ar.Status == "Checked In") ? "1" : "0")</span>
                </div>
                <div class="stat-icon" style="background: rgba(127, 0, 255, 0.1); color: var(--accent-purple);">
                    🏃
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Left Side: Weight Chart and Logging Tools -->
            <div class="col-lg-8">
                <!-- Weight Trend Chart -->
                <div class="glass-panel p-4 mb-4">
                    <h3 class="mb-3">Weight Progress Chart</h3>
                    @if (dailyLogs == null || dailyLogs.Count < 2)
                    {
                        <div class="text-center py-5 text-secondary">
                            <p>Not enough logs to render progress chart. Log your weight for multiple days to view history.</p>
                        </div>
                    }
                    else
                    {
                        <!-- Beautiful SVG Line Chart -->
                        var chartPoints = GetClientChartPoints();
                        var pointsString = string.Join(" ", chartPoints.Select(p => $"{p.X:F1},{p.Y:F1}"));
                        var fillPath = GetClientFillPath(chartPoints);
                        double targetY = GetTargetY(userProfile.TargetWeight, chartPoints);

                        <div class="chart-container">
                            <svg viewBox="0 0 700 200" class="chart-svg">
                                <!-- Grid Lines -->
                                <line x1="35" y1="35" x2="665" y2="35" stroke="rgba(255,255,255,0.05)" />
                                <line x1="35" y1="100" x2="665" y2="100" stroke="rgba(255,255,255,0.05)" />
                                <line x1="35" y1="165" x2="665" y2="165" stroke="rgba(255,255,255,0.1)" />

                                <!-- Target Weight Indicator Line -->
                                @if (targetY >= 35 && targetY <= 165)
                                {
                                    <line x1="35" y1="@targetY" x2="665" y2="@targetY" stroke="rgba(0, 242, 254, 0.4)" stroke-dasharray="4" />
                                    @((MarkupString)$"<text x='585' y='{targetY - 5}' fill='var(--accent-teal)' font-size='9' font-weight='bold'>Target: {userProfile.TargetWeight} kg</text>")
                                }

                                <!-- Progress line -->
                                <polyline fill="none" stroke="url(#chartGrad)" stroke-width="4" stroke-linecap="round" points="@pointsString" />

                                <!-- Gradient fill beneath the line -->
                                <path d="@fillPath" fill="url(#areaGrad)" opacity="0.15" />

                                <!-- Interactive Data Circles -->
                                @foreach (var pt in chartPoints)
                                {
                                    <circle cx="@pt.X" cy="@pt.Y" r="5" class="chart-point" />
                                    @((MarkupString)$"<text x='{pt.X}' y='{pt.Y - 10}' fill='#fff' font-size='10' text-anchor='middle' font-weight='700'>{pt.Weight}</text>")
                                    @((MarkupString)$"<text x='{pt.X}' y='188' fill='var(--text-secondary)' font-size='9' text-anchor='middle'>{pt.Label}</text>")
                                }

                                <defs>
                                    <linearGradient id="chartGrad" x1="0" y1="0" x2="1" y2="0">
                                        <stop offset="0%" stop-color="var(--accent-blue)" />
                                        <stop offset="100%" stop-color="var(--accent-teal)" />
                                    </linearGradient>
                                    <linearGradient id="areaGrad" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="var(--accent-teal)" />
                                        <stop offset="100%" stop-color="transparent" />
                                    </linearGradient>
                                </defs>
                            </svg>
                        </div>
                    }
                </div>

                <!-- Daily Checking Form -->
        <div class="glass-panel p-4 mb-4">
            <div class="section-heading"><div><span class="eyebrow">DAILY CHECK-IN</span><h3>Weight & Meal Update</h3></div>
                <div class="d-flex gap-2">
                    <button class="btn-clinic-secondary @(portalView == "log" ? "active" : "")" @onclick='() => portalView = "log"'>Log Entry</button>
                    <button class="btn-clinic-secondary @(portalView == "history" ? "active" : "")" @onclick='() => portalView = "history"'>Photo History</button>
                </div>
            </div>

            @if (portalView == "history")
            {
                @if (dailyLogs == null || !dailyLogs.Any(l => !string.IsNullOrWhiteSpace(l.MealPhotoUrl)))
                {
                    <div class="empty-state">No meal photos uploaded yet.</div>
                }
                else
                {
                    <div class="meal-timeline">
                        @foreach (var log in (dailyLogs ?? new()).Where(l => !string.IsNullOrWhiteSpace(l.MealPhotoUrl)).Take(20))
                        {
                            <div class="meal-timeline-item">
                                <img src="@log.MealPhotoUrl" alt="Meal photo" />
                                <div class="meal-info">
                                    <div class="meal-date">@log.LogDate.ToString("dd MMM yyyy")</div>
                                    <div class="meal-notes">@log.DietNotes</div>
                                    <div class="macro-bar mt-1">
                                        <div class="seg-carbs" style="width: @log.CarbsPercentage%"></div>
                                        <div class="seg-protein" style="width: @log.ProteinPercentage%"></div>
                                        <div class="seg-fat" style="width: @log.FatPercentage%"></div>
                                        <div class="seg-veg" style="width: @log.VegPercentage%"></div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <p class="text-secondary small mb-4">Send your weight, diet notes and a real meal photo to the clinic team. Your dietician can review the information and follow up through WhatsApp.</p>
                <EditForm Model="logModel" OnValidSubmit="HandleLogSubmission">
                    <DataAnnotationsValidator />
                    <div class="row g-3 mb-3">
                        <div class="col-md-6"><label class="clinic-label">Weight today (kg)</label><InputNumber @bind-Value="logModel.Weight" class="clinic-input" step="0.1" /></div>
                        <div class="col-md-6"><label class="clinic-label">Log date</label><InputDate @bind-Value="logModel.LogDate" class="clinic-input" /></div>
                        <!-- Task 12.4: Optional measurement fields -->
                        <div class="col-md-3"><label class="clinic-label">Waist (in) <span class="text-muted small">optional</span></label><input type="number" class="clinic-input" step="0.1" min="0.1" max="999.9" @bind="waistInput" @bind:event="oninput" /></div>
                        <div class="col-md-3"><label class="clinic-label">Chest (in) <span class="text-muted small">optional</span></label><input type="number" class="clinic-input" step="0.1" min="0.1" max="999.9" @bind="chestInput" @bind:event="oninput" /></div>
                        <div class="col-md-3"><label class="clinic-label">Hips (in) <span class="text-muted small">optional</span></label><input type="number" class="clinic-input" step="0.1" min="0.1" max="999.9" @bind="hipsInput" @bind:event="oninput" /></div>
                        <div class="col-md-3"><label class="clinic-label">Arms (in) <span class="text-muted small">optional</span></label><input type="number" class="clinic-input" step="0.1" min="0.1" max="999.9" @bind="armsInput" @bind:event="oninput" /></div>
                        @if (!string.IsNullOrWhiteSpace(measurementError)) { <div class="col-12"><span class="text-danger small">@measurementError</span></div> }
                        <div class="col-12"><label class="clinic-label">Diet / symptoms / water / activity notes</label><InputTextArea @bind-Value="logModel.DietNotes" class="clinic-input" rows="4" placeholder="Tell your dietician what you ate, water intake, activity and how you felt today..." /></div>
                    </div>

                    <!-- Task 12.1: Macro sliders -->
                    <div class="mb-3">
                        <label class="clinic-label mb-2">Macro Distribution (must total 100%)</label>
                        <div class="macro-slider-group">
                            <div class="slider-row">
                                <label>Carbs</label>
                                <input type="range" min="0" max="100" value="@logModel.CarbsPercentage" @oninput="OnCarbsChange" />
                                <span class="pct-label">@logModel.CarbsPercentage%</span>
                            </div>
                            <div class="slider-row">
                                <label>Protein</label>
                                <input type="range" min="0" max="100" value="@logModel.ProteinPercentage" @oninput="OnProteinChange" />
                                <span class="pct-label">@logModel.ProteinPercentage%</span>
                            </div>
                            <div class="slider-row">
                                <label>Fat</label>
                                <input type="range" min="0" max="100" value="@logModel.FatPercentage" @oninput="OnFatChange" />
                                <span class="pct-label">@logModel.FatPercentage%</span>
                            </div>
                            <div class="slider-row">
                                <label>Veg</label>
                                <input type="range" min="0" max="100" value="@logModel.VegPercentage" @oninput="OnVegChange" />
                                <span class="pct-label">@logModel.VegPercentage%</span>
                            </div>
                        </div>
                        <!-- Task 12.2: Live macro bar -->
                        <div class="macro-bar mt-2">
                            <div class="seg-carbs" style="width: @logModel.CarbsPercentage%"></div>
                            <div class="seg-protein" style="width: @logModel.ProteinPercentage%"></div>
                            <div class="seg-fat" style="width: @logModel.FatPercentage%"></div>
                            <div class="seg-veg" style="width: @logModel.VegPercentage%"></div>
                        </div>
                        <div class="text-secondary small mt-1">Total: @(logModel.CarbsPercentage + logModel.ProteinPercentage + logModel.FatPercentage + logModel.VegPercentage)%</div>
                        <!-- Task 12.3: macro sum validation -->
                        @if (!string.IsNullOrWhiteSpace(macroSumError)) { <div class="clinic-alert clinic-alert-danger mt-1 small">@macroSumError</div> }
                    </div>

                    <div class="meal-upload-panel mb-3">
                        <div><span class="eyebrow">MEAL PHOTO</span><h5 class="mb-1">Upload today's meal</h5><span class="text-secondary small">Use your phone or laptop camera/photo picker.</span></div>
                        <InputFile OnChange="HandleMealPhotoUpload" accept="image/*" />
                    </div>
                    @if (!string.IsNullOrWhiteSpace(mealPhotoError))
                    {
                        <div class="clinic-alert clinic-alert-danger mt-1 small">@mealPhotoError</div>
                    }
                    <!-- Task 12.6: Client-side preview before submit -->
                    @if (!string.IsNullOrWhiteSpace(mealPhotoPreviewUrl))
                    {
                        <div class="mb-3">
                            <span class="clinic-label">Preview</span>
                            <img src="@mealPhotoPreviewUrl" class="meal-preview" alt="Meal preview" />
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(logModel.MealPhotoUrl))
                    {
                        <img src="@logModel.MealPhotoUrl" class="meal-preview" alt="Uploaded meal" />
                    }
                    <div class="d-flex justify-content-between align-items-center mt-3"><span class="text-secondary small">Your clinic team will review this update.</span><button class="btn-clinic" type="submit">Save today's update</button></div>
                    @if (!string.IsNullOrWhiteSpace(logSaveMsg))
                    {
                        <div class="clinic-alert clinic-alert-info mt-2">@logSaveMsg</div>
                    }
                </EditForm>
            }
        </div>

        <div class="row g-4 mb-4">
            <div class="col-lg-7">
                <div class="glass-panel p-4 h-100">
                    <div class="section-heading"><div><span class="eyebrow">APPOINTMENTS</span><h3>Book a Clinic Visit</h3></div><span class="soft-pill">Quick booking</span></div>
                    <EditForm Model="apptModel" OnValidSubmit="HandleAppointmentBooking">
                        <div class="row g-3">
                            <div class="col-md-7"><label class="clinic-label">Date & time</label><InputDate @bind-Value="apptModel.AppointmentDate" class="clinic-input" /></div>
                            <div class="col-md-5"><label class="clinic-label">Service</label><select class="clinic-input" @bind="apptModel.TreatmentType"><option>Slimming</option><option>Physio</option><option>Consultation</option><option>Wellness</option></select></div>
                            <div class="col-12"><label class="clinic-label">Note</label><InputTextArea @bind-Value="apptModel.Notes" class="clinic-input" rows="2" placeholder="Any preferred time or concern..." /></div>
                        </div>
                        <button class="btn-clinic mt-3" type="submit">Request appointment</button>
                    </EditForm>
                    @if (!string.IsNullOrWhiteSpace(apptSaveMsg))
                    {
                        <div class="clinic-alert clinic-alert-success mt-2">@apptSaveMsg</div>
                    }
                    @if (appointments.Any())
                    {
                        <div class="mt-4">@foreach (var appt in appointments.Take(5)) { <div class="message-row"><div><strong>@appt.TreatmentType</strong><div class="text-secondary small">@appt.AppointmentDate.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</div></div><span class="soft-pill">@appt.Status</span></div> }</div>
                    }
                </div>
            </div>
            <div class="col-lg-5">
                <div class="glass-panel p-4 h-100">
                    <span class="eyebrow">DIRECT COMMUNICATION</span><h3>Talk to the Clinic</h3>
                    <p class="text-secondary">For diet changes, fee questions, appointment changes or treatment concerns, WhatsApp is the primary communication channel.</p>
                    @if (currentUser != null)
                    { <a class="btn-clinic w-100 justify-content-center" target="_blank" href="@GetClinicWhatsAppLink()">💬 Open ProTouch WhatsApp</a> }
                    <div class="text-secondary small mt-3">Keep your clinic's official WhatsApp number configured by the admin before production use.</div>
                </div>
            </div>
        </div>

        <!-- My Diet Plan Section — Requirements 12.1, 12.2, 12.3, 12.4 -->
        <div class="glass-panel p-4 mb-4">
            <span class="eyebrow">NUTRITION GUIDANCE</span>
            <h3 class="mb-3">My Diet Plan</h3>
            @if (!string.IsNullOrWhiteSpace(userProfile?.DietPlan))
            {
                <pre class="diet-plan-text">@userProfile.DietPlan</pre>
            }
            else
            {
                <div class="empty-state">
                    No diet plan has been assigned yet. Please contact your clinic.
                </div>
            }
        </div>

        <!-- Clinic Visits & Treatments History -->
                <div class="glass-panel p-4">
                    <h3 class="mb-3">Clinic Attendance & Treatments</h3>
                    <p class="text-secondary small mb-3">Record of physical check-in logs and treatments received at the center.</p>

                    @if (attendanceRecords == null || !attendanceRecords.Any())
                    {
                        <span class="text-secondary small">No physical check-in logs recorded yet.</span>
                    }
                    else
                    {
                        <div style="max-height: 400px; overflow-y: auto; padding-right: 4px;">
                            @foreach (var visit in attendanceRecords)
                            {
                                <div class="glass-panel p-3 mb-3 border-0" style="background: rgba(255,255,255,0.02); border-left: 3px solid @(visit.Status == "Checked In" ? "var(--accent-warning)" : "var(--accent-success)") !important;">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="text-white small font-weight-bold">@visit.TreatmentReceived</span>
                                        <span class="badge-clinic @(visit.Status == "Checked In" ? "badge-pending" : "badge-active") text-xs" style="font-size: 0.65rem;">
                                            @visit.Status
                                        </span>
                                    </div>
                                    <span class="text-secondary small d-block">
                                        Check In: @visit.CheckInTime.ToLocalTime().ToString("dd MMM, h:mm tt")
                                    </span>
                                    @if (visit.CheckOutTime.HasValue)
                                    {
                                        <span class="text-secondary small d-block">
                                            Completed: @visit.CheckOutTime.Value.ToLocalTime().ToString("h:mm tt")
                                        </span>
                                    }
                                    <span class="text-secondary small d-block mt-1">
                                        <strong>Staff:</strong> @visit.Therapist
                                    </span>
                                    @if (!string.IsNullOrEmpty(visit.Notes))
                                    {
                                        <span class="text-muted small d-block mt-1 bg-dark p-2 rounded" style="font-size: 0.8rem; background: rgba(0,0,0,0.2) !important;">
                                            📝 @visit.Notes
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool loading = true;
    private ApplicationUser? currentUser;
    private ClientProfile? userProfile;
    private List<DailyLog> dailyLogs = new();
    private List<AttendanceRecord> attendanceRecords = new();
    private List<Appointment> appointments = new();
    private List<PaymentNotification> activePaymentAlerts = new();

    private double latestWeight;
    private bool hasLoggedWeightToday;

    // Portal view toggle (Task 12.7)
    private string portalView = "log";

    // Macro sum validation (Task 12.3)
    private string macroSumError = "";

    // Measurement fields (Task 12.4)
    private string? waistInput, chestInput, hipsInput, armsInput;
    private string measurementError = "";

    // Meal photo preview (Task 12.6)
    private string mealPhotoPreviewUrl = "";

    // Success/error message state variables
    private string logSaveMsg = "";
    private string apptSaveMsg = "";
    private string paymentSuccessMsg = "";
    private string photoUploadError = "";
    private string mealPhotoError = "";

    // Form inputs models
    private DailyLog logModel = new() { CarbsPercentage = 35, ProteinPercentage = 30, FatPercentage = 15, VegPercentage = 20 };
    private Appointment apptModel = new() { AppointmentDate = DateTime.Today.AddDays(1).AddHours(10), TreatmentType = "Slimming" };

    protected override async Task OnInitializedAsync()
    {
        // Bug 1: Always clear state before loading fresh to prevent stale data on re-login
        currentUser = null;
        userProfile = null;
        dailyLogs = new();
        attendanceRecords = new();
        appointments = new();
        activePaymentAlerts = new();
        latestWeight = 0;
        hasLoggedWeightToday = false;

        loading = true;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            currentUser = await UserManager.FindByNameAsync(user.Identity.Name!);
            if (currentUser != null)
            {
                // Ensure profile exists for the user (in case they just registered)
                await ClinicService.EnsureClientProfileExistsAsync(currentUser.Id);
                
                // Get profile
                userProfile = await ClinicService.GetClientProfileByUserIdAsync(currentUser.Id);

                if (userProfile != null)
                {
                    await LoadProfileDataAsync();
                }
            }
        }
        loading = false;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Bug 1: Always clear state at the top to prevent stale data from previous user
        if (!firstRender) return;

        if (currentUser != null) return;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true) return;

        loading = true;
        StateHasChanged();

        currentUser = await UserManager.FindByNameAsync(authState.User.Identity.Name!);
        if (currentUser != null)
        {
            await ClinicService.EnsureClientProfileExistsAsync(currentUser.Id);
            userProfile = await ClinicService.GetClientProfileByUserIdAsync(currentUser.Id);
            if (userProfile != null)
                await LoadProfileDataAsync();
        }

        loading = false;
        StateHasChanged();
    }

    private async Task LoadProfileDataAsync()
    {
        if (currentUser == null || userProfile == null) return;

        dailyLogs = await ClinicService.GetClientDailyLogsAsync(currentUser.Id);
        attendanceRecords = await ClinicService.GetClientAttendanceAsync(currentUser.Id);
        appointments = await ClinicService.GetClientAppointmentsAsync(currentUser.Id);
        
        var invoices = await ClinicService.GetClientPaymentsAsync(currentUser.Id);
        activePaymentAlerts = invoices.Where(i => !i.IsPaid && i.IsTriggered).ToList();

        var todayLog = dailyLogs.FirstOrDefault(l => l.LogDate == DateTime.Today);
        if (todayLog != null)
        {
            hasLoggedWeightToday = true;
            latestWeight = todayLog.Weight;
            logModel = todayLog; // load into form for editing if they want
        }
        else if (dailyLogs.Any())
        {
            hasLoggedWeightToday = false;
            latestWeight = dailyLogs.First().Weight;
            logModel = new DailyLog
            {
                UserId = currentUser.Id,
                LogDate = DateTime.Today,
                Weight = latestWeight, // prefill with last logged weight
                CarbsPercentage = 35,
                ProteinPercentage = 35,
                FatPercentage = 15,
                VegPercentage = 15
            };
        }
        else
        {
            hasLoggedWeightToday = false;
            latestWeight = userProfile.StartWeight;
            logModel = new DailyLog
            {
                UserId = currentUser.Id,
                LogDate = DateTime.Today,
                Weight = latestWeight,
                CarbsPercentage = 35,
                ProteinPercentage = 35,
                FatPercentage = 15,
                VegPercentage = 15
            };
        }
    }

    // Task 12.8: Use hardened FileUploadService (Tasks 6.4, 6.5, 6.6, 19.1-19.3)
    private async Task HandleMealPhotoUpload(InputFileChangeEventArgs e)
    {
        mealPhotoError = ""; mealPhotoPreviewUrl = "";
        var file = e.File;
        if (currentUser == null) return;

        // Task 12.6: client-side data URL preview
        try {
            using var memStream = new MemoryStream();
            await file.OpenReadStream(8 * 1024 * 1024).CopyToAsync(memStream);
            var base64 = Convert.ToBase64String(memStream.ToArray());
            var mime = file.ContentType ?? "image/jpeg";
            mealPhotoPreviewUrl = $"data:{mime};base64,{base64}";
            StateHasChanged();
        } catch { /* preview failure is non-blocking */ }

        var (path, error) = await FileUploadService.SaveImageAsync(file, "meals", currentUser.Id);
        if (path != null) { logModel.MealPhotoUrl = path; mealPhotoPreviewUrl = ""; }
        else { mealPhotoError = error ?? "Photo must be JPG/PNG/WebP and under 8 MB."; }
        StateHasChanged();
    }

    private async Task HandleProfilePhotoUpload(InputFileChangeEventArgs e)
    {
        photoUploadError = "";
        if (currentUser == null || userProfile == null) return;
        var (path, error) = await FileUploadService.SaveImageAsync(e.File, "profiles", currentUser.Id);
        if (path != null)
        {
            await ClinicService.SetClientPhotoAsync(currentUser.Id, path);
            userProfile.ProfilePhotoUrl = path;
        }
        else
        {
            photoUploadError = error ?? "Photo upload failed. Please use JPG/PNG/WebP under 8 MB.";
        }
        StateHasChanged();
    }

    // Task 12.1: Macro slider handlers — proportional adjustment to keep sum = 100
    private void OnCarbsChange(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var v)) return;
        var delta = v - logModel.CarbsPercentage;
        logModel.CarbsPercentage = v;
        var (np, nf, nv) = AdjustRemaining(logModel.ProteinPercentage, logModel.FatPercentage, logModel.VegPercentage, -delta);
        logModel.ProteinPercentage = np; logModel.FatPercentage = nf; logModel.VegPercentage = nv;
        macroSumError = ""; StateHasChanged();
    }
    private void OnProteinChange(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var v)) return;
        var delta = v - logModel.ProteinPercentage;
        logModel.ProteinPercentage = v;
        var (nc, nf, nv) = AdjustRemaining(logModel.CarbsPercentage, logModel.FatPercentage, logModel.VegPercentage, -delta);
        logModel.CarbsPercentage = nc; logModel.FatPercentage = nf; logModel.VegPercentage = nv;
        macroSumError = ""; StateHasChanged();
    }
    private void OnFatChange(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var v)) return;
        var delta = v - logModel.FatPercentage;
        logModel.FatPercentage = v;
        var (nc, np, nv) = AdjustRemaining(logModel.CarbsPercentage, logModel.ProteinPercentage, logModel.VegPercentage, -delta);
        logModel.CarbsPercentage = nc; logModel.ProteinPercentage = np; logModel.VegPercentage = nv;
        macroSumError = ""; StateHasChanged();
    }
    private void OnVegChange(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var v)) return;
        var delta = v - logModel.VegPercentage;
        logModel.VegPercentage = v;
        var (nc, np, nf) = AdjustRemaining(logModel.CarbsPercentage, logModel.ProteinPercentage, logModel.FatPercentage, -delta);
        logModel.CarbsPercentage = nc; logModel.ProteinPercentage = np; logModel.FatPercentage = nf;
        macroSumError = ""; StateHasChanged();
    }
    private static (int, int, int) AdjustRemaining(int a, int b, int c, int delta)
    {
        var total = a + b + c;
        if (total == 0 || delta == 0) return (Math.Clamp(a, 0, 100), Math.Clamp(b, 0, 100), Math.Clamp(c, 0, 100));
        var da = (int)Math.Round((double)a / total * delta);
        var db = (int)Math.Round((double)b / total * delta);
        var dc = delta - da - db;
        return (Math.Clamp(a + da, 0, 100), Math.Clamp(b + db, 0, 100), Math.Clamp(c + dc, 0, 100));
    }

    private async Task HandleLogSubmission()
    {
        if (currentUser == null || userProfile == null) return;

        // Task 12.3: validate macro sum
        var macroSum = logModel.CarbsPercentage + logModel.ProteinPercentage + logModel.FatPercentage + logModel.VegPercentage;
        if (macroSum != 100) { macroSumError = $"Macro percentages must sum to 100% (currently {macroSum}%). Adjust the sliders."; return; }
        macroSumError = "";

        // Task 12.4: validate optional measurement fields
        measurementError = "";
        if (!ValidateMeasurementInput(waistInput, out var w)) { measurementError = "Waist must be between 0.1 and 999.9 inches."; return; }
        if (!ValidateMeasurementInput(chestInput, out var ch)) { measurementError = "Chest must be between 0.1 and 999.9 inches."; return; }
        if (!ValidateMeasurementInput(hipsInput, out var h)) { measurementError = "Hips must be between 0.1 and 999.9 inches."; return; }
        if (!ValidateMeasurementInput(armsInput, out var ar)) { measurementError = "Arms must be between 0.1 and 999.9 inches."; return; }
        if (w.HasValue) logModel.WaistInches = w.Value;
        if (ch.HasValue) logModel.ChestInches = ch.Value;
        if (h.HasValue) logModel.HipsInches = h.Value;
        if (ar.HasValue) logModel.ArmsInches = ar.Value;

        logModel.UserId = currentUser.Id;
        logModel.LoggedAt = DateTime.UtcNow;

        // Task 12.5: always use upsert (UpdateDailyLogAsync)
        bool wasUpdate = logModel.Id > 0 || await HasLogForToday();
        await ClinicService.UpdateDailyLogAsync(logModel);
        await LoadProfileDataAsync();
        logSaveMsg = wasUpdate ? "✓ Updated today's log successfully!" : "✓ Today's update saved successfully!";
        StateHasChanged();
        await Task.Delay(3000);
        logSaveMsg = "";
        StateHasChanged();
    }

    private async Task<bool> HasLogForToday()
    {
        if (currentUser == null) return false;
        var logs = await ClinicService.GetClientDailyLogsAsync(currentUser.Id);
        return logs.Any(l => l.LogDate == logModel.LogDate);
    }

    private static bool ValidateMeasurementInput(string? input, out double? value)
    {
        value = null;
        if (string.IsNullOrWhiteSpace(input)) return true;
        if (double.TryParse(input, out var d))
        {
            if (d < 0.1 || d > 999.9) return false;
            value = Math.Round(d, 1);
            return true;
        }
        return false;
    }

    private string GetClinicWhatsAppLink()
    {
        var name = currentUser?.FullName ?? "Client";
        return ClinicService.BuildClinicWhatsAppLink($"Hello ProTouch Physio - Slimming Clinic, I am {name}. I need help with my clinic plan.");
    }

    private async Task HandleAppointmentBooking()
