        }
        else
        {
            photoUploadError = error ?? "Photo upload failed. Please use JPG/PNG/WebP under 8 MB.";
        }
        StateHasChanged();
    }

    // Task 12.1: Macro slider handlers — proportional adjustment to keep sum = 100
    private void OnCarbsChange(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var v)) return;
        var delta = v - logModel.CarbsPercentage;
        logModel.CarbsPercentage = v;
        var (np, nf, nv) = AdjustRemaining(logModel.ProteinPercentage, logModel.FatPercentage, logModel.VegPercentage, -delta);
        logModel.ProteinPercentage = np; logModel.FatPercentage = nf; logModel.VegPercentage = nv;
        macroSumError = ""; StateHasChanged();
    }
    private void OnProteinChange(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var v)) return;
        var delta = v - logModel.ProteinPercentage;
        logModel.ProteinPercentage = v;
        var (nc, nf, nv) = AdjustRemaining(logModel.CarbsPercentage, logModel.FatPercentage, logModel.VegPercentage, -delta);
        logModel.CarbsPercentage = nc; logModel.FatPercentage = nf; logModel.VegPercentage = nv;
        macroSumError = ""; StateHasChanged();
    }
    private void OnFatChange(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var v)) return;
        var delta = v - logModel.FatPercentage;
        logModel.FatPercentage = v;
        var (nc, np, nv) = AdjustRemaining(logModel.CarbsPercentage, logModel.ProteinPercentage, logModel.VegPercentage, -delta);
        logModel.CarbsPercentage = nc; logModel.ProteinPercentage = np; logModel.VegPercentage = nv;
        macroSumError = ""; StateHasChanged();
    }
    private void OnVegChange(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var v)) return;
        var delta = v - logModel.VegPercentage;
        logModel.VegPercentage = v;
        var (nc, np, nf) = AdjustRemaining(logModel.CarbsPercentage, logModel.ProteinPercentage, logModel.FatPercentage, -delta);
        logModel.CarbsPercentage = nc; logModel.ProteinPercentage = np; logModel.FatPercentage = nf;
        macroSumError = ""; StateHasChanged();
    }
    private static (int, int, int) AdjustRemaining(int a, int b, int c, int delta)
    {
        var total = a + b + c;
        if (total == 0 || delta == 0) return (Math.Clamp(a, 0, 100), Math.Clamp(b, 0, 100), Math.Clamp(c, 0, 100));
        var da = (int)Math.Round((double)a / total * delta);
        var db = (int)Math.Round((double)b / total * delta);
        var dc = delta - da - db;
        return (Math.Clamp(a + da, 0, 100), Math.Clamp(b + db, 0, 100), Math.Clamp(c + dc, 0, 100));
    }

    private async Task HandleLogSubmission()
    {
        if (currentUser == null || userProfile == null) return;

        // Task 12.3: validate macro sum
        var macroSum = logModel.CarbsPercentage + logModel.ProteinPercentage + logModel.FatPercentage + logModel.VegPercentage;
        if (macroSum != 100) { macroSumError = $"Macro percentages must sum to 100% (currently {macroSum}%). Adjust the sliders."; return; }
        macroSumError = "";

        // Task 12.4: validate optional measurement fields
        measurementError = "";
        if (!ValidateMeasurementInput(waistInput, out var w)) { measurementError = "Waist must be between 0.1 and 999.9 inches."; return; }
        if (!ValidateMeasurementInput(chestInput, out var ch)) { measurementError = "Chest must be between 0.1 and 999.9 inches."; return; }
        if (!ValidateMeasurementInput(hipsInput, out var h)) { measurementError = "Hips must be between 0.1 and 999.9 inches."; return; }
        if (!ValidateMeasurementInput(armsInput, out var ar)) { measurementError = "Arms must be between 0.1 and 999.9 inches."; return; }
        if (w.HasValue) logModel.WaistInches = w.Value;
        if (ch.HasValue) logModel.ChestInches = ch.Value;
        if (h.HasValue) logModel.HipsInches = h.Value;
        if (ar.HasValue) logModel.ArmsInches = ar.Value;

        logModel.UserId = currentUser.Id;
        logModel.LoggedAt = DateTime.UtcNow;

        // Task 12.5: always use upsert (UpdateDailyLogAsync)
        bool wasUpdate = logModel.Id > 0 || await HasLogForToday();
        await ClinicService.UpdateDailyLogAsync(logModel);
        await LoadProfileDataAsync();
        logSaveMsg = wasUpdate ? "✓ Updated today's log successfully!" : "✓ Today's update saved successfully!";
        StateHasChanged();
        await Task.Delay(3000);
        logSaveMsg = "";
        StateHasChanged();
    }

    private async Task<bool> HasLogForToday()
    {
        if (currentUser == null) return false;
        var logs = await ClinicService.GetClientDailyLogsAsync(currentUser.Id);
        return logs.Any(l => l.LogDate == logModel.LogDate);
    }

    private static bool ValidateMeasurementInput(string? input, out double? value)
    {
        value = null;
        if (string.IsNullOrWhiteSpace(input)) return true;
        if (double.TryParse(input, out var d))
        {
            if (d < 0.1 || d > 999.9) return false;
            value = Math.Round(d, 1);
            return true;
        }
        return false;
    }

