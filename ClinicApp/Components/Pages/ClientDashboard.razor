    // Form inputs models
    private DailyLog logModel = new() { CarbsPercentage = 35, ProteinPercentage = 30, FatPercentage = 15, VegPercentage = 20 };
    private Appointment apptModel = new() { AppointmentDate = DateTime.Today.AddDays(1).AddHours(10), TreatmentType = "Slimming" };

    protected override async Task OnInitializedAsync()
    {
        // Bug 1: Always clear state before loading fresh to prevent stale data on re-login
        currentUser = null;
        userProfile = null;
        dailyLogs = new();
        attendanceRecords = new();
        appointments = new();
        activePaymentAlerts = new();
        latestWeight = 0;
        hasLoggedWeightToday = false;

        loading = true;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            currentUser = await UserManager.FindByNameAsync(user.Identity.Name!);
            if (currentUser != null)
            {
                // Ensure profile exists for the user (in case they just registered)
                await ClinicService.EnsureClientProfileExistsAsync(currentUser.Id);
                
                // Get profile
                userProfile = await ClinicService.GetClientProfileByUserIdAsync(currentUser.Id);

                if (userProfile != null)
                {
                    dietPlanDocument = await DietPlanDocuments.GetCurrentAsync(currentUser.Id);
                    await LoadProfileDataAsync();
                }
            }
        }
        loading = false;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Bug 1: Always clear state at the top to prevent stale data from previous user
        if (!firstRender) return;

        if (currentUser != null) return;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true) return;

        loading = true;
        StateHasChanged();

        currentUser = await UserManager.FindByNameAsync(authState.User.Identity.Name!);
        if (currentUser != null)
        {
            await ClinicService.EnsureClientProfileExistsAsync(currentUser.Id);
            userProfile = await ClinicService.GetClientProfileByUserIdAsync(currentUser.Id);
            if (userProfile != null)
                await LoadProfileDataAsync();
        }

        loading = false;
        StateHasChanged();
    }

    private async Task LoadProfileDataAsync()
    {
        if (currentUser == null || userProfile == null) return;

        dailyLogs = await ClinicService.GetClientDailyLogsAsync(currentUser.Id);
        attendanceRecords = await ClinicService.GetClientAttendanceAsync(currentUser.Id);
        appointments = await ClinicService.GetClientAppointmentsAsync(currentUser.Id);
        
        var invoices = await ClinicService.GetClientPaymentsAsync(currentUser.Id);
        activePaymentAlerts = invoices.Where(i => !i.IsPaid && i.IsTriggered).ToList();

        var todayLog = dailyLogs.FirstOrDefault(l => l.LogDate == DateTime.Today);
        if (todayLog != null)
        {
            hasLoggedWeightToday = true;
            latestWeight = todayLog.Weight;
            logModel = todayLog; // load into form for editing if they want
        }
        else if (dailyLogs.Any())
        {
            hasLoggedWeightToday = false;
            latestWeight = dailyLogs.First().Weight;
            logModel = new DailyLog
            {
                UserId = currentUser.Id,
                LogDate = DateTime.Today,
                Weight = latestWeight, // prefill with last logged weight
                CarbsPercentage = 35,
                ProteinPercentage = 35,
                FatPercentage = 15,
                VegPercentage = 15
            };
        }
        else
        {
            hasLoggedWeightToday = false;
            latestWeight = userProfile.StartWeight;
            logModel = new DailyLog
            {
                UserId = currentUser.Id,
                LogDate = DateTime.Today,
                Weight = latestWeight,
                CarbsPercentage = 35,
                ProteinPercentage = 35,
                FatPercentage = 15,
                VegPercentage = 15
            };
        }
    }

    // Task 12.8: Use hardened FileUploadService (Tasks 6.4, 6.5, 6.6, 19.1-19.3)
    private async Task HandleMealPhotoUpload(InputFileChangeEventArgs e)
    {
        mealPhotoError = ""; mealPhotoPreviewUrl = "";
        var file = e.File;
        if (currentUser == null) return;

        // Task 12.6: client-side data URL preview
        try {
            using var memStream = new MemoryStream();
            await file.OpenReadStream(8 * 1024 * 1024).CopyToAsync(memStream);
            var base64 = Convert.ToBase64String(memStream.ToArray());
            var mime = file.ContentType ?? "image/jpeg";
            mealPhotoPreviewUrl = $"data:{mime};base64,{base64}";
            StateHasChanged();
        } catch { /* preview failure is non-blocking */ }

        var (path, error) = await FileUploadService.SaveImageAsync(file, "meals", currentUser.Id);
        if (path != null) { logModel.MealPhotoUrl = path; mealPhotoPreviewUrl = ""; }
        else { mealPhotoError = error ?? "Photo must be JPG/PNG/WebP and under 8 MB."; }
        StateHasChanged();
    }

    private async Task HandleProfilePhotoUpload(InputFileChangeEventArgs e)
    {
        photoUploadError = "";
        if (currentUser == null || userProfile == null) return;
        var (path, error) = await FileUploadService.SaveImageAsync(e.File, "profiles", currentUser.Id);
        if (path != null)
        {
            await ClinicService.SetClientPhotoAsync(currentUser.Id, path);
