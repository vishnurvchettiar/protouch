        if (currentUser == null) return;

        apptModel.UserId = currentUser.Id;
        apptModel.Status = "Scheduled";

        await ClinicService.BookAppointmentAsync(apptModel);
        
        // Reset model with Status set (Bug 7) and StateHasChanged for form re-render
        apptModel = new Appointment
