@page "/"
@layout PublicLayout
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ClinicApp.Services.ClinicService ClinicService

<PageTitle>PROTOUCH Physio - Slimming Clinic | Chhatrapati Sambhajinagar</PageTitle>

<div class="ac-page">

    <!-- ═══════════════════════════════════════════════════
         1. STICKY HEADER (Task 5 — updated nav links + hamburger)
         ═══════════════════════════════════════════════════ -->
    <header class="ac-header" id="ac-header">
        <a href="#top" class="ac-logo">
            <img src="/images/WhatsApp Image 2026-08-12 at 12.25.21 AM.jpeg"
                 alt="ProTouch Physio - Slimming Clinic"
                 onerror="this.style.display='none'" />
        </a>
        <nav class="ac-nav">
            <a href="#services">Services</a>
            <a href="#doctor">About</a>
            <a href="#gallery">Gallery</a>
            <a href="#feedback">Feedback</a>
            <a href="#contact">Contact</a>
        </nav>
        <div class="ac-header-actions">
            <a class="ac-login-btn" href="/Account/Login">Login</a>
            <a class="ac-call-btn" href="tel:9673530031">📞 Call Now</a>
        </div>
        <!-- Hamburger (mobile) -->
        <button class="ac-hamburger" type="button"
                @onclick="ToggleMobileMenu"
                aria-label="Toggle navigation menu"
                aria-expanded="@_mobileMenuOpen">
            <span></span><span></span><span></span>
        </button>
    </header>

    <!-- Mobile nav dropdown -->
    <div class="ac-mobile-nav @(_mobileMenuOpen ? "ac-mobile-nav--open" : "")">
        <a href="#services" @onclick="ToggleMobileMenu">Services</a>
        <a href="#doctor" @onclick="ToggleMobileMenu">About</a>
        <a href="#gallery" @onclick="ToggleMobileMenu">Gallery</a>
        <a href="#feedback" @onclick="ToggleMobileMenu">Feedback</a>
        <a href="#contact" @onclick="ToggleMobileMenu">Contact</a>
    </div>

    <!-- ═══════════════════════════════════════════════════
         2. HERO — dark left / light right split
         ═══════════════════════════════════════════════════ -->
    <section class="ac-hero" id="top">
        <div class="ac-hero-left">
            <p class="ac-kicker">✦ ISO 9001:2015 CERTIFIED CLINIC</p>
            <h1 class="ac-hero-h1">
                Your journey to a<br />
                <em>healthier, stronger</em><br />
                you starts here.
            </h1>
            <p class="ac-hero-sub">
                Physiotherapy-led slimming, rehabilitation and wellness plans by
                <strong style="color:var(--ac-yellow)">Dr. Manjari</strong> — created
                for lasting results, not temporary fixes.
            </p>
            <div class="ac-hero-actions">
                <a class="ac-btn-primary" href="/book">Book Appointment →</a>
                <a class="ac-btn-ghost" href="https://wa.me/919028027888"
                   target="_blank" rel="noopener noreferrer">💬 WhatsApp</a>
            </div>
            <div class="ac-trust-row">
                <span class="ac-trust-item">★★★★★ 4.9 / 5.0</span>
                <span class="ac-trust-divider"></span>
                <span class="ac-trust-item">✓ ISO 9001:2015</span>
                <span class="ac-trust-divider"></span>
                <span class="ac-trust-item">✓ 500+ Patients</span>
            </div>
        </div>

        <div class="ac-hero-right">
            @for (var i = 0; i < heroImages.Count; i++)
            {
                var idx = i;
                <div class="ac-hero-slide @(idx == activeHeroIndex ? "active" : "")">
                    <img src="@heroImages[idx]"
                         alt="ProTouch Clinic"
                         loading="@(idx == 0 ? "eager" : "lazy")"
                         fetchpriority="@(idx == 0 ? "high" : "auto")"
                         onerror="this.style.display='none'" />
                </div>
            }
            <div class="ac-hero-badge">
                <strong>Providing the<br />Caring Touch..!</strong>
                <span>Dr. Manjari<br />Physiotherapist &amp; Slimming Expert</span>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         3. GUARANTEE TICKER
         ═══════════════════════════════════════════════════ -->
    <section class="ac-ticker" aria-label="Our care promise">
        <div class="ac-ticker-track">
            @foreach (var g in guarantees)
            {
                <span class="ac-ticker-item">@g</span>
            }
            @* Duplicate for seamless loop *@
            @foreach (var g in guarantees)
            {
                <span class="ac-ticker-item" aria-hidden="true">@g</span>
            }
        </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         4. TABBED SERVICES (Task 6: Filter Chips + Task 7: Hotspot Map)
         ═══════════════════════════════════════════════════ -->
    <section class="ac-services" id="services" data-reveal>
        <div class="ac-services-inner">
            <div class="ac-services-header">
                <p class="ac-kicker">OUR SERVICES</p>
                <h2>Care for every stage of your wellness journey.</h2>
            </div>

            <!-- Task 6: Service Filter Chips (above tabs) -->
            <div class="ac-chip-row" role="group" aria-label="Filter services by category">
                @foreach (var svc in serviceCards)
                {
                    <button class="ac-tab-chip @(activeTab == svc.Id ? "ac-tab-chip--active" : "")"
                            type="button"
                            aria-pressed="@(activeTab == svc.Id ? "true" : "false")"
                            style="@(activeTab == svc.Id ? $"--chip-accent:{svc.AccentColor};" : "")"
                            @onclick="() => SetTab(svc.Id)">
                        <span>@svc.Icon</span> @svc.Name
                    </button>
                }
            </div>

            <div class="ac-services-tabs">
                @foreach (var svc in serviceCards)
                {
                    <button class="ac-tab @(activeTab == svc.Id ? "ac-tab--active" : "")"
                            type="button"
                            @onclick="() => SetTab(svc.Id)"
                            style="@(activeTab == svc.Id ? $"background:{svc.AccentColor};border-color:{svc.AccentColor};" : "")">
                        <span>@svc.Icon</span> @svc.Name
                    </button>
                }
            </div>

            @{
                var activeSvc = serviceCards.FirstOrDefault(s => s.Id == activeTab) ?? serviceCards[0];
                var svcImgIndex = serviceCards.IndexOf(activeSvc) * 9 + 1;
                var svcImgPath = $"/images/clinic-gallery/gallery-{svcImgIndex:D2}.jpeg";
            }

            <div class="ac-services-panel">
                <div class="ac-panel-left">
                    <span class="ac-svc-icon">@activeSvc.Icon</span>
                    <p class="ac-kicker" style="color:@activeSvc.AccentColor">@activeSvc.Number — @activeSvc.Name</p>
                    <h3>@activeSvc.Name</h3>
                    <p>@activeSvc.Summary</p>
                    <ul>
                        @foreach (var b in activeSvc.Bullets)
                        {
                            <li>@b</li>
                        }
                    </ul>
                    <a class="ac-btn-primary" href="/services/@activeSvc.Id"
                       style="background:@activeSvc.AccentColor">
                        View Service &amp; Book →
                    </a>
                </div>
                <div class="ac-panel-right">
                    <!-- Task 7: SVG Body Hotspot Map -->
                    <div class="ac-hotspot-wrap">
                        <svg class="ac-body-svg" viewBox="0 0 300 450" role="img"
                             aria-label="Interactive body diagram — click a region to explore treatments">
                            <!-- Simplified human body outline -->
                            <path class="ac-body-outline" d="M150,20 C160,20 175,30 175,50 C175,70 165,80 165,80
                                L175,100 L195,95 C210,90 220,100 220,115 L215,160 L195,160 L190,220
                                L200,280 L205,340 L200,380 L195,420 L185,420 L180,380 L175,340
                                L165,295 L150,290 L135,295 L125,340 L120,380 L115,420 L105,420
                                L100,380 L95,340 L100,280 L110,220 L105,160 L85,160 L80,115
                                C80,100 90,90 105,95 L125,100 L135,80 C135,80 125,70 125,50
                                C125,30 140,20 150,20 Z" />

                            <!-- Shoulder/Neck hotspot -->
                            <ellipse class="ac-hotspot @(_hoveredHotspot == "shoulder" ? "ac-hotspot--hover" : "") @(activeTab == "physiotherapy" ? "ac-hotspot--active" : "")"
                                     cx="150" cy="80" rx="30" ry="20"
                                     role="button" tabindex="0"
                                     aria-label="Shoulder and neck region — click to view Physiotherapy and Rehabilitation services"
                                     @onclick='() => SetTab("physiotherapy")'
                                     @onmouseenter='() => _hoveredHotspot = "shoulder"'
                                     @onmouseleave='() => _hoveredHotspot = ""'>
                                <title>Shoulder / Neck → Physiotherapy &amp; Rehabilitation</title>
                            </ellipse>

                            <!-- Waist/Abdomen hotspot -->
                            <ellipse class="ac-hotspot @(_hoveredHotspot == "waist" ? "ac-hotspot--hover" : "") @(activeTab == "weight-loss" ? "ac-hotspot--active" : "")"
                                     cx="150" cy="185" rx="35" ry="28"
                                     role="button" tabindex="0"
                                     aria-label="Waist and abdomen region — click to view Weight Loss and Slimming services"
                                     @onclick='() => SetTab("weight-loss")'
                                     @onmouseenter='() => _hoveredHotspot = "waist"'
                                     @onmouseleave='() => _hoveredHotspot = ""'>
                                <title>Waist / Abdomen → Weight Loss &amp; Slimming</title>
                            </ellipse>

                            <!-- Knee/Lower Limb hotspot -->
                            <ellipse class="ac-hotspot @(_hoveredHotspot == "knee" ? "ac-hotspot--hover" : "") @(activeTab == "physiotherapy" ? "ac-hotspot--active" : "")"
                                     cx="150" cy="300" rx="25" ry="20"
                                     role="button" tabindex="0"
                                     aria-label="Knee and lower limb region — click to view Physiotherapy and Rehabilitation services"
                                     @onclick='() => SetTab("physiotherapy")'
                                     @onmouseenter='() => _hoveredHotspot = "knee"'
                                     @onmouseleave='() => _hoveredHotspot = ""'>
                                <title>Knee / Lower Limb → Physiotherapy &amp; Rehabilitation</title>
                            </ellipse>
                        </svg>
                    </div>
                    <img src="@svcImgPath"
                         alt="@activeSvc.Name"
                         loading="lazy"
                         onerror="this.style.display='none'" />
                </div>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         5. MEET THE EXPERT — Dr. Manjari
         ═══════════════════════════════════════════════════ -->
    <section class="ac-doctor" id="doctor" data-reveal>
        <div class="ac-doctor-photo">
            <img src="/images/clinic-gallery/gallery-27.jpeg"
                 alt="Dr. Manjari — Physiotherapist &amp; Slimming Expert"
                 onerror="this.style.display='none'" />
            <div class="ac-doctor-cred-badge">ISO 9001:2015</div>
        </div>

        <div class="ac-doctor-copy">
            <p class="ac-kicker">MEET THE EXPERT</p>
            <h2>Dr. Manjari</h2>
            <p class="ac-doctor-title">Physiotherapist &amp; Slimming Expert</p>
            <p class="ac-doctor-bio">
                With over a decade of clinical experience, Dr. Manjari combines advanced
                physiotherapy techniques with evidence-based slimming protocols to deliver
                real, lasting results. Her patient-first philosophy ensures every plan is
                personalised, safe and built around your lifestyle — no fasting, no medicine,
                no surgery.
            </p>
            <ul class="ac-doctor-credentials">
                <li>ISO 9001:2015 Certified Clinic — National & International Accreditation</li>
                <li>Specialised in Weight Loss, Inch Loss &amp; Body Contouring</li>
                <li>Expert in Physiotherapy, Rehabilitation &amp; Sports Medicine</li>
                <li>Certified Yoga Therapist — Holistic &amp; Nature Cure</li>
                <li>Height Increase Programs (up to 23 years of age)</li>
                <li>10+ Years of Dedicated Clinical Practice</li>
            </ul>
            <a class="ac-btn-primary" href="/book">Book a Consultation →</a>
        </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         6. ANIMATED STATS STRIP
         ═══════════════════════════════════════════════════ -->
    <section class="ac-stats social-proof-section" data-reveal>
        <div class="ac-stats-inner">
            <div class="ac-stats-grid">
                @foreach (var stat in socialProofStats)
                {
                    <div class="ac-stat-card">
                        <span class="ac-stat-num"
                              data-count-target="@stat.CountTarget"
                              data-count-display="@stat.CountDisplay">@stat.CountDisplay</span>
                        <span class="ac-stat-label">@stat.Label</span>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         Blob divider 1: Stats → BMI
         ═══════════════════════════════════════════════════ -->
    <div class="ac-blob-divider ac-blob-divider--1" aria-hidden="true">
        <svg viewBox="0 0 1440 80" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0,40 C360,80 1080,0 1440,40 L1440,80 L0,80 Z" fill="rgba(0,141,54,0.08)" />
        </svg>
    </div>

    <!-- ═══════════════════════════════════════════════════
         7. BMI / RESULT ESTIMATOR WIDGET (Task 8)
         ═══════════════════════════════════════════════════ -->
    <section class="ac-bmi" id="bmi-estimator" data-reveal>
        <div class="ac-bmi-inner">
            <p class="ac-kicker">WELLNESS ESTIMATOR</p>
            <h2>Discover your personalised wellness plan.</h2>
            <p class="ac-bmi-intro">Enter your details below for an instant, personalised estimate — then book a free consultation with Dr. Manjari.</p>

            <div class="ac-bmi-form">
                <div class="ac-bmi-field">
                    <label for="bmi-height">Height (cm)</label>
                    <input id="bmi-height" type="number" min="100" max="250"
                           placeholder="e.g. 165"
                           @bind="_heightCm" @bind:event="oninput" />
                    @if (!string.IsNullOrEmpty(_heightError))
                    {
                        <span class="ac-field-error">@_heightError</span>
                    }
                </div>
                <div class="ac-bmi-field">
                    <label for="bmi-weight">Weight (kg)</label>
                    <input id="bmi-weight" type="number" min="20" max="300" step="0.1"
                           placeholder="e.g. 70.5"
                           @bind="_weightKg" @bind:event="oninput" />
                    @if (!string.IsNullOrEmpty(_weightError))
                    {
                        <span class="ac-field-error">@_weightError</span>
                    }
                </div>
                <div class="ac-bmi-field">
                    <label for="bmi-goal">Wellness Goal</label>
                    <select id="bmi-goal" @bind="_bmiGoal">
                        <option value="">Select a goal…</option>
                        <option>Weight Loss</option>
                        <option>Inch Loss</option>
                        <option>Physiotherapy / Pain Relief</option>
                        <option>Yoga &amp; Wellness</option>
                        <option>Height Increase</option>
                    </select>
                    @if (!string.IsNullOrEmpty(_goalError))
                    {
                        <span class="ac-field-error">@_goalError</span>
                    }
                </div>
                <button class="ac-btn-primary" type="button" @onclick="ComputeBmi">
                    Calculate My Estimate →
                </button>
            </div>

            @if (_bmiValue.HasValue)
            {
                <div class="ac-bmi-result" style="--bmi-color: @_bmiColor">
                    <div class="ac-bmi-score">
                        <span class="ac-bmi-num">@_bmiValue</span>
                        <span class="ac-bmi-label">BMI — @_bmiCategory</span>
                    </div>
                    <p class="ac-bmi-message">@_bmiMessage</p>
                    <p class="ac-bmi-outcome"><em>@_bmiOutcome</em></p>
                    <a class="ac-btn-primary ac-btn-green" href="/book">
                        Book Your Free Consultation →
                    </a>
                </div>
            }
        </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         Blob divider 2: BMI → Gallery
         ═══════════════════════════════════════════════════ -->
    <div class="ac-blob-divider ac-blob-divider--2" aria-hidden="true">
        <svg viewBox="0 0 1440 80" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0,20 C480,80 960,0 1440,20 L1440,80 L0,80 Z" fill="rgba(124,27,104,0.07)" />
        </svg>
    </div>

    <!-- ═══════════════════════════════════════════════════
         8. PHOTO GALLERY GRID (Task 9 — replaces Before/After)
         ═══════════════════════════════════════════════════ -->
    <section class="ac-gallery" id="gallery" data-reveal>
        <p class="ac-kicker" style="text-align:center">CLINIC GALLERY</p>
        <h2>A glimpse inside ProTouch.</h2>

        <div class="ac-gallery-grid">
            @for (int i = 0; i < _galleryVisible; i++)
            {
                var idx = i;
                <div class="ac-gallery-item" @onclick="() => OpenLightbox(idx)">
                    <img src="@GalleryImages[idx]"
                         alt="ProTouch Clinic Gallery @(idx + 1)"
                         loading="@(idx < 6 ? "eager" : "lazy")"
                         onerror="this.style.display='none'" />
                </div>
            }
        </div>

        @if (CanLoadMore)
        {
            <button class="ac-load-more" @onclick="LoadMoreGallery">Load More</button>
        }

        @if (_isLightboxOpen)
        {
            <div class="ac-lightbox" role="dialog" aria-modal="true">
                <button class="ac-lightbox-close" @onclick="CloseLightbox" aria-label="Close lightbox">✕</button>
                <button class="ac-lightbox-prev" @onclick="LightboxPrev" aria-label="Previous image">‹</button>
                <img src="@GalleryImages[_selectedLightboxIndex]" alt="Gallery image @(_selectedLightboxIndex + 1)" />
                <button class="ac-lightbox-next" @onclick="LightboxNext" aria-label="Next image">›</button>
            </div>
        }
    </section>

    <!-- ═══════════════════════════════════════════════════
         9. TESTIMONIAL CAROUSEL
         ═══════════════════════════════════════════════════ -->
    <section class="ac-testimonials" data-reveal>
        <div class="ac-testimonials-inner">
            <p class="ac-kicker" style="text-align:center">PATIENT STORIES</p>
            <h2>Hear from our patients.</h2>

            <div class="ac-testi-track">
                @for (var i = 0; i < testimonials.Count; i++)
                {
                    var t = testimonials[i];
                    var ti = i;
                    <div class="ac-testi-slide @(ti == activeTestiIndex ? "ac-testi--active" : "")">
                        <span class="ac-stars">★★★★★</span>
                        <p class="ac-testi-quote">@t.Quote</p>
                        <footer class="ac-testi-footer">— @t.RoleLabel</footer>
                    </div>
                }
            </div>

            <div class="ac-testi-arrows">
                <button type="button" @onclick="PrevTesti" aria-label="Previous testimonial">‹</button>
                <button type="button" @onclick="NextTesti" aria-label="Next testimonial">›</button>
            </div>

            <div class="ac-testi-dots" role="tablist" aria-label="Testimonial slides">
                @for (var i = 0; i < testimonials.Count; i++)
                {
                    var di = i;
                    <button type="button"
                            class="@(di == activeTestiIndex ? "active" : "")"
                            @onclick="() => JumpToTesti(di)"
                            aria-label="Testimonial @(di + 1)"></button>
                }
            </div>
        </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         10. FAQ ACCORDION
         ═══════════════════════════════════════════════════ -->
    <section class="ac-faq" data-reveal>
        <div class="ac-faq-inner">
            <p class="ac-kicker">FREQUENTLY ASKED</p>
            <h2>Your questions, answered.</h2>

            <div class="ac-faq-list">
                @for (var i = 0; i < faqItems.Count; i++)
                {
                    var fi = i;
                    var fq = faqItems[fi];
                    <div class="ac-faq-item @(openFaq == fi ? "ac-faq--open" : "")">
                        <button class="ac-faq-q" type="button" @onclick="() => ToggleFaq(fi)">
                            @fq.Q
                            <span class="ac-faq-icon">+</span>
                        </button>
                        <div class="ac-faq-a">
                            <p>@fq.A</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         Blob divider 3: FAQ → Feedback
         ═══════════════════════════════════════════════════ -->
    <div class="ac-blob-divider ac-blob-divider--3" aria-hidden="true">
        <svg viewBox="0 0 1440 80" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0,60 C720,0 1440,80 1440,60 L1440,80 L0,80 Z" fill="rgba(255,235,0,0.1)" />
        </svg>
    </div>

    <!-- ═══════════════════════════════════════════════════
         11. FEEDBACK WIDGET (Task 11)
         ═══════════════════════════════════════════════════ -->
    <section class="ac-feedback" id="feedback" data-reveal>
        <div class="ac-feedback-inner">
            <p class="ac-kicker">SHARE YOUR EXPERIENCE</p>
            <h2>How was your visit?</h2>
            @if (_feedbackSuccess)
            {
                <div class="ac-feedback-success">
                    <span>⭐</span>
                    <p>Thank you for your feedback! Your response has been recorded.</p>
                </div>
            }
            else
            {
                <div class="ac-feedback-form">
                    <div class="ac-stars-row" role="group" aria-label="Star rating">
                        @for (int s = 1; s <= 5; s++)
                        {
                            var star = s;
                            <button type="button"
                                    class="ac-star-btn @((_feedbackHoverRating > 0 ? star <= _feedbackHoverRating : star <= _feedbackRating) ? "ac-star--lit" : "")"
                                    @onclick="() => SetFeedbackStar(star)"
                                    @onmouseenter="() => HoverFeedbackStar(star)"
                                    @onmouseleave="UnhoverFeedbackStar"
                                    aria-label="@star star@(star > 1 ? "s" : "")">★</button>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(_feedbackError))
                    {
                        <p class="ac-feedback-error" role="alert">@_feedbackError</p>
                    }
                    <textarea class="ac-feedback-textarea"
                              maxlength="500"
                              placeholder="Tell us about your experience (optional)..."
                              @bind="_feedbackComment"
                              @bind:event="oninput"></textarea>
                    <p class="ac-char-counter">@FeedbackCharsRemaining characters remaining</p>
                    <button class="ac-btn-primary" type="button"
                            disabled="@_feedbackSubmitting"
                            @onclick="SubmitFeedbackAsync">
                        @(_feedbackSubmitting ? "Submitting…" : "Submit Feedback →")
                    </button>
                </div>
            }
        </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         12. CONTACT SECTION
         ═══════════════════════════════════════════════════ -->
    <section class="ac-contact" id="contact" data-reveal>
        <div class="ac-contact-inner">
            <div class="ac-contact-left">
                <p class="ac-kicker">GET IN TOUCH</p>
                <h2>Let's take the first step together.</h2>
                <p>
                    Contact Dr. Manjari to discuss a physiotherapy, slimming or wellness
                    plan that fits you. Consultations available now.
                </p>
                <div class="ac-contact-actions">
                    <a class="ac-btn-primary" href="/book">Book an Appointment →</a>
                    <a class="ac-btn-ghost"
                       href="https://wa.me/919028027888"
                       target="_blank"
                       rel="noopener noreferrer">💬 WhatsApp Us</a>
                </div>
            </div>

            <div class="ac-contact-right">
                <div class="ac-contact-details">
                    <div class="ac-contact-detail-item">
                        <span class="ac-detail-icon">📞</span>
                        <div>
                            <a href="tel:9673530031">
                                <strong>96735 30031</strong>
                            </a>
                            <a href="tel:+919028027888" style="margin-top:4px;display:block;">
                                <strong>+91 90280 27888</strong>
                            </a>
                            <span>Primary &amp; WhatsApp</span>
                        </div>
                    </div>
                    <div class="ac-contact-detail-item">
                        <span class="ac-detail-icon">✉️</span>
                        <div>
