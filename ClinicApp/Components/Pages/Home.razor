    // ════════════════════════════════════════════════════════
    // Task 8: BMI Estimator
    // ════════════════════════════════════════════════════════
    private void ComputeBmi()
    {
        _heightError = _weightError = _goalError = "";
        _bmiValue = null;

        bool valid = true;
        if (_heightCm < 100 || _heightCm > 250)
        { _heightError = "Height must be between 100 and 250 cm."; valid = false; }
        if (_weightKg < 20 || _weightKg > 300)
        { _weightError = "Weight must be between 20 and 300 kg."; valid = false; }
        if (string.IsNullOrWhiteSpace(_bmiGoal))
        { _goalError = "Please select a wellness goal."; valid = false; }
        if (!valid) return;

        double h = _heightCm / 100.0;
        double bmi = Math.Round(_weightKg / (h * h), 1);
        _bmiValue = bmi;

        (_bmiCategory, _bmiColor) = bmi < 18.5
            ? ("Underweight", "#7c1b68")
            : bmi < 25.0
                ? ("Normal", "#008d36")
                : bmi < 30.0
                    ? ("Overweight", "#ffeb00")
                    : ("Obese", "#e52321");

        _bmiMessage = WellnessMessageMap
            .GetValueOrDefault(_bmiCategory, new())
            .GetValueOrDefault(_bmiGoal, "Your health journey starts here. Book a consultation today.");

        _bmiOutcome = OutcomeMap.GetValueOrDefault(_bmiGoal,
            "Based on your profile, Dr. Manjari will design a personalised plan for you.");
    }

