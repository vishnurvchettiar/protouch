@page "/"
@layout PublicLayout
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>PROTOUCH Physio - Slimming Clinic | Chhatrapati Sambhajinagar</PageTitle>

<div class="wellness-page">

    <!-- ── Header ── -->
    <header class="pt-header">
        <a href="#top" class="pt-logo">
            <img src="/images/WhatsApp Image 2026-08-12 at 12.25.21 AM.jpeg" alt="ProTouch Physio - Slimming Clinic" />
        </a>
        <nav class="pt-nav">
            <a href="#services">Services</a>
            <a href="#approach">Approach</a>
            <a href="#gallery">Gallery</a>
            <a href="#contact">Contact</a>
        </nav>
        <div class="pt-header-actions">
            <a class="pt-login-btn" href="/Account/Login">Login</a>
            <a class="pt-call-btn" href="tel:9673530031">📞 Call Now</a>
        </div>
    </header>

    <main id="top">

        <!-- ═════════════════════════════════════════════
             HERO — 5-image sub-carousel, no personal photos
             ═════════════════════════════════════════════ -->
        <section class="wellness-hero">
            <div class="hero-content">
                <p class="iso-mark">✦ ISO 9001:2015 CERTIFIED COMPANY</p>
                <h1>
                    <span class="hero-line" style="--i:0">Your journey to a</span>
                    <span class="hero-line hero-line-em" style="--i:1"><em>healthier, stronger</em></span>
                    <span class="hero-line" style="--i:2">you starts here.</span>
                </h1>
                <p class="hero-copy">Physiotherapy-led slimming, rehabilitation and wellness plans by <strong>Dr. Manjari</strong> — created for lasting results, not temporary fixes.</p>
                <div class="wellness-actions">
                    <a class="hero-cta-primary" href="/book">Book an Appointment <span class="cta-arrow">→</span></a>
                    <a class="hero-cta-secondary" href="https://wa.me/919028027888" target="_blank" rel="noopener">💬 WhatsApp Us</a>
                </div>
                <div class="hero-trust-badges">
                    <div class="trust-stars">★★★★★ <span>4.9 / 5.0</span></div>
                    <div class="trust-divider"></div>
                    <div class="trust-item">✓ ISO 9001:2015</div>
                    <div class="trust-divider"></div>
                    <div class="trust-item">✓ 500+ Patients</div>
                </div>
            </div>
            <div class="hero-photo">
                @for (var i = 0; i < heroImages.Count; i++)
                {
                    var idx = i;
                    <img src="@heroImages[idx]"
                         alt="Protouch clinic"
                         class="hero-slide @(idx == activeHeroIndex ? "active" : "")"
                         loading="@(idx == 0 ? "eager" : "lazy")"
                         fetchpriority="@(idx == 0 ? "high" : "auto")"
                         onerror="this.style.display='none'" />
                }
                <div class="hero-badge">
                    <strong>Providing the<br />Caring Touch..!</strong>
                    <span>Dr. Manjari<br />Physiotherapist &amp; Slimming Expert</span>
                </div>
            </div>
        </section>

        <!-- Guarantee strip — animated ticker -->
        <section class="guarantee-strip guarantee-strip--ticker" aria-label="Our care promise">
            <div class="guarantee-ticker-track">
                <span class="guarantee-header-pill">✦ Our Promise</span>
                @foreach (var g in guarantees) { <span class="guarantee-item">✓ @g</span> }
                @* Duplicate for seamless loop *@
                <span class="guarantee-header-pill" aria-hidden="true">✦ Our Promise</span>
                @foreach (var g in guarantees) { <span class="guarantee-item" aria-hidden="true">✓ @g</span> }
            </div>
        </section>

        <!-- ═════════════════════════════════════════════
             APPROACH
             ═════════════════════════════════════════════ -->
        <section id="approach" class="wellness-section split-intro" data-reveal>
            <div>
                <p class="section-kicker">A SMARTER, SAFER APPROACH</p>
                <h2>Lose weight,<br /><em>not money.</em></h2>
            </div>
            <div>
                <p class="large-copy">We combine expert physiotherapy, personalised movement and modern body-care technology to help you feel better — without extreme restrictions or invasive procedures.</p>
                <p class="muted-copy">The intelligent alternative to liposuction and other aesthetic devices, designed around your health and your goals.</p>
            </div>
        </section>

        <!-- ═════════════════════════════════════════════
             SERVICES — cards that link to dedicated pages
             ═════════════════════════════════════════════ -->
        <section id="services" class="wellness-section services">
            <p class="section-kicker">OUR SERVICES</p>
            <h2>Care for every stage of your wellness journey.</h2>
            <div class="service-grid-v2">
                @foreach (var svc in serviceCards)
                {
                    <a class="service-card-link" href="/services/@svc.Id" data-reveal>
                        <div class="service-card-home svc-reveal-card" style="border-top-color:@svc.AccentColor; --svc-accent:@svc.AccentColor;">
                            <div class="svc-before-layer"></div>
                            <div class="svc-after-layer"></div>
                            <div class="svc-card-content">
                                <span class="svc-num svc-num-badge" style="color:@svc.AccentColor;">@svc.Number</span>
                                <div class="svc-icon-wrap" style="background:@svc.IconBg;">@svc.Icon</div>
                                <h3>@svc.Name</h3>
                                <p>@svc.Summary</p>
                                <ul>@foreach (var b in svc.Bullets) { <li>@b</li> }</ul>
                                <span class="svc-cta-hint">View service &amp; book →</span>
                            </div>
                            <div class="svc-reveal-label">
                                <span class="svc-before-tag">Before</span>
                                <span class="svc-after-tag">After →</span>
                            </div>
                        </div>
                    </a>
                }
            </div>
        </section>

        <!-- ═════════════════════════════════════════════
             WHY PROTOUCH
             ═════════════════════════════════════════════ -->
        <section class="wellness-section care-panel" data-reveal>
            <div class="care-photo">
                <img src="/images/clinic-gallery/gallery-27.jpeg" alt="Protouch clinic care" />
            </div>
            <div class="care-copy">
                <p class="section-kicker">WHY PROTOUCH</p>
                <h2>Because your body deserves more than a one-size-fits-all plan.</h2>
                <div class="care-reasons">
                    <div data-reveal>
                        <b>Physiotherapy-first</b>
                        <span>Safe movement plans that respect pain, injury and existing health concerns.</span>
                    </div>
                    <div data-reveal>
                        <b>Personalised guidance</b>
                        <span>Diet, treatment and wellness support shaped around your daily life.</span>
                    </div>
                    <div data-reveal>
                        <b>Lasting wellbeing</b>
                        <span>We help minimise underlying biological problems — not just reduce a number.</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═════════════════════════════════════════════
             SOCIAL PROOF — animated stat counters and outcome testimonials
             ═════════════════════════════════════════════ -->
        <section class="wellness-section social-proof-section" data-reveal aria-labelledby="sp-heading">
            <p class="section-kicker">CLINIC OUTCOMES</p>
            <h2 id="sp-heading">Results backed by <em>science and care.</em></h2>

            <div class="sp-stats-grid">
                @foreach (var stat in socialProofStats)
                {
                    <div class="stat-card-sp" data-reveal>
                        <span class="sp-count"
                              data-count-target="@stat.CountTarget"
                              data-count-display="@stat.CountDisplay">@stat.CountDisplay</span>
                        <span class="sp-label">@stat.Label</span>
                    </div>
                }
            </div>

            <div class="sp-testimonials">
                @foreach (var t in testimonials)
                {
                    <blockquote class="testimonial-card" data-reveal>
                        <div class="tc-stars">★★★★★</div>
                        <p>@t.Quote</p>
                        <footer>— @t.RoleLabel</footer>
                    </blockquote>
                }
            </div>
        </section>

        <!-- ═════════════════════════════════════════════
             PROGRAMS
             ═════════════════════════════════════════════ -->
        <section class="wellness-section programs" data-reveal>
            <div>
                <p class="section-kicker">YOUR CARE, CONNECTED</p>
                <h2>Support that continues between clinic visits.</h2>
            </div>
            <div class="program-points">
                <p><b>01</b> Book consultations directly with the clinic.</p>
                <p><b>02</b> Track daily weight, treatments and wellness progress.</p>
                <p><b>03</b> Receive personal diet guidance and appointment reminders.</p>
            </div>
        </section>

        <!-- ═════════════════════════════════════════════
             GALLERY — auto-rotating carousel
             ═════════════════════════════════════════════ -->
        <section id="gallery" class="wellness-section carousel-section-wrap" data-reveal>
            <p class="section-kicker">CLINIC GALLERY</p>
            <h2>A glimpse inside ProTouch Clinic.</h2>

            <div class="carousel-section">
                <div class="carousel-track">
                    @for (var i = 0; i < carouselSlides.Count; i++)
                    {
                        var idx = i;
                        <div class="carousel-slide @(idx == activeSlideIndex ? "active" : "")">
                            <img src="@carouselSlides[idx].ImagePath"
                                 alt="@carouselSlides[idx].Caption"
                                 loading="lazy"
                                 onerror="this.parentElement.style.background='linear-gradient(135deg,#008d36,#eef6f1)'" />
                            @if (!string.IsNullOrWhiteSpace(carouselSlides[idx].Caption))
                            {
                                <div class="carousel-caption">@carouselSlides[idx].Caption</div>
                            }
                        </div>
                    }
                </div>
                <div class="carousel-dots" role="tablist" aria-label="Gallery slides">
                    @for (var i = 0; i < carouselSlides.Count; i++)
                    {
                        var idx = i;
                        <button class="carousel-dot @(idx == activeSlideIndex ? "active" : "")"
                                @onclick="() => JumpToSlide(idx)"
                                aria-label="Slide @(idx + 1)"
                                type="button"></button>
                    }
                </div>
            </div>

        </section>

        <!-- ═════════════════════════════════════════════
             CONTACT
             ═════════════════════════════════════════════ -->
        <section id="contact" class="contact-section" data-reveal>
            <div>
                <p class="section-kicker">VISIT PROTOUCH CLINIC</p>
                <h2>Let's take the first step together.</h2>
                <p>Contact Dr. Manjari to discuss a physiotherapy, slimming or wellness plan that fits you.</p>
                <p class="contact-urgency">Consultations available now — call us or use the booking bar below.</p>
            </div>
            <div class="contact-details">
                <a href="tel:9673530031"><strong>96735 30031</strong><span>Primary phone</span></a>
                <a href="tel:+919028027888"><strong>+91 90280 27888</strong><span>Alternate / WhatsApp</span></a>
                <a href="mailto:protouch1998@gmail.com"><strong>protouch1998@gmail.com</strong><span>Email us</span></a>
                <p>Row H. No. 22, Kasliwal Bhagyoday,<br />Opposite Surya Lawns / Near Datta Mandir, Beed By-pass,<br />Mirajgave Nagari, Ch. Sambhajinagar – 431010</p>
                <a class="wellness-primary directions" target="_blank" rel="noopener"
                   href="https://www.google.com/maps/search/?api=1&query=Kasliwal+Bhagyoday+Beed+By-pass+Chhatrapati+Sambhajinagar">Get directions →</a>
            </div>
        </section>

    </main>

    <footer>© @DateTime.Now.Year PROTOUCH Physio - Slimming Clinic <span>•</span> Dr. Manjari</footer>

    <!-- ═════════════════════════════════════════════
         FLOATING STICKY BOOKING BAR
         Fixed to viewport bottom; shown when hero scrolls out of view.
         Not inside <main> — must NOT have data-reveal.
         ═════════════════════════════════════════════ -->
    <div class="sticky-booking-bar" role="complementary" aria-label="Quick booking bar">
        <a class="sticky-bar-btn sticky-bar-btn--book"
           href="/book"
           aria-label="Book an online appointment at ProTouch Clinic">
            📅 Book Online
        </a>
        <a class="sticky-bar-btn sticky-bar-btn--wa"
           href="https://wa.me/919028027888"
           target="_blank"
           rel="noopener"
           aria-label="Contact ProTouch Clinic via WhatsApp">
            💬 WhatsApp Us
        </a>
    </div>

</div>

@code {
    private readonly string[] guarantees = ["No Fasting", "No Medicine", "No Surgery", "No Side Effects", "No Down Time"];

    private record CarouselSlide(string ImagePath, string Caption);
    private record ServiceCard(string Id, string Number, string Icon, string Name, string Summary, string[] Bullets, string AccentColor, string IconBg);

    // Social Proof data models
    private record StatCounter(string CountDisplay, double CountTarget, string Label);
    private record Testimonial(string Quote, string RoleLabel);

    // Carousel
    private List<CarouselSlide> carouselSlides = new();
    private int activeSlideIndex = 0;
    private System.Threading.Timer? _carouselTimer;

    // Hero
    private List<string> heroImages = new();
    private int activeHeroIndex = 0;
    private System.Threading.Timer? _heroTimer;

    // Service cards (link to /services/{id})
    private List<ServiceCard> serviceCards = new();

    // Social Proof — stat counters and outcome testimonials
    private List<StatCounter> socialProofStats = new();
    private List<Testimonial> testimonials = new();

    protected override void OnInitialized()
    {
        // Hero images — clinic treatment/environment shots only, no personal photos
        heroImages = new List<string>
        {
            "/images/clinic-gallery/gallery-37.jpeg",   // high-res clinic treatment shot
            "/images/clinic-gallery/gallery-42.jpeg",   // high-res clinic interior
            "/images/clinic-gallery/gallery-55.jpeg",   // premium clinic photo
            "/images/clinic-gallery/gallery-29.jpeg",   // rich quality clinic shot
            "/images/clinic-gallery/gallery-38.jpeg",   // high-res treatment room
        };

        // Carousel — 18 curated interleaved slides across all 4 categories
        carouselSlides = new List<CarouselSlide>
        {
            // Fresh selection — spread evenly across all 60 clinic gallery images
            new("/images/clinic-gallery/gallery-03.jpeg",  "ProTouch Physio Clinic"),
            new("/images/clinic-gallery/gallery-06.jpeg",  "Weight Loss Programs"),
            new("/images/clinic-gallery/gallery-09.jpeg",  "Physiotherapy & Rehabilitation"),
            new("/images/clinic-gallery/gallery-12.jpeg",  "Expert Treatment Care"),
            new("/images/clinic-gallery/gallery-15.jpeg",  "Advanced Slimming Therapy"),
            new("/images/clinic-gallery/gallery-19.jpeg",  "Clinic Facilities"),
            new("/images/clinic-gallery/gallery-24.jpeg",  "Specialised Equipment"),
            new("/images/clinic-gallery/gallery-26.jpeg",  "Body Contouring & Toning"),
            new("/images/clinic-gallery/gallery-33.jpeg",  "Personalised Care Plans"),
            new("/images/clinic-gallery/gallery-40.jpeg",  "Slimming & Inch Loss"),
            new("/images/clinic-gallery/gallery-44.jpeg",  "RF & Cryotherapy"),
            new("/images/clinic-gallery/gallery-50.jpeg",  "Children's Programmes"),
            new("/images/clinic-gallery/gallery-54.jpeg",  "Yoga & Nature Cure"),
            new("/images/clinic-gallery/gallery-57.jpeg",  "Sports Rehabilitation"),
            new("/images/clinic-gallery/gallery-60.jpeg",  "Dr. Manjari's Clinic"),
            new("/images/clinic-gallery/gallery-25.jpeg",  "Treatment Room"),
            new("/images/clinic-gallery/gallery-34.jpeg",  "Our Team & Approach"),
            new("/images/clinic-gallery/gallery-45.jpeg",  "Sri Sai ProTouch"),
        };

        // Service cards — each links to its dedicated page
        serviceCards = new List<ServiceCard>
        {
            new("weight-loss", "01", "⚖️", "Weight Loss & Slimming",
                "Weight loss, inch loss, figure correction, body shaping, toning and skin tightening.",
                new[] { "4–8 kg weight loss per month", "2–5 inches loss per session" },
                "#008d36", "rgba(0,141,54,0.08)"),
            new("physiotherapy", "02", "🦴", "Physiotherapy & Rehabilitation",
                "Back, neck and knee pain, arthritis, spondylitis, sinusitis, paralysis and injury care.",
                new[] { "Muscle & ligament injury care", "Orthopaedic & neurological" },
                "#7c1b68", "rgba(124,27,104,0.08)"),
            new("yoga", "03", "🧘", "Yoga & Russian Nature Cure",
                "Personalised yoga for diabetes, blood pressure, thyroid, hormonal health and lifestyle support.",
                new[] { "Menstrual wellness support", "Pre & post-natal care" },
                "#f4b41a", "rgba(244,180,26,0.08)"),
            new("specialised", "04", "⭐", "Specialised Programs For Children",
                "Height increase, sports rehabilitation and focused clinician-guided health plans.",
                new[] { "Height increase up to 23 years", "1–3 inches growth possible" },
                "#e52321", "rgba(229,35,33,0.08)"),
        };

        // Social Proof — clinic-documented outcomes; no patient names or photos
        socialProofStats = new List<StatCounter>
        {
            new("4–8 kg",  8,   "Weight Loss / Month"),
            new("2–5 in",  5,   "Lost Per Session"),
            new("500+",    500, "Patients Served"),
            new("10+",     10,  "Years of Experience"),
        };

        testimonials = new List<Testimonial>
        {
            new("\"Lost 6 kg in the first month without any fasting or medicine — the physiotherapy approach made all the difference.\"",
                "Weight Loss Patient"),
            new("\"My knee pain reduced significantly within two weeks of targeted rehabilitation. Finally able to walk without discomfort.\"",
                "Physiotherapy Patient"),
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _carouselTimer = new System.Threading.Timer(_ =>
            {
                InvokeAsync(() =>
                {
                    activeSlideIndex = (activeSlideIndex + 1) % carouselSlides.Count;
                    StateHasChanged();
                });
            }, null, TimeSpan.FromSeconds(4), TimeSpan.FromSeconds(4));

            _heroTimer = new System.Threading.Timer(_ =>
            {
                InvokeAsync(() =>
                {
                    activeHeroIndex = (activeHeroIndex + 1) % heroImages.Count;
                    StateHasChanged();
                });
            }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));

            // Initialise all homepage animations via site.js (each called exactly once)
            await JS.InvokeVoidAsync("initHeroStagger");
            await JS.InvokeVoidAsync("initScrollReveal");
            await JS.InvokeVoidAsync("initGuaranteeTicker");
            await JS.InvokeVoidAsync("initStickyBar", ".wellness-hero", ".sticky-booking-bar");
            // Note: initStatCounters is NOT called here — it is triggered internally by
            // initScrollReveal when .social-proof-section enters the viewport.
            // Concept 4: Dynamic ambient glow on services section
            await JS.InvokeVoidAsync("initServiceAmbientGlow");
        }
    }

    private void JumpToSlide(int index)
    {
        activeSlideIndex = index;
        _carouselTimer?.Change(TimeSpan.FromSeconds(4), TimeSpan.FromSeconds(4));
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("destroyHomepageAnimations"); } catch { }
        try { _carouselTimer?.Dispose(); } catch { }
        try { _heroTimer?.Dispose(); } catch { }
    }
}
