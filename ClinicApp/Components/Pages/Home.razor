@page "/"
@layout PublicLayout
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ClinicApp.Services.ClinicService ClinicService

<PageTitle>PROTOUCH Physio - Slimming Clinic | Chhatrapati Sambhajinagar</PageTitle>

<div class="pt-page ac-page">

    <!-- ═══════════════════════ HEADER ═══════════════════════ -->
    <header class="pt-header" id="pt-header">
        <a href="#top" class="pt-logo">
                                    <img src="/images/WhatsApp Image 2026-08-12 at 12.25.21 AM.jpeg"
                     alt="ProTouch Physio - Slimming Clinic" width="160" height="48"
                     onerror="this.style.display='none'" />
        </a>
        <nav class="pt-nav ac-nav" role="navigation" aria-label="Main navigation">
            <a href="#services">Services</a>
            <a href="#body-parts">Treatments</a>
            <a href="#team">Team</a>
            <a href="#feedback">Feedback</a>
            <a href="#contact">Contact</a>
        </nav>
        <div class="pt-header-actions">
            <a class="ac-login-btn" href="/Account/Login">Login</a>
            <a class="pt-btn-primary" href="/book">Book a Visit</a>
        </div>
        <button class="pt-hamburger" type="button"
                @onclick="ToggleMobileMenu"
                aria-label="Toggle navigation menu"
                aria-expanded="@_mobileMenuOpen">
            <span></span><span></span><span></span>
        </button>
    </header>

    <div class="pt-mobile-nav @(_mobileMenuOpen ? "pt-mobile-nav--open" : "")">
        <a href="#services"   @onclick="ToggleMobileMenu">Services</a>
        <a href="#body-parts" @onclick="ToggleMobileMenu">Treatments</a>
        <a href="#team"       @onclick="ToggleMobileMenu">Team</a>
        <a href="#feedback"   @onclick="ToggleMobileMenu">Feedback</a>
        <a href="#contact"    @onclick="ToggleMobileMenu">Contact</a>
        <a class="pt-btn-primary" href="/book" @onclick="ToggleMobileMenu">Book a Visit</a>
    </div>

    <!-- ═══════════════════════ HERO ═════════════════════════ -->
    <section class="pt-hero" id="top">
        <div class="pt-hero-left">
            <p class="pt-kicker">✦ ISO 9001:2015 CERTIFIED CLINIC</p>
            <h1 class="pt-hero-h1">
                Take care of<br />
                <em>your health</em>
            </h1>
            <p class="pt-hero-sub">
                Physiotherapy-led slimming, rehabilitation and wellness plans by
                <strong>Dr. Manjari</strong> — created for lasting results, not temporary fixes.
            </p>
            <div class="pt-hero-stats">
                <div class="pt-stat-pill">
                    <span class="pt-stat-num">99%</span>
                    <span class="pt-stat-label">Cured</span>
                </div>
                <span class="pt-stat-divider"></span>
                <div class="pt-stat-pill">
                    <span class="pt-stat-num">4–8 kg</span>
                    <span class="pt-stat-label">/ Month</span>
                </div>
                <span class="pt-stat-divider"></span>
                <div class="pt-stat-pill">
                    <span class="pt-stat-num">500+</span>
                    <span class="pt-stat-label">Patients</span>
                </div>
            </div>
            <div class="pt-hero-actions">
                <a class="pt-btn-primary" href="/book">Book a Visit</a>
                <a class="pt-hero-link" href="#services">Our Services →</a>
            </div>
        </div>
        <div class="pt-hero-right">
            @for (var i = 0; i < heroImages.Count; i++)
            {
                var idx = i;
                var slideClass = idx == 0 ? "pt-hero-slide--1" : idx == 1 ? "pt-hero-slide--2" : "pt-hero-slide--3";
                <div class="pt-hero-slide @slideClass">
<img src="@heroImages[idx]" alt="ProTouch Clinic"
                             loading="@(idx == 0 ? "eager" : "lazy")"
                             fetchpriority="@(idx == 0 ? "high" : "auto")"
                             onerror="this.style.display='none'" />
                </div>
            }
            <div class="pt-hero-overlay-strip"></div>
        </div>
    </section>

    <!-- ═══════════════════ BOOKING BANNER ═══════════════════ -->
    <section class="pt-booking-banner" aria-label="Booking call to action">
        <p class="pt-banner-text">Ready to start your wellness journey?</p>
        <a class="pt-btn-inverse" href="/book">Book a Visit Now →</a>
    </section>

    <!-- ═══════════════════ BODY PART TREATMENTS ═════════════ -->
    <section class="pt-body-parts" id="body-parts" data-reveal>
        <div class="pt-body-parts-inner">
            <p class="pt-kicker">TREATMENTS BY AREA</p>
            <h2>We can help with any part of you</h2>
            <div class="pt-bp-tabs" role="tablist" aria-label="Body area treatments">
                @foreach (var tab in bodyPartTabs)
                {
                    <button class="pt-bp-tab @(activeBodyPart == tab.Id ? "pt-bp-tab--active" : "")"
                            type="button" role="tab"
                            id="tab-@tab.Id"
                            aria-selected="@(activeBodyPart == tab.Id ? "true" : "false")"
                            aria-controls="panel-@tab.Id"
                            @onclick="() => SetBodyPart(tab.Id)">
                        @tab.Label
                    </button>
                }
            </div>
            @{
                var activeBpTab = bodyPartTabs.FirstOrDefault(t => t.Id == activeBodyPart) ?? bodyPartTabs[0];
                var bpIdx = bodyPartTabs.IndexOf(activeBpTab);
                var bpImg = $"/images/clinic-gallery/gallery-{(bpIdx * 9 + 27):D2}.jpeg";
            }
            <div class="pt-bp-panel" id="panel-@activeBpTab.Id" role="tabpanel" aria-labelledby="tab-@activeBpTab.Id">
                <div class="pt-bp-panel-left">
                    <h3>@activeBpTab.Label</h3>
                    <p>@activeBpTab.Description</p>
                    <a class="pt-btn-primary" href="/book">Book Treatment →</a>
                </div>
                <div class="pt-bp-panel-right" aria-hidden="true">
<img src="@bpImg" alt="@activeBpTab.Label" loading="lazy"
                             onerror="this.style.display='none'" />
                </div>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════ SERVICES ═════════════════════ -->
    <section class="pt-services" id="services" data-reveal>
        <div class="pt-services-header">
            <p class="pt-kicker">WHAT WE OFFER</p>
            <h2>Our Services</h2>
            <p class="pt-services-intro">
                Expert-led programmes for weight loss, physiotherapy, yoga and specialised care —
                all under one roof. No fasting, no medicine, no surgery.
            </p>
        </div>
        <div class="pt-services-row">
            @{bool isSvcFirst = true;}
            @foreach (var svc in serviceCards)
            {
                var svcIdx = serviceCards.IndexOf(svc);
                var svcImgNum = svcIdx * 9 + 1;
                var svcImg = $"/images/clinic-gallery/gallery-{svcImgNum:D2}.jpeg";
                <div class="pt-svc-card" style="--svc-accent: @svc.AccentColor">
                    <div class="pt-svc-card-img">
<img src="@svcImg" alt="@svc.Name"
                                 loading="@(isSvcFirst ? "eager" : "lazy")"
                                 fetchpriority="@(isSvcFirst ? "high" : "auto")"
                                 onerror="this.style.display='none'" />
                    </div>
                    <div class="pt-svc-card-body">
                        <h3>@svc.Name</h3>
                        <p>@svc.Summary</p>
                        <a class="pt-svc-link" href="/services/@svc.Id">View &amp; Book →</a>
                    </div>
                </div>
                isSvcFirst = false;
            }
        </div>
    </section>

    <!-- ═══════════════════ HOW IT WORKS ═════════════════════ -->
    <section class="pt-how-it-works" data-reveal>
        <div class="pt-how-inner">
            <p class="pt-kicker">HOW IT WORKS</p>
            <h2>Our team of specialists is at your service</h2>
            <div class="pt-steps">
                @foreach (var step in howItWorksSteps)
                {
                    <div class="pt-step">
                        <span class="pt-step-num" aria-hidden="true">@step.Number</span>
                        <h3 class="pt-step-title">@step.Title</h3>
                        <p class="pt-step-desc">@step.Description</p>
                    </div>
                }
            </div>
            <blockquote class="pt-pull-quote">
                <p>"The best care for lasting results!"</p>
                <footer>— ISO 9001:2015 Certified Clinic</footer>
            </blockquote>
        </div>
    </section>

    <!-- ═══════════════════ DARK CTA + STATS ═════════════════ -->
    <section class="pt-dark-cta" data-reveal>
        <div class="pt-dark-cta-inner">
            <div class="pt-dark-cta-copy">
                <p class="pt-kicker" style="color: var(--pt-mint)">ISO 9001:2015 CERTIFIED</p>
                <h2>Take care of your health anytime, anywhere</h2>
                <p>
                    In-clinic and teleconsultation appointments available.
                    Dr. Manjari's team is ready to build your personalised plan today —
                    no fasting, no medicine, no surgery.
                </p>
                <a class="pt-btn-primary" href="/book">Book a Visit Now →</a>
            </div>
            <div class="pt-dark-stats social-proof-section ac-stats" data-reveal>
                @foreach (var stat in socialProofStats)
                {
                    <div class="pt-dark-stat">
                        <span class="pt-dark-stat-num"
                              data-count-target="@stat.CountTarget"
                              data-count-display="@stat.CountDisplay">@stat.CountDisplay</span>
                        <span class="pt-dark-stat-label">@stat.Label</span>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- ═══════════════════ SPECIALISTS / TEAM ═══════════════ -->
    <section class="pt-specialists" id="team" data-reveal>
        <div class="pt-specialists-inner">
            <p class="pt-kicker">MEET THE TEAM</p>
            <h2>Our team of specialists is at your service</h2>
            <div class="pt-specialists-grid">
                <!-- Primary: Dr. Manjari -->
                <div class="pt-specialist-card pt-specialist-card--primary">
                    <div class="pt-specialist-photo">
                                                <img src="/images/clinic-gallery/gallery-27.jpeg"
                                 alt="Dr. Manjari — Physiotherapist &amp; Slimming Expert"
                                 loading="lazy" onerror="this.style.display='none'" />
                    </div>
                    <div class="pt-specialist-body">
                        <h3>Dr. Manjari</h3>
                        <p class="pt-specialist-title">Physiotherapist &amp; Slimming Expert</p>
                        <ul class="pt-specialist-creds">
                            @foreach (var cred in doctorCredentials)
                            {
                                <li>@cred</li>
                            }
                        </ul>
                        <a class="pt-btn-primary" href="/book">Book Consultation →</a>
                    </div>
                </div>
                <!-- Supporting practitioners -->
                @foreach (var practitioner in supportingPractitioners)
                {
                    <div class="pt-specialist-card">
                        <div class="pt-specialist-photo pt-specialist-photo--placeholder" aria-hidden="true">
                            <span>👤</span>
                        </div>
                        <div class="pt-specialist-body">
                            <h3>@practitioner.Title</h3>
                            <p class="pt-specialist-title">ProTouch Specialist</p>
                            <a class="pt-link" href="#contact">Learn More →</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- ═══════════════════ BMI ESTIMATOR ════════════════════ -->
    <section class="pt-bmi" id="bmi-estimator" data-reveal>
        <div class="pt-bmi-inner">
            <p class="pt-kicker">WELLNESS ESTIMATOR</p>
            <h2>Discover your personalised wellness plan.</h2>
            <p class="pt-bmi-intro">Enter your details for an instant, personalised estimate — then book a free consultation.</p>
            <div class="pt-bmi-form">
                <div class="pt-bmi-field">
                    <label for="bmi-height">Height (cm)</label>
                    <input id="bmi-height" type="number" min="100" max="250" placeholder="e.g. 165"
                           @bind="_heightCm" @bind:event="oninput" />
                    @if (!string.IsNullOrEmpty(_heightError))
                    {
                        <span class="pt-field-error">@_heightError</span>
                    }
                </div>
                <div class="pt-bmi-field">
                    <label for="bmi-weight">Weight (kg)</label>
                    <input id="bmi-weight" type="number" min="20" max="300" step="0.1" placeholder="e.g. 70.5"
                           @bind="_weightKg" @bind:event="oninput" />
                    @if (!string.IsNullOrEmpty(_weightError))
                    {
                        <span class="pt-field-error">@_weightError</span>
                    }
                </div>
                <div class="pt-bmi-field">
                    <label for="bmi-goal">Wellness Goal</label>
                    <select id="bmi-goal" @bind="_bmiGoal">
                        <option value="">Select a goal…</option>
                        <option>Weight Loss</option>
                        <option>Inch Loss</option>
                        <option>Physiotherapy / Pain Relief</option>
                        <option>Yoga &amp; Wellness</option>
                        <option>Height Increase</option>
                    </select>
                    @if (!string.IsNullOrEmpty(_goalError))
                    {
                        <span class="pt-field-error">@_goalError</span>
                    }
                </div>
                <button class="pt-btn-primary" type="button" @onclick="ComputeBmi">Calculate →</button>
            </div>
            @if (_bmiValue.HasValue)
            {
                <div class="pt-bmi-result" style="--bmi-color: @_bmiColor">
                    <div class="pt-bmi-score">
                        <span class="pt-bmi-num">@_bmiValue</span>
                        <span class="pt-bmi-label">BMI — @_bmiCategory</span>
                    </div>
                    <p class="pt-bmi-message">@_bmiMessage</p>
                    <p class="pt-bmi-outcome"><em>@_bmiOutcome</em></p>
                    <a class="pt-btn-primary" href="/book">Book Your Free Consultation →</a>
                </div>
            }
        </div>
    </section>

    <!-- ═══════════════════ PHOTO GALLERY ════════════════════ -->
    <section class="pt-gallery" id="gallery" data-reveal>
        <p class="pt-kicker">CLINIC GALLERY</p>
        <h2>A glimpse inside ProTouch.</h2>
        <div class="pt-gallery-grid">
            @for (int i = 0; i < _galleryVisible; i++)
            {
                var idx = i;
                <div class="pt-gallery-item" @onclick="() => OpenLightbox(idx)">
<img src="@GalleryImages[idx]"
                             alt="ProTouch Clinic @(idx + 1)"
                             loading="@(idx < 6 ? "eager" : "lazy")"
                             onerror="this.style.display='none'" />
                </div>
            }
        </div>
        @if (CanLoadMore)
        {
            <button class="pt-load-more" @onclick="LoadMoreGallery">Load More Photos</button>
        }
        @if (_isLightboxOpen)
        {
            <div class="pt-lightbox" role="dialog" aria-modal="true">
                <button class="pt-lightbox-close" @onclick="CloseLightbox" aria-label="Close lightbox">✕</button>
                <button class="pt-lightbox-prev" @onclick="LightboxPrev" aria-label="Previous image">‹</button>
<img src="@GalleryImages[_selectedLightboxIndex]"
                         alt="Gallery image @(_selectedLightboxIndex + 1)" />
                <button class="pt-lightbox-next" @onclick="LightboxNext" aria-label="Next image">›</button>
            </div>
        }
    </section>

    <!-- ═══════════════════ TESTIMONIALS ═════════════════════ -->
    <section class="pt-testimonials ac-testimonials" data-reveal>
        <div class="pt-testimonials-inner">
            <p class="pt-kicker">PATIENT STORIES</p>
            <h2>Hear from our patients.</h2>
            <div class="pt-testi-track">
                @for (var i = 0; i < testimonials.Count; i++)
                {
                    var t = testimonials[i];
                    var ti = i;
                    <div class="pt-testi-slide @(ti == activeTestiIndex ? "ac-testi--active" : "")">
                        <span class="pt-stars">★★★★★</span>
                        <p class="pt-testi-quote">@t.Quote</p>
                        <footer class="pt-testi-footer">— @t.RoleLabel</footer>
                    </div>
                }
            </div>
            <div class="pt-testi-arrows">
                <button type="button" @onclick="PrevTesti" aria-label="Previous testimonial">‹</button>
                <button type="button" @onclick="NextTesti" aria-label="Next testimonial">›</button>
            </div>
            <div class="pt-testi-dots" role="tablist" aria-label="Testimonial slides">
                @for (var i = 0; i < testimonials.Count; i++)
                {
                    var di = i;
                    <button type="button"
                            class="@(di == activeTestiIndex ? "active" : "")"
                            @onclick="() => JumpToTesti(di)"
                            aria-label="Testimonial @(di + 1)"></button>
                }
            </div>
        </div>
    </section>

    <!-- ═══════════════════ FAQ ACCORDION ════════════════════ -->
    <section class="pt-faq" data-reveal>
        <div class="pt-faq-inner">
            <p class="pt-kicker">FREQUENTLY ASKED</p>
            <h2>Your questions, answered.</h2>
            <div class="pt-faq-list">
                @for (var i = 0; i < faqItems.Count; i++)
                {
                    var fi = i;
                    var fq = faqItems[fi];
                    <div class="pt-faq-item @(openFaq == fi ? "ac-faq--open" : "")">
                        <button class="pt-faq-q" type="button" @onclick="() => ToggleFaq(fi)">
                            @fq.Q
                            <span class="pt-faq-icon">+</span>
                        </button>
                        <div class="pt-faq-a">
                            <p>@fq.A</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- ═══════════════════ FEEDBACK WIDGET ══════════════════ -->
    <section class="pt-feedback" id="feedback" data-reveal>
        <div class="pt-feedback-inner">
            <p class="pt-kicker">SHARE YOUR EXPERIENCE</p>
            <h2>How was your visit?</h2>
            @if (_feedbackSuccess)
            {
                <div class="pt-feedback-success">
                    <span>⭐</span>
                    <p>Thank you! Your feedback has been recorded.</p>
                </div>
            }
            else
            {
                <div class="pt-feedback-form">
                    <div class="pt-stars-row" role="group" aria-label="Star rating">
                        @for (int s = 1; s <= 5; s++)
                        {
                            var star = s;
                            <button type="button"
                                    class="pt-star-btn @((_feedbackHoverRating > 0 ? star <= _feedbackHoverRating : star <= _feedbackRating) ? "ac-star--lit" : "")"
                                    @onclick="() => SetFeedbackStar(star)"
                                    @onmouseenter="() => HoverFeedbackStar(star)"
                                    @onmouseleave="UnhoverFeedbackStar"
                                    aria-label="@star star@(star > 1 ? "s" : "")">★</button>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(_feedbackError))
                    {
                        <p class="pt-feedback-error" role="alert">@_feedbackError</p>
                    }
                    <textarea class="pt-feedback-textarea" maxlength="500"
                              placeholder="Tell us about your experience (optional)..."
                              @bind="_feedbackComment" @bind:event="oninput"></textarea>
                    <p class="pt-char-counter">@FeedbackCharsRemaining characters remaining</p>
                    <button class="pt-btn-primary" type="button"
                            disabled="@_feedbackSubmitting"
                            @onclick="SubmitFeedbackAsync">
                        @(_feedbackSubmitting ? "Submitting…" : "Submit Feedback →")
                    </button>
                </div>
            }
        </div>
    </section>

    <!-- ═══════════════════ CONTACT ═══════════════════════════ -->
    <section class="pt-contact" id="contact" data-reveal>
        <div class="pt-contact-inner">
            <div class="pt-contact-left">
                <p class="pt-kicker">GET IN TOUCH</p>
                <h2>Let's take the first step together.</h2>
                <p>Contact Dr. Manjari to discuss a physiotherapy, slimming or wellness plan that fits you.</p>
                <div class="pt-contact-actions">
                    <a class="pt-btn-primary" href="/book">Book an Appointment →</a>
                    <a class="pt-btn-ghost" href="https://wa.me/919028027888" target="_blank" rel="noopener noreferrer">💬 WhatsApp Us</a>
                </div>
            </div>
            <div class="pt-contact-right">
                <div class="pt-contact-details">
                    <div class="pt-contact-detail-item">
                        <span class="pt-detail-icon">📞</span>
                        <div>
                            <a href="tel:9673530031"><strong>96735 30031</strong></a>
                            <a href="tel:+919028027888" style="display:block;margin-top:4px"><strong>+91 90280 27888</strong></a>
                            <span>Primary &amp; WhatsApp</span>
                        </div>
                    </div>
                    <div class="pt-contact-detail-item">
                        <span class="pt-detail-icon">✉️</span>
                        <div>
                            <a href="mailto:protouch1998@gmail.com"><strong>protouch1998@gmail.com</strong></a>
                            <span>Email Us</span>
                        </div>
                    </div>
                    <div class="pt-contact-detail-item">
                        <span class="pt-detail-icon">📍</span>
                        <div>
                            <strong>Row H. No. 22, Kasliwal Bhagyoday,<br />Beed By-pass, Chhatrapati Sambhajinagar – 431010</strong>
                            <span>Clinic Address</span>
                        </div>
                    </div>
                </div>
                <a class="pt-directions-link"
                   href="https://www.google.com/maps/search/?api=1&query=Kasliwal+Bhagyoday+Beed+By-pass+Chhatrapati+Sambhajinagar"
                   target="_blank" rel="noopener noreferrer">Get Directions →</a>
            </div>
        </div>
    </section>

    <!-- ═══════════════════ FOOTER ════════════════════════════ -->
    <footer class="pt-footer">
        © @DateTime.Now.Year PROTOUCH Physio - Slimming Clinic
        <span>•</span> Dr. Manjari
        <span>•</span> Chhatrapati Sambhajinagar
    </footer>

    <!-- ═══════════════════ FLOATING CTA ═════════════════════ -->
    <div class="pt-floating-cta" role="complementary" aria-label="Quick actions">
        <a class="pt-float-btn pt-float-wa" href="https://wa.me/919028027888"
           target="_blank" rel="noopener noreferrer" aria-label="WhatsApp us">💬</a>
        <a class="pt-float-btn pt-float-book" href="/book" aria-label="Book appointment">📅</a>
    </div>

    <button class="ac-back-to-top" id="ac-back-to-top" type="button"
            aria-label="Back to top"
            @onclick='async () => await JS.InvokeVoidAsync("scrollToTop")'>↑</button>

</div>

@code {
    private record CarouselSlide(string ImagePath, string Caption);
    private record ServiceCard(string Id, string Number, string Icon, string Name, string Summary, string[] Bullets, string AccentColor, string IconBg);
    private record StatCounter(string CountDisplay, double CountTarget, string Label);
    private record Testimonial(string Quote, string RoleLabel);
    private record FaqItem(string Q, string A);
    private record BodyPartTab(string Id, string Label, string Description);
    private record HowItWorksStep(string Number, string Title, string Description);
    private record SupportingPractitioner(string Title);

    // ── Hero ─────────────────────────────────────────────────
    private List<string> heroImages = new();
    private int activeHeroIndex = 0;

    // ── Testimonial carousel ─────────────────────────────────
    private int activeTestiIndex = 0;

    // ── Services tabs ────────────────────────────────────────
    private string activeTab = "weight-loss";

    // ── FAQ ──────────────────────────────────────────────────
    private int openFaq = -1;

    // ── Body parts ───────────────────────────────────────────
    private string activeBodyPart = "neck-shoulder";
    private List<BodyPartTab> bodyPartTabs = new();
    private List<HowItWorksStep> howItWorksSteps = new();
    private List<SupportingPractitioner> supportingPractitioners = new();
    private List<string> doctorCredentials = new();

    // ── Navigation ───────────────────────────────────────────
    private bool _mobileMenuOpen = false;
    private void ToggleMobileMenu() => _mobileMenuOpen = !_mobileMenuOpen;
    private void SetBodyPart(string id) => activeBodyPart = id;

    // ── Data lists ───────────────────────────────────────────
    private List<ServiceCard> serviceCards = new();
    private List<StatCounter> socialProofStats = new();
    private List<Testimonial> testimonials = new();
    private List<FaqItem> faqItems = new();
    private readonly string[] guarantees = ["No Fasting", "No Medicine", "No Surgery", "No Side Effects", "No Down Time"];
