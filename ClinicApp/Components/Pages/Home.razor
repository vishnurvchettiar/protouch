    private void SetFeedbackStar(int star)   => _feedbackRating = star;
    private void HoverFeedbackStar(int star) => _feedbackHoverRating = star;
    private void UnhoverFeedbackStar()       => _feedbackHoverRating = 0;

    private async Task SubmitFeedbackAsync()
    {
        _feedbackError = "";
        if (_feedbackRating == 0)
        {
            _feedbackError = "Please select a star rating before submitting.";
            return;
        }
        _feedbackSubmitting = true;
        try
        {
            await ClinicService.SaveFeedbackAsync(_feedbackRating, _feedbackComment);
            _feedbackSuccess = true;
        }
        catch
        {
            _feedbackError = "Unable to save your feedback. Please try again.";
        }
        finally
        {
            _feedbackSubmitting = false;
        }
    }

