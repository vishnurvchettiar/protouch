@page "/"
@layout PublicLayout

<PageTitle>PROTOUCH Physio - Slimming Clinic | Chhatrapati Sambhajinagar</PageTitle>

<div class="ppage" data-ptx="home">

    <!-- ═══════════════ HERO: a framed photo that grows to full screen as you scroll ═══════════════ -->
    <section class="zh dk" id="top">
        <div class="top">Physio &amp; Slimming Clinic · Chhatrapati Sambhajinagar</div>
        <div class="bgw" aria-hidden="true"><span class="hw1">Gentle</span><span class="hw2">touch</span></div>
        <div class="frame">
            <img decoding="async" src="@heroImages[0].ImagePath" alt="@heroImages[0].Caption" />
        </div>
        <div class="side">
            <div><b>500+</b><span>patients served</span></div>
            <div><b>ISO</b><span>9001:2015 certified</span></div>
        </div>
        <div class="ov">
            <div class="c">
                <h1>Care that feels <em>personal</em>, results that last.</h1>
                <p>Physiotherapy-led slimming, rehabilitation and wellness by <strong>Dr. Manjari</strong>. No fasting, no medicine, no surgery.</p>
                <div class="prow">
                    <a class="pbtn" href="/book" data-magnet><span>Book a Visit <b class="ar">→</b></span></a>
                    <a class="pbtn o" href="/services" data-magnet><span>Explore services</span></a>
                </div>
            </div>
        </div>
        <div class="hint">Scroll</div>
    </section>
    <Wave Kind="dl" />

    <!-- ═══════════════ BELIEF + FIGURES ═══════════════ -->
    <section class="sec lt" style="padding-top:clamp(30px,5vw,70px)">
        <div class="c">
            <div class="eb" data-rv><i></i>Our belief</div>
            <p class="st" data-hl>ProTouch is built on a simple idea: <span class="chip">care</span> should be personal, hands-on and honest. Led by Dr. Manjari, our ISO 9001:2015 certified clinic has served 500+ patients, helping them lose weight, ease pain and feel well without fasting, medicine or surgery.</p>
            <div class="circ" data-st>
                @for (var i = 0; i < socialProofStats.Count; i++)
                {
                    var stat = socialProofStats[i];
                    <div class="cc">
                        <div class="r">
                            <svg viewBox="0 0 100 100" aria-hidden="true">
                                <circle class="b" cx="50" cy="50" r="44" />
                                <circle class="f" cx="50" cy="50" r="44" data-p="@ringPercent[i]" />
                            </svg>
                            <b data-ct>@stat.CountDisplay</b>
                        </div>
                        <span>@stat.Label</span>
                    </div>
                }
            </div>
        </div>
    </section>
    <Wave Kind="ld" />

    <!-- ═══════════════ SERVICES: cards stack as you scroll ═══════════════ -->
    <section class="sec dk" id="services" style="padding-top:clamp(30px,5vw,70px)">
        <div class="c">
            <div class="eb" data-rv><i></i>Our services</div>
            <h2 class="h" data-split>Four programmes, <em>stacked</em> with care.</h2>
            <div style="margin-top:60px">
                @foreach (var svc in serviceCards)
                {
                    <article class="sc">
                        <div class="tx">
                            <span class="no">@svc.Number</span>
                            <h3>@svc.Name</h3>
                            <p>@svc.Summary</p>
                            <ul>
                                @foreach (var bullet in svc.Bullets)
                                {
                                    <li>@bullet</li>
                                }
                            </ul>
                            <div><a class="pbtn" href="/services/@svc.Id" data-magnet><span>View &amp; book <b class="ar">→</b></span></a></div>
                        </div>
                        <div class="ph">
                            <img decoding="async" src="@svc.ImagePath" alt="@svc.ImageAlt" loading="lazy" />
                            <span class="cir" aria-hidden="true">→</span>
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>
    <Wave Kind="dl" />

    <!-- ═══════════════ FIND YOUR AREA ═══════════════ -->
    <section class="sec lt" id="body-parts" style="padding-top:clamp(30px,5vw,70px)">
        <div class="c fd">
            <div>
                <div class="eb" data-rv><i></i>Treatments by area</div>
                <h2 class="h" data-split>We can help with <em>any part</em> of you.</h2>
                <div class="tabs" role="tablist" aria-label="Body area treatments">
                    @for (var i = 0; i < bodyPartTabs.Count; i++)
                    {
                        var tab = bodyPartTabs[i];
                        <button class="tab @(i == 0 ? "on" : "")" type="button" role="tab"
                                aria-selected="@(i == 0 ? "true" : "false")"
                                data-t="@tab.Label" data-desc="@tab.Description">@tab.Label<span>@((i + 1).ToString("00"))</span></button>
                    }
                </div>
            </div>
            <div class="cl">
                <div class="big">
                    @for (var i = 0; i < bodyPartTabs.Count; i++)
                    {
                        var tab = bodyPartTabs[i];
                        <img decoding="async" class="@(i == 0 ? "on" : "")" src="@tab.ImagePath" alt="@tab.ImageAlt" loading="@(i == 0 ? "eager" : "lazy")" />
                    }
                </div>
                <div class="sm"><img decoding="async" src="/images/clinic_hero.jpg" alt="ProTouch clinic reception" loading="lazy" /></div>
                <div class="ap">
                    <h3>@bodyPartTabs[0].Label</h3>
                    <p class="desc">@bodyPartTabs[0].Description</p>
                    <a class="pbtn" href="/book"><span>Book treatment <b class="ar">→</b></span></a>
                </div>
            </div>
        </div>
    </section>

    <!-- ═══════════════ WELLNESS ESTIMATOR (interactive) ═══════════════ -->
    <section class="sec lt" id="bmi-estimator" style="padding-top:0">
        <div class="c bmi">
            <div>
                <div class="eb" data-rv><i></i>Wellness estimator</div>
                <h2 class="h" data-split>Discover your <em>personalised</em> plan.</h2>
                <p class="plead" data-rv style="margin-top:20px">Enter your details for an instant, personalised estimate, then book a free consultation.</p>
            </div>
            <div data-rv>
                <BmiEstimator @rendermode="InteractiveServer" />
            </div>
        </div>
    </section>
    <Wave Kind="ld" />

    <!-- ═══════════════ PINNED STATEMENT ═══════════════ -->
    <section class="dp" id="approach">
        <div class="stg2">
            <span class="m" aria-hidden="true">“</span>
            <div class="qt">
                <div class="eb" style="background:rgba(255,255,255,.08);color:var(--gold)"><i></i>Our promise</div>
                <q>The best care for lasting results.</q>
                <cite>ISO 9001:2015 Certified Clinic</cite>
                <div class="cr">
                    @foreach (var g in guarantees)
                    {
                        <span>@g</span>
                    }
                </div>
            </div>
        </div>
    </section>
    <Wave Kind="dl" />

    <!-- ═══════════════ TEAM + HOW IT WORKS ═══════════════ -->
    <section class="sec lt" id="team" style="padding-top:clamp(30px,5vw,70px)">
        <div class="c">
            <div class="eb" data-rv><i></i>Meet the team</div>
            <h2 class="h" data-split style="max-width:900px">Our team of specialists is at <em>your service.</em></h2>
            <div class="tm2" style="margin-top:50px">
                <div class="drc" data-rv>
                    <div class="im" aria-hidden="true">M</div>
                    <div>
                        <h3>Dr. Manjari</h3>
                        <span class="role">Physiotherapist &amp; Slimming Expert</span>
                        <ul class="creds2">
                            @foreach (var cred in doctorCredentials)
                            {
                                <li>@cred</li>
                            }
                        </ul>
                        <a class="pbtn" href="/book" data-magnet><span>Book consultation <b class="ar">→</b></span></a>
                    </div>
                </div>
                <div class="prs" data-st>
                    @foreach (var practitioner in supportingPractitioners)
                    {
                        <div class="pr2">
                            <i aria-hidden="true">@practitioner.Title.Substring(0, 1)</i>
                            <div><b>@practitioner.Title</b><span>ProTouch specialist</span></div>
                        </div>
                    }
                </div>
            </div>

            <div style="text-align:center;margin-top:clamp(80px,10vw,130px)">
                <div class="eb" data-rv><i></i>How it works</div>
                <h2 class="h" data-split>Three gentle <em>steps.</em></h2>
                <div class="ps three">
                    <div class="pr"></div>
                    @for (var i = 0; i < howItWorksSteps.Count; i++)
                    {
                        var step = howItWorksSteps[i];
                        <div class="pst">
                            <div class="o">@(i + 1)</div>
                            <h3>@step.Title</h3>
                            <p>@step.Description</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
    <Wave Kind="ld" />

    <!-- ═══════════════ GALLERY ═══════════════ -->
    <section class="sec dk" id="gallery" style="padding-top:clamp(30px,5vw,70px)">
        <div class="c">
            <div class="eb" data-rv><i></i>Clinic gallery</div>
            <h2 class="h" data-split>A glimpse inside <em>ProTouch.</em></h2>
            <div data-lbset>
                <GalleryGrid @rendermode="InteractiveServer" />
            </div>
        </div>
    </section>
    <Wave Kind="dl" />

    <!-- ═══════════════ PATIENT STORIES + FAQ + FEEDBACK ═══════════════ -->
    <section class="sec lt" id="stories" style="padding-top:clamp(30px,5vw,70px)">
        <div class="c" style="text-align:center">
            <div class="eb" data-rv><i></i>Patient stories</div>
            <h2 class="h" data-split>Hear from our <em>patients.</em></h2>
            <div class="tt-wrap">
                <div class="tt" aria-live="polite">
                    @for (var i = 0; i < testimonials.Count; i++)
                    {
                        var t = testimonials[i];
                        <div class="tq @(i == 0 ? "on" : "")">
                            <span class="stars" aria-hidden="true">★★★★★</span>
                            <q>@t.Quote</q>
                            <small>— @t.RoleLabel</small>
                        </div>
                    }
                </div>
                <div class="tctl">
                    <button class="tprev" type="button" aria-label="Previous testimonial">‹</button>
                    <div class="tdots">
                        @for (var i = 0; i < testimonials.Count; i++)
                        {
                            <button type="button" class="@(i == 0 ? "on" : "")" aria-label="Testimonial @(i + 1)"></button>
                        }
                    </div>
                    <button class="tnext" type="button" aria-label="Next testimonial">›</button>
                </div>
            </div>

            <div style="margin-top:clamp(80px,10vw,130px)">
                <div class="eb" data-rv><i></i>Frequently asked</div>
                <h2 class="h" data-split>Your questions, <em>answered.</em></h2>
                <div class="faq">
                    @foreach (var fq in faqItems)
                    {
                        <div class="q">
                            <button type="button" aria-expanded="false"><span>@fq.Q</span><i>+</i></button>
                            <div class="a"><div><p>@fq.A</p></div></div>
                        </div>
                    }
                </div>
            </div>

            <div id="feedback" style="margin-top:clamp(80px,10vw,130px)">
                <div class="fbk">
                    <div class="eb" data-rv><i></i>Share your experience</div>
                    <h2 class="h" data-split>How was your <em>visit?</em></h2>
                    <div data-rv>
                        <FeedbackForm @rendermode="InteractiveServer" />
                    </div>
                </div>
            </div>
        </div>
    </section>
    <Wave Kind="ld" />

    <!-- ═══════════════ CONTACT ═══════════════ -->
    <section class="sec dk" id="contact" style="padding-top:clamp(30px,5vw,70px)">
        <div class="c ctc">
            <div>
                <div class="eb" data-rv><i></i>Get in touch</div>
                <h2 class="h" data-split>Let's take the first step <em>together.</em></h2>
                <p class="b" data-rv>Contact Dr. Manjari to discuss a physiotherapy, slimming or wellness plan that fits you.</p>
                <div class="acts" data-rv>
                    <a class="pbtn g" href="/book" data-magnet><span>Book an appointment <b class="ar">→</b></span></a>
                    <a class="pbtn o" href="https://wa.me/919028027888" target="_blank" rel="noopener noreferrer" data-magnet><span>WhatsApp us</span></a>
                </div>
            </div>
            <div class="cds" data-st>
                <div class="cd">
                    <i><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z" /></svg></i>
                    <div>
                        <small>Phone · WhatsApp</small>
                        <a href="tel:9673530031"><strong>96735 30031</strong></a><br />
                        <a href="tel:+919028027888"><strong>+91 90280 27888</strong></a>
                    </div>
                </div>
                <div class="cd">
                    <i><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3" /><path d="M3 8l9 6 9-6" /></svg></i>
                    <div>
                        <small>Email us</small>
                        <a href="mailto:protouch1998@gmail.com"><strong>protouch1998@gmail.com</strong></a>
                    </div>
                </div>
                <div class="cd">
                    <i><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></svg></i>
                    <div>
                        <small>Clinic address</small>
                        <strong>Row H. No. 22, Kasliwal Bhagyoday,<br />Beed By-pass, Chhatrapati Sambhajinagar – 431010</strong><br />
                        <a class="dirs" href="https://www.google.com/maps/search/?api=1&query=Kasliwal+Bhagyoday+Beed+By-pass+Chhatrapati+Sambhajinagar"
                           target="_blank" rel="noopener noreferrer">Get directions →</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@code {
    private record CarouselSlide(string ImagePath, string Caption);
    private record ServiceCard(string Id, string Number, string Name, string Summary, string[] Bullets, string ImagePath, string ImageAlt);
    private record StatCounter(string CountDisplay, string Label);
    private record Testimonial(string Quote, string RoleLabel);
    private record FaqItem(string Q, string A);
    private record BodyPartTab(string Id, string Label, string Description, string ImagePath, string ImageAlt);
    private record HowItWorksStep(string Number, string Title, string Description);
    private record SupportingPractitioner(string Title);

    private readonly int[] ringPercent = { 80, 50, 100, 70 };
    private readonly string[] guarantees = ["No Fasting", "No Medicine", "No Surgery", "No Side Effects", "No Down Time"];

    private List<CarouselSlide> heroImages = new();
    private List<BodyPartTab> bodyPartTabs = new();
    private List<HowItWorksStep> howItWorksSteps = new();
    private List<SupportingPractitioner> supportingPractitioners = new();
    private List<string> doctorCredentials = new();
    private List<ServiceCard> serviceCards = new();
    private List<StatCounter> socialProofStats = new();
    private List<Testimonial> testimonials = new();
    private List<FaqItem> faqItems = new();

    protected override void OnInitialized()
    {
        heroImages = new List<CarouselSlide>
        {
            new("/images/homepage/weight-loss.png", "Nutritionist discussing a healthy meal plan with a client."),
        };

        bodyPartTabs = new List<BodyPartTab>
        {
            new("neck-shoulder", "Neck & Shoulder", "Physiotherapy for cervical spondylitis, neck pain, frozen shoulder and upper-limb rehabilitation.", "/images/homepage/physiotherapy-session.png", "Physiotherapist guiding a patient through a shoulder mobility exercise."),
            new("back-spine",    "Back & Spine",    "Treatment for lumbar spondylitis, sciatica, slipped disc and post-operative spinal care.", "/images/homepage/back-spine.png", "Physiotherapist supervising a gentle back mobility exercise."),
            new("knee-leg",      "Knee & Leg",      "Knee pain, arthritis, ligament rehabilitation and sports injury recovery.", "/images/homepage/knee-leg.png", "Physiotherapist guiding a patient through a knee strengthening exercise."),
            new("arm-elbow",     "Arm & Elbow",     "Tennis elbow, golfer's elbow, repetitive strain and fracture rehabilitation.", "/images/homepage/arm-elbow.png", "Physiotherapist supporting a patient during a forearm and wrist mobility exercise."),
            new("abdomen-core",  "Abdomen & Core",  "Core strengthening, diastasis recti, post-natal rehabilitation and inch-loss programmes.", "/images/homepage/abdomen-core.png", "Physiotherapist supervising a gentle core stability exercise."),
            new("full-body",     "Full Body Wellness", "Weight loss, inch loss, yoga therapy, Russian nature cure and overall body contouring.", "/images/homepage/full-body-wellness.png", "Client practicing a supported yoga balance pose with a therapist."),
        };

        howItWorksSteps = new List<HowItWorksStep>
        {
            new("01", "Book a Consultation",
                "Choose your preferred service and submit a booking request online or by calling 96735 30031. Our team confirms your appointment within 24 hours."),
            new("02", "Personalised Assessment",
                "Dr. Manjari conducts a thorough assessment of your health profile, goals and medical history. A tailored treatment plan is created specifically for you."),
            new("03", "Start Your Journey",
                "Begin your programme with expert guidance, track your progress and achieve lasting results — no fasting, no medicine, no surgery."),
        };

        supportingPractitioners = new List<SupportingPractitioner>
        {
            new("Senior Physiotherapist"),
            new("Yoga Therapist"),
            new("Diet & Nutrition Consultant"),
        };

        doctorCredentials = new List<string>
        {
            "ISO 9001:2015 Certified Clinic — National & International Accreditation",
            "Specialised in Weight Loss, Inch Loss & Body Contouring",
            "Expert in Physiotherapy, Rehabilitation & Sports Medicine",
            "Certified Yoga Therapist — Holistic & Nature Cure",
            "Height Increase Programs (up to 23 years of age)",
            "10+ Years of Dedicated Clinical Practice",
        };

        serviceCards = new List<ServiceCard>
        {
            new("weight-loss", "01", "Weight Loss & Slimming",
                "Weight loss, inch loss, figure correction, body shaping, toning and skin tightening.",
                new[] { "4–8 kg weight loss per month", "2–5 inches loss per session" },
                "/images/homepage/weight-loss.png", "Nutritionist discussing a healthy meal plan with a client."),
            new("physiotherapy", "02", "Physiotherapy & Rehabilitation",
                "Back, neck and knee pain, arthritis, spondylitis, sinusitis, paralysis and injury care.",
                new[] { "Muscle & ligament injury care", "Orthopaedic & neurological" },
                "/images/homepage/physiotherapy-session.png", "Physiotherapist supporting a patient during a mobility exercise."),
            new("yoga", "03", "Yoga & Russian Nature Cure",
                "Personalised yoga for diabetes, blood pressure, thyroid, hormonal health and lifestyle support.",
                new[] { "Menstrual wellness support", "Pre & post-natal care" },
                "/images/homepage/yoga.png", "Small group following a gentle yoga session."),
            new("specialised", "04", "Specialised Programs For Children",
                "Height increase, sports rehabilitation and focused clinician-guided health plans.",
                new[] { "Height increase up to 23 years", "1–3 inches growth possible" },
                "/images/homepage/specialised-care.png", "Child doing a supervised balance exercise with a parent present."),
        };

        socialProofStats = new List<StatCounter>
        {
            new("4–8 kg",  "Weight Loss / Month"),
            new("2–5 in",  "Lost Per Session"),
            new("500+",    "Patients Served"),
            new("10+",     "Years of Experience"),
        };

        testimonials = new List<Testimonial>
        {
            new("Lost 6 kg in the first month without any fasting or medicine — the physiotherapy approach made all the difference.",
                "Weight Loss Patient"),
            new("My knee pain reduced significantly within two weeks of targeted rehabilitation. Finally able to walk without discomfort.",
                "Physiotherapy Patient"),
            new("The personalised yoga program helped manage my thyroid and I feel more energetic than ever. Highly recommend Dr. Manjari!",
                "Yoga & Wellness Patient"),
            new("My child gained 2 inches through the specialised height increase program. We are extremely happy with the results.",
                "Parent — Specialised Program"),
            new("The slimming program was completely safe — no side effects, no surgery. Lost 8 kg in just 5 weeks.",
                "Slimming Program Patient"),
        };

        faqItems = new List<FaqItem>
        {
            new("Is the weight loss treatment safe?",
                "Yes, all treatments are physiotherapy-led with no surgery, no medicine, no fasting, and no side effects. The clinic is ISO 9001:2015 certified."),
            new("How quickly will I see results?",
                "Most patients see visible inch loss from the very first session. Weight loss of 4–8 kg per month is typical with the full treatment plan."),
            new("Who is eligible for the slimming program?",
                "Anyone above 16 years of age is eligible. A brief health assessment is conducted before starting."),
            new("How many sessions do I need?",
                "Typically 12–24 sessions depending on your goal. Dr. Manjari will create a personalised plan after your first consultation."),
            new("Does the physiotherapy program work for chronic pain?",
                "Yes. We treat back, neck and knee pain, arthritis, spondylitis, paralysis and many more conditions using electrotherapy and manual therapy."),
            new("Can children join the height increase program?",
                "Yes, the program is available up to 23 years of age with potential growth of 1–3 inches. A consultation with Dr. Manjari will determine suitability."),
        };
    }
}
