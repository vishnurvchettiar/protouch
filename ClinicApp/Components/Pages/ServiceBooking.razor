@page "/book"
@layout PublicLayout
@* Task 14.1: NO [Authorize] — page must be accessible anonymously *@

<PageTitle>Book an Appointment | ProTouch Physio - Slimming Clinic</PageTitle>

<div class="ppage" data-ptx="book">

    <section class="ih dk" style="padding-bottom:clamp(60px,7vw,90px)">
        <span class="bl" style="width:560px;height:560px;right:-160px;top:-160px;background:radial-gradient(circle at 30% 30%,rgba(22,99,92,.5),transparent 70%)"></span>
        <div class="c">
            <div class="crumb"><a href="/">Home</a> / <b>Book an appointment</b></div>
            <h1 data-split data-now>Come in, or <em>book ahead.</em></h1>
            <p class="plead" data-hero style="margin-top:24px">Choose a service and share your details. The clinic team will call to confirm your appointment. Teleconsultation is available too.</p>
        </div>
    </section>
    <Wave Kind="dl" />

    <section class="sec lt" style="padding-top:20px">
        <div class="c ct">
            <div data-rv>
                <BookingForm @rendermode="InteractiveServer" Preselect="@PreselectName" />
            </div>
            <div class="ic" data-st>
                <div>
                    <small>Address</small>
                    Row H. No. 22, Kasliwal Bhagyoday, Beed By-pass, Chhatrapati Sambhajinagar – 431010
                    <br /><a class="dirs" style="color:var(--goldd)" href="https://www.google.com/maps/search/?api=1&query=Kasliwal+Bhagyoday+Beed+By-pass+Chhatrapati+Sambhajinagar" target="_blank" rel="noopener noreferrer">Get directions →</a>
                </div>
                <div>
                    <small>Phone</small>
                    <a href="tel:9673530031">96735 30031</a> · <a href="tel:+919028027888">+91 90280 27888</a>
                </div>
                <div>
                    <small>Email</small>
                    <a href="mailto:protouch1998@gmail.com">protouch1998@gmail.com</a>
                </div>
                <div>
                    <small>WhatsApp</small>
                    <a class="pbtn" style="margin-top:8px" href="https://wa.me/919028027888" target="_blank" rel="noopener noreferrer"><span>Chat on WhatsApp <b class="ar">→</b></span></a>
                </div>
            </div>
        </div>
    </section>
</div>

@code {
    /// <summary>Optional ?service=weight-loss style link that pre-selects a service.</summary>
    [SupplyParameterFromQuery(Name = "service")] public string? Service { get; set; }

    private string? PreselectName =>
        !string.IsNullOrWhiteSpace(Service) && PublicCatalog.Services.TryGetValue(Service.ToLowerInvariant(), out var s)
            ? s.Name
            : null;
}
