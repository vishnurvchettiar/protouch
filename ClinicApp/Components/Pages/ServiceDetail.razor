@page "/services/{ServiceId}"
@layout PublicLayout
@rendermode InteractiveServer
@using ClinicApp.Data
@using ClinicApp.Services
@inject ClinicService ClinicService
@inject NavigationManager NavManager

<PageTitle>@(currentService?.Name ?? "Service") | Sri Sai Protouch</PageTitle>

<div class="wellness-page">

    <!-- ── Header ── -->
    <header class="wellness-header">
        <a href="/" class="wellness-logo">
            <img src="/images/sri-sai-protouch-logo.svg" alt="Sri Sai Protouch" />
        </a>
        <nav>
            <a href="/">Home</a>
            <a href="/#services">Services</a>
            <a href="/#approach">Our Approach</a>
            <a href="/#contact">Contact</a>
        </nav>
        <a class="wellness-call" href="tel:9673530031">📞 Call 96735 30031</a>
    </header>

    @if (currentService == null)
    {
        <div style="max-width:700px;margin:6rem auto;padding:0 1.5rem;text-align:center;">
            <p class="section-kicker">404 — NOT FOUND</p>
            <h1 style="font-family:'Playfair Display',Georgia,serif;color:#1a1520;font-size:2.8rem;margin:1rem 0;">Service not found.</h1>
            <p style="color:#6b636d;margin-bottom:2rem;">The service you're looking for doesn't exist. Browse all our services below.</p>
            <a class="wellness-primary" href="/#services">← View All Services</a>
        </div>
    }
    else
    {
        <!-- ── Service Hero Banner ── -->
        <section class="svc-hero" style="background: @currentService.BannerGradient;">
            <div class="svc-hero-inner">
                <a href="/#services" class="svc-back">← All Services</a>
                <p class="section-kicker" style="color:@currentService.KickerColor;">@currentService.CategoryLabel</p>
                <h1>@currentService.Name</h1>
                <p class="svc-hero-tagline">@currentService.Tagline</p>
                <div class="svc-hero-badges">
                    @foreach (var b in currentService.HeroBadges)
                    {
                        <span>@b</span>
                    }
                </div>
            </div>
            <div class="svc-hero-image">
                <img src="@currentService.HeroImage" alt="@currentService.Name" onerror="this.parentElement.style.background='linear-gradient(135deg,#008d36,#eef6f1)'" />
            </div>
        </section>

        <!-- ── What We Treat / Offer ── -->
        <section class="wellness-section svc-content-section">
            <div class="svc-intro-grid">
                <div class="svc-overview">
                    <p class="section-kicker">OVERVIEW</p>
                    <h2>@currentService.OverviewHeading</h2>
                    <p class="large-copy">@currentService.OverviewBody</p>
                </div>
                <div class="svc-stats-col">
                    @foreach (var stat in currentService.KeyStats)
                    {
                        <div class="svc-stat-card">
                            <strong>@stat.Value</strong>
                            <span>@stat.Label</span>
                        </div>
                    }
                </div>
            </div>
        </section>

        <!-- ── Treatments & Methods ── -->
        <section class="svc-treatments-band">
            <div class="wellness-section" style="padding-top:60px;padding-bottom:60px;">
                <p class="section-kicker">TREATMENTS &amp; METHODS</p>
                <h2>How we help you.</h2>
                <div class="svc-treatment-grid">
                    @foreach (var t in currentService.Treatments)
                    {
                        <div class="svc-treatment-card">
                            <span class="svc-treat-icon">@t.Icon</span>
                            <h4>@t.Name</h4>
                            <p>@t.Description</p>
                        </div>
                    }
                </div>
            </div>
        </section>

        <!-- ── Sub-services pills ── -->
        @if (currentService.SubServices.Length > 0)
        {
            <section class="wellness-section" style="padding-top:60px;padding-bottom:60px;">
                <p class="section-kicker">SUB-SERVICES</p>
                <h2>Specialisations within this service.</h2>
                <div class="svc-subservice-pills">
                    @foreach (var s in currentService.SubServices)
                    {
                        <button class="svc-pill @(selectedSubService == s ? "active" : "")"
                                type="button"
                                @onclick="() => SelectSubService(s)">@s</button>
                    }
                </div>
                @if (!string.IsNullOrEmpty(selectedSubService))
                {
                    <div class="svc-pill-cta">
                        <p>Ready to book <strong>@selectedSubService</strong>?</p>
                        <button class="wellness-primary" type="button" @onclick="() => ScrollToBooking()">Book Now →</button>
                    </div>
                }
            </section>
        }

        <!-- ── Photo gallery strip ── -->
        <section class="svc-photo-strip">
            @foreach (var img in currentService.GalleryImages)
            {
                <div class="svc-photo-item">
                    <img src="@img" alt="@currentService.Name" loading="lazy" onerror="this.style.display='none'" />
                </div>
            }
        </section>

        <!-- ── Outcomes ── -->
        <section class="wellness-section svc-outcomes-section">
            <p class="section-kicker">EXPECTED OUTCOMES</p>
            <h2>What you can expect.</h2>
            <div class="svc-outcomes-grid">
                @foreach (var o in currentService.Outcomes)
                {
                    <div class="svc-outcome-item">
                        <span class="svc-outcome-icon">✓</span>
                        <p>@o</p>
                    </div>
                }
            </div>
        </section>

        <!-- ════════════════════════════════════════════════════════
             INLINE BOOKING FORM
             ════════════════════════════════════════════════════════ -->
        <section id="book-now" class="svc-booking-section">
            <div class="wellness-section" style="padding-top:0;">
                @if (bookingSuccess)
                {
                    <div class="booking-success">
                        <div class="checkmark-circle">✓</div>
                        <h2>Booking Request Received!</h2>
                        <p>Thank you, <strong>@submittedName</strong>. We've received your request for <strong>@submittedService</strong> on <strong>@submittedDate</strong>. The team will contact you on <strong>@submittedPhone</strong> to confirm.</p>
                        <div style="margin-top:2rem;display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
                            <a class="wellness-primary" href="/">← Back to Home</a>
                            <a class="wellness-secondary" href="/#services">View Other Services</a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="svc-booking-card">
                        <div class="svc-booking-header">
                            <p class="section-kicker" style="color:#ffeb00;">BOOK AN APPOINTMENT</p>
                            <h2 style="color:#fff;">Ready to start your @currentService.Name journey?</h2>
                            <p style="color:#c8e8d0;">Fill in your details below — our team will confirm your appointment within the day.</p>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(submitError))
                        {
                            <div class="svc-booking-error">⚠ @submitError</div>
                        }

                        <div class="svc-form-grid">
                            <!-- Full Name -->
                            <div class="svc-field">
                                <label>Full Name *</label>
                                <input type="text" @bind="fullName" @bind:event="oninput"
                                       placeholder="Your full name" maxlength="100"
                                       class="@(string.IsNullOrEmpty(nameError) ? "" : "field-error")" />
                                @if (!string.IsNullOrEmpty(nameError))
                                { <span class="field-error-msg">@nameError</span> }
                            </div>

                            <!-- Phone -->
                            <div class="svc-field">
                                <label>Mobile Number *</label>
                                <input type="tel" @bind="phoneNumber" @bind:event="oninput"
                                       placeholder="10-digit Indian mobile" maxlength="15"
                                       class="@(string.IsNullOrEmpty(phoneError) ? "" : "field-error")" />
                                @if (!string.IsNullOrEmpty(phoneError))
                                { <span class="field-error-msg">@phoneError</span> }
                            </div>

                            <!-- Preferred Date -->
                            <div class="svc-field">
                                <label>Preferred Date &amp; Time *</label>
                                <input type="datetime-local" @bind="preferredDate"
                                       class="@(string.IsNullOrEmpty(dateError) ? "" : "field-error")" />
                                @if (!string.IsNullOrEmpty(dateError))
                                { <span class="field-error-msg">@dateError</span> }
                            </div>

                            <!-- Service (pre-filled, readonly display) -->
                            <div class="svc-field">
                                <label>Service</label>
                                <div class="svc-field-prefill">@currentService.Name</div>
                            </div>

                            <!-- Notes — full width -->
                            <div class="svc-field svc-field-wide">
                                <label>Additional Notes (optional)</label>
                                <textarea @bind="notes" rows="3"
                                          placeholder="Any specific concerns, preferred timings, or health details..."></textarea>
                            </div>
                        </div>

                        <div class="svc-form-footer">
                            <span>* Required fields. We'll call you to confirm.</span>
                            <button class="wellness-primary svc-submit-btn"
                                    type="button"
                                    @onclick="HandleSubmit"
                                    disabled="@submitting">
                                @(submitting ? "Submitting…" : "Request Appointment →")
                            </button>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    <footer>© @DateTime.Now.Year SRI SAI PROTOUCH Physio - Slimming Clinic <span>•</span> Dr. Manjari</footer>
</div>

