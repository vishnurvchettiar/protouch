    protected override void OnParametersSet()
    {
        ServiceCatalogue.TryGetValue(ServiceId?.ToLower() ?? "", out var svc);
        currentService = svc;
        // Reset booking form when service changes
        ResetForm();
    }

    private void SelectSubService(string s)
    {
        selectedSubService = selectedSubService == s ? "" : s;
    }

    private void ScrollToBooking()
    {
        // Blazor can't directly scroll — we use a JS-free anchor approach
        NavManager.NavigateTo($"/services/{ServiceId}#book-now", false);
    }

    private void ResetForm()
    {
        fullName = phoneNumber = notes = nameError = phoneError = dateError = submitError = "";
        preferredDate = DateTime.Today.AddDays(1).AddHours(10);
        bookingSuccess = submitting = false;
    }

    private async Task HandleSubmit()
    {
        nameError = phoneError = dateError = submitError = "";
        var valid = true;

        var trimName = (fullName ?? "").Trim();
        if (trimName.Length < 2 || trimName.Length > 100)
        { nameError = "Full name must be 2–100 characters."; valid = false; }

        var digits = new string(phoneNumber.Where(char.IsDigit).ToArray());
        if (digits.Length != 10 || digits[0] < '6')
        { phoneError = "Enter a valid 10-digit Indian mobile number (starts 6–9)."; valid = false; }

        var now = DateTime.UtcNow;
        var prefUtc = preferredDate.ToUniversalTime();
        if (prefUtc < now.AddHours(1))
        { dateError = "Please choose a time at least 1 hour from now."; valid = false; }
        else if (prefUtc > now.AddDays(90))
        { dateError = "Preferred date must be within the next 90 days."; valid = false; }

        if (!valid) return;

        submitting = true;
        try
        {
            var request = new BookingRequest
            {
                FullName = trimName,
                PhoneNumber = digits,
                ServiceType = currentService!.Name,
                PreferredDate = prefUtc,
                Notes = (notes ?? "").Trim()
            };
            await ClinicService.SubmitBookingRequestAsync(request);

            submittedName = trimName;
            submittedService = currentService!.Name;
            submittedDate = preferredDate.ToString("dd MMM yyyy, hh:mm tt");
            submittedPhone = phoneNumber;
            bookingSuccess = true;
        }
        catch (ArgumentException ex) { submitError = ex.Message; }
        catch { submitError = "We couldn't submit your request. Please call us directly."; }
        finally { submitting = false; }
    }
}
