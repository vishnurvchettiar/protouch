@page "/services/{ServiceId}"
@layout PublicLayout

<PageTitle>@(svc?.Name ?? "Service") | ProTouch Physio - Slimming Clinic</PageTitle>

@if (svc == null || ex == null)
{
    <div class="ppage" data-ptx="notfound">
        <section class="nf dk">
            <div class="c">
                <div class="eb"><i></i>404 · Not found</div>
                <h1>Service not <em>found.</em></h1>
                <p>The service you're looking for doesn't exist. Browse all our services instead.</p>
                <a class="pbtn" href="/services"><span>View all services <b class="ar">→</b></span></a>
            </div>
        </section>
    </div>
}
else
{
    var s = svc;
    var x = ex;
    var related = PublicCatalog.Order.Where(o => o != s.Id).ToList();

    <div class="ppage" data-ptx="detail">

        <!-- ═══════════════ HERO ═══════════════ -->
        <section class="ih dk">
            <span class="bl" style="width:560px;height:560px;right:-160px;top:-160px;background:radial-gradient(circle at 30% 30%,rgba(22,99,92,.5),transparent 70%)"></span>
            <div class="c">
                <div class="g">
                    <div>
                        <div class="crumb"><a href="/">Home</a> / <a href="/services">Services</a> / <b>@x.Short</b></div>
                        <h1 data-split data-now>@s.Name</h1>
                        <p class="plead" data-hero>@s.Tagline</p>
                        <div class="prow" data-hero style="display:flex;gap:12px;flex-wrap:wrap">
                            <a class="pbtn" href="#book-now" data-magnet><span>Book this service <b class="ar">→</b></span></a>
                            <a class="pbtn o" href="#conditions" data-magnet><span>What we treat</span></a>
                        </div>
                        <div class="bdg" data-hero>
                            @foreach (var b in s.HeroBadges)
                            {
                                <span>@b.Replace("✓", "").Trim()</span>
                            }
                        </div>
                    </div>
                    <div class="trio">
                        <div class="ci a" data-depth="10"><img src="@x.Image" alt="@s.Name" /></div>
                        <div class="ci b" data-depth="-16"><img src="@x.Image2" alt="" /></div>
                        <div class="ci c3" data-depth="20"><img src="@x.Image3" alt="" /></div>
                    </div>
                </div>
                <div class="ks" data-st>
                    @foreach (var stat in s.KeyStats)
                    {
                        <div><b data-ct>@stat.Value</b><span>@stat.Label</span></div>
                    }
                </div>
            </div>
        </section>
        <Wave Kind="dl" />

        <!-- ═══════════════ OVERVIEW + OUTCOMES ═══════════════ -->
        <section class="sec lt" style="padding-top:clamp(30px,5vw,70px)">
            <div class="c ov2">
                <div>
                    <div class="eb" data-rv><i></i>Overview</div>
                    <h2 class="h" data-split>@s.OverviewHeading</h2>
                    <p class="b" data-rv>@s.OverviewBody</p>
                </div>
                <ul class="out" data-st>
                    @foreach (var o in s.Outcomes)
                    {
                        <li><svg viewBox="0 0 24 24" aria-hidden="true"><path data-d d="M4 12l5 5L20 6" /></svg><span>@o</span></li>
                    }
                </ul>
            </div>
        </section>
        <Wave Kind="ld" />

        <!-- ═══════════════ TREATMENTS ═══════════════ -->
        <section class="sec dk" style="padding-top:clamp(30px,5vw,70px)">
            <div class="c">
                <div class="eb" data-rv><i></i>Treatments &amp; methods</div>
                <h2 class="h" data-split>How we <em>help you.</em></h2>
                <div class="tg" data-st>
                    @{ var ti = 0; }
                    @foreach (var t in s.Treatments)
                    {
                        ti++;
                        <div class="tc" data-tilt>
                            <span class="n">@ti.ToString("00")</span>
                            <h3>@t.Name</h3>
                            <p>@t.Description</p>
                        </div>
                    }
                </div>
            </div>
        </section>
        <Wave Kind="dl" />

        <!-- ═══════════════ CONDITIONS ═══════════════ -->
        <section class="sec lt" id="conditions" style="padding-top:clamp(30px,5vw,70px)">
            <div class="c">
                <div class="eb" data-rv><i></i>Sub-services</div>
                <h2 class="h" data-split>Specialisations <em>within this service.</em></h2>
                <p class="plead" data-rv style="margin-top:18px">Choose one and it is added to your booking request.</p>
                <div class="cn">
                    <div class="chips" data-st>
                        @foreach (var sub in s.SubServices)
                        {
                            <button class="chp" type="button" data-c="@sub">@sub</button>
                        }
                    </div>
                    <div class="ap">
                        <h3>Book this service</h3>
                        <div class="sv">@s.Name</div>
                        <p class="selnote">Interested in: <b>any condition</b></p>
                        <a class="pbtn" href="#book-now"><span>Continue to booking <b class="ar">→</b></span></a>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══════════════ PROCESS ═══════════════ -->
        <section class="sec lt" style="padding-top:0">
            <div class="c" style="text-align:center">
                <div class="eb" data-rv><i></i>How it works</div>
                <h2 class="h" data-split>Four steps for <em>@(x.Short.ToLowerInvariant()).</em></h2>
                <div class="ps">
                    <div class="pr"></div>
                    @for (var i = 0; i < x.Steps.Length; i++)
                    {
                        <div class="pst">
                            <div class="o">@(i + 1)</div>
                            <h3>@x.Steps[i].Title</h3>
                            <p>@x.Steps[i].Text</p>
                        </div>
                    }
                </div>
            </div>
        </section>

        <!-- ═══════════════ CLINIC MATERIAL ═══════════════ -->
        <section class="sec lt" style="padding-top:0">
            <div class="c">
                <div class="eb" data-rv><i></i>From the clinic</div>
                <h2 class="h" data-split>Programme <em>material.</em></h2>
                <div class="psr" style="margin-top:36px" data-lbset data-st>
                    @foreach (var poster in x.Posters)
                    {
                        <figure data-lb><img loading="lazy" src="@poster" alt="@s.Name programme poster" onerror="this.parentElement.style.display='none'" /></figure>
                    }
                </div>
            </div>
        </section>

        <!-- ═══════════════ FAQ ═══════════════ -->
        <section class="sec lt" style="padding-top:0">
            <div class="c" style="text-align:center">
                <div class="eb" data-rv><i></i>Questions</div>
                <h2 class="h" data-split>About <em>@(x.Short.ToLowerInvariant()).</em></h2>
                <div class="faq">
                    @foreach (var f in x.Faq)
                    {
                        <div class="q">
                            <button type="button" aria-expanded="false"><span>@f.Q</span><i>+</i></button>
                            <div class="a"><div><p>@f.A</p></div></div>
                        </div>
                    }
                </div>
            </div>
        </section>

        <!-- ═══════════════ BOOKING (interactive) ═══════════════ -->
        <section class="sec lt" id="book-now" style="padding-top:0">
            <div class="c" data-rv>
                <ServiceBookingForm @rendermode="InteractiveServer" ServiceName="@s.Name" SubServices="@s.SubServices" />
            </div>
        </section>

        <!-- ═══════════════ OTHER SERVICES ═══════════════ -->
        <section class="sec lt" style="padding-top:0">
            <div class="c">
                <div class="eb" data-rv><i></i>Explore more</div>
                <h2 class="h" data-split>Other <em>services.</em></h2>
                <div class="rel" style="margin-top:36px" data-st>
                    @foreach (var rid in related)
                    {
                        var rs = PublicCatalog.Services[rid];
                        var rx = PublicCatalog.Extras[rid];
                        <article class="rc">
                            <div class="im"><img src="@rx.Image" alt="@rs.Name" loading="lazy" /></div>
                            <h3>@rs.Name</h3>
                            <p>@string.Join(" · ", rs.SubServices.Take(3))</p>
                            <a class="pbtn" href="/services/@rid"><span>Explore <b class="ar">→</b></span></a>
                        </article>
                    }
                </div>
            </div>
        </section>

        <PtxCta />
    </div>
}

@code {
    [Parameter] public string ServiceId { get; set; } = "";

    private ServicePageData? svc;
    private ServiceExtra? ex;

    protected override void OnParametersSet()
    {
        var key = (ServiceId ?? "").ToLowerInvariant();
        svc = PublicCatalog.Services.GetValueOrDefault(key);
        ex = PublicCatalog.Extras.GetValueOrDefault(key);
    }
}
